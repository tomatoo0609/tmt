                if (r != 0 || !res) { last = r; continue; }
                for (u8* ai = static_cast<u8*>(res); ai && !saOk; ai = *reinterpret_cast<u8**>(ai + 0x28)) {
                    for (int o = 0x18; o <= 0x20 && !saOk; o += 8) {
                        const u8* q = *reinterpret_cast<u8**>(ai + o); if (!q) continue;
                        if (q[1] == 2 && (q[0] == 16 || q[0] == 0)) { std::memcpy(sa, q, 16); saOk = true; }
                    }
                }
                u.fai(res);
                if (!saOk) last = 98;
            }
            if (!saOk) return 1100 + (last < 0 ? 99 : last % 100); /* 11xx: 名前から住所を調べられない (xx = 理由の番号) */
        }
        sa[0] = 16; sa[1] = 2; sa[2] = 443 >> 8; sa[3] = 443 & 255;
        const int fd = u.sock(2, 1, 0); if (fd < 0) return 13;
        { const s64 tv[2] = { 15, 0 }; u.sso(fd, 0xFFFF, 0x1006, tv, 16); u.sso(fd, 0xFFFF, 0x1005, tv, 16); } /* 受信・送信の時間切れ: 15 秒 */
        if (u.conn(fd, sa, 16) != 0) { u.cls(fd); return 14; }
        alignas(16) static u8 ctx[0x40], con[0x100];
        std::memset(ctx, 0, sizeof(ctx)); std::memset(con, 0, sizeof(con));
