        constexpr int kDump = 0x4000, kDumpN = 4; u8* out = g_EbBuf; constexpr int kEnt = 40; const int cap = static_cast<int>((sizeof(g_EbBuf) - 256 - kDumpN * (kDump + 16)) / kEnt); uintptr_t dumpAt[kDumpN]; int nd = 0; int ol = 0, m = 0, cand = 0, moved = 0;
        std::memcpy(out, "INKDF001", 8); ol = 8 + 4 + 4 + 4; std::memcpy(out + ol, g_DfMe1, 12); ol += 12; std::memcpy(out + ol, g_DfMe2, 12); ol += 12; const u64 mb = MainBase(); std::memcpy(out + ol, &mb, 8); ol += 8; const int head = ol;
        for (int pass = 0; pass < 2; pass++) {
            for (int k = 0; k < g_DfN && m < cap; k++) {
                if (gen != g_LoadGen) { g_DfMsg = 6; return; }
                const uintptr_t at = g_DfAddr[k]; if (!Readable(at, 12)) continue;
                float nw[3]; std::memcpy(nw, reinterpret_cast<const void*>(at), 12); const float* od = g_DfOld[k];
                const float mvx = nw[0] - od[0], mvy = nw[1] - od[1], mvz = nw[2] - od[2]; if (!(mvx * mvx + mvy * mvy + mvz * mvz > 0.01f)) continue; /* 動いていない */
                const float ax = od[0] - g_DfMe1[0], az = od[2] - g_DfMe1[2], bx = nw[0] - g_DfMe2[0], bz = nw[2] - g_DfMe2[2], by = nw[1] - (g_DfMe2[1] - kLiveHeight);
                const bool isC = ax * ax + az * az > 0.36f && bx * bx + bz * bz < 1.44f && by > -0.5f && by < 3.0f;
                if ((pass == 0) != isC) continue;
                if (pass == 0) cand++; else moved++;
                u32 vtRel = 0xFFFFFFFFu, off = 0; MemoryInfo mi; u32 page;
                if (R_SUCCEEDED(svcQueryMemory(&mi, &page, at))) for (u32 back = 0; back <= 0x400; back += 8) { const uintptr_t q = (at & ~static_cast<uintptr_t>(7)) - back; if (q < mi.addr) break;
                    const uintptr_t v = *reinterpret_cast<const uintptr_t*>(q); if (v >= mlo && v < mhi && !(v & 7)) { vtRel = static_cast<u32>(v - mlo); off = static_cast<u32>(at - q); break; } } /* 前にある、main の中を指す値 */
                u8* e = out + head + m * kEnt; const u64 a64 = at; std::memcpy(e, &a64, 8); std::memcpy(e + 8, od, 12); std::memcpy(e + 20, nw, 12); std::memcpy(e + 32, &vtRel, 4); std::memcpy(e + 36, &off, 4); m++;
                if (pass == 0 && vtRel != 0xFFFFFFFFu) { const float fx = od[0] - g_DfMe1[0], fz = od[2] - g_DfMe1[2]; const uintptr_t ob = at - off; bool dupD = false; for (int q = 0; q < nd; q++) if (ob + kDump / 2 > dumpAt[q] && ob < dumpAt[q] + kDump / 2) dupD = true; /* 同じ物は 1 回だけ */
                    if (fx * fx + fz * fz > 2.25f && !dupD && nd < kDumpN) dumpAt[nd++] = ob; } /* 1 回目に自分から 1.5 以上はなれていた候補 (自分の部品ではない) の、物の先頭のまわり */
            }
        }
        const u32 h3[3] = { static_cast<u32>(m), static_cast<u32>(cand), static_cast<u32>(g_DfN) }; std::memcpy(out + 8, h3, 12);
        ol = head + m * kEnt; std::memcpy(out + ol, "DUMP", 4); ol += 4; const u32 ndu = static_cast<u32>(nd); std::memcpy(out + ol, &ndu, 4); ol += 4;
        for (int q = 0; q < nd; q++) { const u64 c64 = dumpAt[q]; std::memcpy(out + ol, &c64, 8); ol += 8; const uintptr_t from = (dumpAt[q] & ~static_cast<uintptr_t>(7)) - kDump / 2; u64 f64 = from; std::memcpy(out + ol, &f64, 8); ol += 8;
            if (Readable(from, kDump)) std::memcpy(out + ol, reinterpret_cast<const void*>(from), kDump); else std::memset(out + ol, 0, kDump); ol += kDump; }
        const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) UpdWrite(sdk, "inkd:/inkdraw/bin/asaridiff.bin", out, static_cast<u32>(ol)); /* 裏の流れなので、そのまま書く */
        g_DfCand = cand; g_DfMoved = moved; g_DfMsg = 4;
    }
    void DfPress() { /* 1 回目: アサリの横 (持たずに) で押す。2 回目: そのアサリを拾ってから押す */
        const int st = g_DfMsg; if (st == 1 || st == 3) return;
        if (st == 2 && g_DfGen != g_LoadGen) { g_DfMsg = 6; return; } /* 1 回目のあとロードした: 覚えた場所はもう使えない */
        float me[3]; if (!SelfPos(me)) { g_DfMsg = 5; return; }
        if (st == 2) { const float qx = me[0] - g_DfMe1[0], qy = me[1] - g_DfMe1[1], qz = me[2] - g_DfMe1[2]; if (qx * qx + qy * qy + qz * qz < 0.0001f) { g_DfMsg = 7; return; } /* 拾うと少しは動くはず: まったく同じなら、座標が取れていない (もう一度 1 回目から) */
            std::memcpy(g_DfMe2, me, 12); g_DfMsg = 3; if (!BgRequest(2048u, nullptr)) g_DfMsg = 5; return; }
        std::memcpy(g_DfMe1, me, 12); g_DfGen = g_LoadGen; g_DfMsg = 1; if (!BgRequest(2048u, nullptr)) g_DfMsg = 5;
    }
    void AdPress() {
        if (g_AdMsg == 1) return; float me[3]; if (!SelfPos(me)) { g_AdMsg = 3; return; }
        std::memcpy(g_AdMe, me, 12); g_AdGen = g_LoadGen; g_AdNo = g_AdNo + 1; g_AdMsg = 1; if (!BgRequest(1024u, nullptr)) g_AdMsg = 3;
    }
    volatile int g_TsMsg = 0, g_TsN = 0; /* チームサーチ: 0 まだ / 1 体を探し中 / 2 保存した */
    void TsPress() { /* チームサーチ: 試合が始まった直後 (スタート地点にいる間) に押すと、味方は自分の近く・敵は遠くにいるので、見比べて敵と味方を分ける値を探せる */
        if (g_EnN <= 0) { g_EnWantUntil = NowTick() + 60ull * 19200000ull; g_EnScanNow = true; g_TsMsg = 1; return; }
        EbDump("inkd:/inkdraw/bin/teamsearch.bin", 0x2000, 16); g_TsN = g_EnN; g_TsMsg = 2;
    }
    void DthPress() {
        const int st = g_DtStep;
        if (st == 0 || st >= 9) {
            EbDump("inkd:/inkdraw/bin/enemybodies.bin");
            float me[3]; float dd[kDtObjMax]; g_DtNObj = 0;
            if (SelfPos(me)) for (int k = 0; k < g_EnN; k++) { float p2[3]; if (!EnPos(k, p2)) continue; const float dx = p2[0] - me[0], dz = p2[2] - me[2], d = dx * dx + dz * dz;
                int pos = g_DtNObj; while (pos > 0 && dd[pos - 1] > d) pos--; if (pos >= kDtObjMax) continue;
                for (int q = (g_DtNObj < kDtObjMax ? g_DtNObj : kDtObjMax - 1); q > pos; q--) { g_DtObjs[q] = g_DtObjs[q - 1]; dd[q] = dd[q - 1]; }
                g_DtObjs[pos] = g_EnObj[k]; dd[pos] = d; if (g_DtNObj < kDtObjMax) g_DtNObj++; }
            if (g_DtNObj == 0) { g_EnWantUntil = NowTick() + 60ull * 19200000ull; g_EnScanNow = true; g_DtStep = 11; return; }
            for (int o = 0; o < g_DtNObj; o++) { if (Readable(g_DtObjs[o], 0x1000)) std::memcpy(g_DtShadow[o], reinterpret_cast<const void*>(g_DtObjs[o]), 0x1000); else std::memset(g_DtShadow[o], 0, 0x1000); }
            std::memset(g_DtCnt, 0, sizeof(g_DtCnt)); g_DtHead = 0; g_DtNLog = 0; g_DtNMark = 0; g_DtT0 = NowTick(); g_DtT = 0; g_DtWin = g_DtT0; g_DtStop = 0; g_DtSample = 0; g_DtStep = 2; return;
        }
        if (st == 2) { const u64 n = NowTick(); if (g_DtNMark < 8) g_DtMark[g_DtNMark++] = static_cast<u32>((n - g_DtT0) / 19200ull); g_DtStop = n + 4ull * 19200000ull; g_DtStep = 3; } /* 倒した時刻に印。4 秒あとに保存 */
    }
    void DthTick() {
        const int st = g_DtStep; if (st != 2 && st != 3) return;
        const u64 now = NowTick(); if (g_DtT && now - g_DtT < 960000ull) return; g_DtT = now; /* 0.05 秒ごと */
        if (now - g_DtWin > 3ull * 19200000ull) { std::memset(g_DtCnt, 0, sizeof(g_DtCnt)); g_DtWin = now; } /* 3 秒ごとに、同じ場所を覚える回数をリセット (ずっと変わり続ける場所で記録がいっぱいにならないように) */
        const u32 tms = static_cast<u32>((now - g_DtT0) / 19200ull); g_DtSample = static_cast<int>(tms / 1000u);
        for (int o = 0; o < g_DtNObj; o++) {
            if (!Readable(g_DtObjs[o], 0x1000)) continue; const u32* w = reinterpret_cast<const u32*>(g_DtObjs[o]);
            for (int i = 0; i < kDtWords; i++) { const u32 v = w[i]; if (v == g_DtShadow[o][i]) continue;
                if (g_DtCnt[o][i] < 6) { g_DtCnt[o][i]++; DtEnt& e = g_DtLog[g_DtHead]; e.t = tms; e.off = static_cast<u16>(i * 4); e.obj = static_cast<u8>(o); e.pad = 0; e.oldv = g_DtShadow[o][i]; e.newv = v; g_DtHead = (g_DtHead + 1) % kDtLogMax; if (g_DtNLog < kDtLogMax) g_DtNLog++; }
                g_DtShadow[o][i] = v; }
        }
        if ((st == 3 && now >= g_DtStop) || now - g_DtT0 > 120ull * 19200000ull) DtSave(); /* 印から 4 秒後、または 2 分たったら保存 */
    }
    /* 設定の保存: SD の inkdraw/settings.json。起動して 3 秒後に読み、そのあとは設定が変わったら (2 秒に 1 回まで) 自動で書く */
    /* pchtxt の保存: ON/OFF を変えたファイルの @enabled / @disabled の行を書きかえる (まとまりに自分の行がなければ、最初のパッチの行の前に足す)。
       足した行があれば、ほかのまとまりも自分の行を持つので、前のまとまりの設定を引きつがなくなる */
    static void PchSave() {
        static const char* const kPf[10] = { "inkd:/inkdraw/patches.pchtxt", "inkd:/inkdraw/patch1.pchtxt", "inkd:/inkdraw/patch2.pchtxt", "inkd:/inkdraw/patch3.pchtxt", "inkd:/inkdraw/patch4.pchtxt",
            "inkd:/inkdraw/patch5.pchtxt", "inkd:/inkdraw/patch6.pchtxt", "inkd:/inkdraw/patch7.pchtxt", "inkd:/inkdraw/patch8.pchtxt", "inkd:/inkdraw/patch9.pchtxt" };
        const uintptr_t sdk = UpdSdk(); if (!sdk || !UpdMount(sdk)) return;
        static char in[0x10000], out[0x10000 + 64 * 16];
        for (int f = 0; f < 10; f++) {
            bool any = false; for (int g = 0; g < g_GrpN; g++) if (g_Grp[g].file == f) any = true; if (!any) continue;
            const int n = UpdReadSmall(sdk, kPf[f], in, static_cast<int>(sizeof(in))); if (n <= 0 || n >= static_cast<int>(sizeof(in))) continue;
            bool crlf = false; for (int q = 0; q + 1 < n; q++) if (in[q] == '\r' && in[q + 1] == '\n') { crlf = true; break; }
            int o = 0, pos = 0; bool ok = true; s32 nS_[64], nE_[64], nF_[64]; for (int g = 0; g < 64; g++) { nS_[g] = -1; nE_[g] = -1; nF_[g] = -1; }
            for (int g = 0; g < g_GrpN && ok; g++) { const PchGroup& G = g_Grp[g]; if (G.file != f) continue;
                const char* m = G.on ? "@enabled" : "@disabled"; const int ml = G.on ? 8 : 9;
                if (G.mS >= pos && G.mE <= G.first && G.mE >= G.mS) { /* 自分の行を書きかえる */
                    const int cp = G.mS - pos; std::memcpy(out + o, in + pos, cp); o += cp; nS_[g] = o; std::memcpy(out + o, m, ml); o += ml; nE_[g] = o; pos = G.mE;
                } else if (G.mS < 0 && G.first >= pos && G.first <= n) { /* 自分の行がない: 最初のパッチの行の前に足す */
                    const int cp = G.first - pos; std::memcpy(out + o, in + pos, cp); o += cp; nS_[g] = o; std::memcpy(out + o, m, ml); o += ml; nE_[g] = o;
                    if (crlf) out[o++] = '\r'; out[o++] = '\n'; pos = G.first;
                } else ok = false;
                nF_[g] = G.first + (o - pos); /* 書いたあとの、最初のパッチの行の位置 */
                if (o > static_cast<int>(sizeof(out)) - 64) ok = false; }
            if (!ok) continue;
            std::memcpy(out + o, in + pos, n - pos); o += n - pos;
            UpdWrite(sdk, kPf[f], out, static_cast<u32>(o));
            for (int g = 0; g < g_GrpN; g++) if (g_Grp[g].file == f) { g_Grp[g].mS = nS_[g]; g_Grp[g].mE = nE_[g]; g_Grp[g].first = nF_[g]; } /* 次に保存するとき用 */
        }
    }
    void SettingsTick() {
        if (g_PchSaveReq && NowTick() - g_PchSaveT > 19200000ull) { g_PchSaveReq = false; PchSave(); } /* ON/OFF を変えて 1 秒たったら保存 */
        static u64 t0 = 0, lastW = 0; static u32 lastH = 0; static bool loaded = false; const u64 now = NowTick(); if (!t0) t0 = now;
        struct KV { const char* k; int v; };
        auto cur = [&](KV* o) { int n = 0;
            o[n++] = { "aimbot", (g_LookOn && g_LookSlot == 6) ? 1 : 0 }; o[n++] = { "aimTarget", g_AimTgt }; o[n++] = { "aHold", g_LookAHold ? 1 : 0 };
            o[n++] = { "circle", g_CircOn ? 1 : 0 }; o[n++] = { "circleSize", g_CircR }; o[n++] = { "range", g_LookRange }; o[n++] = { "lead", g_LeadLv };
            o[n++] = { "fov", g_FovLv }; o[n++] = { "fovCandidate", g_FovSel }; o[n++] = { "zrHold", g_Fx[4] };
            o[n++] = { "uiScale", g_UiScale }; o[n++] = { "uiX", g_UiX }; o[n++] = { "uiY", g_UiY }; o[n++] = { "menuCat", g_Cat }; o[n++] = { "menuSel", g_MenuSel }; return n; };
        if (!loaded) {
            if (now - t0 < 3ull * 19200000ull) return; loaded = true;
            const uintptr_t sdk = UpdSdk(); char t[2048]; int n = -1; if (sdk && UpdMount(sdk)) n = UpdReadSmall(sdk, "inkd:/inkdraw/settings.json", t, sizeof(t) - 1);
            if (n > 0) { t[n] = 0;
                auto get = [&](const char* key, int* out) { char pat[40]; std::snprintf(pat, sizeof(pat), "\"%s\":", key); const char* q = nullptr; { const int pl = static_cast<int>(std::strlen(pat)); for (const char* r = t; *r && !q; r++) { int k = 0; while (k < pl && r[k] == pat[k]) k++; if (k == pl) q = r; } } if (!q) return false; /* strstr は使わない (読み込む関数を増やさない) */ q += std::strlen(pat); while (*q == ' ') q++; int sg = 1; if (*q == '-') { sg = -1; q++; } if (*q < '0' || *q > '9') return false; int v = 0; while (*q >= '0' && *q <= '9') v = v * 10 + (*q++ - '0'); *out = v * sg; return true; };
                int v;
                if (get("aimTarget", &v) && v >= 0 && v < 3) g_AimTgt = v; if (get("aHold", &v)) g_LookAHold = v != 0; if (get("circle", &v)) g_CircOn = v != 0;
                if (get("circleSize", &v) && v >= 1 && v <= 100) g_CircR = v; if (get("range", &v) && v >= 0 && v <= 19) g_LookRange = v; if (get("lead", &v) && v >= 0 && v <= 20) g_LeadLv = v;
                if (get("fovCandidate", &v) && v >= 0 && v < 24) g_FovSel = v; if (get("zrHold", &v)) g_Fx[4] = v ? 1 : 0;
                if (get("uiScale", &v) && v >= 50 && v <= 150) g_UiScale = v; if (get("uiX", &v) && v > -2000 && v < 2000) g_UiX = v; if (get("uiY", &v) && v > -2000 && v < 2000) g_UiY = v;
                { int mc = -1, ms = 0; if (get("menuCat", &mc) && mc >= -1 && mc < kCatCount && get("menuSel", &ms) && ms >= 0) { g_Cat = mc; g_MenuSel = ms; if (g_MenuSel >= PageCount()) g_MenuSel = 0; if (mc >= 0) g_CatSel[mc] = g_MenuSel; } } /* メニューの場所も前のまま */
                if (get("aimbot", &v) && v) { g_LookSlot = 6; g_LookOn = true; g_EnScanNow = true; g_BalScanNow = true; }
            }
            KV kv[24]; const int m = cur(kv); u32 h = 2166136261u; for (int k = 0; k < m; k++) h = (h ^ static_cast<u32>(kv[k].v + 7919 * k)) * 16777619u; lastH = h; return;
        }
        if (now - lastW < 2ull * 19200000ull) return;
        KV kv[24]; const int m = cur(kv); u32 h = 2166136261u; for (int k = 0; k < m; k++) h = (h ^ static_cast<u32>(kv[k].v + 7919 * k)) * 16777619u;
        if (h == lastH) return; lastH = h; lastW = now;
        char t[1024]; int L = std::snprintf(t, sizeof(t), "{\n");
        for (int k = 0; k < m; k++) L += std::snprintf(t + L, sizeof(t) - L, "  \"%s\": %d%s\n", kv[k].k, kv[k].v, k + 1 < m ? "," : "");
        L += std::snprintf(t + L, sizeof(t) - L, "}\n");
        const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) UpdWrite(sdk, "inkd:/inkdraw/settings.json", t, static_cast<u32>(L));
    }
    void ScanTick() {
        static u64 lastT = 0; static int fr = 0, nextCam = 0;
        if (g_ScanStep == 0) { fr = 0; return; }
        const u64 now = NowTick(); if (now - lastT < 300000ull) return; lastT = now; /* 1 フレームに 1 回 */
        if (!g_LookOn) { g_LookRx = 0; g_LookRy = 0; }
        if (g_ScanStep == 1 && fr == 0) {
            if (!CamValid()) { if (nextCam++ % 120 == 0) CamFind(); if (nextCam > 600) { g_ScanStep = 0; g_ScanMsg = 3; nextCam = 0; } return; } /* カメラを探す (10 秒まで) */
            nextCam = 0;
            g_ScBase = (g_CamPos & ~static_cast<uintptr_t>(3)) - kScanF * 2; std::memset(g_ScOk, 1, sizeof(g_ScOk));
            g_LookOn = false; ScanSnap(0);
        }
        fr++;
        static const int kLen[7] = { 0, 20, 20, 20, 15, 12, 15 };
        if (g_ScanStep == 2) g_LookRx = 20000; else if (g_ScanStep == 4) g_LookRy = 20000; else if (g_ScanStep == 6) g_LookRy = -20000; else { g_LookRx = 0; g_LookRy = 0; }
        if (fr >= kLen[g_ScanStep]) {
            fr = 0;
            if (g_ScanStep == 1) ScanSnap(1); else if (g_ScanStep == 2) ScanSnap(2); else if (g_ScanStep == 3) ScanSnap(3); else if (g_ScanStep == 4) ScanSnap(4);
            if (g_ScanStep == 6) { g_ScanStep = 0; g_LookRx = 0; g_LookRy = 0; ScanAnalyze(); return; }
            g_ScanStep = g_ScanStep + 1;
            if (g_ScanStep != 1) { /* 次の段階の最初のフレームでは、まだ倒さない */ }
        }
    }
    /* 今のカメラの向き (横、長さ 1)。カメラの値が見つかっていればそれ、なければ歩いて覚えた向き。どちらもなければ false */
    bool CamYawGet(float* fx, float* fz, bool* live) {
        { float o[3]; float ee[3]; if ((g_ScanFix || CamEye(ee)) && CamDir3(o)) { const float h = __builtin_sqrtf(o[0] * o[0] + o[2] * o[2]); if (h > 0.1f) { *fx = o[0] / h; *fz = o[2] / h; *live = true; return true; } } }
        if (g_CdOff >= 0 && CamValid() && g_CamPos - 0x800 == g_CdBase && Readable(g_CdBase + g_CdOff * 4, 12)) {
            const float* f = reinterpret_cast<const float*>(g_CdBase) + g_CdOff;
            const float a = f[0] * static_cast<float>(g_CdSign), c = f[2] * static_cast<float>(g_CdSign), h = __builtin_sqrtf(a * a + c * c);
            if (h > 0.1f && a == a && c == c) { *fx = a / h; *fz = c / h; *live = true; return true; }
        }
        if (g_CamFOk) { *fx = g_CamF[0]; *fz = g_CamF[1]; *live = false; return true; }
        return false;
    }

    /* 十字キー上/下を押している間、カメラの追従先を上げ下げする。離したらその高さのまま。0 まで下げると元に戻る。 */
    /* フリーカメラ: メニューで決めた高さまで、カメラの追従先をなめらかに上げる (体は動かさない) */
    /* 壁抜け (試作): Lスティックを倒した向きに、足元の座標を直接ずらして、壁の当たり判定を押し切る。床は動かさない (高さは触らない)。 */
    void WallUpdate() {
        if (false && g_HSpd > 0 && !g_MenuOpen && g_CamFOk && !(g_BtnNow & (1ull << 8)) && LiveValid()) {
            /* 人速度: 歩く向きに、1 フレームごとに少し足元の座標をずらして、速くする (ZL を押している間 = イカは対象外) */
            const float sx = g_LStickX, sy = g_LStickY; const float mg = __builtin_sqrtf(sx * sx + sy * sy);
            MemoryInfo mi; u32 pg;
            if (mg > 0.2f && R_SUCCEEDED(svcQueryMemory(&mi, &pg, g_LivePos)) && (mi.perm & Perm_W)) {
                float* f = reinterpret_cast<float*>(g_LivePos);
                const float vr = g_CamF[0] * sy - g_CamF[1] * sx, vi = g_CamF[0] * sx + g_CamF[1] * sy;
                const float nn = __builtin_sqrtf(vr * vr + vi * vi);
                if (nn > 0.01f) { const float ex = 0.03f * static_cast<float>(g_HSpd > 20 ? 20 : g_HSpd) * (mg > 1.0f ? 1.0f : mg) / nn; f[0] += vr * ex; f[2] += vi * ex; }
            }
        }
        return; /* 壁抜けは BugFly の仕組み (体の写しを全部動かす) の中で行う */
        if (!g_Wall || g_MenuOpen || !g_CamFOk) return;
        const float sx = g_LStickX, sy = g_LStickY;
        if (sx * sx + sy * sy <= 0.04f) return;
        if (!LiveValid()) return;
        float* f = reinterpret_cast<float*>(g_LivePos);
        MemoryInfo mi; u32 pg;
        if (!R_SUCCEEDED(svcQueryMemory(&mi, &pg, g_LivePos)) || !(mi.perm & Perm_W)) return;
        const float vr = g_CamF[0] * sy - g_CamF[1] * sx, vi = g_CamF[0] * sx + g_CamF[1] * sy;
        f[0] += vr * 0.45f; f[2] += vi * 0.45f; g_WallN = g_WallN + 1;
    }
    void CamUpdate() {
        const float target = static_cast<float>(g_FreeCam);
        if (target == 0.0f && g_CamOff == 0.0f && !g_Flk && g_FlkX == 0.0f && g_FlkZ == 0.0f) { g_CamActive = false; return; }
        if (!LiveValid()) { g_LivePos = 0; FindLivePos(nullptr); }
        if (!CamValid()) {
            g_CamActive = false;
            u64 now; asm volatile("mrs %0, cntpct_el0" : "=r"(now));
            if (now > g_CamNextSearch) { CamFind(); g_CamNextSearch = now + 38400000ull; }
            if (!CamValid()) return;
        }
        if (!LiveValid()) return;
        {
            const float rawY = reinterpret_cast<const float*>(g_LivePos)[1];
            static float ySm = 0.0f; static bool haveSm = false;
            if (!haveSm || __builtin_fabsf(rawY - ySm) > 3.0f) { ySm = rawY; haveSm = true; } else ySm += (rawY - ySm) * 0.45f; /* 足元の高さの細かい揺れをならす (カメラのガクガク対策) */
            const float liveY = ySm;
            float* c = reinterpret_cast<float*>(g_CamPos);
            const float d = target - g_CamOff;
            g_CamOff += d > 0.6f ? 0.6f : (d < -0.6f ? -0.6f : d); /* なめらかに近づける */
            if (!g_CamActive && g_CamOff != 0.0f) { g_CamDelta = c[1] - liveY; g_CamActive = true; }
            if (g_CamActive) {
                MemoryInfo mi; u32 pg;
                if (R_SUCCEEDED(svcQueryMemory(&mi, &pg, g_CamPos)) && (mi.perm & Perm_W)) { c[1] = liveY + g_CamDelta + g_CamOff; c[3] = c[1]; }
                if (g_CamOff == 0.0f) g_CamActive = false;
            }
            /* 視点移動: 体は動かさず、カメラの追従先だけを十字キーで動かす (カメラの向きに合わせて 前後左右) */
            if (g_Flk || g_FlkX != 0.0f || g_FlkZ != 0.0f) {
                if (g_Flk && !g_MenuOpen) {
                    u32 dp = 0; for (int i = 0; i < 64; i++) dp |= g_PadDp[i];
                    float fw = ((dp & 2) ? 1.0f : 0.0f) - ((dp & 8) ? 1.0f : 0.0f), rt = ((dp & 4) ? 1.0f : 0.0f) - ((dp & 1) ? 1.0f : 0.0f);
                    { const float rx = g_RStkX, ry = g_RStkY; if (rx * rx + ry * ry > 0.04f) { fw += ry; rt += rx; } } /* 右スティック */
                    if (fw != 0.0f || rt != 0.0f) { const float cf0 = g_CamFOk ? g_CamF[0] : 1.0f, cf1 = g_CamFOk ? g_CamF[1] : 0.0f; g_FlkX += (cf0 * fw - cf1 * rt) * 0.8f; g_FlkZ += (cf0 * rt + cf1 * fw) * 0.8f; }
                } else if (!g_Flk) { g_FlkX *= 0.9f; g_FlkZ *= 0.9f; if (g_FlkX < 0.05f && g_FlkX > -0.05f) g_FlkX = 0.0f; if (g_FlkZ < 0.05f && g_FlkZ > -0.05f) g_FlkZ = 0.0f; }
                MemoryInfo mi2; u32 pg2; const float* Lp = reinterpret_cast<const float*>(g_LivePos);
                if (R_SUCCEEDED(svcQueryMemory(&mi2, &pg2, g_CamPos)) && (mi2.perm & Perm_W)) { (void)Lp; /* c[0] / c[2] はカメラの横の位置ではない (距離など) ので、書かない */ }
            }
        }
    }
    void CamUpdateOld() {
        if (!kEnableCam) return;
        if (g_RiseDir == 0 && g_CamOff <= 0.0f) return;
        if (!LiveValid()) { g_LivePos = 0; FindLivePos(nullptr); }
        if (!CamValid()) {
            g_CamActive = false;
            u64 now; asm volatile("mrs %0, cntpct_el0" : "=r"(now));
            if (g_RiseDir > 0 && now > g_CamNextSearch) {
                CamFind();
                g_CamNextSearch = now + 38400000ull; /* 約 2 秒おき */
            }
            if (!CamValid()) return;
        }
        if (!LiveValid()) return;
        const float liveY = reinterpret_cast<const float*>(g_LivePos)[1];
        float* c = reinterpret_cast<float*>(g_CamPos);
        if (g_RiseDir > 0) g_CamOff += 0.3f;
        else if (g_RiseDir < 0) g_CamOff -= 0.6f;
        if (g_CamOff > 150.0f) g_CamOff = 150.0f;
        if (g_CamOff <= 0.0f) { g_CamOff = 0.0f; }
        if (!g_CamActive && g_CamOff > 0.0f) { g_CamDelta = c[1] - liveY; g_CamActive = true; }
        if (g_CamActive) {
            MemoryInfo mi; u32 pg;
            if (R_SUCCEEDED(svcQueryMemory(&mi, &pg, g_CamPos)) && (mi.perm & Perm_W)) {
                c[1] = liveY + g_CamDelta + g_CamOff;
                c[3] = c[1];
            }
            if (g_CamOff <= 0.0f) g_CamActive = false;
        }
    }
}

HOOK_DEFINE_TRAMPOLINE(PaintRequestHook) {

    /* ---- 絵の診断: 描くたびに (終わったとき・途中で止まったとき・予約したのに始まらなかったとき) SD に inkdiag_*.bin を書く ---- */
    static u32 DiagWrite(int reason) {
        if (g_DgFiles >= 30) return 9;
        g_DgFiles++;
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk) ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return 1;
        using MountFn  = u32 (*)(const char*); using CreateFn = u32 (*)(const char*, s64); using OpenFn = u32 (*)(FileHandle*, const char*, int);
        using WriteFn  = u32 (*)(FileHandle, s64, const void*, u64, const s32*); using FlushFn = u32 (*)(FileHandle); using CloseFn = void (*)(FileHandle);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0) rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return 2;
            g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        }
        std::memset(g_DgBuf, 0, sizeof(g_DgBuf));
        u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t));
        u64* hd = reinterpret_cast<u64*>(g_DgBuf);
        hd[0] = 0x3147414449444B4Eull; /* "NKDIAG1" 風の目印 */
        hd[1] = t; hd[2] = static_cast<u64>(reason); hd[3] = static_cast<u64>(static_cast<u32>(g_DgTotal)); hd[4] = static_cast<u64>(static_cast<s64>(g_Cursor));
        hd[5] = static_cast<u64>(g_DgSent) | (static_cast<u64>(g_DgQFull) << 32);
        hd[6] = static_cast<u64>(g_DgSkip) | (static_cast<u64>(g_DgBegins) << 32);
        hd[7] = static_cast<u64>(g_DgQUsed) | (static_cast<u64>(g_DgQCap) << 32);
        hd[8] = static_cast<u64>(g_DgSeqFirst) | (static_cast<u64>(g_DgSeqLast) << 32);
        hd[9] = static_cast<u64>(g_SeqRef) | (static_cast<u64>(g_SeqTpf) << 32);
        hd[10] = static_cast<u64>(static_cast<u32>((t - g_SeqTick) / 19200ull)) | (static_cast<u64>(static_cast<u32>((t - g_DgBeginT) / 19200ull)) << 32); /* 最後に見た塗りからの ms / 描き始めからの ms */
        hd[11] = static_cast<u64>(g_OriginSrc) | (static_cast<u64>(g_IdxSrc) << 8) | (static_cast<u64>(g_HaveTmpl ? 1 : 0) << 16) | (static_cast<u64>(g_TmplOwn ? 1 : 0) << 24) | (static_cast<u64>(g_Armed ? 1 : 0) << 32) | (static_cast<u64>(g_HaveSeq ? 1 : 0) << 40) | (static_cast<u64>(g_FireHeld ? 1 : 0) << 48) | (static_cast<u64>(g_HaveEnemy ? 1 : 0) << 56);
        hd[12] = static_cast<u64>(static_cast<u32>(g_W)) | (static_cast<u64>(static_cast<u32>(g_H)) << 32);
        hd[13] = static_cast<u64>(g_FillMode) | (static_cast<u64>(g_TextImg ? 1 : 0) << 8) | (static_cast<u64>(g_SpiralRun ? 1 : 0) << 16) | (static_cast<u64>(g_CleanMode ? 1 : 0) << 24) | (static_cast<u64>(g_ImgK) << 32) | (static_cast<u64>(g_TextK) << 40) | (static_cast<u64>(g_ForceGlyph) << 48);
        hd[14] = static_cast<u64>(g_LocalIdx) | (static_cast<u64>(g_DgHookPaint) << 32); hd[15] = g_LastMgr;
        std::memcpy(g_DgBuf + 0x80, g_Origin, 12); std::memcpy(g_DgBuf + 0x8C, &g_DgStep, 4); std::memcpy(g_DgBuf + 0x90, &g_DgDot, 4);
        std::memcpy(g_DgBuf + 0xA0, g_LastHit, 12); std::memcpy(g_DgBuf + 0xB0, &g_DgNetTrue, 4); std::memcpy(g_DgBuf + 0xB4, &g_DgNetFalse, 4);
        std::memcpy(g_DgBuf + 0x100, g_DgFirst, 0x60); std::memcpy(g_DgBuf + 0x160, g_DgLast, 0x60);
        std::memcpy(g_DgBuf + 0x1C0, g_Base.raw, 0x40);
        std::memcpy(g_DgBuf + 0x200, g_Tmpl.raw, 0x60);
        std::memcpy(g_DgBuf + 0x260, g_EnemyTmpl.raw, 0x60);
        std::memcpy(g_DgBuf + 0x2C0, g_ShotRaw, 0x60); std::memcpy(g_DgBuf + 0x320, &g_ShotN, 4); std::memcpy(g_DgBuf + 0x324, &g_ShotNear, 4); std::memcpy(g_DgBuf + 0x328, &g_ShotOwn, 4); std::memcpy(g_DgBuf + 0x350, g_NearRaw, 0x60); std::memcpy(g_DgBuf + 0x3C0, &g_NearN, 4); std::memcpy(g_DgBuf + 0x3C4, &g_NearCap, 4);
        char name[48]; const char* pp = "inkd:/inkdraw/bin/inkdiag_"; char* q = name;
        while (*pp) *q++ = *pp++;
        for (int i = 7; i >= 0; i--) *q++ = "0123456789abcdef"[(static_cast<u32>(t >> 4) >> (i * 4)) & 15];
        *q++ = '.'; *q++ = 'b'; *q++ = 'i'; *q++ = 'n'; *q = 0;
        const auto create = reinterpret_cast<CreateFn>(sdk + kSdkCreateFile); const auto open = reinterpret_cast<OpenFn>(sdk + kSdkOpenFile);
        const auto write = reinterpret_cast<WriteFn>(sdk + kSdkWriteFile); const auto flush = reinterpret_cast<FlushFn>(sdk + kSdkFlushFile); const auto close = reinterpret_cast<CloseFn>(sdk + kSdkCloseFile);
        if (create(name, static_cast<s64>(sizeof(g_DgBuf))) != 0) return 3;
        FileHandle fh { nullptr };
        if (open(&fh, name, 2) != 0) return 4;
        const s32 opt = 0;
        const u32 wr = write(fh, 0, g_DgBuf, sizeof(g_DgBuf), &opt);
        flush(fh); close(fh);
        return wr == 0 ? 0 : 5;
    }
    /* 毎フレーム (メインの tick から): 診断ファイルを書く時を見張る */
    static void DiagTick() {
        static u64 armedSince = 0; static bool armedLogged = false, stallLogged = false;
        const u64 now = NowTick();
        if (g_DgReq) { const int r = g_DgReq; g_DgReq = 0; DiagWrite(r); return; }
        if (g_Armed) { if (!armedSince) { armedSince = now; armedLogged = false; } else if (!armedLogged && now - armedSince > 19200000ull * 2) { armedLogged = true; DiagWrite(3); } }
        else armedSince = 0;
        if (g_Cursor >= 0 && g_DgBeginT) { if (!stallLogged && now - g_DgBeginT > 19200000ull * 5) { stallLogged = true; DiagWrite(2); } }
        else stallLogged = false;
    }

    static void SendOne(PaintRequest* req) {
        { /* ロード画面の間 (ゲームの毎フレームの更新が止まっている) と、ロードの直後 5 秒は塗りを送らない。塗りの管理が作り直されている途中で、ゲームが空の場所を読んで落ちていた (インクの道) */
            static u64 lf = 0, lft = 0; const u64 nw0 = NowTick(); if (g_CntFrame != lf) { lf = g_CntFrame; lft = nw0; }
            if (g_FrameFallback || !lft || nw0 - lft > 3840000ull || (g_LoadT && nw0 - g_LoadT < 5ull * 19200000ull)) return; }
        if (kBroadcast && g_OffPaintRequest == 0x371D1C0) {
            /* ゲームの Paint_Request は、通信に送る関数 (0x371F940) が false を返すと、自分の画面にも塗らずに捨てる。
               通信の状態 (相手が受け取れない・順番待ち など) で false になる時があり、絵が出たり出なかったりする原因だった。
               そこで、通信への送信は同じようにしつつ、自分の画面への塗りは結果にかかわらず必ず行う。 */
            const uintptr_t mgr = ReadPaintMgr();
            const uintptr_t st = MainBase() + 0x60F1550;
            bool stOk = true;
            if (Readable(st, 8)) { const uintptr_t gs = *reinterpret_cast<const uintptr_t*>(st); if (gs && Readable(gs + 0xd0, 4) && *reinterpret_cast<const s32*>(gs + 0xd0) == 2) stOk = false; }
            if (mgr && stOk && Readable(mgr + 0x2d8, 0x18)) {
                const uintptr_t q = *reinterpret_cast<const uintptr_t*>(mgr + 0x2d8), net = *reinterpret_cast<const uintptr_t*>(mgr + 0x2e8);
                if (q && net) {
                    using SendFn = u64 (*)(void*, void*); using ExecFn = u64 (*)(u64);
                    const u64 r = reinterpret_cast<SendFn>(MainBase() + 0x371F940)(reinterpret_cast<void*>(net), req);
                    if (r & 1u) g_DgNetTrue++; else g_DgNetFalse++;
                    reinterpret_cast<ExecFn>(MainBase() + 0x371D320)(reinterpret_cast<u64>(req));
                    return;
                }
            }
            return; /* ゲームが塗りを受け付けない状態 (マネージャなし・試合終了後など) */
        }
        if (kBroadcast) {
            /* 本物の塗りと同じ第2引数で呼ぶ。ゲームが撃ったときに通信へ送る経路と同じになる。 */
            /* 本物の撃ちと同じ第2引数 (ビット0 = 1) で呼ぶ。0 にした版 (frame5〜8) は友達に見えず、
               本物の撃ちと同じ値で呼んだ版は友達にも見えた。 */
            Orig(req, g_BaseA2 | 1ull);
        } else {
            using ExecLocalFn = u64 (*)(u64);
            reinterpret_cast<ExecLocalFn>(exl::util::modules::GetTargetOffset(g_OffPaintExecLocal))(reinterpret_cast<u64>(req));
        }
    }

    /* 塗りの待ち行列に空きがあるか。いっぱいのときに出すと、点が捨てられて絵が欠ける (出たり出なかったりの原因の一つ) */
    static bool PaintQueueRoom() {
        const uintptr_t mgr = ReadPaintMgr();
        if (!mgr || !Readable(mgr + 0x2d8, 8)) return true;
        const uintptr_t q = *reinterpret_cast<const uintptr_t*>(mgr + 0x2d8);
        if (!q || !Readable(q + 0x300, 0x20)) return true;
        const s32 used = *reinterpret_cast<const s32*>(q + 0x300), cap = *reinterpret_cast<const s32*>(q + 0x318);
        if (cap <= 0) return true;
        g_DgQUsed = static_cast<u32>(used); g_DgQCap = static_cast<u32>(cap);
        return used + 8 < cap;
    }
    static float UzuSin(float a) { const float tp = 6.2831853f; a -= tp * static_cast<float>(static_cast<int>(a / tp)); if (a > 3.1415927f) a -= tp; const float a2 = a * a; return a * (1.0f - a2 / 6.0f * (1.0f - a2 / 20.0f * (1.0f - a2 / 42.0f * (1.0f - a2 / 72.0f * (1.0f - a2 / 110.0f))))); }
    static float UzuCos(float a) { return UzuSin(a + 1.5707963f); }

    /* ---- テンプレート (絵の形): 点の位置を返す。座標は画面の見た目 (右 +x, 下 +y)。 ---- */
static constexpr const char* kTplNames[30] = { "ハート", "稲妻", "魔法陣", "蝶", "月と星", "桜", "手裏剣", "王冠", "目", "剣", "ネコ", "イヌ", "ウサギ", "サカナ", "トリ", "クマ", "ペンギン", "カメ", "ほし", "ダイヤ", "やじるし", "雪の結晶", "ドクロ", "おうち", "ロケット", "あしあと", "太陽", "花", "音符", "かさ" };
/* 自動生成: 新しいテンプレート 20 種 (動物など)。kind: p=閉じた線 o=開いた線 e=だ円。end = その線までに使う点の合計 */
struct TStroke { signed char kind; int n; int end; const float* p; };
