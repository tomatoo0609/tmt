        {
            static u64 openT = 0;
            if (g_OpenEdge) { g_OpenEdge = false; openT = nowS; }
            float po = openT ? static_cast<float>(nowS - openT) / 3840000.0f : 1.0f; /* 0.2 秒 */
            if (po > 1.0f) po = 1.0f;
            const float q = 1.0f - po; const float e = 1.0f - q * q * q;
            xo = -static_cast<int>((1.0f - e) * static_cast<float>(g_BaseW)); g_MenuOpenT = openT; mA = 8; /* 左からすっと出る (フェードはなし) */
