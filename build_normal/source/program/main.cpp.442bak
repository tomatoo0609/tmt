        std::memcpy(out, "INKEB001", 8); ol = 8; float me[3] = { 0.0f, 0.0f, 0.0f }; const u32 hm = SelfPos(me) ? 1u : 0u; std::memcpy(out + ol, &hm, 4); ol += 4; std::memcpy(out + ol, me, 12); ol += 12;
        const int cpos = ol; ol += 4; int n = 0;
