        k &= UpdSym(u.sslInit, "_ZN2nn3ssl10InitializeEv"); k &= UpdSym(u.ctxCreate, "_ZN2nn3ssl7Context6CreateENS1_10SslVersionE");
        UpdSym(u.ctxCtor, "_ZN2nn3ssl7ContextC1Ev"); UpdSym(u.ctxDestroy, "_ZN2nn3ssl7Context7DestroyEv", "nnsslContextDestroy"); UpdSym(u.conCtor, "_ZN2nn3ssl10ConnectionC1Ev");
        k &= UpdSym(u.conCreate, "_ZN2nn3ssl10Connection6CreateEPNS0_7ContextE", "nnsslConnectionCreate");
