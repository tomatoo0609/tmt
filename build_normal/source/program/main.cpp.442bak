                const bool proven = g_VF.n > 0 && g_VF.idx[0] == g_VGoodI && g_VF.typ[0] == g_VGoodK; /* 一度ちゃんと効いた場所 */
                if (proven && ady < 0.35f) { yInt += dyR * 0.3f; if (yInt > 0.06f) yInt = 0.06f; if (yInt < -0.06f) yInt = -0.06f; } else yInt = 0.0f; /* 大きく向き直っている間は足さない (足した分が残って、着いたときに行き過ぎていた) */
                const bool bigTurn = proven && ady > 0.35f; const float oLim = bigTurn ? 0.30f : 0.17f; /* 敵を倒して次の敵へ向き直るとき: 確かめ済みの場所なら 1 フレームで大きく回す (ずれが 20 度を切ったら、今までのなめらかな動きに戻る) */
                float off = dyR * (bigTurn ? 0.5f : gk) + (bigTurn ? 0.0f : ffYaw * D2R) + yInt; if (off > oLim) off = oLim; if (off < -oLim) off = -oLim; /* 大きく向き直るときも、なめらかに回る */
                { const float ao = offPrev < 0.0f ? -offPrev : offPrev; g_VecTolCos = proven ? __builtin_cosf((ao > 0.30f ? 0.30f : ao) + 0.063f) : 0.998f; } /* 確かめ中の場所は今までどおり厳しく見る */
                const float yB = yNow + off; offPrev = off;
                const float w[3] = { __builtin_sinf(yB) * cp, sp, __builtin_cosf(yB) * cp }; bool full = false; (void)hn;
                static int vStuck = 0; static float vPy = 0.0f; static u64 vBanT = 0; const bool pitExt = curPit > 1.22f || curPit < -1.22f; const bool vBan = (vBanT && now < vBanT) || pitExt; if (pitExt) { g_LookRx = 0; pCx = 0; } /* 真上・真下 (70 度より先) では左右を回さない (向きが決まらず、くるくる回っていた) */ /* 書いても左右が動かない (効かなくなった場所): しばらくスティックで回す */
                bool vWrote = false; if (!vBan && VecWrite(c, w, &full)) { vWrote = true; g_LookRx = 0; pCx = 0; if (full) { g_LookRy = 0; pCy = 0; } }
                { float dv = yNow - vPy; while (dv > 3.1415927f) dv -= 6.2831853f; while (dv < -3.1415927f) dv += 6.2831853f; const float adv = dv < 0.0f ? -dv : dv;
                  if (vWrote && ady > 0.1f && adv < 0.002f) { if (++vStuck >= 6) { vBanT = now + 2ull * 19200000ull; vStuck = 0; } } else vStuck = 0; vPy = yNow; }
            }
            if (g_LkRows < 600 && !g_LkSaved) {
                const float* E = reinterpret_cast<const float*>(g_CamPos - 0xC);
                LkPut("%d | %.2f %.2f %.2f | %.2f %.2f %.2f | %.3f %.3f %.3f | 左右 %.4f→%.4f 上下 %.4f→%.4f | ずれ %.2f %.2f | 向き %d ok%d ng%d %d:%d | ", g_LkRows, E[0], E[1], E[2], E[3], E[4], E[5], c[0], c[1], c[2], curYaw, wantYaw, curPit, wantPit, ey, ep,
                      g_VF.n, g_VF.ok, g_VF.fail, g_VF.n ? static_cast<int>(g_VF.idx[0] * 4 - kAngBack) : 0, g_VF.n ? g_VF.typ[0] : 0);
            }
        }
        { /* ジャイロ: 右スティックの上下を大きく倒しても上下が動かない (上下の端ではないのに) = ジャイロ操作。
             地点から「切替距離」以内に入ったら、本物のジャイロを止めて (手の動きは無視)、こちらでジャイロを動かして上下を合わせる。
             どの軸が上下か、どれだけ動かすと何度回るかは、動かしながら覚える (15 フレーム動かなければ次の軸へ。3 つとも駄目ならジャイロではない) */
            static bool gyro = false, haveG = false; static int stuck = 0, axStuck = 0, axTried = 0, nG = 0, prevRy = 0; float& kg = g_GyroKg; static float prevW = 0.0f, pitG = 0.0f, yawG = 0.0f;
            if (!haveP2Init) { gyro = false; stuck = 0; axStuck = 0; axTried = 0; nG = 0; kg = 6.0f; prevW = 0.0f; haveG = false; haveP2Init = true; } /* 使い始めるたびに、覚え直す */
            const bool virt = GyroRangeIn();
            g_GyroVirt = virt;
            if (haveG && dtT < 500000ull) {
                const float dp = pit - pitG;
                (void)stuck; /* ジャイロかどうかの自動判定はやめた (間違えてジャイロを動かし、カメラがあばれた)。ジャイロを動かすのは「切替距離」の中だけ */
                const float dyw = LookWrap(yaw - yawG);
                if ((gyro || virt) && (prevW > 0.05f || prevW < -0.05f)) {
                    if (false && (dyw > 0.3f || dyw < -0.3f) && __builtin_fabsf(dyw) > __builtin_fabsf(dp)) { /* 左右が回っても軸を変えない (地点を見るは左右を毎フレーム直接回すので、間違えて軸を変え、上下があばれていた) */ g_GyroAx = (g_GyroAx + 1) % 3; kg = 6.0f; nG = 0; axStuck = 0; } /* 左右が回った = 上下の軸ではない: すぐ次の軸へ */
                    else if (dp < 0.05f && dp > -0.05f) { if (++axStuck >= 15) { g_GyroAx = (g_GyroAx + 1) % 3; kg = 6.0f; nG = 0; axStuck = 0; if (++axTried >= 3 && !virt) { gyro = false; axTried = 0; stuck = 0; } } } /* 3 軸とも動かない = ジャイロではなかった: スティックに戻す */
                    else { axStuck = 0; axTried = 0; const float k = dp / prevW; if (k == k && (k > 0.2f || k < -0.2f) && k < 300.0f && k > -300.0f && (nG < 2 || k * kg > 0.0f)) { kg = nG < 2 ? k : kg * 0.6f + k * 0.4f; nG++; } /* 向きが逆の測り間違いは捨てる */ }
                }
            }
            pitG = pit; yawG = yaw; haveG = true; prevRy = g_LookRy;
            float W = 0.0f;
            if ((gyro || virt) && g_LookRy != 0) { /* 上下をまだ合わせきれていない (ベクトルで合わせていない) */
                if (gyro) { g_LookRy = 0; pCy = 0; } /* ジャイロ操作では右スティックの上下は効かない */
                if (ep > 0.03f || ep < -0.03f) { W = ep * 0.8f / (kg > 0.2f || kg < -0.2f ? kg : 6.0f); if (W > 0.5f) W = 0.5f; if (W < -0.5f) W = -0.5f; /* 1 秒に半回転まで (速すぎるとあばれる) */ }
            }
            prevW = W; if (virt) { W += GyroUserW(); if (W > 0.8f) W = 0.8f; if (W < -0.8f) W = -0.8f; } g_GyroW = W; /* 切替距離の中: 右スティックの上下も足す */
            if (g_LkRows < 600 && !g_LkSaved) LkPut("ジャイロ %d 近く%d 軸%d k%.2f w%.3f 呼%u | ", gyro ? 1 : 0, virt ? 1 : 0, static_cast<int>(g_GyroAx), kg, W, static_cast<unsigned>(g_GyroCalls));
        }
        for (int q = 6; q > 0; q--) { g_StX.h[q] = g_StX.h[q - 1]; g_StY.h[q] = g_StY.h[q - 1]; } auto eff = [](int c) { const int a = c < 0 ? -c : c; const int e = a > kStDz ? a - kStDz : 0; return c < 0 ? -e : e; }; g_StX.h[0] = eff(g_LookRx); g_StY.h[0] = eff(g_LookRy); if (g_VF.wrote) g_StDirectN = 0; else if (g_StDirectN < 99) g_StDirectN++; /* このフレームで実際に倒した量 */
        pCx = g_LookRx; pCy = g_LookRy;
        if (g_LkRows < 600 && !g_LkSaved) { LkPut("%d %d | K左右 %.2f K上下 %.2f\n", g_LookRx, g_LookRy, static_cast<double>(g_StX.K * 1e5f), static_cast<double>(g_StY.K * 1e5f)); if (++g_LkRows >= 600) LkSave(); }
    }

    /* ===== 視点探し: カメラの向きの値を、メモリから自動で探す =====
       カメラの追従先 (55.0 の目印の 0x20 前) の前後 64KB を、次の 6 段階の区切りで写しておき、比べる。
         1 止まる (0.33 秒) → 2 右スティックを右へ (0.33 秒) → 3 止まる → 4 右スティックを上へ (0.25 秒) → 5 止まる → 6 下へ戻す
       見つけるもの:
         向き   : 長さ 1 の float 3 つ。止まっている間は変わらず、右で横に回り (10 度以上)、上で上下だけ動く
         角度   : float 1 つ。止まっている間は変わらず、右で 0.17〜3.0 変わる (ラジアン)。上では変わらない
         位置   : float 3 つ。追従先から 2〜20 の距離のまま、右で 0.5 以上動く
       結果は SD の inkdraw/bin/camscan.txt に書き、いちばん良い「向き」を使う。 */
    constexpr int kScanF = 32768; /* 64KB 前後 = 128KB = float 32768 個 */
    static float g_ScS[5][kScanF]; static u8 g_ScOk[kScanF / 1024];
    static uintptr_t g_ScBase = 0;
    static void ScanSnap(int k) {
        for (int pg = 0; pg < kScanF / 1024; pg++) {
            const uintptr_t a = g_ScBase + static_cast<uintptr_t>(pg) * 4096u;
            if (!Readable(a, 4096)) { g_ScOk[pg] = 0; continue; }
            std::memcpy(&g_ScS[k][pg * 1024], reinterpret_cast<const void*>(a), 4096);
        }
    }
    static float ScYaw(const float* v) { return LookAtan2(v[2], v[0]); }
    static char g_ScTxt[4096];
    static void ScanAnalyze() {
        struct Hit { int i; float sc; float dyaw, dp; };
        Hit best[8]; int nb = 0; Hit ang[8]; int na = 0; Hit pos[8]; int np = 0;
        auto push = [](Hit* arr, int& n, const Hit& h) { if (n < 8) { arr[n++] = h; } else { int w = 0; for (int q = 1; q < 8; q++) if (arr[q].sc < arr[w].sc) w = q; if (h.sc > arr[w].sc) arr[w] = h; } };
        const float* S0 = g_ScS[0]; const float* S1 = g_ScS[1]; const float* S2 = g_ScS[2]; const float* S3 = g_ScS[3]; const float* S4 = g_ScS[4];
        const float* T = reinterpret_cast<const float*>(g_CamPos);
        float tx = 0, ty = 0, tz = 0; if (Readable(g_CamPos, 12)) { tx = T[0]; ty = T[1]; tz = T[2]; }
        for (int i = 0; i + 2 < kScanF; i++) {
            if (!g_ScOk[i / 1024] || !g_ScOk[(i + 2) / 1024]) continue;
            const float* a0 = S0 + i; const float* a1 = S1 + i; const float* a2 = S2 + i; const float* a3 = S3 + i; const float* a4 = S4 + i;
            if (!(a1[0] == a1[0] && a1[1] == a1[1] && a1[2] == a1[2] && a2[0] == a2[0] && a2[2] == a2[2] && a4[1] == a4[1])) continue;
            const bool still = __builtin_fabsf(a0[0] - a1[0]) < 1e-3f && __builtin_fabsf(a0[1] - a1[1]) < 1e-3f && __builtin_fabsf(a0[2] - a1[2]) < 1e-3f;
            /* 向き */
            auto unit = [](const float* v) { const float m = v[0] * v[0] + v[1] * v[1] + v[2] * v[2]; return m > 0.94f && m < 1.06f && (v[0] * v[0] + v[2] * v[2]) > 0.09f; };
            if (still && unit(a1) && unit(a2) && unit(a3) && unit(a4)) {
                const float dyaw = __builtin_fabsf(LookWrap(ScYaw(a2) - ScYaw(a1)));
                const float dyawP = __builtin_fabsf(LookWrap(ScYaw(a4) - ScYaw(a3)));
                const float dp = __builtin_fabsf(a4[1] - a3[1]);
                if (dyaw > 10.0f && dyawP < 4.0f) push(best, nb, Hit { i, dyaw + (dp > 0.03f ? 100.0f : 0.0f) + dp * 200.0f, dyaw, dp });
            }
            /* 角度 */
            if (__builtin_fabsf(a0[0] - a1[0]) < 1e-4f) {
                const float d1 = __builtin_fabsf(a2[0] - a1[0]), d2 = __builtin_fabsf(a4[0] - a3[0]);
                if (d1 > 0.17f && d1 < 6.0f && d2 < 0.05f && a1[0] > -7.0f && a1[0] < 7.0f) push(ang, na, Hit { i, d1, d1, d2 });
            }
            /* 位置 */
            if (still) {
                auto dist = [&](const float* v) { const float x = v[0] - tx, y = v[1] - ty, z = v[2] - tz; return __builtin_sqrtf(x * x + y * y + z * z); };
                const float r1 = dist(a1), r2 = dist(a2), mv = __builtin_sqrtf((a2[0] - a1[0]) * (a2[0] - a1[0]) + (a2[2] - a1[2]) * (a2[2] - a1[2]));
                if (r1 > 2.0f && r1 < 20.0f && __builtin_fabsf(r2 - r1) < 0.3f && mv > 0.5f) push(pos, np, Hit { i, mv, r1, mv });
            }
        }
        auto sortD = [](Hit* arr, int n) { for (int x = 0; x < n; x++) for (int y = x + 1; y < n; y++) if (arr[y].sc > arr[x].sc) { const Hit t = arr[x]; arr[x] = arr[y]; arr[y] = t; } };
        sortD(best, nb); sortD(ang, na); sortD(pos, np);
        const intptr_t off0 = static_cast<intptr_t>(g_ScBase) - static_cast<intptr_t>(g_CamPos);
        int L = 0; auto put = [&](const char* f, auto... a) { if (L < static_cast<int>(sizeof(g_ScTxt)) - 160) L += std::snprintf(g_ScTxt + L, sizeof(g_ScTxt) - L, f, a...); };
        put("inkdraw 視点探し (追従先 = 55.0 の 0x20 前。オフセットは追従先から)\n追従先 %.2f %.2f %.2f\n\n[向き: float 3 つ]\n", tx, ty, tz);
        for (int k = 0; k < nb; k++) { const intptr_t o = off0 + best[k].i * 4; const float* v = g_ScS[4] + best[k].i; put("%c0x%X  左右%.1f度 上下%.3f  今 (%.3f %.3f %.3f)\n", o < 0 ? '-' : '+', static_cast<unsigned>(o < 0 ? -o : o), best[k].dyaw, best[k].dp, v[0], v[1], v[2]); }
        put("\n[角度: float 1 つ]\n");
        for (int k = 0; k < na; k++) { const intptr_t o = off0 + ang[k].i * 4; put("%c0x%X  変化 %.3f  今 %.3f\n", o < 0 ? '-' : '+', static_cast<unsigned>(o < 0 ? -o : o), ang[k].dyaw, g_ScS[4][ang[k].i]); }
        put("\n[カメラの位置: float 3 つ]\n");
        for (int k = 0; k < np; k++) { const intptr_t o = off0 + pos[k].i * 4; const float* v = g_ScS[4] + pos[k].i; put("%c0x%X  距離 %.2f 動き %.2f  今 (%.2f %.2f %.2f)\n", o < 0 ? '-' : '+', static_cast<unsigned>(o < 0 ? -o : o), pos[k].dyaw, pos[k].dp, v[0], v[1], v[2]); }
        g_ScanN = nb;
        if (nb > 0) {
            g_ScanRel = static_cast<int>(off0 + best[0].i * 4);
            /* 前向きか後ろ向きか: 歩いて覚えた向きがあれば、それと比べる */
            const float* v = g_ScS[4] + best[0].i; int sg = 1;
            if (g_CamFOk) { const float h = __builtin_sqrtf(v[0] * v[0] + v[2] * v[2]); if (h > 0.1f && (v[0] * g_CamF[0] + v[2] * g_CamF[1]) / h < 0.0f) sg = -1; }
            g_ScanSign = sg; g_ScanFix = true; g_ScanMsg = 1;
        } else g_ScanMsg = 2;
        /* SD に書く */
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk) ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return;
        using MountFn = u32 (*)(const char*); using CreateFn = u32 (*)(const char*, s64); using OpenFn = u32 (*)(FileHandle*, const char*, int);
        using WriteFn = u32 (*)(FileHandle, s64, const void*, u64, const s32*); using FlushFn = u32 (*)(FileHandle); using CloseFn = void (*)(FileHandle); using DelFn = u32 (*)(const char*);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0) rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return;
            g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        }
        const char* name = "inkd:/inkdraw/bin/camscan.txt";
        reinterpret_cast<DelFn>(sdk + 0xA9E80)(name);
        if (reinterpret_cast<CreateFn>(sdk + kSdkCreateFile)(name, L) != 0) return;
        FileHandle fh { nullptr };
        if (reinterpret_cast<OpenFn>(sdk + kSdkOpenFile)(&fh, name, 2) != 0) return;
        const s32 opt = 0;
        reinterpret_cast<WriteFn>(sdk + kSdkWriteFile)(fh, 0, g_ScTxt, static_cast<u64>(L), &opt);
        reinterpret_cast<FlushFn>(sdk + kSdkFlushFile)(fh);
        reinterpret_cast<CloseFn>(sdk + kSdkCloseFile)(fh);
    }
    /* ---- アップデート確認: 起動したら GitHub (raw.githubusercontent.com) の version.txt を見て、新しければ「アップデートしますか?」と聞く ----
       場所は SD の inkdraw/update_url.txt に 1 行で書く (例: raw.githubusercontent.com/ユーザー名/リポジトリ名/main)。
       version.txt の 1 行: 「種類 番号 大きさ crc32(16進)」(種類は normal / dev)。ファイルは <場所>/<種類>/subsdk9。
       通信は別のスレッドで行う (ゲームを止めない)。関数の場所は名前で探し、見つからなければ何もしない。 */
    struct UpdApi {
        bool ok = false;
        u32 (*nifmInit)(); u32 (*nifmSubmit)(); bool (*nifmAvail)();
        int (*gai)(const char*, const char*, const void*, void**); void (*fai)(void*);
        int (*sock)(int, int, int); int (*conn)(int, const void*, u32); int (*cls)(int); int (*sso)(int, int, int, const void*, u32);
        bool (*sockIsInit)(); u32 (*sockInit)(void*, size_t, size_t, int); u32 (*sockFin)(); void* (*alignedAlloc)(size_t, size_t); u32 (*sslFin)();
        u32 (*sslInit)(); void (*ctxCtor)(void*); u32 (*ctxCreate)(void*, int); u32 (*ctxDestroy)(void*);
        void (*conCtor)(void*); u32 (*conCreate)(void*, void*); u32 (*conSock)(void*, int); u32 (*conHost)(void*, const char*, u32);
        u32 (*conVerify)(void*, u32); u32 (*conHand)(void*); u32 (*conRead)(void*, char*, int*, u32); u32 (*conWrite)(void*, const char*, int*, u32); u32 (*conDestroy)(void*);
        void (*sleepNs)(s64); void* (*mallocF)(size_t); void (*freeF)(void*); u32 (*renameF)(const char*, const char*);
        int (*thCreate)(void*, void (*)(void*), void*, void*, size_t, int); void (*thStart)(void*);
    };
    UpdApi g_Ua;
    /* モジュール (sdk → main) の記号表を直接読んで、名前から場所を探す。読めない所は読まない */
    static unsigned long UpdLookup(const char* name) {
        const exl::util::ModuleIndex mods[2] = { exl::util::ModuleIndex::Sdk, exl::util::ModuleIndex::Main };
        for (int mi = 0; mi < 2; mi++) {
            if (!exl::util::HasModule(mods[mi])) continue;
            const uintptr_t base = exl::util::GetModuleInfo(mods[mi]).m_Total.m_Start, end = exl::util::GetModuleInfo(mods[mi]).m_Total.m_Start + exl::util::GetModuleInfo(mods[mi]).m_Total.m_Size;
            if (!Readable(base, 8)) continue;
            const uintptr_t mod = base + *reinterpret_cast<const u32*>(base + 4);
            if (mod + 8 > end || !Readable(mod, 8) || std::memcmp(reinterpret_cast<const void*>(mod), "MOD0", 4) != 0) continue;
            const uintptr_t dyn = mod + static_cast<intptr_t>(*reinterpret_cast<const s32*>(mod + 4));
            uintptr_t hash = 0, sym = 0, str = 0; u64 strsz = 0;
            for (int k = 0; k < 512; k++) {
                const uintptr_t e = dyn + 16 * k; if (e + 16 > end || !Readable(e, 16)) break;
                const u64 tag = *reinterpret_cast<const u64*>(e), val = *reinterpret_cast<const u64*>(e + 8);
                if (tag == 0) break;
                const uintptr_t a = val < base ? base + val : val;
                if (tag == 4) hash = a; else if (tag == 6) sym = a; else if (tag == 5) str = a; else if (tag == 10) strsz = val;
            }
            if (!sym || !str || !strsz) continue;
            u64 n = 0;
            if (hash && Readable(hash, 8)) n = *reinterpret_cast<const u32*>(hash + 4);
            else if (str > sym) n = (str - sym) / 24;
            if (n > 400000) n = 400000;
            int nl = 0; while (name[nl]) nl++;
            for (u64 i = 1; i < n; i++) {
                const uintptr_t se = sym + 24 * i; if (se + 24 > end) break;
                if ((i & 255) == 1 && !Readable(se, 24 * 256 < (end - se) ? 24 * 256 : 24)) break;
                const u32 nm = *reinterpret_cast<const u32*>(se); const u16 shn = *reinterpret_cast<const u16*>(se + 6); const u64 v = *reinterpret_cast<const u64*>(se + 8);
                if (shn == 0 || v == 0 || nm + static_cast<u64>(nl) + 1 > strsz) continue;
                const char* sn = reinterpret_cast<const char*>(str + nm);
                if (std::memcmp(sn, name, static_cast<size_t>(nl) + 1) == 0) return base + v;
            }
        }
        return 0;
    }
    template <class T> static bool UpdSym(T& out, const char* a, const char* b = nullptr) {
        unsigned long p = UpdLookup(a);
        if (!p && b) p = UpdLookup(b);
        out = reinterpret_cast<T>(p); return p != 0;
    }
    static bool UpdResolve() {
        if (g_Ua.ok) return true;
        UpdApi& u = g_Ua; bool k = true;
        k &= UpdSym(u.nifmInit, "_ZN2nn4nifm10InitializeEv"); k &= UpdSym(u.nifmSubmit, "_ZN2nn4nifm27SubmitNetworkRequestAndWaitEv"); k &= UpdSym(u.nifmAvail, "_ZN2nn4nifm18IsNetworkAvailableEv");
