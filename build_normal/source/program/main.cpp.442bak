    /* 32x32 の白黒マスクを size 角に縮めて重ねる (なめらか) */
    void SwIcon(Cv& v, int cx, int cy, int sz, int k, Col c, float am) {
        const unsigned char* m = kIconA[k % 6];
        const int x0 = cx - sz / 2, y0 = cy - sz / 2;
        for (int yy = 0; yy < sz; yy++) for (int xx = 0; xx < sz; xx++) {
            const float sx = (xx + 0.5f) * 32.0f / sz - 0.5f, sy = (yy + 0.5f) * 32.0f / sz - 0.5f;
            int ix = static_cast<int>(sx < 0 ? 0 : sx), iy = static_cast<int>(sy < 0 ? 0 : sy); if (ix > 30) ix = 30; if (iy > 30) iy = 30;
            float fx = sx - ix, fy = sy - iy; if (fx < 0) fx = 0; if (fx > 1) fx = 1; if (fy < 0) fy = 0; if (fy > 1) fy = 1;
            const float a = (m[iy * 32 + ix] * (1 - fx) * (1 - fy) + m[iy * 32 + ix + 1] * fx * (1 - fy) + m[(iy + 1) * 32 + ix] * (1 - fx) * fy + m[(iy + 1) * 32 + ix + 1] * fx * fy) / 255.0f * am;
            if (a > 0.01f) Blend(v, x0 + xx, y0 + yy, c, a);
        }
    }
    /* 線で描くアイコン: 0 = 照準 (ガチチート)、1 = ダウンロード (アップデートを確認)、2 = 虫めがね (サーチ) */
    void SwIconShape(Cv& v, int cx, int cy, int sz, int kind, Col c) {
        const float h = static_cast<float>(sz) * 0.5f; const int x0 = cx - sz / 2, y0 = cy - sz / 2;
        auto cl = [](float a) { return a < 0.0f ? 0.0f : (a > 1.0f ? 1.0f : a); };
        for (int yy = 0; yy < sz; yy++) for (int xx = 0; xx < sz; xx++) {
            const float px = static_cast<float>(xx) + 0.5f - h, py = static_cast<float>(yy) + 0.5f - h, ax = px < 0 ? -px : px, ay = py < 0 ? -py : py; float a = 0.0f;
            if (kind == 0) { const float r = __builtin_sqrtf(px * px + py * py);
                a = cl(1.6f - (r - h * 0.62f < 0 ? h * 0.62f - r : r - h * 0.62f));
                if ((ax < 0.9f && ay > h * 0.30f && ay < h * 0.98f) || (ay < 0.9f && ax > h * 0.30f && ax < h * 0.98f)) a = 1.0f;
                if (r < 1.6f) a = 1.0f; }
            else if (kind == 2) { const float qx = px + h * 0.18f, qy = py + h * 0.18f, r = __builtin_sqrtf(qx * qx + qy * qy); a = cl(1.6f - (r - h * 0.5f < 0 ? h * 0.5f - r : r - h * 0.5f)); /* 輪 */
                const float t = (px + py) * 0.70710678f, d = (px - py) * 0.70710678f; if (t > h * 0.38f && t < h * 1.15f) { const float b = cl(1.9f - (d < 0 ? -d : d)); if (b > a) a = b; } } /* 持ち手 (右下へ) */
            else if (kind == 3) { /* やり直しの矢印: 輪 (右上が欠けている) と、欠けた所の三角 */
                const float R = h * 0.6f, r = __builtin_sqrtf(px * px + py * py), th = LookAtan2(py, px);
                a = cl(1.6f - (r - R < 0 ? R - r : r - R)); if (th > -80.0f && th < -20.0f) a = 0.0f;
                const float Px = R * 0.17365f, Py = -R * 0.98481f, tx1 = Px + 0.98481f * h * 0.5f, ty1 = Py + 0.17365f * h * 0.5f, ux = Px + 0.17365f * h * 0.34f, uy = Py - 0.98481f * h * 0.34f, wx = Px - 0.17365f * h * 0.34f, wy = Py + 0.98481f * h * 0.34f;
                const float d1 = (px - ux) * (ty1 - uy) - (tx1 - ux) * (py - uy), d2 = (px - wx) * (uy - wy) - (ux - wx) * (py - wy), d3 = (px - tx1) * (wy - ty1) - (wx - tx1) * (py - ty1);
                if (!((d1 < 0 || d2 < 0 || d3 < 0) && (d1 > 0 || d2 > 0 || d3 > 0))) a = 1.0f; }
            else { if (ax < 1.1f && py > -h * 0.9f && py < h * 0.1f) a = 1.0f;
                if (py >= -h * 0.12f && py <= h * 0.42f) { const float t = cl(h * 0.42f - py - ax + 0.5f); if (t > a) a = t; }
                if ((py > h * 0.62f && py < h * 0.62f + 2.0f && ax < h * 0.9f) || (ax > h * 0.9f - 2.0f && ax < h * 0.9f && py > h * 0.28f && py < h * 0.62f + 2.0f)) a = 1.0f; }
            if (a > 0.01f) Blend(v, x0 + xx, y0 + yy, c, a);
        }
    }
    /* 色相 h (0..1) の明るい色 */
    Col HueCol(float h, float s, float val) {
        h -= static_cast<float>(static_cast<int>(h)); const float h6 = h * 6.0f; const int i = static_cast<int>(h6); const float f = h6 - i;
        const float p = val * (1 - s), q = val * (1 - s * f), t = val * (1 - s * (1 - f));
        switch (i % 6) { case 0: return Col { val, t, p }; case 1: return Col { q, val, p }; case 2: return Col { p, val, t }; case 3: return Col { p, q, val }; case 4: return Col { t, p, val }; default: return Col { val, p, q }; }
    }
    /* 文字の画像を 1.5 倍に拡大して重ねる (双一次) */
    void SwStrBig(Cv& v, const menu_text::Str& st, int x, int y, float sc, Col fg, float am) {
        static float buf[40 * 132]; const int W = st.w < 128 ? st.w : 128, H = st.h < 36 ? st.h : 36;
        for (int i = 0; i < 40 * 132; i++) buf[i] = 0.0f;
        for (int i = 0; i < st.n; i++) { const uint16_t* q = st.runs + i * 4; for (int k = 0; k < q[2]; k++) { const int px = q[1] + k, py = q[0]; if (px < W && py < H) buf[(py + 1) * 132 + px + 1] = q[3] / 3.0f; } }
        const int dw = static_cast<int>(W * sc) + 1, dh = static_cast<int>(H * sc) + 1;
        for (int yy = 0; yy < dh; yy++) for (int xx = 0; xx < dw; xx++) {
            const float sx = (xx + 0.5f) / sc - 0.5f, sy = (yy + 0.5f) / sc - 0.5f; const int ix = static_cast<int>(sx + 1.0f) - 1, iy = static_cast<int>(sy + 1.0f) - 1;
            const float fx = sx - ix, fy = sy - iy; if (ix < -1 || iy < -1 || ix >= W || iy >= H) continue;
            const float* b0 = buf + (iy + 1) * 132 + ix + 1;
            const float a = (b0[0] * (1 - fx) * (1 - fy) + b0[1] * fx * (1 - fy) + b0[132] * (1 - fx) * fy + b0[133] * fx * fy) * am;
            if (a > 0.02f) Blend(v, x + xx, y + yy, fg, a > 1.0f ? 1.0f : a);
        }
    }
    /* 最上位の項目の左に出す小さなアイコン (14x14) */
    void SwCatIcon(Cv& v, int x, int cy, int k) {
        static const Col kC[11] = { {1.0f,0.55f,0.35f}, {0.45f,0.85f,1.0f}, {1.0f,0.85f,0.35f}, {0.75f,0.6f,1.0f}, {1.0f,0.5f,0.75f}, {0.6f,1.0f,0.4f}, {1.0f,0.4f,0.4f}, {0.4f,1.0f,0.8f}, {0.5f,0.7f,1.0f}, {1.0f,0.75f,0.3f}, {0.8f,0.8f,0.8f} };
        const Col c = kC[(k < 0 ? 0 : k) % 11]; const int y = cy - 7;
        switch (k % 11) {
        case 0: SwRRect(v, x, y + 1, 14, 12, 3.0f, c); SwRect(v, x + 4, y + 5, 6, 4, Col { 0.08f, 0.13f, 0.18f }); break; /* 四角: 設定 */
        case 1: SwRect(v, x + 1, y + 8, 3, 5, c); SwRect(v, x + 5, y + 4, 3, 9, c); SwRect(v, x + 9, y + 1, 3, 12, c); break; /* ぼう */
        case 2: SwRRect(v, x + 1, y + 1, 12, 12, 6.0f, c); SwRRect(v, x + 4, y + 4, 6, 6, 3.0f, Col { 0.08f, 0.13f, 0.18f }); break; /* わ */
        case 3: for (int t = 0; t < 7; t++) { SwRect(v, x + 6 - t, y + 1 + t, 2 * t + 2, 1, c); } SwRect(v, x + 5, y + 8, 4, 5, c); break; /* やじるし */
        case 4: SwRRect(v, x, y + 3, 14, 8, 4.0f, c); SwRect(v, x + 6, y, 2, 14, c); break; /* ひらたい十 */
        case 5: SwRect(v, x + 6, y, 2, 14, c); SwRect(v, x, y + 6, 14, 2, c); SwRRect(v, x + 4, y + 4, 6, 6, 3.0f, c); break; /* 十 */
        case 6: for (int t = 0; t < 7; t++) { SwRect(v, x + t, y + t, 2, 2, c); SwRect(v, x + 12 - t, y + t, 2, 2, c); } SwRect(v, x + 6, y + 7, 2, 6, c); break; /* ハート風 */
        case 7: SwRRect(v, x + 1, y + 2, 12, 10, 2.0f, c); SwRect(v, x + 3, y + 4, 8, 1, Col { 0.08f, 0.13f, 0.18f }); SwRect(v, x + 3, y + 7, 5, 1, Col { 0.08f, 0.13f, 0.18f }); break; /* 表示 */
        case 8: SwRect(v, x + 1, y + 7, 12, 2, c); SwRect(v, x + 6, y + 2, 2, 10, c); SwRRect(v, x + 5, y + 1, 4, 4, 2.0f, c); break; /* 移動 */
        case 9: SwRRect(v, x + 2, y + 1, 10, 7, 3.5f, c); SwRect(v, x + 6, y + 8, 2, 4, c); SwRect(v, x + 3, y + 12, 8, 2, c); break; /* エモート: ふきだし */
        default: SwRect(v, x + 1, y + 2, 12, 2, c); SwRect(v, x + 1, y + 6, 8, 2, c); SwRect(v, x + 1, y + 10, 10, 2, c); break; /* 数値 */
        }
    }
    u64 g_MenuOpenT = 0; /* メニューを開いた時刻 (フェードに使う) */
    u64 g_FuncOnT = 0, g_FuncOffT = 0;
    bool FuncVis() { /* ステータス: 消えるときも 0.2 秒だけ出しておく (フェードアウト) */
        static bool prev = false; const u64 n = NowTick();
        if (g_FuncOn && !prev) g_FuncOnT = n; if (!g_FuncOn && prev) g_FuncOffT = n; prev = g_FuncOn;
        return g_FuncOn || (g_FuncOffT && n - g_FuncOffT < 3840000ull);
    }
    float FuncFade() { const u64 n = NowTick(); return g_FuncOn ? (g_FuncOnT ? static_cast<float>(n - g_FuncOnT) / 3840000.0f : 1.0f) : 1.0f - static_cast<float>(n - g_FuncOffT) / 3840000.0f; }
    bool MenuClosing() { return g_CloseT != 0 && NowTick() - g_CloseT < 3840000ull; }
    bool MenuVis() {
        static bool prev = false;
        if (g_MenuOpen) g_CloseT = 0;
        else if (prev) g_CloseT = NowTick();
        prev = g_MenuOpen;
        return g_MenuOpen || MenuClosing();
    }
    /* 起動の表示 "INKDRAW": 暗いパネルがすっと開き、文字が順に光って現れ、光の帯が走り、5 秒で閉じる */
    static void SplashLetter(Cv& v, char ch, int x, int y, int w, int h, int s, Col c) {
        auto R = [&](int rx, int ry, int rw, int rh) { SwRect(v, x + rx, y + ry, rw, rh, c); };
        switch (ch) {
        case 'M': R(0, 0, s, h); R(w - s, 0, s, h); for (int k = 0; k < h / 2; k++) { const int dx = (w / 2 - s) * k / (h / 2); R(s + dx, k, s, 1); R(w - 2 * s - dx, k, s, 1); } break;
        case 'C': R(0, 0, w, s); R(0, 0, s, h); R(0, h - s, w, s); R(w - s, 0, s, s * 2 / 3); R(w - s, h - s * 2 / 3, s, s * 2 / 3); break;
        case 'a': R(0, 0, w, s); R(w - s, 0, s, h); R(0, h / 2 - s / 2, w, s); R(0, h - s, w, s); R(0, h / 2, s, h / 2); break;
        case 'n': R(0, 0, s, h); R(0, 0, w, s); R(w - s, 0, s, h); break;
        case 'o': R(0, 0, w, s); R(0, h - s, w, s); R(0, 0, s, h); R(w - s, 0, s, h); break;
        case 'l': R(0, 0, s, h); break;
        default: R(0, 0, s, h); R(w - s, 0, s, h); R(0, h - s, w, s); break; /* u */
        }
    }
    static void SplashSparkle(Cv& v, int x, int y, int r, Col c) {
        SwRect(v, x - r, y, 2 * r + 1, 1, c); SwRect(v, x, y - r, 1, 2 * r + 1, c);
        if (r >= 4) { const Col d { c.r * 0.6f, c.g * 0.6f, c.b * 0.6f }; SwRect(v, x - r / 2, y - 1, r + 1, 3, d); SwRect(v, x - 1, y - r / 2, 3, r + 1, d); }
        SwRect(v, x - 1, y - 1, 3, 3, Col { 1.0f, 1.0f, 1.0f });
    }
    /* 起動の表示 "Inkdraw" (10 秒): オーロラの夜空に、ガラスのふちの文字が一筆書きのように現れ、最後は光の粒になって昇って消える */
    static u32 g_SplScr[100 * 130];
    static void SplashRRectLine(Cv& v, int x, int y, int w, int h, int r, int th, Col c) {
        SwRect(v, x + r, y, w - 2 * r, th, c); SwRect(v, x + r, y + h - th, w - 2 * r, th, c); SwRect(v, x, y + r, th, h - 2 * r, c); SwRect(v, x + w - th, y + r, th, h - 2 * r, c);
        for (int k = 0; k <= 24; k++) {
            const float an = static_cast<float>(k) * (1.5707963f / 24.0f), ca = __builtin_cosf(an), sa = __builtin_sinf(an);
            const int dx = static_cast<int>(ca * static_cast<float>(r)), dy = static_cast<int>(sa * static_cast<float>(r));
            SwRect(v, x + r - dx, y + r - dy, th, th, c); SwRect(v, x + w - r + dx - th, y + r - dy, th, th, c);
            SwRect(v, x + r - dx, y + h - r + dy - th, th, th, c); SwRect(v, x + w - r + dx - th, y + h - r + dy - th, th, th, c);
        }
    }
    /* 起動画面の文字: 5x7 の点の字を sc 倍で描く (使える字は kCh の中だけ。空白は飛ばす) */
    static void SplTxt(Cv& v, int x, int y, const char* s, int n, int sc, Col c, float a) {
        static const char kCh[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.:>/%-+";
        static const u8 kGl[43][7] = {
            {0x0E,0x11,0x11,0x1F,0x11,0x11,0x11}, {0x1E,0x11,0x11,0x1E,0x11,0x11,0x1E}, {0x0E,0x11,0x10,0x10,0x10,0x11,0x0E}, {0x1E,0x11,0x11,0x11,0x11,0x11,0x1E},
            {0x1F,0x10,0x10,0x1E,0x10,0x10,0x1F}, {0x1F,0x10,0x10,0x1E,0x10,0x10,0x10}, {0x0E,0x11,0x10,0x17,0x11,0x11,0x0F}, {0x11,0x11,0x11,0x1F,0x11,0x11,0x11},
            {0x0E,0x04,0x04,0x04,0x04,0x04,0x0E}, {0x07,0x02,0x02,0x02,0x02,0x12,0x0C}, {0x11,0x12,0x14,0x18,0x14,0x12,0x11}, {0x10,0x10,0x10,0x10,0x10,0x10,0x1F},
            {0x11,0x1B,0x15,0x15,0x11,0x11,0x11}, {0x11,0x11,0x19,0x15,0x13,0x11,0x11}, {0x0E,0x11,0x11,0x11,0x11,0x11,0x0E}, {0x1E,0x11,0x11,0x1E,0x10,0x10,0x10},
            {0x0E,0x11,0x11,0x11,0x15,0x12,0x0D}, {0x1E,0x11,0x11,0x1E,0x14,0x12,0x11}, {0x0F,0x10,0x10,0x0E,0x01,0x01,0x1E}, {0x1F,0x04,0x04,0x04,0x04,0x04,0x04},
            {0x11,0x11,0x11,0x11,0x11,0x11,0x0E}, {0x11,0x11,0x11,0x11,0x11,0x0A,0x04}, {0x11,0x11,0x11,0x15,0x15,0x15,0x0A}, {0x11,0x11,0x0A,0x04,0x0A,0x11,0x11},
            {0x11,0x11,0x0A,0x04,0x04,0x04,0x04}, {0x1F,0x01,0x02,0x04,0x08,0x10,0x1F},
            {0x0E,0x11,0x13,0x15,0x19,0x11,0x0E}, {0x04,0x0C,0x04,0x04,0x04,0x04,0x0E}, {0x0E,0x11,0x01,0x02,0x04,0x08,0x1F}, {0x1F,0x02,0x04,0x02,0x01,0x11,0x0E},
            {0x02,0x06,0x0A,0x12,0x1F,0x02,0x02}, {0x1F,0x10,0x1E,0x01,0x01,0x11,0x0E}, {0x06,0x08,0x10,0x1E,0x11,0x11,0x0E}, {0x1F,0x01,0x02,0x04,0x08,0x08,0x08},
            {0x0E,0x11,0x11,0x0E,0x11,0x11,0x0E}, {0x0E,0x11,0x11,0x0F,0x01,0x02,0x0C},
            {0x00,0x00,0x00,0x00,0x00,0x0C,0x0C}, {0x00,0x0C,0x0C,0x00,0x0C,0x0C,0x00}, {0x08,0x04,0x02,0x01,0x02,0x04,0x08}, {0x01,0x01,0x02,0x04,0x08,0x10,0x10},
            {0x18,0x19,0x02,0x04,0x08,0x13,0x03}, {0x00,0x00,0x00,0x1F,0x00,0x00,0x00}, {0x00,0x04,0x04,0x1F,0x04,0x04,0x00},
        };
        if (a <= 0.0f) return;
        for (int i = 0; s[i] && i < n; i++, x += 6 * sc) {
            int gi = -1; for (int k = 0; kCh[k]; k++) if (kCh[k] == s[i]) { gi = k; break; }
            if (gi < 0) continue;
            for (int r = 0; r < 7; r++) for (int k = 0; k < 5; k++) if ((kGl[gi][r] >> (4 - k)) & 1)
                for (int dy = 0; dy < sc; dy++) for (int dx = 0; dx < sc; dx++) Blend(v, x + k * sc + dx, y + r * sc + dy, c, a);
        }
    }
    /* なめらかな文字: 太さのある曲線 (丸い端) を距離から塗り、ふちをなめらかにする。形は最初に 1 回だけ作って覚える。
       書き順 (線の上の位置) も覚えておき、文字を「だんだん書かれていく」ように見せる。 */
    static constexpr int kSplM = 18; /* 光のにじみ用の余白 */
    static unsigned char g_SplCov[7][132 * 150], g_SplGlow[7][132 * 150], g_SplPar[7][132 * 150];
    struct SplSg { float x0, y0, x1, y1, cum, len; };
    static SplSg g_SplSg[7][64]; static int g_SplSgN[7]; static float g_SplTot[7];
    static int g_SplPW[7], g_SplPH[7]; static bool g_SplBuilt = false;
    static u32 g_SplBase[900 * 430]; static int g_SplBW = 0, g_SplBH = 0;
    static int g_SplX = 0, g_SplY = 0, g_SplW = 0, g_SplH = 0, g_SplR = 0; static size_t g_SplOff = 0; static bool g_SplOn = false;
    static void SplashBuild() {
        if (g_SplBuilt) return; g_SplBuilt = true;
        static const int kW[7] = { 92, 66, 66, 78, 76, 15, 66 }, kH[7] = { 112, 76, 76, 112, 76, 112, 76 };
        const float hw = 7.0f;
        for (int i = 0; i < 7; i++) {
            const int w = kW[i], h = kH[i]; g_SplPW[i] = w + 2 * kSplM; g_SplPH[i] = h + 2 * kSplM;
            int n = 0; SplSg* sg = g_SplSg[i];
            auto X = [&](float u) { return static_cast<float>(kSplM) + hw + u * (static_cast<float>(w) - 2.0f * hw); };
            auto Y = [&](float u) { return static_cast<float>(kSplM) + hw + u * (static_cast<float>(h) - 2.0f * hw); };
            auto line = [&](float x0, float y0, float x1, float y1) { if (n < 64) sg[n++] = SplSg { X(x0), Y(y0), X(x1), Y(y1), 0.0f, 0.0f }; };
            auto arc = [&](float cx, float cy, float rx, float ry, float a0, float a1, int k) {
                float px = cx + rx * __builtin_cosf(a0), py = cy + ry * __builtin_sinf(a0);
                for (int j = 1; j <= k; j++) { const float an = a0 + (a1 - a0) * static_cast<float>(j) / static_cast<float>(k); const float qx = cx + rx * __builtin_cosf(an), qy = cy + ry * __builtin_sinf(an); line(px, py, qx, qy); px = qx; py = qy; }
            };
            const float PI = 3.1415927f;
            switch (i) {
            case 0: line(0, 1, 0, 0.04f); line(0, 0.04f, 0.5f, 0.74f); line(0.5f, 0.74f, 1, 0.04f); line(1, 0.04f, 1, 1); break;
            case 1: arc(0.5f, 0.5f, 0.5f, 0.5f, -0.4f, 2 * PI - 0.4f, 36); line(1, 0, 1, 1); break;
            case 2: line(0, 0, 0, 1); line(0, 0.5f, 0, 0.5f); arc(0.5f, 0.5f, 0.5f, 0.5f, PI, 2 * PI, 20); line(1, 0.5f, 1, 1); break;
            case 3: arc(0.54f, 0.5f, 0.56f, 0.5f, -0.75f, -(2 * PI - 0.75f), 44); break; /* 右上から反時計回りに書く */
            case 4: arc(0.5f, 0.5f, 0.5f, 0.5f, -PI / 2, 3 * PI / 2, 40); break;
            case 5: line(0.5f, 0, 0.5f, 1); break;
            default: line(0, 0, 0, 0.5f); arc(0.5f, 0.5f, 0.5f, 0.5f, PI, 0, 20); line(1, 0, 1, 1); break;
            }
            g_SplSgN[i] = n; float cum = 0.0f;
            for (int k = 0; k < n; k++) { const float ex = sg[k].x1 - sg[k].x0, ey = sg[k].y1 - sg[k].y0; sg[k].len = __builtin_sqrtf(ex * ex + ey * ey); sg[k].cum = cum; cum += sg[k].len; }
            g_SplTot[i] = cum > 1.0f ? cum : 1.0f;
            const int PW = g_SplPW[i], PH = g_SplPH[i];
            for (int y = 0; y < PH; y++) for (int x = 0; x < PW; x++) {
                const float px = static_cast<float>(x) + 0.5f, py = static_cast<float>(y) + 0.5f; float best = 1e9f, bpar = 0.0f;
                for (int k = 0; k < n; k++) {
                    const float ex = sg[k].x1 - sg[k].x0, ey = sg[k].y1 - sg[k].y0, wx = px - sg[k].x0, wy = py - sg[k].y0;
                    const float l2 = ex * ex + ey * ey; float t = l2 > 0.0f ? (wx * ex + wy * ey) / l2 : 0.0f; if (t < 0.0f) t = 0.0f; if (t > 1.0f) t = 1.0f;
                    const float dx = wx - ex * t, dy = wy - ey * t, d2 = dx * dx + dy * dy; if (d2 < best) { best = d2; bpar = (sg[k].cum + t * sg[k].len) / g_SplTot[i]; }
                }
                float c = hw + 0.5f - __builtin_sqrtf(best); if (c < 0.0f) c = 0.0f; if (c > 1.0f) c = 1.0f;
                g_SplCov[i][y * PW + x] = static_cast<unsigned char>(c * 255.0f);
                g_SplPar[i][y * PW + x] = static_cast<unsigned char>(bpar * 254.0f);
            }
            { /* ぼかして光のにじみにする (横→縦、2 回) */
                static int tmp[132 * 150], tmp2[132 * 150];
                for (int k = 0; k < PW * PH; k++) tmp[k] = g_SplCov[i][k];
                for (int pass = 0; pass < 2; pass++) {
                    const int R = 5;
                    for (int y = 0; y < PH; y++) for (int x = 0; x < PW; x++) { int sum = 0; for (int dx = -R; dx <= R; dx++) { const int xx = x + dx; if (xx >= 0 && xx < PW) sum += tmp[y * PW + xx]; } tmp2[y * PW + x] = sum / (2 * R + 1); }
                    for (int y = 0; y < PH; y++) for (int x = 0; x < PW; x++) { int sum = 0; for (int dy = -R; dy <= R; dy++) { const int yy = y + dy; if (yy >= 0 && yy < PH) sum += tmp2[yy * PW + x]; } tmp[y * PW + x] = sum / (2 * R + 1); }
                }
                for (int k = 0; k < PW * PH; k++) { int g = tmp[k] * 2; if (g > 255) g = 255; g_SplGlow[i][k] = static_cast<unsigned char>(g); }
            }
        }
    }
    /* 起動の表示を、専用の絵 (g_SplBase) に描く。メニューとは別の絵なので、メニューを開いても消えない。 */
    static void SplashDraw() { /* 起動の表示 (モダン): 暗いグラデーションの板、左寄せの大きな Inkdraw、グラデーションの短い線、説明、作った人、右下にバージョンの札。
                                    アップデートがあるときは、板が下にのびて「アップデートがあります」と はい / いいえ が出る (のびた分は自動でまん中に寄る) */
        SplashBuild();
        static u64 extT = 0; const int us = g_UpdState; const bool upd = (us == 2 || (g_SplUpd && us >= 1 && us <= 8) || (g_SplUpd && g_UpdManual)) && !g_SplashLeaveT; const u64 nw = NowTick();
        if (upd && !extT) extT = nw; if (!upd) extT = 0;
        static int su = 0; if (upd) su = (us == 0 && g_UpdManual) ? 1 : us; /* 消えていく間は、最後に出していた中身のまま */
        float ex = 0.0f; if (g_SplMan) ex = 1.0f; else if (extT) { float q = static_cast<float>(nw - extT) / 7680000.0f; if (q > 1.0f) q = 1.0f; ex = 1.0f - (1.0f - q) * (1.0f - q) * (1.0f - q); } /* 0.4 秒でのびる */
        const int BW = 820, BH0 = 200, EH = static_cast<int>(100.0f * ex), BH = BH0 + EH;
        g_SplBW = BW; g_SplBH = BH; g_SplR = 28;
        Cv v { g_SplBase, BW, BH, 0, 0 };
        for (int k = 0; k < BW * BH; k++) g_SplBase[k] = 0;
        const Col edge { 0.040f, 0.043f, 0.052f }, white { 0.97f, 0.97f, 0.98f }, dimc { 0.55f, 0.57f, 0.62f }; /* ふちは出さない (板と同じ色) */
        SwRRect(v, 0, 0, BW, BH, 28.0f, edge);
        for (int y = 2; y < BH - 2; y++) { /* 上から下へ、ほんの少し明るくなる */
            const float k = static_cast<float>(y) / static_cast<float>(BH);
            const Col cc { 0.040f + 0.025f * k, 0.043f + 0.027f * k, 0.052f + 0.032f * k };
            const float yc = static_cast<float>(y) + 0.5f, r2 = 26.0f; float dy = 0.0f; if (yc < 2.0f + r2) dy = 2.0f + r2 - yc; else if (yc > static_cast<float>(BH) - 2.0f - r2) dy = yc - (static_cast<float>(BH) - 2.0f - r2);
            if (dy >= r2) continue; const int in = static_cast<int>(2.0f + r2 - __builtin_sqrtf(r2 * r2 - dy * dy) + 0.999f); /* 中の板: 2 画素内側、半径 26 (角でもふちが 2 画素残る) */
            SwRect(v, in, y, BW - 2 * in, 1, cc);
        }
        for (int y = 2; y < BH0 - 2; y++) for (int x = BW / 2; x < BW - 30; x++) { const float d = static_cast<float>(x - BW + 120 + y) / 260.0f; if (d < 0.0f || d > 1.0f) continue; const float a = (1.0f - d) * d * 0.10f; Blend(v, x, y, Col { 0.55f, 0.45f, 1.0f }, a); }
        /* ロゴ「Inkdraw」+ すぐ右にバージョン (枠なし)。読み込みのバーは板の下の方に置き、アップデートの文字が出るときは、その区切りの線になる */
        const menu_text::Str& T = menu_text::kTITLEBIG;
        const int tx = 64, ly = BH0 - 32, ty = (ly - T.h) / 2; /* ロゴの上の余白と、ロゴからバーまでの余白を同じに */
        SwStr(v, T, tx, ty, white);
        { char vt[48]; std::snprintf(vt, sizeof(vt), "%s%s   ビルド %d", kInkVerName, kInkKind[0] == 'd' ? " dev" : "", kInkVer);
          SwHD(v, vt, tx + T.w + 14, ty + T.h - 18, 1, dimc); } /* 文字の下の線 (ベースライン) をロゴにそろえる */
        { /* 読み込みのバー: 少しずつのびて、確認が終わったら最後まで行く。ダウンロード中は進み具合 */
            static float shown = 0.0f; const u64 el = nw - g_SplashT0; float pre = static_cast<float>(el) / (3.0f * 19200000.0f); if (pre > 1.0f) pre = 1.0f; pre = 0.85f * (1.0f - (1.0f - pre) * (1.0f - pre));
            const bool dl = upd && su == 3;
            const bool dn = !dl && (g_SplDoneT || g_SplashLeaveT || (g_SplUpd && su != 1) || us == 2); const float tg = dl ? (g_UpdTot ? static_cast<float>(g_UpdGot > g_UpdTot ? g_UpdTot : g_UpdGot) / static_cast<float>(g_UpdTot) : 0.0f) : (dn ? 1.0f : pre);
            if (dl) shown = tg; else { shown += (tg - shown) * (dn ? 0.30f : 0.5f); if (dn && shown > 0.995f) shown = 1.0f; if (shown > tg && !dn) shown = tg; }
            const int bx = tx + 2, bw = BW - 64 - bx, len = static_cast<int>(static_cast<float>(bw) * shown + 0.5f);
            SwRRect(v, bx, ly, bw, 4, 2.0f, Col { 0.16f, 0.17f, 0.20f });
            for (int x = 0; x < len; x++) { const float k = static_cast<float>(x) / static_cast<float>(bw > 1 ? bw - 1 : 1); SwRect(v, bx + x, ly, 1, 4, Col { 0.62f - 0.42f * k, 0.40f + 0.48f * k, 1.0f }); }
        }
        if (EH > 6) { /* のびた所: アップデートの流れ。左に見出し (28px)、右に操作 (A / B) やエラーの番号 (20px)。説明が要るときだけ見出しの下に 1 行 */
            const int y0 = ly + 4, EA = BH - 8 - y0; /* 区切りの線は出さない (読み込みのバーがその代わり)。文字は、バーの下から板の下までのまん中に */
            if (EH > 40) {
                const Col okc { 0.55f, 0.92f, 0.62f }, ngc { 1.0f, 0.62f, 0.50f }, bgc { 0.060f, 0.064f, 0.079f };
                auto drawSt = [&](int st, float al, int oy) { /* st の中身を、濃さ al (0〜1、板の色へ混ぜる)、上下に oy ずらして描く */
                    auto mixc = [&](Col c) { return Col { bgc.r + (c.r - bgc.r) * al, bgc.g + (c.g - bgc.g) * al, bgc.b + (c.b - bgc.b) * al }; };
                    const char* h1 = "アップデートがあります"; Col hc = white; char ln[96]; ln[0] = 0; char rt[48]; rt[0] = 0; bool ask = false;
                    if (st == 2) { std::snprintf(ln, sizeof(ln), "ビルド %d  →  %d", kInkVer, static_cast<int>(g_UpdNew)); ask = true; }
                    else if (st == 1) { h1 = "アップデートを確認しています"; }
                    else if (st == 6) { h1 = g_UpdMsg == 9 ? "開発版は更新なし" : "最新です"; hc = okc; }
                    else if (st == 3) { h1 = "ダウンロードしています"; std::snprintf(rt, sizeof(rt), "%u / %u KB", static_cast<unsigned>(g_UpdGot / 1024), static_cast<unsigned>(g_UpdTot / 1024)); }
                    else if (st == 7) { h1 = "アップデート完了"; hc = okc; std::snprintf(ln, sizeof(ln), "今すぐ再起動しますか?"); ask = true; }
                    else if (st == 4 || st == 8) { h1 = "アップデート完了"; hc = okc; }
                    else { h1 = "アップデート失敗"; hc = ngc; static const char* const kWhy[7] = { "確認できない", "SDが使えない", "update_url.txtが無い", "インターネットの接続がありません", "確認できない", "ダウンロード失敗", "通信機能が無い" };
                           if (g_UpdErr) std::snprintf(rt, sizeof(rt), "エラー %d", static_cast<int>(g_UpdErr)); else std::snprintf(rt, sizeof(rt), "%s", kWhy[g_UpdMsg >= 0 && g_UpdMsg < 7 ? g_UpdMsg : 0]); } /* 右: エラーの番号 (番号がないときは理由) */
                    const int hh = HdLineH(0), sh = HdLineH(1), cy = y0 + EA / 2 + oy;
                    const int hy = ln[0] ? cy - (hh + 4 + sh) / 2 : cy - hh / 2;
                    SwHD(v, h1, 64, hy, 0, mixc(hc));
                    if (ln[0]) SwHD(v, ln, 64, hy + hh + 4, 1, mixc(dimc));
                    if (rt[0]) SwHD(v, rt, BW - 64 - HdW(rt, 1), cy - sh / 2, 1, mixc(dimc)); /* 右: エラーの番号 / ダウンロードの量 */
                    if (ask && EH > 80) { /* 右: A はい  B いいえ (ボタンの丸 + 文字) */
                        auto key = [&](int x, const char* k, const char* t, Col tc) -> int { const int r = 13, cx = x + r; SwRRect(v, x, cy - r, 2 * r, 2 * r, static_cast<float>(r), mixc(Col { 0.86f, 0.87f, 0.90f }));
                            SwHD(v, k, cx - HdW(k, 1) / 2, cy - sh / 2, 1, mixc(Col { 0.06f, 0.065f, 0.08f })); SwHD(v, t, x + 2 * r + 8, cy - sh / 2, 1, mixc(tc)); return 2 * r + 8 + HdW(t, 1); };
                        const int wA = 26 + 8 + HdW("はい", 1), wB = 26 + 8 + HdW("いいえ", 1), gapK = 22;
                        int x = BW - 64 - (wA + gapK + wB); x += key(x, "A", "はい", white) + gapK; key(x, "B", "いいえ", dimc);
                    }
                };
                static int curSt = -1, oldSt = -1; static u64 swT = 0; /* 中身が切りかわった時刻 */
                if (su != curSt) { oldSt = curSt; curSt = su; swT = nw; }
                float pr = oldSt < 0 ? 1.0f : static_cast<float>(nw - swT) / 5760000.0f; if (pr > 1.0f) pr = 1.0f; /* 0.3 秒 */
                const float e = 1.0f - (1.0f - pr) * (1.0f - pr) * (1.0f - pr); constexpr int kSl = 14;
                if (pr < 1.0f) drawSt(oldSt, 1.0f - e, -static_cast<int>(kSl * e)); /* 古い文字: 上へ消える */
