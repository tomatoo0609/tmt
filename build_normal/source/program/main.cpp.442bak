                        const float* f = reinterpret_cast<const float*>(w + i + kClPos / 4);
                        if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2]) || f[0] < -2000.0f || f[0] > 2000.0f || f[1] < -2000.0f || f[1] > 2000.0f || f[2] < -2000.0f || f[2] > 2000.0f) continue;
                        if ((f[0] == 0.0f && f[1] == 0.0f && f[2] == 0.0f) || f[1] < -100.0f) continue; /* 使われていない (しまってある) アサリ */
                        all++; if (n >= kClMax) continue; /* 全部の数も数える (アサリのないステージで 48 個見つかっていた) */
                        const uintptr_t at = base + i * 4; bool dup = false; for (int q = 0; q < n; q++) if (g_ClObj[q] == at) dup = true; if (!dup) g_ClObj[n++] = at;
                    }
                });
            }
            cur = end;
        }
        g_ClN = n; g_ClAll = all;
