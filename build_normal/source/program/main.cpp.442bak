        const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) UpdWrite(sdk, kAf[g_AsrNo % 3], out, static_cast<u32>(head + n * 28)); /* ここは裏の流れなので、そのまま書く */
