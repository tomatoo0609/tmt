    int PageItem(int j) { return g_Cat < 0 ? (j >= kCatCount ? kDynUpd : 100 + kTopOrder[j % kCatCount]) : CatItem(g_Cat, j); }
    void UpdateFuncOn() { g_FuncOn = g_Ruler || g_InfoOn || (g_ModeOn && !g_FlyQuiet) || NowTick() < g_FillDiagUntil || g_Fx[18] || g_Fx[19] || g_Fx[20] || g_Fx[21]; }
    void FxInput(int k, bool act, bool lf, bool rt) {
        if (k == 13) { int v = g_Fx[13]; if (act) v = v ? 0 : 2; if (lf && v > 0) v--; if (rt && v < 5) v++; g_Fx[13] = v; }
        else if (k == 14) { int v = g_Fx[14]; if (act) v = 0; if (lf && v > -50) v -= 25; if (rt && v < 200) v += 25; g_Fx[14] = v; }
        else if (act) g_Fx[k] = g_Fx[k] ? 0 : 1;
        UpdateFuncOn();
    }
