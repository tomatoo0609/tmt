    constexpr int kDfMax = 16384; static uintptr_t g_DfAddr[kDfMax]; static float g_DfOld[kDfMax][3]; static volatile int g_DfN = 0, g_DfMsg = 0, g_DfCand = 0, g_DfMoved = 0; static volatile u32 g_DfGen = 0; static float g_DfMe1[3], g_DfMe2[3];
    /* g_DfMsg: 0 まだ / 1 探し中 (1 回目) / 2 覚えた (拾ってから L) / 3 比べ中 (2 回目) / 4 保存した / 5 自分の座標が分からない / 6 ロードで中止 / 7 自分の座標が変わっていない */
    void DfScanSync() {
        const u32 gen = g_DfGen; if (gen != g_LoadGen) { g_DfMsg = 6; return; }
        const uintptr_t mlo = exl::util::GetMainModuleInfo().m_Total.m_Start, mhi = exl::util::GetMainModuleInfo().m_Total.GetEnd();
        if (g_DfMsg == 1) { /* 1 回目: 足元のまわり (横 5 以内、高さ -1.5〜+3) にある座標を全部覚える (3 だと、少し離れたアサリが入っていなかった) */
            const float mx = g_DfMe1[0], fy = g_DfMe1[1] - kLiveHeight, mz = g_DfMe1[2]; int n = 0;
            MemoryInfo sm; u32 sp; uintptr_t selfLo = 0, selfHi = 0; if (R_SUCCEEDED(svcQueryMemory(&sm, &sp, reinterpret_cast<uintptr_t>(g_DfAddr)))) { selfLo = sm.addr; selfHi = sm.addr + sm.size; }
            uintptr_t cur = 0;
