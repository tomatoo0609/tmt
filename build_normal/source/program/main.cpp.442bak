    }
    static uintptr_t UpdSdk() { return exl::util::HasModule(exl::util::ModuleIndex::Sdk) ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0; }
    static bool UpdMount(uintptr_t sdk) {
        using MountFn = u32 (*)(const char*); using DirFn = u32 (*)(const char*);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0) rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return false;
            g_DumpMounted = true;
        }
        const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin");
        return true;
    }
    static int UpdReadSmall(uintptr_t sdk, const char* name, char* out, int cap) {
        using OpenFn = u32 (*)(FileHandle*, const char*, int); using SizeFn = u32 (*)(s64*, FileHandle); using ReadFn = u32 (*)(u64*, FileHandle, s64, void*, u64); using CloseFn = void (*)(FileHandle);
        FileHandle fh { nullptr };
        if (reinterpret_cast<OpenFn>(sdk + kSdkOpenFile)(&fh, name, 1) != 0) return -1;
        s64 sz = 0; reinterpret_cast<SizeFn>(sdk + kSdkGetFileSize)(&sz, fh); if (sz > cap - 1) sz = cap - 1; if (sz < 0) sz = 0;
        u64 got = 0; reinterpret_cast<ReadFn>(sdk + kSdkReadFile)(&got, fh, 0, out, static_cast<u64>(sz));
        reinterpret_cast<CloseFn>(sdk + kSdkCloseFile)(fh);
        out[got] = 0; return static_cast<int>(got);
    }
    static bool UpdWrite(uintptr_t sdk, const char* name, const void* data, u32 len) {
        using CreateFn = u32 (*)(const char*, s64); using OpenFn = u32 (*)(FileHandle*, const char*, int);
        using WriteFn = u32 (*)(FileHandle, s64, const void*, u64, const s32*); using FlushFn = u32 (*)(FileHandle); using CloseFn = void (*)(FileHandle); using DelFn = u32 (*)(const char*);
        reinterpret_cast<DelFn>(sdk + 0xA9E80)(name);
        if (reinterpret_cast<CreateFn>(sdk + kSdkCreateFile)(name, static_cast<s64>(len)) != 0) return false;
        FileHandle fh { nullptr };
        if (reinterpret_cast<OpenFn>(sdk + kSdkOpenFile)(&fh, name, 2) != 0) return false;
        const s32 opt = 1; /* 書いたらすぐ確定 */
        const u32 wr = len ? reinterpret_cast<WriteFn>(sdk + kSdkWriteFile)(fh, 0, data, len, &opt) : 0;
        reinterpret_cast<FlushFn>(sdk + kSdkFlushFile)(fh);
        reinterpret_cast<CloseFn>(sdk + kSdkCloseFile)(fh);
        return wr == 0;
    }
    /* SDK の中から、名前で関数の場所を探す (SDK の動的シンボル表を、先頭から順に読む。読めない所は読まない)。
       前は rtld の探し方を使っていたが、表の作りの違いで落ちた */
    static uintptr_t SdkSym(const char* name) {
        const uintptr_t base = UpdSdk(); if (!base || !Readable(base, 8)) return 0;
        const uintptr_t mod = base + *reinterpret_cast<const u32*>(base + 4); if (!Readable(mod, 8) || *reinterpret_cast<const u32*>(mod) != 0x30444F4Du) return 0; /* "MOD0" */
        const uintptr_t dyn = mod + static_cast<intptr_t>(*reinterpret_cast<const s32*>(mod + 4));
        uintptr_t sym = 0, str = 0; u64 strsz = 0;
        for (int i = 0; i < 128; i++) { const uintptr_t e = dyn + static_cast<uintptr_t>(i) * 16; if (!Readable(e, 16)) return 0; const u64 tag = *reinterpret_cast<const u64*>(e), val = *reinterpret_cast<const u64*>(e + 8);
            if (tag == 0) break; if (tag == 6) sym = val; else if (tag == 5) str = val; else if (tag == 10) strsz = val; }
        if (!sym || !str || !strsz) return 0; if (sym < base) sym += base; if (str < base) str += base;
        size_t n = str > sym ? (str - sym) / 24 : 60000; if (n > 60000) n = 60000;
        size_t nl = 0; while (name[nl]) nl++;
        uintptr_t okPage = 1;
        for (size_t i = 1; i < n; i++) {
            const uintptr_t e = sym + i * 24;
            if ((e & ~0xFFFull) != okPage || ((e + 23) & ~0xFFFull) != okPage) { if (!Readable(e, 24)) return 0; okPage = ((e + 23) & ~0xFFFull) == (e & ~0xFFFull) ? (e & ~0xFFFull) : 1; }
            const u32 nmo = *reinterpret_cast<const u32*>(e); const u16 shn = *reinterpret_cast<const u16*>(e + 6); const u64 val = *reinterpret_cast<const u64*>(e + 8);
            if (!val || !shn || nmo + nl + 1 > strsz) continue;
            const char* q = reinterpret_cast<const char*>(str + nmo); if (!Readable(reinterpret_cast<uintptr_t>(q), nl + 1)) continue;
            bool m = true; for (size_t k = 0; k <= nl; k++) if (q[k] != name[k]) { m = false; break; }
            if (m) return base + val;
        }
        return 0;
    }
    static void UpdFinish(int st, int msg) { g_UpdMsg = msg; g_UpdState = st; g_UpdT = NowTick(); }
    static void UpdWorker(void*) {
        UpdApi& u = g_Ua;
        const uintptr_t sdk = UpdSdk();
        using DelFn = u32 (*)(const char*);
        static const char* const kBusy = "inkd:/inkdraw/bin/upd_busy.flag";
        for (;;) {
            if (g_UpdAutoPhase == 1 && !g_UpdReq) g_UpdAutoPhase = 2; /* 自動の確認が終わった (起動の表示を引っこめる) */
            while (!g_UpdReq) u.sleepNs(100000000ll);
            const bool manual = g_UpdReq == 2; g_UpdReq = 0;
            g_UpdErr = 0;
            if (!sdk || !UpdMount(sdk)) { if (manual) UpdFinish(5, 1); else g_UpdState = 0; continue; }
            { /* 場所の設定 */
                char t[300]; int n = UpdReadSmall(sdk, "inkd:/inkdraw/update_url.txt", t, sizeof(t));
                if (n <= 8) { const char* d = "raw.githubusercontent.com/tomatoo0609/modmenu/main/update"; n = 0; while (d[n] && n < static_cast<int>(sizeof(t)) - 1) { t[n] = d[n]; n++; } } /* ファイルが無いときは、いつもの場所 */
                int i = 0; while (i < n && (t[i] == ' ' || t[i] == '\r' || t[i] == '\n' || static_cast<u8>(t[i]) == 0xEF || static_cast<u8>(t[i]) == 0xBB || static_cast<u8>(t[i]) == 0xBF)) i++;
                if (n > 8 && t[i] == 'h') { while (i < n && t[i] != '/') i++; while (i < n && t[i] == '/') i++; } /* https:// を飛ばす */
                int hl = 0; while (i < n && t[i] != '/' && t[i] > ' ' && hl < 95) g_UpdHost[hl++] = t[i++]; g_UpdHost[hl] = 0;
                while (i < n && t[i] == '/') i++;
                int pl = 0; while (i < n && t[i] > ' ' && pl < 159) g_UpdPath[pl++] = t[i++]; while (pl > 0 && g_UpdPath[pl - 1] == '/') pl--; g_UpdPath[pl] = 0;
                if (n <= 0 || hl == 0 || pl == 0) { if (manual) UpdFinish(5, 2); else g_UpdState = 0; continue; }
            }
            if (!manual) { char t[4]; if (UpdReadSmall(sdk, kBusy, t, sizeof(t)) >= 0) { g_UpdState = 0; continue; } } /* 前回、確認の途中で落ちた: 自動ではもう確かめない (メニューからなら確かめる) */
            UpdWrite(sdk, kBusy, "1", 1);
            g_UpdState = 1;
            u.nifmInit(); if (!u.nifmAvail()) u.nifmSubmit(); /* もうつながっていれば、つなぐのを待たない (確認が速くなる) */
            bool ownSock = false; void* sockPool = nullptr;
            auto netEnd = [&] { if (g_UpdOwnSsl && u.sslFin) u.sslFin(); g_UpdOwnSsl = false; if (ownSock) { u.sockFin(); if (sockPool) u.freeF(sockPool); } ownSock = false; sockPool = nullptr; }; /* 自分で準備したものは片付ける (ゲームがあとで自分で準備できるように) */
            if (u.nifmAvail() && u.sockIsInit && !u.sockIsInit() && u.sockInit && u.sockFin && u.alignedAlloc) { /* ゲームがまだ通信の準備をしていない: 自分で準備する */
