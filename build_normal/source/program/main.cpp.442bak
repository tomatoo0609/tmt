        for (int k = 0; k < n && nref < 0; k++) { /* 写し探しはやめた (アサリがステージ中に散らばると、40 秒で終わらなかった) */ if (!Readable(g_ClObj[k] + kClPos, 12)) continue; const float* f = reinterpret_cast<const float*>(g_ClObj[k] + kClPos); if (ClamNearSelf(f)) continue; std::memcpy(P[nref], f, 12); O[nref] = g_ClObj[k]; own[nref] = static_cast<u8>(k); nref++; }
        int nc = 0; cur = 0; float xlo = 1e9f, xhi = -1e9f; for (int j = 0; j < nref; j++) { if (P[j][0] < xlo) xlo = P[j][0]; if (P[j][0] > xhi) xhi = P[j][0]; } xlo -= 1e-4f; xhi += 1e-4f;
        for (int guard = 0; guard < 8192 && nc < kClCpMax && nref > 0; guard++) {
