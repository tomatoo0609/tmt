            X6Hook::InstallAtOffset(0x28595E0);
        if (*reinterpret_cast<const u32*>(mainBase + 0x4D8D220) == 0x1E220020) GspHook::InstallAtOffset(0x4D8D220); /* scvtf s0, w1 */
        if (*reinterpret_cast<const u32*>(mainBase + 0x2845EC4) == 0x1E200908u) HSpdHook::InstallAtOffset(0x2845EC4); /* fmul s8, s8, s0 */
        if (*reinterpret_cast<const u32*>(mainBase + 0x2845E40) == 0xAA1C03E0u) SpdHook::InstallAtOffset(0x2845E40); /* mov x0, x28 (移動速度の表) */
        if (*reinterpret_cast<const u32*>(mainBase + 0x285DE90) == 0x2A1F03E0) { MarkHookA::InstallAtOffset(0x285DE90); MarkHookB::InstallAtOffset(0x285DE94); }
        { /* ノックバック記録の見張り: 命令がそのとおりのときだけ付ける (別の版では付けない) */
          auto ok = [&](uintptr_t o, u32 w) { return *reinterpret_cast<const u32*>(mainBase + o) == w; };
          if (ok(0x21C4B3C, 0xD10183FFu) && ok(0x21C4C68, 0xD10183FFu) && ok(0x21C4C30, 0xAA1403E0u) && ok(0x21C4D5C, 0xAA1403E0u)) {
              KbHook4::InstallAtOffset(0x21C4B3C); KbHook5::InstallAtOffset(0x21C4C68); KbHook6::InstallAtOffset(0x21C4C30); KbHook7::InstallAtOffset(0x21C4D5C); g_KbInst = true; } } /* mov w0, wzr */
    }
}

extern "C" NORETURN void exl_exception_entry() {
    /* Note: this is only applicable in the context of applets/sysmodules. */
    EXL_ABORT("Default exception handler called!");
}
