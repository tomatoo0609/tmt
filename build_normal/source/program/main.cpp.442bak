            for (int q = 0; q < g_ClCpN && q < kClCpMax; q++) { const int k = g_ClCpOwner[q]; if (k >= kClMax || !g_ClUse[k] || !Writable(g_ClCp[q], 12)) continue;
                float* w = reinterpret_cast<float*>(g_ClCp[q]); w[0] = g_ClTgt[k][0]; w[1] = g_ClTgt[k][1] + g_ClCpDy[q]; w[2] = g_ClTgt[k][2]; }
        }
    }
    volatile int g_AsrMsg = 0, g_AsrN = 0, g_AsrNo = 0; volatile u32 g_AsrGen = 0; float g_AsrMe[3]; /* アサリサーチ: 0 まだ / 1 探し中 / 2 保存した / 3 自分の座標が分からない / 4 ロードで中止 */
    void AsrScanSync() { /* 裏の流れで: メモリ全体から、足元のまわりにある座標を探す */
