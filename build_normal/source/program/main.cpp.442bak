            if (u.conSock(con, fd) != 0) rc = 17;
            else if (u.conHost(con, g_UpdHost, hl) != 0) rc = 18;
            else if (u.conVerify(con, 3 /* 証明書と名前を確かめる */) != 0) rc = 19;
            else if (u.conHand(con) != 0) rc = 20;
            else {
                char req[512];
                const int rl = std::snprintf(req, sizeof(req), "GET /%s/%s HTTP/1.1\r\nHost: %s\r\nUser-Agent: inkdraw\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n", g_UpdPath, rel, g_UpdHost);
                int wr = 0;
                if (u.conWrite(con, req, &wr, static_cast<u32>(rl)) != 0 || wr <= 0) rc = 21;
                else {
                    u32 n = 0; int hdrEnd = -1; long clen = -1; bool chunked = false; int status = 0;
                    while (n < g_UpdCap - 1) {
                        int rd = 0; const u32 want = g_UpdCap - 1 - n > 16384 ? 16384 : g_UpdCap - 1 - n;
                        if (u.conRead(con, reinterpret_cast<char*>(g_UpdBuf) + n, &rd, want) != 0 || rd <= 0) break;
                        n += static_cast<u32>(rd);
