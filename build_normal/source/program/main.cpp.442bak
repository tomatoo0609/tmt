/* 028595E0: mov x19, x6 。ここを通るたびに x6 を覚えておく (メモリサーチ用) */
/* 位置のマーキング: 0285DE90 の「mov w0, wzr」(しない) を、自分のときだけ「する」にする。2 つの印の差は、関数の出口 (0285DE94) で返り値を直すため */
static bool MarkIsSelf(uintptr_t x1) {
    if (!x1) return false;
    const uintptr_t base = PlayerTableBase();
    if (!base) return false;
    const int idx = g_LocalIdx;
    if (idx < 0 || idx > 9) return false;
    const uintptr_t ent = base + static_cast<uintptr_t>(idx) * kPlayerStride;
    /* x1 は「プレイヤー本体 + 0xD34」の中を指している (呼び出し元は 0293592C)。本体の範囲に入っていれば自分 */
    const uintptr_t pb = x1 - 0xD34;
    if (x1 == ent || pb == ent) return true;
    if (!Readable(ent + kPlayerObjOff, 8)) return false;
    const uintptr_t obj = *reinterpret_cast<const uintptr_t*>(ent + kPlayerObjOff);
    if (!obj) return false;
    return pb == obj || (x1 >= obj && x1 < obj + 0x4000);
}
HOOK_DEFINE_INLINE(HSpdHook) {
