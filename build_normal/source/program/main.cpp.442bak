                else if (g_SelPanel == 6) { static const char* const kTw2[3] = { "細", "普通", "太" }; nm = kTw2[gi % 3]; now = (g_TrW % 3 == gi); }
                else if (g_SelPanel == 5) { static const char* const kWc[4] = { "ワープ", "記憶する", "地点を見る", "印・消す" }; nm = kWc[gi & 3]; now = false; }
                else if (g_SelPanel == 12) { static char lb2[10][48]; const int c = gi % 10; if (c == 8) { std::snprintf(lb2[c], 48, "いちばん近い敵 (%d)", static_cast<int>(g_EnN)); now = g_LookOn && g_LookSlot == 5; } else if (c == 9) { std::snprintf(lb2[c], 48, "A押しの間だけ: %s", g_LookAHold ? "オン" : "オフ"); now = g_LookAHold; } else if (c == 7) { std::snprintf(lb2[c], 48, "いちばん近いバルーン (%d個)", static_cast<int>(g_BalN)); now = g_LookOn && g_LookSlot == 4; } else if (c == 6) { const float Rr = 2.8f + 2.8f * static_cast<float>(g_LookRange); std::snprintf(lb2[c], 48, "向く範囲: %.1f (左右)", Rr); } else if (c == 5) { static const char* const kGr[6] = { "OFF", "3m", "5m", "10m", "20m", "30m" }; std::snprintf(lb2[c], 48, "ジャイロ切替距離: %s", kGr[g_GyroRange % 6]); } else if (c <= 2) std::snprintf(lb2[c], 48, "地点%d%s", c + 1, g_WarpHas[c] ? "" : " (空き)"); else if (c == 3) std::snprintf(lb2[c], 48, "スタート地点%s", g_WarpHas[3] ? "" : " (まだ)"); else std::snprintf(lb2[c], 48, "見るのをやめる"); nm = lb2[c]; if (c < 7) now = c <= 3 && g_LookOn && g_LookSlot == c; }
                else if (g_SelPanel >= 9 && g_SelPanel <= 11) { static char wb[5][48]; const int c = gi % 5;
                    if (g_SelPanel == 9) { if (c <= 2) std::snprintf(wb[c], 48, "地点%d%s", c + 1, g_WarpHas[c] ? "" : " (空き)"); else std::snprintf(wb[c], 48, "スタート地点%s", g_WarpHas[3] ? "" : " (まだ)"); now = g_WarpHas[c]; }
                    else if (g_SelPanel == 10) { std::snprintf(wb[c], 48, "地点%dに記憶%s", c + 1, g_WarpHas[c] ? " (上書き)" : ""); now = g_WarpHas[c]; }
                    else if (c == 0) { std::snprintf(wb[c], 48, "ワープの印: %s", g_WarpMark ? "ON" : "OFF"); now = g_WarpMark; }
                    else { std::snprintf(wb[c], 48, "全部消す / OFF"); now = false; }
                    nm = wb[c]; }
                else if (g_SelPanel == 7) { static const char* const kRt[4] = { "そのまま", "90度", "180度", "270度" }; nm = kRt[gi & 3]; now = ((g_ImgRot & 3) == gi); }
                else if (g_SelPanel == 8) { static const char* const kRv[2] = { "今の場所を予約する", "予約を消す" }; nm = kRv[gi & 1]; now = (gi == 0 && g_ResvHave); }
                else { nm = kEr[gi]; now = (g_EraseSel % 3 == gi); }
                if (cur) SwRRect(v, px0 + 6, y + 1, PW - 12, prow - 2, 12.0f, selBg);
                SwU8(v, nm, px0 + 24, y + (prow - font_glyphs::kLineH) / 2, PW - 90, cur ? ink : white);
                if (g_SelPanel == 12 && gi == 6) SwBar(v, px0 + 24, y + prow - 6, PW - 60, static_cast<float>(g_LookRange) / 19.0f, false, accent); /* 向く範囲のバー */
                if (now) SwRRect(v, px0 + PW - 34, y + prow / 2 - 5, 10, 10, 5.0f, cur ? ink : accent);
                /* 右端の > は出さない */
            }

        }
        if (g_MemPanel) {
            /* メモリサーチ: x6 (028595E0 で拾った値) の +0x004〜+0x1000 */
            const Col pp { 0.075f, 0.080f, 0.095f }, pb = accent, sel2 { 0.14f, 0.17f, 0.24f };
            const int px0 = x0 + MWt + gap + (dCat >= 0 ? MW + gap : 0) + sideXo, PH = sideH;
            { PRect pr { px0, y0, PW, PH, 18 }; pr.a = sideA; g_BaseRects[g_BaseRectN++] = pr; if (sideA < 8) g_FadeBusy = true; }
            SwRRect(v, px0, y0, PW, PH, 18.0f, Col { 0.46f, 0.48f, 0.52f }); /* 2 つ目のメニューと同じ: グレーのふち (太さ 2) + 暗い板 */
            SwRRect(v, px0 + 2, y0 + 2, PW - 4, PH - 4, 16.0f, panel); (void)pp;
            auto hex = [](char* o, u64 x, int digits) { for (int i = digits - 1; i >= 0; i--) { const int d = (x >> (i * 4)) & 15; *o++ = static_cast<char>(d < 10 ? '0' + d : 'A' + d - 10); } *o = 0; };
            auto dec = [](char* o, s64 x) { char t[24]; int n = 0; bool neg = x < 0; u64 u = neg ? static_cast<u64>(-x) : static_cast<u64>(x); do { t[n++] = static_cast<char>('0' + u % 10); u /= 10; } while (u && n < 22); if (neg) *o++ = '-'; while (n) *o++ = t[--n]; *o = 0; };
            auto flt = [&](char* o, float f) {
                if (!(f == f)) { const char* q = "NaN"; while (*q) *o++ = *q++; *o = 0; return; }
                if (f > 1e9f || f < -1e9f) { const char* q = f < 0 ? "-大" : "大"; while (*q) *o++ = *q++; *o = 0; return; }
                if (f < 0) { *o++ = '-'; f = -f; }
                const s64 ip = static_cast<s64>(f); dec(o, ip); while (*o) o++;
                s64 fr = static_cast<s64>((f - ip) * 1000.0f + 0.5f); if (fr > 999) fr = 999;
                *o++ = '.'; *o++ = static_cast<char>('0' + fr / 100); *o++ = static_cast<char>('0' + (fr / 10) % 10); *o++ = static_cast<char>('0' + fr % 10); *o = 0;
            };
            const uintptr_t base = g_MemBase;
            char hd[64]; { const char* q = "x6 = "; int k = 0; while (*q) hd[k++] = *q++; hex(hd + k, base, 10); }
            SwU8(v, hd, px0 + 18, y0 + 16, PW - 36, white);
            static const char* const kTypeName[3] = { "16進", "小数", "整数" };
            SwU8(v, kTypeName[g_MemType % 3], px0 + PW - 70, y0 + 12, 60, pb);
            SwRect(v, px0 + 12, y0 + head - 6, PW - 24, 1, border);
            const int prow = 26, top = y0 + head, visible = (PH - head - foot - 4) / prow;
            static int s_first = 0;
            int first = s_first;
            if (g_MemSel < first) first = g_MemSel;
            if (g_MemSel >= first + visible) first = g_MemSel - visible + 1;
            if (first < 0) first = 0;
            s_first = first;
            const bool ok = base && Readable(base, 0x1004);
            if (!ok) SwU8(v, base ? "読めない場所です" : "まだ x6 が拾えていません", px0 + 20, top + 8, PW - 40, Col { 0.95f, 0.6f, 0.6f });
            for (int i = 0; ok && i < visible && first + i < kMemRows; i++) {
                const int ri = first + i, off = 4 + ri * 4, y = top + prow * i;
                const bool sl = ri == g_MemSel;
                if (sl) SwRRect(v, px0 + 6, y + 1, PW - 12, prow - 2, 12.0f, sel2);
                u32 raw; std::memcpy(&raw, reinterpret_cast<const void*>(base + off), 4);
                char t[32]; t[0] = '+'; hex(t + 1, static_cast<u64>(off), 3);
                SwU8(v, t, px0 + 18, y + (prow - font_glyphs::kLineH) / 2, 70, sl ? pb : dim);
                char h[16]; hex(h, raw, 8);
                SwU8(v, h, px0 + 96, y + (prow - font_glyphs::kLineH) / 2, 100, g_MemType == 0 || sl ? white : dim);
                char val[32];
                if (g_MemType == 2) dec(val, static_cast<s32>(raw)); else { float f; std::memcpy(&f, &raw, 4); flt(val, f); }
                SwU8(v, val, px0 + 210, y + (prow - font_glyphs::kLineH) / 2, PW - 230, g_MemType != 0 || sl ? white : dim);
            }
        }
        { /* 3 つ目のメニュー: 開ききったときの絵を覚えておき、閉じるときは、その絵を 2 つ目の後ろへ滑らせて戻す (開くときと同じ動き) */
            const int spx = x0 + MWt + gap + (dCat >= 0 ? MW + gap : 0);
            if (side && sideXo == 0 && sideH > 0 && sideH <= 700) {
                for (int yy = 0; yy < sideH; yy++) for (int xx = 0; xx < PW; xx++) { const int sx = spx + xx, sy = y0 + yy; snapPx[yy * 360 + xx] = (sx >= 0 && sx < g_BaseW && sy >= 0 && sy < g_BaseH) ? v.px[sy * v.w + sx] : 0u; }
                snapH = sideH;
            } else if (sideClosing) {
                float pc = static_cast<float>(NowTick() - sideCloseT) / 3840000.0f; if (pc > 1.0f) pc = 1.0f;
                const int cxo = -static_cast<int>(pc * pc * static_cast<float>((dCat >= 0 ? MW : MWt) + gap)); g_SlideBusy = true; g_AnimBusy = true;
                for (int yy = 0; yy < snapH; yy++) for (int xx = 0; xx < PW; xx++) { const u32 pxl = snapPx[yy * 360 + xx]; if (!pxl) continue; const int sx = spx + cxo + xx, sy = y0 + yy; if (sx >= 0 && sx < g_BaseW && sy >= 0 && sy < g_BaseH) v.px[sy * v.w + sx] = pxl; }
                PRect pr { spx + cxo, y0, PW, snapH, 18 }; g_BaseRects[g_BaseRectN++] = pr;
            }
        }
        {
            static bool hadCat = false; static u64 catT = 0;
            if (g_Cat >= 0 && !hadCat) catT = nowS;
            hadCat = g_Cat >= 0;
            if (dCat >= 0) {
                float pc = g_Cat >= 0 ? static_cast<float>(nowS - catT) / 3840000.0f : static_cast<float>(nowS - catBackT) / 3840000.0f; if (pc > 1.0f) pc = 1.0f;
                const float q = 1.0f - pc; const float ep = g_Cat >= 0 ? 1.0f - q * q * q : 1.0f - pc * pc * pc;
                if (pc < 1.0f) g_SlideBusy = true;
                const int bx = x0 + static_cast<int>(static_cast<float>(MWt + gap) * ep);
                const float ph = static_cast<float>(NowTick() % 38400000ull) / 38400000.0f;
                const float tri = ph < 0.5f ? ph * 2.0f : (1.0f - ph) * 2.0f;
                const float gl = 0.55f + 0.45f * tri;
                (void)gl; SwRRect(v, bx, y0, MW, MHc, 18.0f, Col { 0.46f, 0.48f, 0.52f }); /* ふち: グレー、太さ 2 */
                SwRRect(v, bx + 2, y0 + 2, MW - 4, MHc - 4, 16.0f, panel);
                static const menu_text::Str* const kCatLB[5] = { &menu_text::kL_CAT0, &menu_text::kL_CAT1, &menu_text::kL_CAT2, &menu_text::kL_CAT3, &menu_text::kL_CAT6 };
                SwU8(v, kCatName[dCat], bx + 18, y0 + 14, 240, whiteG); /* メニューの名前: 2 つ目も 3 つ目も同じ高さ・白 */
                drawRows(dCat, bx, g_Cat >= 0 ? g_MenuSel : -1, g_Cat >= 0);
                { PRect pr { bx, y0, MW, MHc, 18 }; pr.a = mA; (void)pc; g_BaseRects[g_BaseRectN++] = pr; } /* 出るときはふわっと濃く、戻るときは薄く */
            }
        }
        { PRect pr { x0, y0, MWt, MHt, 18 }; pr.a = mA; g_BaseRects[g_BaseRectN++] = pr; }
        if (mA < 8) g_FadeBusy = true; g_FuncMenuA = mA;
        SwRRect(v, x0, y0, MWt, MHt, 18.0f, Col { 0.46f, 0.48f, 0.52f }); /* ふち: グレー、太さ 2 (中の色となじむように) */
        SwRRect(v, x0 + 2, y0 + 2, MWt - 4, MHt - 4, 16.0f, panel);
        {
            /* タイトル: 光らせずに白い文字だけ。左に細い縦の線、右に小さくバージョン (白い枠に合わせて、すっきり) */
            const float tsc = 1.25f; const int tx = x0 + 18, ty2 = y0 + 11; /* 左の縦線はなし */
            SwStrBig(v, menu_text::kTITLE, tx, ty2, tsc, whiteG, 1.0f);
            { char vt[24]; std::snprintf(vt, sizeof(vt), "%s", kInkVerName); SwU8(v, vt, tx + static_cast<int>(static_cast<float>(menu_text::kTITLE.w) * tsc) + 10, ty2 + static_cast<int>(static_cast<float>(menu_text::kTITLE.h) * tsc) - font_glyphs::kLineH + 1, 90, dimG); } /* Inkdraw のすぐ右 (下をそろえる) */
            static const menu_text::Str* const kCatL[5] = { &menu_text::kL_CAT0, &menu_text::kL_CAT1, &menu_text::kL_CAT2, &menu_text::kL_CAT3, &menu_text::kL_CAT6 };
            if (false && g_Cat >= 0 && g_Cat < 5) SwStr(v, *kCatL[g_Cat], x0 + MW - 18 - kCatL[g_Cat]->w, y0 + 14, dimG);
            else if (false && g_Cat >= 5 && g_Cat < kCatCount) SwU8(v, kCatName[g_Cat], x0 + MW - 18 - 100, y0 + 14, 100, dimG);
        }
        {
            /* 左のレール: 最上位のカテゴリを、アイコンだけで並べる */
            const int nIc = 0;
            for (int q = 0; q < nIc; q++) {
                const int cy = y0 + 30 + q * ((RH - 60) / (nIc - 1));
                const bool act = g_Cat >= 0 ? (kTopOrder[q] == g_Cat) : (q == g_MenuSel);
                if (act) { SwRRect(v, rx0 + (RW - 36) / 2, cy - 18, 36, 36, 18.0f, selBg); { if (kTopOrder[q] == kCatRst) SwIconShape(v, rx0 + RW / 2, cy, 24, 3, ink); else SwIcon(v, rx0 + RW / 2, cy, 24, kTopOrder[q], ink, 1.0f); } }
                else if (kTopOrder[q] == kCatRst) SwIconShape(v, rx0 + RW / 2, cy, 24, 3, Col { 0.55f, 0.57f, 0.61f }); else SwIcon(v, rx0 + RW / 2, cy, 24, kTopOrder[q], Col { 0.55f, 0.57f, 0.61f }, 1.0f);
            }
        }
        drawRows(-1, x0, g_Cat < 0 ? g_MenuSel : ([&]{ for (int q = 0; q < kCatCount; q++) if (kTopOrder[q] == g_Cat) return q; return 0; })(), g_Cat < 0);
        if (g_UiMove) SwU8(v, "十字キーで移動    L: 決定", x0 + 18, y0 + MHt - 28, MWt - 36, Col { 1.0f, 0.85f, 0.4f });

        if (fvis && !sideV) { int fw, fh; SwDrawFunc(v, x0 + MWt + gap + (dCat >= 0 ? MW + gap : 0), y0, fw, fh); }
    }
    /* 100% で描いた絵を、大きさに合わせて縮小/拡大して、写す用の画像にする */
    /* 2 つの色を t/256 の割合で混ぜる (4 つの色成分をまとめて計算) */
    ALWAYS_INLINE u32 LerpPx(u32 a, u32 b, u32 t) {
        const u32 M = 0x00FF00FFu;
        const u32 rb = (((a & M) * (256 - t) + (b & M) * t) >> 8) & M;
        const u32 ag = (((a >> 8) & M) * (256 - t) + ((b >> 8) & M) * t) & 0xFF00FF00u;
        return rb | ag;
    }
    int g_LastUx = -9999, g_LastUy = -9999; u64 g_ScaleT = 0; bool g_ScaleRough = false;
    void SwScale(int W, int H, bool pix = true) {
        float sc = g_UiScale / 100.0f;
        if (g_BaseW <= 0 || g_BaseH <= 0) { g_SwW = 0; g_SwH = 0; g_SwRectN = 0; return; }
        if (g_BaseW * sc > W - 8) sc = static_cast<float>(W - 8) / g_BaseW;
        if (g_BaseH * sc > H - 8) sc = static_cast<float>(H - 8) / g_BaseH;
        if (g_BaseW * sc > kOvW) sc = static_cast<float>(kOvW) / g_BaseW;
        if (g_BaseH * sc > kOvH) sc = static_cast<float>(kOvH) / g_BaseH;
        const int dw = static_cast<int>(g_BaseW * sc), dh = static_cast<int>(g_BaseH * sc);
        int ux = g_UiX, uy = g_UiY;
        if (ux < 0) ux = 0; if (uy < 0) uy = 0;
        if (ux + dw > W) ux = W - dw; if (uy + dh > H) uy = H - dh;
        if (g_UiMove) { g_UiX = ux; g_UiY = uy; } /* 大きさを変えても、決めた位置は変えない (画面からはみ出す分だけ、見える位置をずらす) */
        g_SwX = ux; g_SwY = uy; g_SwW = dw; g_SwH = dh;
        g_SwSc = sc;
        const float inv = 1.0f / sc;
        const int ss = 1; /* 縮小するときは 2x2 で平均して、ぎざぎざを減らす */
        if (!pix) {} else if (dw == g_BaseW && dh == g_BaseH) std::memcpy(g_Scratch, g_Base, static_cast<size_t>(dw) * dh * 4); /* 100% のときは、そのまま写す (速い) */
        else if (g_AnimBusy || g_SlideBusy || (g_ScaleRough = (NowTick() - g_ScaleT < 1920000ull), g_ScaleT = NowTick(), g_ScaleRough)) {
            /* アニメーション中は、いちばん近い点をそのまま写す (速い)。止まったら、きれいな計算でもう一度描く */
            static int tn[kOvW * 2];
            for (int x = 0; x < dw; x++) { int ix = static_cast<int>((x + 0.5f) * inv); tn[x] = ix >= g_BaseW ? g_BaseW - 1 : ix; }
            for (int y = 0; y < dh; y++) {
                int iy = static_cast<int>((y + 0.5f) * inv); if (iy >= g_BaseH) iy = g_BaseH - 1;
                const u32* row = g_Base + iy * g_BaseW; u32* out = g_Scratch + y * dw;
                for (int x = 0; x < dw; x++) out[x] = row[tn[x]];
            }
        }
        else {
            /* 整数だけで計算する: 横方向の位置と重みは先に表にしておく */
            static int tx0[kOvW * 2], tx1[kOvW * 2]; static u32 twx[kOvW * 2];
            for (int x = 0; x < dw; x++) for (int sx = 0; sx < ss; sx++) {
                const float fx = (x + (sx + 0.5f) / ss) * inv - 0.5f;
                int ix = static_cast<int>(fx < 0 ? fx - 1 : fx); const float t = fx - ix;
                int i0 = ix < 0 ? 0 : (ix >= g_BaseW ? g_BaseW - 1 : ix), i1 = ix + 1 < 0 ? 0 : (ix + 1 >= g_BaseW ? g_BaseW - 1 : ix + 1);
                const int k = x * ss + sx; tx0[k] = i0; tx1[k] = i1; twx[k] = static_cast<u32>(t * 256.0f);
            }
            for (int y = 0; y < dh; y++) {
                const u32* r0[2]; const u32* r1[2]; u32 wy[2];
                for (int sy = 0; sy < ss; sy++) {
                    const float fy = (y + (sy + 0.5f) / ss) * inv - 0.5f;
                    int iy = static_cast<int>(fy < 0 ? fy - 1 : fy); const float t = fy - iy;
                    const int j0 = iy < 0 ? 0 : (iy >= g_BaseH ? g_BaseH - 1 : iy), j1 = iy + 1 < 0 ? 0 : (iy + 1 >= g_BaseH ? g_BaseH - 1 : iy + 1);
                    r0[sy] = g_Base + j0 * g_BaseW; r1[sy] = g_Base + j1 * g_BaseW; wy[sy] = static_cast<u32>(t * 256.0f);
                }
                u32* out = g_Scratch + y * dw;
                for (int x = 0; x < dw; x++) {
                    u32 accRB = 0, accAG = 0;
                    for (int sy = 0; sy < ss; sy++) for (int sx = 0; sx < ss; sx++) {
                        const int k = x * ss + sx;
                        const u32 top = LerpPx(r0[sy][tx0[k]], r0[sy][tx1[k]], twx[k]);
                        const u32 bot = LerpPx(r1[sy][tx0[k]], r1[sy][tx1[k]], twx[k]);
                        const u32 v = LerpPx(top, bot, wy[sy]);
                        accRB += v & 0x00FF00FFu; accAG += (v >> 8) & 0x00FF00FFu;
                    }
                    if (ss == 2) { accRB >>= 2; accAG >>= 2; }
                    out[x] = (accRB & 0x00FF00FFu) | ((accAG & 0x00FF00FFu) << 8);
                }
            }
        }
        g_SwRectN = 0;
        for (int k = 0; k < g_BaseRectN; k++) {
            const PRect& p = g_BaseRects[k];
            g_SwRects[g_SwRectN++] = PRect { ux + static_cast<int>(p.x * sc), uy + static_cast<int>(p.y * sc), static_cast<int>(p.w * sc), static_cast<int>(p.h * sc), static_cast<int>(p.r * sc) + 1, p.t, p.a };
        }
    }
    /* 起動の表示の絵を大きくして (なめらかに)、メニューの絵のあとろに置く。画面のまん中に出す。 */
    static void SplashScale(int W, int H) {
        g_SplOn = false;
        if (!SplashOn()) return;
        SplashDraw();
        float sc = static_cast<float>(H) / 1080.0f; if (sc > 1.0f) sc = 1.0f; /* 拡大はしない (くっきり) */
        if (g_SplBW * sc > W - 8) sc = static_cast<float>(W - 8) / g_SplBW;
        if (g_SplBH * sc > H - 8) sc = static_cast<float>(H - 8) / g_SplBH;
        const int dw = static_cast<int>(g_SplBW * sc), dh = static_cast<int>(g_SplBH * sc);
        if (dw < 2 || dh < 2) return;
        const size_t off = ((static_cast<size_t>(g_SwW) * static_cast<size_t>(g_SwH) + 63u) & ~static_cast<size_t>(63u));
        if ((off + static_cast<size_t>(dw) * static_cast<size_t>(dh)) * 4u > kPixBytes) return; /* 入りきらないときは出さない */
        u32* out0 = g_Scratch + off;
        const float inv = 1.0f / sc;
        static int tx0[kOvW], tx1[kOvW]; static u32 twx[kOvW];
        for (int x = 0; x < dw && x < kOvW; x++) {
            const float fx = (static_cast<float>(x) + 0.5f) * inv - 0.5f; int ix = static_cast<int>(fx < 0 ? fx - 1 : fx); const float tt = fx - static_cast<float>(ix);
            tx0[x] = ix < 0 ? 0 : (ix >= g_SplBW ? g_SplBW - 1 : ix); tx1[x] = ix + 1 < 0 ? 0 : (ix + 1 >= g_SplBW ? g_SplBW - 1 : ix + 1); twx[x] = static_cast<u32>(tt * 256.0f);
        }
        for (int y = 0; y < dh; y++) {
            const float fy = (static_cast<float>(y) + 0.5f) * inv - 0.5f; int iy = static_cast<int>(fy < 0 ? fy - 1 : fy); const float ty = fy - static_cast<float>(iy);
            const int j0 = iy < 0 ? 0 : (iy >= g_SplBH ? g_SplBH - 1 : iy), j1 = iy + 1 < 0 ? 0 : (iy + 1 >= g_SplBH ? g_SplBH - 1 : iy + 1);
            const u32* r0 = g_SplBase + j0 * g_SplBW; const u32* r1 = g_SplBase + j1 * g_SplBW; const u32 wy = static_cast<u32>(ty * 256.0f);
            u32* out = out0 + y * dw;
            for (int x = 0; x < dw; x++) { const u32 top = LerpPx(r0[tx0[x]], r0[tx1[x]], twx[x]); const u32 bot = LerpPx(r1[tx0[x]], r1[tx1[x]], twx[x]); out[x] = LerpPx(top, bot, wy); }
        }
        { /* 横の位置: 入るときは左の外からまん中へ (0.5 秒、だんだんゆっくり)、出るときはまん中から右の外へ (0.5 秒、だんだん速く) */
            const u64 n = NowTick(); const int cxp = (W - dw) / 2; int xx = cxp;
            if (g_SplashLeaveT) { float q = static_cast<float>(n - g_SplashLeaveT) / 9600000.0f; if (q > 1.0f) q = 1.0f; xx = cxp + static_cast<int>(q * q * q * static_cast<float>(W - cxp)); }
            else { float q = static_cast<float>(n - g_SplashT0) / 9600000.0f; if (q > 1.0f) q = 1.0f; const float e = 1.0f - (1.0f - q) * (1.0f - q) * (1.0f - q); xx = -dw + static_cast<int>(e * static_cast<float>(cxp + dw)); }
            g_SplX = xx; }
        g_SplY = (H - dh) / 2; g_SplW = dw; g_SplH = dh; g_SplR = static_cast<int>(36.0f * sc) + 1; g_SplOff = off * 4u; g_SplOn = true;
    }
    /* ワープの印: 画面の上の帯 (方位計)。まん中が今向いている向き (カメラの向き。歩いたときに覚え直す)。
       記憶した地点の向きに光る印を出し、下に番号と距離。左右 90 度より後ろの地点は、端に寄せて矢印を付ける。 */
    static bool g_HudOn = false; static int g_HudX = 0, g_HudY = 0, g_HudW = 0, g_HudH = 0; static size_t g_HudOff = 0;
    bool HudWanted() { if (!g_WarpMark || SplashOn()) return false; for (int k = 0; k < 4; k++) if (g_WarpHas[k]) return true; return false; }
    static float HudAtan2(float y, float x) { /* 度で返す (おおよそ) */
        const float ax = x < 0 ? -x : x, ay = y < 0 ? -y : y; if (ax < 1e-6f && ay < 1e-6f) return 0.0f;
        const float a = (ax > ay ? ay / ax : ax / ay); const float s2 = a * a; float r = ((-0.0464964749f * s2 + 0.15931422f) * s2 - 0.327622764f) * s2 * a + a;
        if (ay > ax) r = 1.5707963f - r; if (x < 0) r = 3.1415927f - r; if (y < 0) r = -r; return r * 57.29578f;
    }
    /* 地点 k の、今の向きからの角度 (右が +) と横の距離。わからなければ false */
    static bool HudRel(int k, float* ang, float* dist) {
        float F0, F1, L[3]; bool lv; if (!g_WarpHas[k] || !SelfPos(L) || !CamYawGet(&F0, &F1, &lv)) return false;
        const float dx = g_WarpSlots[k][0] - L[0], dz = g_WarpSlots[k][2] - L[2];
        const float fw = dx * F0 + dz * F1, rt = -dx * F1 + dz * F0;
        *ang = HudAtan2(rt, fw); *dist = __builtin_sqrtf(dx * dx + dz * dz); return true;
    }
    static void HudScale(int W, int H) {
        g_HudOn = false;
        if (!HudWanted()) return;
        const int hw = 460, hh = 60;
        if (hw > W - 8 || hh > H - 8) return;
        size_t off = ((static_cast<size_t>(g_SwW) * static_cast<size_t>(g_SwH) + 63u) & ~static_cast<size_t>(63u));
        if (g_SplOn) off = ((off + static_cast<size_t>(g_SplW) * static_cast<size_t>(g_SplH) + 63u) & ~static_cast<size_t>(63u));
        if ((off + static_cast<size_t>(hw) * static_cast<size_t>(hh)) * 4u > kPixBytes) return;
        Cv v { g_Scratch + off, hw, hh, 0, 0 };
        const float t = static_cast<float>(NowTick() % (19200000ull * 600ull)) / 19200000.0f;
        SwRect(v, 0, 0, hw, hh, Col { 0.025f, 0.04f, 0.075f });
        SwRect(v, 0, 0, hw, 1, Col { 0.18f, 0.55f, 0.70f }); SwRect(v, 0, hh - 1, hw, 1, Col { 0.18f, 0.55f, 0.70f });
        const int cx = hw / 2, sw = hw / 2 - 34, ly = 22;
        SwRect(v, 24, ly, hw - 48, 1, Col { 0.20f, 0.35f, 0.45f });
        for (int a = -90; a <= 90; a += 15) { const int x = cx + a * sw / 90; const int th = (a % 45 == 0) ? 7 : 4; SwRect(v, x, ly - th, 1, th * 2 + 1, Col { 0.30f, 0.50f, 0.60f }); }
        for (int k = 0; k <= 3; k++) SwRect(v, cx - k, 3 + k, 2 * k + 1, 1, Col { 0.95f, 0.98f, 1.0f }); /* まん中 (今の向き) */
        float hq0 = 0.0f, hq1 = 0.0f; bool hlv = false; const bool hYaw = CamYawGet(&hq0, &hq1, &hlv);
        if (!SelfValid()) { SwU8(v, "座標が不明", cx - U8W("座標が不明") / 2, 34, hw - 20, Col { 0.85f, 0.75f, 0.60f }); }
        else if (!hYaw) { SwU8(v, "向きを覚え中 (少し歩く)", cx - U8W("向きを覚え中 (少し歩く)") / 2, 34, hw - 20, Col { 0.85f, 0.75f, 0.60f }); }
        else {
            static const Col kC[4] = { { 0.25f, 0.95f, 1.0f }, { 1.0f, 0.35f, 0.85f }, { 1.0f, 0.88f, 0.25f }, { 0.40f, 1.0f, 0.50f } };
            for (int k = 0; k < 4; k++) {
                float ang, dist; if (!HudRel(k, &ang, &dist)) continue;
                const bool out = ang > 90.0f || ang < -90.0f; const float a2 = ang > 90.0f ? 90.0f : (ang < -90.0f ? -90.0f : ang);
                const int x = cx + static_cast<int>(a2 * static_cast<float>(sw) / 90.0f);
                const float pl = 0.65f + 0.35f * __builtin_sinf(t * 6.0f + static_cast<float>(k) * 1.7f); /* 光の強さを脈打たせる */
                const Col c = kC[k], core { c.r + (1.0f - c.r) * 0.5f * pl, c.g + (1.0f - c.g) * 0.5f * pl, c.b + (1.0f - c.b) * 0.5f * pl };
                for (int dy = -12; dy <= 12; dy++) for (int dx = -12; dx <= 12; dx++) {
                    const int dd = (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
                    if (dd <= 6) Blend(v, x + dx, ly + dy, core, 1.0f);
                    else if (dd <= 12) Blend(v, x + dx, ly + dy, c, (1.0f - static_cast<float>(dd - 6) / 6.0f) * 0.75f * pl * (out ? 0.5f : 1.0f));
                }
                if (out) { const int dir = ang > 0 ? 1 : -1; for (int q = 0; q <= 4; q++) { SwRect(v, x + dir * (14 + q), ly - 4 + q, 2, 1, c); SwRect(v, x + dir * (14 + q), ly + 4 - q, 2, 1, c); } } /* 後ろ: 矢印 */
                char lb[16]; std::snprintf(lb, sizeof(lb), "%s %d", k == 3 ? "S" : (k == 0 ? "1" : (k == 1 ? "2" : "3")), static_cast<int>(dist + 0.5f));
                SwU8(v, lb, x - U8W(lb) / 2, 36, 80, c);
            }
        }
        { float q0, q1; bool lv = false; if (CamYawGet(&q0, &q1, &lv)) SwU8(v, lv ? "カメラ" : "歩き", hw - 8 - U8W(lv ? "カメラ" : "歩き"), 36, 60, Col { 0.40f, 0.55f, 0.62f }); }
        g_HudX = (W - hw) / 2; g_HudY = 14; g_HudW = hw; g_HudH = hh; g_HudOff = off * 4u; g_HudOn = true;
    }
    /* アップデート確認の窓: 画面のまん中に出す (聞く / ダウンロード中 / 結果) */
    static bool g_UpdOn = false; static int g_UpdX = 0, g_UpdY = 0, g_UpdW = 0, g_UpdH = 0; static size_t g_UpdOff = 0;
    bool UpdWanted() { if (g_SplUpd) { if (g_UpdState == 0 && !g_UpdManual && !SplashOn()) g_SplUpd = false; return false; } /* 起動の表示の板で出している (終わるまで窓は出さない) */ if (g_UpdState == 2 && SplashOn() && !g_SplashLeaveT) return false; /* 起動の表示の中で聞いている */ const bool want = (g_UpdState >= 2 && g_UpdState <= 5 && !(g_UpdState == 5 && g_UpdMsg == 0)) || g_UpdState == 7 || g_UpdState == 8; if (want && !SplashOn()) SplashManual(); return false; } /* 窓は使わず、起動の表示の板を出す */
    static void UpdScale(int W, int H) {
        g_UpdOn = false;
        if (!UpdWanted()) return;
        const int uw = 500, uh = 190;
        if (uw > W - 8 || uh > H - 8) return;
        size_t off = ((static_cast<size_t>(g_SwW) * static_cast<size_t>(g_SwH) + 63u) & ~static_cast<size_t>(63u));
        if (g_SplOn) off = ((off + static_cast<size_t>(g_SplW) * static_cast<size_t>(g_SplH) + 63u) & ~static_cast<size_t>(63u));
        if (g_HudOn) off = ((off + static_cast<size_t>(g_HudW) * static_cast<size_t>(g_HudH) + 63u) & ~static_cast<size_t>(63u));
        if ((off + static_cast<size_t>(uw) * static_cast<size_t>(uh)) * 4u > kPixBytes) return;
        Cv v { g_Scratch + off, uw, uh, 0, 0 };
        /* メニュー / 起動の表示と同じ見た目: 暗い板 + グレーのふち、上に Inkdraw とバージョン、左にグラデーションの短い線、はい / いいえ は丸い札 */
        const Col edge { 0.30f, 0.31f, 0.33f }, wh { 0.96f, 0.97f, 0.98f }, dim { 0.55f, 0.57f, 0.62f }, okc { 0.55f, 0.92f, 0.62f }, ngc { 1.0f, 0.62f, 0.50f };
        for (int k = 0; k < uw * uh; k++) g_Scratch[off + k] = 0;
        SwRRect(v, 0, 0, uw, uh, 18.0f, edge);
        SwRRect(v, 1, 1, uw - 2, uh - 2, 17.0f, Col { 0.043f, 0.047f, 0.055f });
        auto grad = [&](int x0, int y0, int w, int h) { for (int x = 0; x < w; x++) { const float k = static_cast<float>(x) / static_cast<float>(w > 1 ? w - 1 : 1); SwRect(v, x0 + x, y0, 1, h, Col { 0.62f - 0.42f * k, 0.40f + 0.48f * k, 1.0f }); } };
        const menu_text::Str& T = menu_text::kTITLE;
        SwStr(v, T, 22, (52 - T.h) / 2, wh);
        { char o[32]; std::snprintf(o, sizeof(o), "%s", kInkVerName); SwU8(v, o, 22 + T.w + 12, (52 - font_glyphs::kLineH) / 2, 120, dim); }
        SwRect(v, 16, 51, uw - 32, 1, Col { 0.20f, 0.21f, 0.24f });
        auto head = [&](const char* t, Col c) { grad(22, 70, 5, 22); SwU8(v, t, 38, 68, uw - 60, c); };
        auto sub = [&](const char* t, int line) { SwU8(v, t, 38, 68 + font_glyphs::kLineH + 6 + line * (font_glyphs::kLineH + 4), uw - 60, dim); };
        auto btns = [&]() { /* はい / いいえ: 右下の丸い札 (起動の表示と同じ) */
            for (int k = 0; k < 2; k++) {
                const int bw = 116, bh = 36, bx = uw - 22 - (2 - k) * (bw + 12) + 12, by = uh - bh - 18; const bool sel = g_UpdSel == k;
                if (sel) { SwRRect(v, bx, by, bw, bh, 18.0f, Col { 0.62f, 0.45f, 1.0f }); SwRRect(v, bx + 2, by + 2, bw - 4, bh - 4, 16.0f, Col { 0.22f, 0.18f, 0.36f }); }
                else { SwRRect(v, bx, by, bw, bh, 18.0f, Col { 0.26f, 0.27f, 0.31f }); SwRRect(v, bx + 1, by + 1, bw - 2, bh - 2, 17.0f, Col { 0.075f, 0.080f, 0.095f }); }
                const char* t = k == 0 ? "はい" : "いいえ"; SwU8(v, t, bx + (bw - U8W(t)) / 2, by + (bh - font_glyphs::kLineH) / 2, bw, sel ? wh : dim);
            }
        };
        char b[96];
        const int st = g_UpdState;
        if (st == 2) {
            head("アップデートがあります", wh);
            std::snprintf(b, sizeof(b), "Ver %d  →  %d", kInkVer, static_cast<int>(g_UpdNew)); sub(b, 0);
            btns();
        } else if (st == 3) {
            head("ダウンロードしています", wh);
            const u32 tot = g_UpdTot, gotb = g_UpdGot;
            std::snprintf(b, sizeof(b), "%u KB / %u KB", static_cast<unsigned>(gotb / 1024), static_cast<unsigned>(tot / 1024)); SwU8R(v, b, uw - 22, 68, 200, dim);
            sub("電源を切らないでください", 0);
            const int bx = 22, bw = uw - 44, by = uh - 34, bh = 6;
            SwRRect(v, bx, by, bw, bh, 3.0f, Col { 0.16f, 0.15f, 0.22f });
            if (tot) { const u32 g2 = gotb > tot ? tot : gotb; const int len = static_cast<int>(static_cast<u64>(bw) * g2 / tot); if (len > 0) { for (int x = 0; x < len; x++) { const float k = static_cast<float>(x) / static_cast<float>(bw); SwRect(v, bx + x, by + (x < 3 || x > len - 4 ? 1 : 0), 1, bh - (x < 3 || x > len - 4 ? 2 : 0), Col { 0.62f - 0.42f * k, 0.40f + 0.48f * k, 1.0f }); } } }
        } else if (st == 7) {
            head("アップデート完了", okc);
            std::snprintf(b, sizeof(b), "Ver %d  今すぐ再起動しますか?", static_cast<int>(g_UpdNew)); sub(b, 0);
            btns();
        } else if (st == 4 || st == 8) {
            head("アップデート完了", okc);
            std::snprintf(b, sizeof(b), "Ver %d", static_cast<int>(g_UpdNew)); sub(b, 0); sub("ゲームを再起動すると反映されます", 1);
        } else {
            head("アップデート失敗", ngc);
            if (g_UpdErr == 41) std::snprintf(b, sizeof(b), "エラー 41 (%u / %u)", static_cast<unsigned>(g_UpdGotLen), static_cast<unsigned>(g_UpdWantLen)); else std::snprintf(b, sizeof(b), "エラー %d", static_cast<int>(g_UpdErr)); sub(b, 0);
            sub("今のまま遊べます", 1);
        }
        g_UpdX = (W - uw) / 2; g_UpdY = (H - uh) / 2; g_UpdW = uw; g_UpdH = uh; g_UpdOff = off * 4u; g_UpdOn = true;
    }
    bool SwPresent(void* tex, int W, int H) {
        if (!InitSw()) return false;
        if (g_TexFmt < 0) { g_TexFmt = g_Sw.texFmt(tex); g_TexFmtPub = g_TexFmt; }
        HudRefresh();
        if (g_UiMove) { g_UiX += static_cast<int>(g_LStickX * 10.0f); g_UiY -= static_cast<int>(g_LStickY * 10.0f); }
        u32 hsh = 2166136261u;
        auto mix = [&](u32 x) { hsh = (hsh ^ x) * 16777619u; };
        if (SplashOn()) mix(static_cast<u32>((NowTick() - g_SplashT0) / 320000ull)); mix(SplashOn() ? 1u : 0u);
        if (HudWanted()) { mix(static_cast<u32>(NowTick() / 1920000ull)); for (int k = 0; k < 4; k++) { float a, dd; if (HudRel(k, &a, &dd)) { mix(static_cast<u32>(static_cast<int>(a) + 1000)); mix(static_cast<u32>(dd)); } } mix(g_CamFOk ? 1u : 0u); mix(g_CdOff >= 0 ? 1u : 0u); mix(LiveValid() ? 1u : 0u); } /* 方位計: 1 秒に 10 回まで描き直す */
        mix(g_UiScale); mix(g_DtStep); mix(g_DtSample); mix(g_RstMsg && NowTick() - g_RstT < 57600000ull ? 1u : 0u); mix(g_FadeBusy ? static_cast<u32>(NowTick() / 192000ull) : 0u); mix(FuncVis() ? 1u : 0u); mix(g_MenuSel); mix(g_ModeOn); mix(g_PatchEnabled); mix(g_DrawEnabled); mix(g_PchPanel); mix(g_PchSel); mix(g_PchScroll);
        mix(g_TextOn); mix(g_NameOn); mix(g_CrashArm && NowTick() - g_CrashArmT < 3ull * 19200000ull ? 1u : 0u); mix(g_NameRnd); mix(g_NameRndIv); mix(g_NickHooked); for (const char* q = g_NameU8; *q; q++) mix(static_cast<u8>(*q)); mix(g_TextK); mix(g_TextMsg); for (const char* q = g_TextU8; *q; q++) mix(static_cast<u8>(*q)); mix(g_UiMove); mix(g_MenuOpen); mix(g_Cat); mix(g_TrkStage); mix(g_Jump); mix(g_FuncOn); { char b[24][64]; const int n = BuildFuncList(b); for (int i = 0; i < n; i++) for (const char* q = b[i]; *q; q++) mix(static_cast<u8>(*q)); } mix(g_FillPushed); mix(g_FillSeen); for (int q = 0; q < 24; q++) mix(static_cast<u32>(g_Fx[q])); mix(g_Force60); mix(g_Gsp); mix(g_GspCalls); mix(g_GspIdx); mix(g_ScareOn); mix(g_ScareInt); mix(g_ScareN); mix(static_cast<u32>(g_IntervalGame)); mix(g_Bunny); mix(g_BunnyMode); mix(g_InfoOn); mix(g_LaunchNw); mix(g_EmoteOn); mix(g_EmoFire); mix(g_SelPanel); mix(g_SelCur); mix(g_SelScroll); mix(g_ImgSel); mix(g_UzuStyle); mix(static_cast<u32>(g_FlyWalkD)); mix(g_LcState); if (g_AnimBusy) mix(static_cast<u32>(NowTick() / 480000ull)); if (g_MenuOpen && g_UiScale == 100) mix(static_cast<u32>(NowTick() / 1920000ull)); /* 光るふち: 1秒に10回 */ mix(g_MenuSel); mix(g_HaveTmpl); mix(g_LaunchLeft > 0); mix(g_LaunchPend); mix(g_WarpOn); mix(g_WarpHas[0]); mix(g_WarpHas[1]); mix(g_WarpHas[2]); mix(g_WarpHas[3]); mix(g_WarpMark); mix(g_BoxOn ? 1u : 0u); mix(g_BalOn ? 1u : 0u); mix(static_cast<u32>(g_BalN)); mix(static_cast<u32>(g_GyroRange)); mix(static_cast<u32>(g_LookRange)); mix(g_LookActive ? 1u : 0u); mix(static_cast<u32>(g_LookWhy)); mix(g_LookOn); mix(g_LookMsg); mix(static_cast<u32>(g_ScanStep)); mix(static_cast<u32>(g_ScanMsg)); mix(static_cast<u32>(g_UpdState)); mix(static_cast<u32>(g_AsStep)); mix(static_cast<u32>(g_Ft2Step)); mix(static_cast<u32>(g_UpdState)); mix(static_cast<u32>(g_UpdSel)); mix(g_EnOn ? 1u : 0u); mix(static_cast<u32>(g_CircR)); mix(g_CircOn ? 1u : 0u); mix(g_LineOn ? 1u : 0u); mix(static_cast<u32>(g_LeadLv)); mix(static_cast<u32>(g_AimTgt)); mix(static_cast<u32>(g_Fx[4])); mix(static_cast<u32>(g_FovLv)); mix(static_cast<u32>(g_FovSel)); mix(static_cast<u32>(g_FovN)); mix(static_cast<u32>(g_EnWarpMsg)); mix(static_cast<u32>(g_WarpMsg)); mix(g_WarpReq ? 1u : 0u); mix(static_cast<u32>(g_WarpHold > 0)); mix(g_LookAHold ? 1u : 0u); mix(static_cast<u32>(g_LookRange)); mix(static_cast<u32>(g_LookSlot)); mix(static_cast<u32>(g_EnN)); mix(static_cast<u32>(g_Ft2Grp)); mix(g_Ft2Wait ? 1u : 0u); mix(static_cast<u32>(g_AsSample)); mix(static_cast<u32>(g_AsN)); mix(static_cast<u32>(g_UpdSel)); mix(static_cast<u32>(g_UpdGot / 16384u)); mix(static_cast<u32>(g_UpdMsg)); mix(static_cast<u32>(g_ScanRel)); mix(static_cast<u32>(g_LookSlot)); mix(g_ImgRot); mix(g_ResvHave); mix(g_ResvMsg); mix(g_ResvReq); mix(g_WarpMsg); mix(g_WarpHold > 0 || g_WarpHoldL > 0); mix(g_WarpReq || g_WarpSaveReq); mix(g_TrW); mix(g_TrP); mix(g_MenuCol); mix(g_MemPanel); mix(g_MemSel); mix(g_MemType); mix(static_cast<u32>(g_MemBase)); mix(static_cast<u32>(g_MemBase >> 32)); if (g_MemPanel) mix(static_cast<u32>(NowTick() / 3200000ull)); /* メモリサーチ中は 1 秒に 6 回描き直す */ mix(g_BlinkOn); mix(g_Genki); mix(g_CleanSel); mix(g_DrawTeam); mix(g_FreeCam); mix(g_RespawnState); mix(static_cast<u32>(g_RespIdx)); mix(g_ImgK); mix(g_InkSz); mix(static_cast<u32>(g_LogClrState)); mix(g_HSpd); mix(g_HState); mix(g_HCalls / 16u); mix(g_Trail ? 1u : 0u); mix(static_cast<u32>(g_TrailWhy)); mix(static_cast<u32>(g_TrailN / 8)); mix(static_cast<u32>(g_SpdMul * 100.0f)); mix(g_SpdObj != 0); mix(static_cast<u32>(g_SpdGrp)); mix(g_Flk ? 1u : 0u); mix(g_Wall ? 1u : 0u); mix(g_Ruler ? 1u : 0u); mix(g_CamFOk ? 1u : 0u); mix(g_UiScale); mix(g_AnimBusy ? 1u : 0u); mix(g_SlideBusy ? 1u : 0u); mix(W); mix(H);
        for (int i = 0; i < g_GrpN; i++) mix(g_Grp[i].on ? 1u : 0u);
        if (hsh == g_SwHash && g_ScaleRough && NowTick() - g_ScaleT >= 1920000ull) { g_ScaleRough = false; g_SwHash = hsh ^ 1u; } /* 止まったら、きれいな計算で 1 回描き直す */
        if (hsh != g_SwHash) {
            g_SwHash = hsh;
            SwDrawMenu(W, H);
            SwScale(W, H);
            SplashScale(W, H);
            HudScale(W, H);
            UpdScale(W, H);
            g_SwCur ^= 1;
            /* 描いた場所がそのまま次の 1 枚 */
