        if (!g_MenuOpen && !MenuClosing()) {
            /* メニューを閉じていて「関数表示」だけ出す */
            int fw = 0, fh = 0;
            g_BaseRectN = 0;
            { char bb[24][64]; const int nn = BuildFuncList(bb); g_BaseW = 308; g_BaseH = 46 + 30 * (nn > 0 ? (nn > 16 ? 16 : nn) : 16) + 18; g_FuncMenuA = 8; } /* 消えていく間は中身が変わらないので、大きめに */ /* 実際の行の数だけ (むだに大きく塗らない) */
            Cv v0 { g_Base, g_BaseW, g_BaseH, 0, 0 };
