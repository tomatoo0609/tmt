                    for (size_t i = a; i < b && n < cap; i++) {
                        float x; std::memcpy(&x, w + i, 4); const float dx = x - mx; if (!(dx < 3.0f && dx > -3.0f)) continue;
                        float z; std::memcpy(&z, w + i + 2, 4); const float dz = z - mz; if (!(dz < 3.0f && dz > -3.0f)) continue;
                        float y; std::memcpy(&y, w + i + 1, 4); const float dy = y - fy; if (!(dy < 3.0f && dy > -1.5f)) continue;
                        const uintptr_t at = mi.addr + i * 4; u32 vtRel = 0xFFFFFFFFu, off = 0;
                        for (u32 back = 0; back <= 0x400; back += 8) { /* 前にある、main の中を指す値 (vtable らしい物) */
