        const int states[kMenuItems] = { (g_ModeOn && !g_FlyQuiet) ? 1 : 0, (g_Jump & 1) ? 1 : 0, (g_Jump & 2) ? 1 : 0, -1, -1, -1, -1, -1, -1, g_BlinkOn ? 1 : 0, g_PatchEnabled ? 1 : 0, -1, -1, -1, -1, g_Bunny ? 1 : 0, -1, g_EmoteOn ? 1 : 0, g_InfoOn ? 1 : 0, (g_Fx[0] ? 1 : 0), (g_Fx[1] ? 1 : 0), (g_Fx[2] ? 1 : 0), (g_Fx[3] ? 1 : 0), (g_Fx[4] ? 1 : 0), (g_Fx[5] ? 1 : 0), (g_Fx[6] ? 1 : 0), (g_Fx[7] ? 1 : 0), (g_Fx[8] ? 1 : 0), (g_Fx[9] ? 1 : 0), (g_Fx[10] ? 1 : 0), (g_Fx[11] ? 1 : 0), (g_Fx[12] ? 1 : 0), -1, -1, (g_Fx[15] ? 1 : 0), (g_Fx[16] ? 1 : 0), (g_Fx[17] ? 1 : 0), (g_Fx[18] ? 1 : 0), (g_Fx[19] ? 1 : 0), (g_Fx[20] ? 1 : 0), (g_Fx[21] ? 1 : 0), -1, g_Force60 ? 1 : 0, -1 };
        auto drawRows = [&](int pageCat, int x0, int selJ, bool active) {
        const int MW = pageCat < 0 ? MWt : MWc0; /* メインメニューだけ細い */
        int cnt = 0; if (pageCat < 0) cnt = kCatCount; else cnt = CatCount(pageCat);
        int pOff = 0; /* pchtxt の一覧: 多いときは 12 行ぶんの窓を、選んでいる行のまわりに出す */
        if (pageCat == kPchCat && cnt > kPchVis) {
            const int total = cnt; pOff = (active ? selJ : 0) - kPchVis / 2; if (pOff < 0) pOff = 0; if (pOff > total - kPchVis) pOff = total - kPchVis;
            selJ -= pOff; cnt = kPchVis;
            const int trackH = rowH * kPchVis, thumbH = (trackH * kPchVis / total) < 16 ? 16 : (trackH * kPchVis / total), thumbY = (trackH - thumbH) * pOff / (total - kPchVis);
            SwRRect(v, x0 + MW - 5, y0 + head + thumbY, 3, thumbH, 1.5f, Col { 0.38f, 0.40f, 0.45f });
        }
        SwRect(v, x0 + 12, y0 + head - 6, MW - 24, 1, border);
        if (!active) { if (selJ >= 0 && selJ < cnt) SwRRect(v, x0 + 6, y0 + head + rowH * selJ + 1, MW - 12, rowH - 2, 12.0f, Col { 0.16f, 0.17f, 0.19f }); }
        else {
            /* 選択の帯は、前の位置から今の位置へなめらかに滑らせる (時間で動く) */
            static float aY = -1.0f; static u64 aT = 0; static int aCat = -99; static int aSel = -1;
            const float tgt = static_cast<float>(y0 + head + rowH * selJ);
            const u64 nowA = NowTick();
            if (aY < 0.0f || aCat != g_Cat || (nowA - aT) > 19200000ull) aY = tgt;
            else { float dt = static_cast<float>(nowA - aT) / 19200000.0f; float k = dt * 16.0f; if (k > 1.0f) k = 1.0f; aY += (tgt - aY) * k; if (aY - tgt < 0.6f && tgt - aY < 0.6f) aY = tgt; }
            aT = nowA; aCat = g_Cat; aSel = selJ; (void)aSel;
            g_AnimBusy = (aY != tgt) || g_SlideBusy;
            if (selJ >= 0 && selJ < cnt) {
                const int yy = static_cast<int>(aY);
                SwRRect(v, x0 + 6, yy + 1, MW - 12, rowH - 2, 12.0f, side ? Col { 0.16f, 0.17f, 0.19f } : selBg);
            }
        }
        for (int j = 0; j < cnt; j++) {
            const int i = pageCat < 0 ? (j >= kCatCount ? kDynUpd : 100 + kTopOrder[(j) % kCatCount]) : CatItem(pageCat, j + pOff);
            const int y = y0 + head + rowH * j;
            const bool sel = (selJ == j) && !side && active;
