struct TTpl { const TStroke* s; int n; int total; };
static constexpr TTpl kTplEx[20] = { { kTs0, 51, 963 }, { kTs1, 53, 1082 }, { kTs2, 48, 959 }, { kTs3, 27, 741 }, { kTs4, 26, 551 }, { kTs5, 24, 672 }, { kTs6, 26, 873 }, { kTs7, 19, 735 }, { kTs8, 14, 877 }, { kTs9, 19, 773 }, { kTs10, 11, 788 }, { kTs11, 50, 623 }, { kTs12, 20, 731 }, { kTs13, 31, 1329 }, { kTs14, 24, 725 }, { kTs15, 12, 666 }, { kTs16, 32, 852 }, { kTs17, 25, 979 }, { kTs18, 17, 568 }, { kTs19, 28, 706 } };
    static void TplOpen(const float* p, int n, float u, float& x, float& y) { /* 開いた折れ線 */
        float tot = 0.0f; for (int i = 0; i + 1 < n; i++) { const float dx = p[i * 2 + 2] - p[i * 2], dy = p[i * 2 + 3] - p[i * 2 + 1]; tot += __builtin_sqrtf(dx * dx + dy * dy); }
        float d = u * tot;
        for (int i = 0; i + 1 < n; i++) { const float dx = p[i * 2 + 2] - p[i * 2], dy = p[i * 2 + 3] - p[i * 2 + 1]; const float l = __builtin_sqrtf(dx * dx + dy * dy); if (d <= l || i == n - 2) { const float t = l > 1e-6f ? d / l : 0.0f; x = p[i * 2] + dx * t; y = p[i * 2 + 1] + dy * t; return; } d -= l; }
    }
    static int TplStages(int s) { static const int k[10] = { 5, 3, 5, 6, 3, 3, 3, 2, 3, 3 }; s %= kTplN; return s >= 10 ? kTplEx[s - 10].n : k[s]; }
    static int TplTotal(int s) { s %= kTplN; return s >= 10 ? kTplEx[s - 10].total : TplStages(s) * kUzuPer; }
    static void TplPoly(const float* p, int n, float u, float& x, float& y) { /* 閉じた折れ線を、長さにそって進む */
        float tot = 0.0f; for (int i = 0; i < n; i++) { const int j = (i + 1) % n; const float dx = p[j * 2] - p[i * 2], dy = p[j * 2 + 1] - p[i * 2 + 1]; tot += __builtin_sqrtf(dx * dx + dy * dy); }
        float d = u * tot;
        for (int i = 0; i < n; i++) { const int j = (i + 1) % n; const float dx = p[j * 2] - p[i * 2], dy = p[j * 2 + 1] - p[i * 2 + 1]; const float l = __builtin_sqrtf(dx * dx + dy * dy); if (d <= l || i == n - 1) { const float t = l > 1e-6f ? d / l : 0.0f; x = p[i * 2] + dx * t; y = p[i * 2 + 1] + dy * t; return; } d -= l; }
    }
    static void TplStar(float u, float R, float r, int pts, float rot, float& x, float& y) { /* 星形 (外 R、内 r) */
        float p[24]; for (int i = 0; i < pts * 2 && i < 12; i++) { const float a = rot + static_cast<float>(i) * 3.1415927f / static_cast<float>(pts); const float rr = (i & 1) ? r : R; p[i * 2] = rr * UzuCos(a); p[i * 2 + 1] = rr * UzuSin(a); }
        TplPoly(p, pts * 2, u, x, y);
    }
    static void TplPt(int sty, int stg, int sj, float& ox, float& oy) {
        const float TP = 6.2831853f, S = 10.5f; const float u = static_cast<float>(sj) / static_cast<float>(kUzuPer);
        float x = 0.0f, y = 0.0f; const int st = sty % kTplN;
        if (st >= 10) {
            const TTpl& tp = kTplEx[st - 10]; const int cc = stg * kUzuPer + sj; int ki = 0, start = 0;
            while (ki < tp.n - 1 && cc >= tp.s[ki].end) { start = tp.s[ki].end; ki++; }
            const TStroke& k = tp.s[ki]; const float uu = static_cast<float>(cc - start) / static_cast<float>(k.end - start);
            if (k.kind == 'e') { x = k.p[0] + k.p[2] * UzuCos(uu * 6.2831853f); y = k.p[1] + k.p[3] * UzuSin(uu * 6.2831853f); }
            else if (k.kind == 'p') TplPoly(k.p, k.n, uu, x, y);
            else TplOpen(k.p, k.n, uu, x, y);
        } else if (st == 0) { /* ハート: 大きさの違う 5 つが重なる */
            const float th = u * TP, sc = 1.0f - 0.17f * static_cast<float>(stg);
            const float c1 = UzuCos(th), c2 = UzuCos(2 * th), c3 = UzuCos(3 * th), c4 = UzuCos(4 * th), s1 = UzuSin(th);
            x = 16.0f * s1 * s1 * s1 / 17.0f * sc; y = -(13.0f * c1 - 5.0f * c2 - 2.0f * c3 - c4) / 17.0f * sc + 0.06f;
        } else if (st == 1) { /* 稲妻 */
            static const float p[] = { 0.30f,-1.0f, -0.50f,0.12f, -0.06f,0.12f, -0.34f,1.0f, 0.52f,-0.22f, 0.06f,-0.22f };
            const float sc = 1.0f - 0.09f * static_cast<float>(stg); TplPoly(p, 6, u, x, y); x *= sc; y *= sc;
        } else if (st == 2) { /* 魔法陣: 外の輪 2 つ + 六芒星 + 内側の輪 */
            if (stg == 0) { x = UzuCos(u * TP); y = UzuSin(u * TP); }
            else if (stg == 1) { x = 0.9f * UzuCos(u * TP); y = 0.9f * UzuSin(u * TP); }
            else if (stg == 2) { TplStar(u, 0.9f, 0.52f, 6, -1.5707963f, x, y); }
            else if (stg == 3) { x = 0.45f * UzuCos(u * TP); y = 0.45f * UzuSin(u * TP); }
            else { x = 0.16f * UzuCos(u * TP); y = 0.16f * UzuSin(u * TP); }
        } else if (st == 3) { /* 蝶 (バタフライ曲線) */
            const float th = (static_cast<float>(stg * kUzuPer + sj) / static_cast<float>(6 * kUzuPer)) * 12.0f * 3.1415927f;
            const float a = (2.0f * th - 3.1415927f) / 24.0f, sa = UzuSin(a);
            float ex = 1.0f; { const float s = UzuSin(th); ex = 1.0f + s + s * s * 0.5f + s * s * s / 6.0f + s * s * s * s / 24.0f; if (s < -0.5f) ex = 0.45f + 0.8f * (s + 1.0f); }
            const float r = ex - 2.0f * UzuCos(4.0f * th) + sa * sa * sa * sa * sa;
            x = UzuSin(th) * r / 4.3f; y = -UzuCos(th) * r / 4.3f + 0.15f;
        } else if (st == 4) { /* 三日月と星 */
            if (stg < 2) {
                const float sc = 1.0f - 0.07f * static_cast<float>(stg);
                if (u < 0.5f) { const float a = 0.75f + (u * 2.0f) * (TP - 1.5f); x = sc * UzuCos(a); y = sc * UzuSin(a); }
                else { const float a = (TP - 0.75f) - ((u - 0.5f) * 2.0f) * (TP - 1.5f) ; x = sc * (0.42f + 0.80f * UzuCos(a)); y = sc * 0.80f * UzuSin(a); }
                x -= 0.2f;
            } else { TplStar(u, 0.30f, 0.12f, 5, -1.5707963f, x, y); x += 0.62f; y -= 0.55f; }
        } else if (st == 5) { /* 桜 */
            const float sc = 1.0f - 0.28f * static_cast<float>(stg);
            const float th = u * TP * 2.0f, c = UzuCos(2.5f * th); const float r = (c < 0 ? -c : c) * 0.85f + 0.15f; x = sc * r * UzuSin(th); y = -sc * r * UzuCos(th);
        } else if (st == 6) { /* 手裏剣 */
            if (stg < 2) { const float sc = 1.0f - 0.16f * static_cast<float>(stg); TplStar(u, 1.0f * sc, 0.30f * sc, 4, 0.7853982f, x, y); }
            else { x = 0.15f * UzuCos(u * TP); y = 0.15f * UzuSin(u * TP); }
        } else if (st == 7) { /* 王冠 */
            static const float p[] = { -1.0f,0.55f, -1.0f,-0.55f, -0.5f,0.0f, 0.0f,-0.8f, 0.5f,0.0f, 1.0f,-0.55f, 1.0f,0.55f };
            if (stg == 0) TplPoly(p, 7, u, x, y); else { x = -1.0f + u * 2.0f; y = 0.8f - 0.1f * UzuSin(u * 3.1415927f * 6.0f) * 0.0f; }
        } else if (st == 8) { /* 目 */
            if (stg == 0) { const float t2 = u < 0.5f ? u * 2.0f : (1.0f - u) * 2.0f; x = -1.0f + 2.0f * t2; const float h = 0.55f * (1.0f - x * x); y = u < 0.5f ? -h : h; }
            else if (stg == 1) { x = 0.38f * UzuCos(u * TP); y = 0.38f * UzuSin(u * TP); }
            else { x = 0.16f * UzuCos(u * TP); y = 0.16f * UzuSin(u * TP); }
        } else { /* 剣 */
            if (stg == 0) { static const float p[] = { 0.0f,-1.0f, 0.13f,-0.72f, 0.13f,0.28f, -0.13f,0.28f, -0.13f,-0.72f }; TplPoly(p, 5, u, x, y); }
            else if (stg == 1) { static const float p[] = { -0.45f,0.28f, 0.45f,0.28f, 0.45f,0.40f, -0.45f,0.40f }; TplPoly(p, 4, u, x, y); }
            else { if (u < 0.6f) { static const float p[] = { -0.06f,0.40f, 0.06f,0.40f, 0.06f,0.82f, -0.06f,0.82f }; TplPoly(p, 4, u / 0.6f, x, y); } else { const float a = (u - 0.6f) / 0.4f * TP; x = 0.1f * UzuCos(a); y = 0.92f + 0.1f * UzuSin(a); } }
        }
        ox = -x * S; oy = y * S; /* 横は、絵と同じ向きにそろえる */
    }
    /* インクの道: 進む向きの少し前にインクを置く (frame206 と同じ動き。人のときも出す) */
    static void TrailTick() {
        static u64 lastT = 0; static float prev[2] = {}; static bool hp = false;
        if (!g_Trail) { hp = false; return; }
        if (g_BaseTick == 0 && !g_HaveTmpl) { g_TrailWhy = 1; hp = false; return; }
        if (g_Cursor >= 0) { g_TrailWhy = 6; hp = false; return; }
        const PaintRequest& B = g_BaseTick != 0 ? g_Base : g_Tmpl; const u64 B0 = g_BaseTick != 0 ? g_BaseTick : g_TmplTick;
        const u64 now = NowTick(); if (now - lastT < 640000ull) return; lastT = now;
        static u64 failT = 0; if (now < failT) return;
        float L[3];
        if (!GetPlayerPos(L)) { g_TrailWhy = 3; failT = now + 19200000ull; return; } /* 1 秒後にまた試す */
        const float px = L[0], py = L[1];
        if (!hp) { prev[0] = px; prev[1] = py; hp = true; return; }
        const float dx = px - prev[0], dy = py - prev[1];
        prev[0] = px; prev[1] = py;
        const float d = __builtin_sqrtf(dx * dx + dy * dy);
        const float ax = d > 0.05f ? dx / d * 1.6f : 0.0f, ay = d > 0.05f ? dy / d * 1.6f : 0.0f; /* 進む向きの少し前 */
        if (!PaintQueueRoom()) { g_TrailWhy = 5; return; }
        PaintRequest req = B;
        u32 seq; std::memcpy(&seq, B.raw + 4, 4); u64 bt = B0;
        if (g_HaveSeq && g_SeqTick > bt) { seq = g_SeqRef; bt = g_SeqTick; }
        { static u64 lastF = 0; static u64 lastFT = 0; const bool framesOk = g_CntFrame != lastF || NowTick() - lastFT < 9600000ull; if (g_CntFrame != lastF) { lastF = g_CntFrame; lastFT = NowTick(); }
          if (g_HaveSeq && bt == g_SeqTick && framesOk && !g_FrameFallback && g_CntFrame >= g_SeqFrame) seq += static_cast<u32>(g_CntFrame - g_SeqFrame) + 30u; /* ゲームのフレームを数える (ずれない) */
          else { const u32 el = static_cast<u32>((NowTick() - bt) / g_SeqTpf); u32 lead = el / 200u; if (lead > 300u) lead = 300u; seq += el + 30u + lead; } } /* フレームが数えられないときは、今までどおり時間から */
        std::memcpy(req.raw + 4, &seq, 4);
        float ox2 = 0.0f, oy2 = 0.0f; int reps = 1; /* 道の模様: 進む向きに直角にずらす */
        if (d > 0.05f) { const float nx = -dy / d, ny = dx / d;
            if (g_TrP == 2) { const float sg = (g_TrailN & 1) ? 1.2f : -1.2f; ox2 = nx * sg; oy2 = ny * sg; } /* ジグザグ */
            if (g_TrP == 3) { ox2 = nx * 1.1f; oy2 = ny * 1.1f; reps = 2; } /* 二本線 */
        }
        if (g_TrP == 1 && ((g_TrailN / 2) & 1)) { g_TrailN = g_TrailN + 1; return; } /* 点線: 2 回出して 2 回休む */
        { const float tw = (g_TrW == 0 ? 0.8f : (g_TrW == 2 ? 2.4f : 1.5f)) * (reps == 2 ? 0.6f : 1.0f); const float size[2] = { tw, tw }; std::memcpy(req.raw + kOffSize, size, sizeof(size)); } /* 道の太さ */
        static const float kZo[6] = { 0.0f, -0.6f, 0.6f, 1.4f, 2.6f, 3.8f }; /* イカのときは体の高さがちがうので、いくつかの高さに出す */
        for (int rp = 0; rp < reps; rp++) for (int zi = 0; zi < 6; zi++) {
            if (rp && !PaintQueueRoom()) break;
            const float sg2 = rp ? -1.0f : 1.0f;
            const float pos[3] = { px + ax + ox2 * sg2, py + ay + oy2 * sg2, L[2] + kZo[zi] };
            std::memcpy(req.raw + kOffPos, pos, sizeof(pos));
            { /* 床の番号: 4 秒以内に見たものを優先、なければ 40 秒以内で高さの近いもの */
                const u64 nowT = NowTickF(); int best = -1, old = -1; float bd = 1e9f, bo = 1e9f;
                for (int k = 0; k < g_FlN; k++) {
                    const u64 age = nowT - g_FlT[k];
                    if (age > 768000000ull) continue;
                    const float fx = g_FlS[k][0] - pos[0], fy = g_FlS[k][1] - pos[1], fz = g_FlS[k][2] - pos[2];
                    if (fz > 4.0f || fz < -4.0f) continue;
                    const float fd = fx * fx + fy * fy + fz * fz * 4.0f;
                    if (age <= 76800000ull) { if (fd < 144.0f && fd < bd) { bd = fd; best = k; } }
                    else if (fz > -1.5f && fz < 1.5f && fd < 36.0f && fd < bo) { bo = fd; old = k; }
                }
                if (best < 0) best = old;
                if (best >= 0) { const u16 fid = g_FlId[best]; req.raw[0x3e] = static_cast<u8>(fid & 255); req.raw[0x3f] = static_cast<u8>(fid >> 8); }
            }
            SendOne(&req);
        }
        g_TrailWhy = ((NowTick() - bt) > 19200000ull * 90ull) ? 7 : 0; g_TrailN = g_TrailN + 1;
    }
    static void EnInkTick() { /* 相手の座標の下にインクを塗る: インクの道と同じ塗りの頼み方で、敵の足元に出す */
        if (!g_EnInkOn || g_Cursor >= 0) return;
        if (g_BaseTick == 0 && !g_HaveTmpl) { g_EnInkWhy = 1; return; } /* 塗りの見本がまだない (一度塗ると取れる) */
        const u64 now = NowTick(); static u64 lastT = 0; if (now - lastT < 1920000ull) return; lastT = now; /* 0.1 秒ごと */
        float me[3]; if (!SelfPos(me)) { g_EnInkWhy = 2; return; }
        int ks[4]; float ds[4]; int nk = 0; /* 近い敵 4 人 */
        for (int k = 0; k < g_EnN && k < kEnMaxFwd; k++) { float e[3]; if (!EnPos(k, e) || !EnMovedOnce(k)) continue; const float dx = e[0] - me[0], dz = e[2] - me[2], d = dx * dx + dz * dz;
            int pos = nk; while (pos > 0 && ds[pos - 1] > d) pos--; if (pos >= 4) continue; const int last = nk < 4 ? nk : 3; for (int q = last; q > pos; q--) { ks[q] = ks[q - 1]; ds[q] = ds[q - 1]; } ks[pos] = k; ds[pos] = d; if (nk < 4) nk++; }
        g_EnInkN = nk; if (nk == 0) { g_EnInkWhy = 3; return; } g_EnInkWhy = 0;
        const PaintRequest& B = g_BaseTick != 0 ? g_Base : g_Tmpl; const u64 B0 = g_BaseTick != 0 ? g_BaseTick : g_TmplTick;
        for (int j = 0; j < nk; j++) {
            float e[3]; if (!EnPos(ks[j], e)) continue;
            for (int zi = 0; zi < 3; zi++) {
                if (!PaintQueueRoom()) { g_EnInkWhy = 4; return; }
                PaintRequest req = B; u32 seq; std::memcpy(&seq, B.raw + 4, 4); u64 bt = B0;
                if (g_HaveSeq && g_SeqTick > bt) { seq = g_SeqRef; bt = g_SeqTick; }
                if (g_HaveSeq && bt == g_SeqTick && !g_FrameFallback && g_CntFrame >= g_SeqFrame) seq += static_cast<u32>(g_CntFrame - g_SeqFrame) + 30u;
                else { const u32 el = static_cast<u32>((NowTick() - bt) / g_SeqTpf); u32 lead = el / 200u; if (lead > 300u) lead = 300u; seq += el + 30u + lead; }
                std::memcpy(req.raw + 4, &seq, 4);
                const float size[2] = { 1.5f, 1.5f }; std::memcpy(req.raw + kOffSize, size, sizeof(size));
                static const float kZe[3] = { 0.0f, 0.6f, -0.6f };
                const float pos[3] = { e[0], -e[2], e[1] + kZe[zi] }; std::memcpy(req.raw + kOffPos, pos, sizeof(pos)); /* 塗りの座標: (x, -z, 高さ) */
                { const s32 kind = kKindPoint; std::memcpy(req.raw + kOffKind, &kind, sizeof(kind)); req.raw[0x3e] = 0xFF; req.raw[0x3f] = 0xFF; req.raw[0x48] = 0xFF; req.raw[kOffObjFlag] = 0; } /* 絵を描くと同じ: 床を選ばない点の塗り (敵の足元の床の番号は分からない) */
                SendOne(&req); g_EnInkSent = g_EnInkSent + 1;
            }
        }
    }
    /* 絵のまわりの星: 小さい星 14 個 (中心と上下左右の 5 点) と、流れ星 3 本 (尾を引く 7 点)。絵の四角の外側だけに置き、絵と重ならないようにする。 */
    static constexpr int kStarN = 14, kShootN = 3, kStarPts = kStarN * 5 + kShootN * 7;
    static void StarPt(int s, float hx, float hy, float* ox, float* oy, float* sz) {
        auto hs = [](u32 k) { k ^= k >> 16; k *= 0x7feb352du; k ^= k >> 15; k *= 0x846ca68bu; k ^= k >> 16; return static_cast<float>(k & 0xFFFF) / 65535.0f; };
        const float kTwoPi = 6.2831853f;
        float ang, mar, tx = 0.0f, ty = 0.0f, dx = 0.0f, dy = 0.0f, size = 0.55f;
        if (s < kStarN * 5) {
            const int k = s / 5, j = s % 5;
            ang = (static_cast<float>(k) + 0.15f + 0.7f * hs(static_cast<u32>(k) * 7u + 1u)) / static_cast<float>(kStarN) * kTwoPi;
            mar = 2.4f + 3.0f * hs(static_cast<u32>(k) * 7u + 2u);
            static const float kA[5][2] = { {0, 0}, {0.55f, 0}, {-0.55f, 0}, {0, 0.55f}, {0, -0.55f} };
            dx = kA[j][0]; dy = kA[j][1]; size = j == 0 ? 0.7f : 0.5f;
        } else {
            const int q = s - kStarN * 5, k = q / 7, j = q % 7;
            ang = (static_cast<float>(k) + 0.5f) / static_cast<float>(kShootN) * kTwoPi + 0.9f; /* 小さい星の間に入るようにずらす */
            mar = 6.5f + 2.0f * hs(static_cast<u32>(k) * 11u + 5u);
            /* 尾は中心へ向かって 3.6 まで。内側の端でも絵から 2.9 以上離れる */
            const float ca = __builtin_cosf(ang), sa = __builtin_sinf(ang);
            const float t = static_cast<float>(j) * 0.6f;
            dx = -ca * t; dy = -sa * t; size = 0.85f - 0.06f * static_cast<float>(j);
        }
        const float ca = __builtin_cosf(ang), sa = __builtin_sinf(ang);
        const float ax = ca < 0 ? -ca : ca, ay = sa < 0 ? -sa : sa;
        float t = 1e9f;
        if (ax > 1e-4f) t = (hx + mar) / ax;
        if (ay > 1e-4f && (hy + mar) / ay < t) t = (hy + mar) / ay; /* 絵の四角を mar だけ広げた枠の上に置く */
        tx = ca * t; ty = sa * t;
        *ox = tx + dx; *oy = ty + dy; *sz = size;
    }
    static void EmitDots(int budget) {
        const int pixels = g_W * g_H;
        const int kFeet = 0; /* 絵の前に、足元を小さく塗る (足元を塗ってから描くと出やすいため) */
        const bool starsOn = false; /* 絵のまわりの星はやめた (インクの道のまわりに出す) */
        const int mainTot = (g_SpiralRun ? TplTotal(g_UzuStyle) : pixels * kPasses) + kFeet;
        const int total  = mainTot + (starsOn ? kStarPts : 0);

        g_Emitting = true; g_DgTotal = total;
        /* 絵の大きさは、長い辺がニコニコ (32 ドット x 0.7) と同じ 22.4 になるようにそろえる。
           細かい絵ほど点の間隔と点の大きさを小さくして、なめらかにする。 */
        const int longSide = g_W > g_H ? g_W : g_H;
        float step = longSide > 0 ? (32.0f * kStep) / static_cast<float>(longSide) : kStep;
        if (g_TextImg && g_FillMode == 0) { static const float kTk[4] = { 1.6f, 2.4f, 3.4f, 4.8f }; step *= kTk[(g_TextK - 1) & 3]; }
        const float kImgF[4] = { 0.25f, 0.5f, 0.75f, 1.0f };
        static const float kNtab[8] = { 0.25f, 0.4f, 0.6f, 1.0f, 2.0f, 3.0f, 4.0f, 5.0f }; /* 絵の大きさ 1〜8 (4 = 前の「1」。1〜3 はそれより小さい) */
        const float kN = kNtab[(g_ImgK < 1 ? 1 : (g_ImgK > 8 ? 8 : g_ImgK)) - 1];
        if (g_FillMode == 0) step *= g_SpiralRun ? 0.5f : 0.5f * kN;
        float dot = step * (kDotSize / kStep);
        if (dot < (g_ImgK < 6 && g_FillMode == 0 ? 0.4f : 0.55f)) dot = (g_ImgK < 6 && g_FillMode == 0 ? 0.4f : 0.55f);
        if (g_FillMode == 0) { const int isz = g_InkSz < 1 ? 1 : (g_InkSz > 5 ? 5 : g_InkSz); dot *= (7.0f + static_cast<float>(isz - 1) * 1.75f) / 5.0f; /* 7 より小さいと点が出にくいので、いちばん小さくても 7 の大きさ */ if (dot < 0.12f) dot = 0.12f; } /* インクの大きさ: 5 がこれまで。1 でその 1/5 */
        if (g_SpiralRun && g_FillMode == 0) dot *= kN; /* テンプレートは、大きさに合わせて点も大きくする */
        if (g_TextImg && g_FillMode == 0) { static const float kTf[5] = { 0.3f, 0.45f, 0.6f, 0.8f, 1.0f }; const int isz = g_InkSz < 1 ? 1 : (g_InkSz > 5 ? 5 : g_InkSz); dot = step * (kDotSize / kStep) * kTf[isz - 1]; if (dot < 0.12f) dot = 0.12f; } /* 文字の絵: インクの大きさ 1〜5 で点の大きさも変わる */
        const bool fill = g_FillMode != 0;
        if (g_FillMode == 1) { step = 3.0f; dot = 3.2f; }
        if (g_FillMode == 2) { step = 5.0f; dot = 10.0f; } /* 隙間なし: 点を大きくして、重ねて塗る */ /* 全塗り: 大きめの点を並べて、床を一面塗る */ /* 点を大きくしすぎると、となりの点とつながって形がくずれる (ブロック状になる) ので、間隔に見合った大きさにする */
        /* 友達の画面が落ちないように: 1フレームに送る点を少なくし、上の行から少しずつ、区切りごとに休む */
        /* 全塗り(隙間あり)だけ、友達の画面が落ちないように時計でゆっくり出す。絵を描くときは待ち時間なし。 */
        {
            static u64 lastT = 0; static int frameDots = 0; static int batchDots = 0; static u64 pauseUntil = 0;
            const u64 nowT = NowTick();
            if (nowT - lastT > 320000ull) { lastT = nowT; frameDots = 0; } /* 約 1/60 秒ごとに数え直す */
            if (nowT < pauseUntil) { g_Emitting = false; return; }
            const int kPerFrame = fill ? 2 : 3, kBatch = 60; /* 絵も 1/60 秒に 6 点まで: 友達の画面が落ちないように */
            if (budget > kPerFrame - frameDots) budget = kPerFrame - frameDots;
            if (budget <= 0) { g_Emitting = false; return; }
            frameDots += budget;
            batchDots += budget;
            if (fill && batchDots >= kBatch) { batchDots = 0; pauseUntil = nowT + 9600000ull; } /* 60 個ごとに 0.5 秒休む */
        }
        while (g_Cursor < total && budget > 0) {
            if (!PaintQueueRoom()) { g_DgQFull++; break; } /* 次のフレームに続きを出す */
            const int c0 = g_Cursor++;
            if (c0 < kFeet) {
                PaintRequest fr = g_Base;
                u32 seq; std::memcpy(&seq, g_Base.raw + 4, 4);
                u64 bt = g_BaseTick;
                if (g_HaveSeq && g_SeqTick > bt) { seq = g_SeqRef; bt = g_SeqTick; }
                seq += static_cast<u32>((NowTick() - bt) / g_SeqTpf) + 30u + SeqLeadCap((NowTick() - bt) / g_SeqTpf); /* 時間がたつほど、ずれの分 (2%) も先にする */ /* 少し先の番号にして、ずれても「古い塗り」にならないようにする */
                std::memcpy(fr.raw + 4, &seq, 4);
                const float fp[3] = { g_Origin[0] + static_cast<float>(c0 % 3 - 1) * 0.3f, g_Origin[1] + static_cast<float>(c0 / 3 - 1) * 0.3f, g_Origin[2] };
                std::memcpy(fr.raw + kOffPos, fp, sizeof(fp));
                { u16 fid; if (FloorIdAt(fp, &fid)) { fr.raw[0x3e] = static_cast<u8>(fid & 255); fr.raw[0x3f] = static_cast<u8>(fid >> 8); } }
                const float fsz[2] = { 0.3f, 0.3f };
                std::memcpy(fr.raw + kOffSize, fsz, sizeof(fsz));
                SendOne(&fr);
                g_DgSent++;
                budget--;
                continue;
            }
            const int c = c0 - kFeet;
            const bool isStar = c0 >= mainTot;
            float sox = 0.0f, soy = 0.0f, ssz = 0.0f;
            if (isStar) StarPt(c0 - mainTot, 0.5f * g_W * step, 0.5f * g_H * step, &sox, &soy, &ssz);
            const int i = isStar ? 0 : c % pixels;
            const int stg = g_SpiralRun ? c / kUzuPer : 0; const int sj = c % kUzuPer;
            const bool on = (isStar || g_CleanMode || fill || g_SpiralRun) ? true : PixelOn(i);
            if (!on) { g_DgSkip++; continue; } /* 塗らない部分は飛ばす (敵の色で塗るのはやめた) */

            int x = i % g_W;
            int y = i / g_W;
            if (g_FillMode == 1) {
                /* 全塗り: プレイヤーの足元から外へ向かって、うずまきの順に塗る (上の端から塗ると、ステージの外を長く塗り続けてしまう) */
                int r = 0, base = 0, dx = 0, dy = 0;
                if (i > 0) {
                    r = 1; base = 1;
                    while (i >= base + 8 * r) { base += 8 * r; r++; }
                    int k = i - base; const int e = 2 * r;
                    if (k < e) { dx = -r + k; dy = -r; }
                    else if ((k -= e) < e) { dx = r; dy = -r + k; }
                    else if ((k -= e) < e) { dx = r - k; dy = r; }
                    else { k -= e; dx = -r; dy = r - k; }
                }
                x = g_W / 2 + dx; y = g_H / 2 + dy;
                if (x < 0 || y < 0 || x >= g_W || y >= g_H) continue;
            }

            /* 絵の部分は自分の色、塗らない部分は敵の色で塗る */
            PaintRequest req = on ? g_Base : g_EnemyTmpl;
            {
                const PaintRequest& src = on ? g_Base : g_EnemyTmpl;
                /* 番号 (+4) は「いまのゲームのフレーム番号」でないと、古い塗りとして無視される (すでにあるインクの上や、時間がたったあとで出なくなる)。
                   見本の番号より、最近見たゲームの番号のほうが新しければそちらを基準にして、経った時間ぶん進める。 */
                u32 seq; std::memcpy(&seq, src.raw + 4, 4);
                u64 bt = on ? g_BaseTick : g_EnemyTick;
                if (g_HaveSeq && g_SeqTick > bt) { seq = g_SeqRef; bt = g_SeqTick; }
                seq += static_cast<u32>((NowTick() - bt) / g_SeqTpf) + 30u + SeqLeadCap((NowTick() - bt) / g_SeqTpf); /* 時間がたつほど、ずれの分 (2%) も先にする */ /* 少し先の番号にして、ずれても「古い塗り」にならないようにする */
                std::memcpy(req.raw + 4, &seq, 4);
            }

            float ox = (static_cast<float>(x) - g_W * 0.5f) * step, oy = (static_cast<float>(y) - g_H * 0.5f) * step;
            if (g_SpiralRun) { TplPt(g_UzuStyle, stg, sj, ox, oy); ox *= kN; oy *= kN; }
            if (isStar) { ox = sox; oy = soy; }
            if (!fill && (g_ImgRot & 3)) { const int r = g_ImgRot & 3; const float tx = ox, ty2 = oy; if (r == 1) { ox = -ty2; oy = tx; } else if (r == 2) { ox = -tx; oy = -ty2; } else { ox = ty2; oy = -tx; } } /* 絵の向き: 中心のまわりに 90° ずつ回す */
            const float pos[3] = {
                g_Origin[0] + ox,
                g_Origin[1] + oy,
                g_Origin[2], /* 高さは変えない */
            };
            std::memcpy(req.raw + kOffPos, pos, sizeof(pos));
            u16 fidU = 0xFFFF; bool hasF = false;
            { u16 fid; if (FloorIdAt(pos, &fid)) { hasF = true; fidU = fid; req.raw[0x3e] = static_cast<u8>(fid & 255); req.raw[0x3f] = static_cast<u8>(fid >> 8); } }

            /* 友達の画面が受信から作り直す形 (丸いしぶき) にそろえる。送る側と受ける側で見た目が同じになる。 */
            if (!INKDRAW_BASELINE) {
            const s32 kind = kKindPoint;
            std::memcpy(req.raw + kOffKind, &kind, sizeof(kind));
            req.raw[0x3e] = 0xFF; req.raw[0x3f] = 0xFF;
            req.raw[0x48] = 0xFF;
            req.raw[kOffObjFlag] = 0;
            }

            if (g_CleanMode) {
                /* インクリーナーの試し: いつもの塗りのまま、選んだ場所に第3チームらしい値を入れる */
                /* いつもの自分の塗りのまま (塗るあいだ、自分のチームの番号を一時的に変えている) */
            }
            if (kDotSize > 0.0f) {
                const float dU = isStar ? ssz : dot; const float size[2] = { g_CleanMode ? dU * 1.6f : dU, g_CleanMode ? dU * 1.6f : dU };
                std::memcpy(req.raw + kOffSize, size, sizeof(size));
            }

            SendOne(&req);
            { u16 alt; if (hasF && !INKDRAW_BASELINE == false && PaintQueueRoom() && FloorIdAlt(pos, fidU, &alt)) { PaintRequest r2 = req; r2.raw[0x3e] = static_cast<u8>(alt & 255); r2.raw[0x3f] = static_cast<u8>(alt >> 8); SendOne(&r2); g_DgSent++; } } /* 別の番号の床が隣にあるときは、そちらにも 1 点送る */
            g_DgSent++; { u32 sq2; std::memcpy(&sq2, req.raw + 4, 4); if (!g_DgHaveFirst) { g_DgHaveFirst = true; g_DgSeqFirst = sq2; std::memcpy(g_DgFirst, req.raw, 0x60); } g_DgSeqLast = sq2; std::memcpy(g_DgLast, req.raw, 0x60); }
            budget--;
        }
        g_Emitting = false;

        if (g_Cursor >= total) {
            g_DgReq = 1; g_DgTotal = total; g_DgStep = step; g_DgDot = dot;
            g_Cursor = -1; g_SpiralRun = false;
            if (g_TeamOvr && g_CleanTeamSet) g_CleanRestoreAt = NowTick() + 19200000ull; /* 塗り終わって 1 秒後に、チームを元に戻す */
            g_CleanMode = false;
            g_FillMode = 0;
        }
    }


    /* 絵の元の要求から、描き始める準備をする。 */
    static void BeginDraw(const PaintRequest* base, u64 a2) {
        std::memcpy(&g_Base, base, sizeof(g_Base));
        g_BaseTick = (base == &g_Tmpl) ? g_TmplTick : NowTick();
        std::memcpy(g_Origin, base->raw + kOffPos, sizeof(g_Origin));
        /* 自分の座標がわかっていれば、その真下を中心にする。 */
        float pp[3];
        /* ボタンだけで描くときも、押すたびに足元の座標を探し直す。見つからなければ最後に撃った場所、それも無ければ見本の位置。 */
        const bool fromTmpl = (base == &g_Tmpl);
        bool haveP;
        if (fromTmpl && GetPlayerPos(pp) && FootValid()) haveP = true; /* 足元の座標 (ロードしても見つかる) があれば、それを使う */
        else if (fromTmpl) {
            const uintptr_t oldLive = g_LivePos;
            g_LivePos = 0;
            FindLivePos(nullptr);
            if (!LiveValid() && oldLive) { g_LivePos = oldLive; if (!LiveValid()) g_LivePos = 0; } /* 探し直しで見つからなくても、前に見つけた座標が使えればそれを使う */
            haveP = LiveValid();
            if (haveP) {
                const float* f = reinterpret_cast<const float*>(g_LivePos);
                pp[0] = f[0]; pp[1] = -f[2]; pp[2] = f[1] - kLiveHeight;
            }
        } else {
            haveP = GetPlayerPos(pp);
        }
        if (g_ResvHave) { /* 描く場所の予約: 予約した足元の座標を、塗りの座標に直して中心にする */
            pp[0] = g_ResvPos[0]; pp[1] = -g_ResvPos[2]; pp[2] = g_ResvPos[1] - kLiveHeight; haveP = true;
        }
        if (haveP) {
            std::memcpy(g_Origin, pp, sizeof(g_Origin));
            g_OriginSrc = 2;
        } else if (g_HaveLastHit) {
            std::memcpy(g_Origin, g_LastHit, sizeof(g_Origin)); /* 座標が不明なら、最後に自分が撃って塗った場所 */
            g_OriginSrc = 1;
        } else {
            g_OriginSrc = 0;
        }
        if (fromTmpl && !g_TmplOwn) {
            /* ステージの仕掛けの塗りを見本にしているときは、自分のプレイヤー番号に直して、自分の色で塗る。 */
            const int fi = FindLocalIdx();
            if (fi >= 0) { g_LocalIdx = fi; g_IdxSrc = 2; }
            else if (g_HaveIdx) g_IdxSrc = 1;
            else g_IdxSrc = 0;
            g_Base.raw[0] = static_cast<u8>(g_LocalIdx);
            const u32 zero = 0;
            std::memcpy(g_Base.raw + 0x40, &zero, 4);
            std::memcpy(g_Base.raw + 0x44, &zero, 4);
        }
        g_BaseA2 = a2;
        g_Armed  = false;
        g_DgNetTrue = 0; g_DgNetFalse = 0; g_DgSent = 0; g_DgQFull = 0; g_DgSkip = 0; g_DgBegins++; g_DgBeginT = NowTick(); g_DgHaveFirst = false; g_DgSeqFirst = 0; g_DgSeqLast = 0; g_DgTotal = 0;
        if (INKDRAW_DUMP && g_HaveLastHit) {
            const uintptr_t sh = GetShooter(g_ShKind, g_ShId);
            #if INKDRAW_DUMP == 2
            { volatile u64 here = 0; g_DumpResult = WriteDump2(base, g_ShKind, g_ShId, g_LastHit, reinterpret_cast<uintptr_t>(&here)); }
            (void)sh;
#else
            g_DumpResult = WriteDump(base, g_ShKind, g_ShId, g_LastHit, sh);
#endif
        }
        if (INKDRAW_DUMP) {
            /* 書き出しの結果: 笑顔=成功 / 四角=SDをマウントできない / 十字=ファイル作成・書き込み失敗 / X=撃った記録がない */
            if (!g_HaveLastHit || g_DumpResult == 0xFFFFFFFF) UseErrorImage();
            else if (g_DumpResult == 0) UseBuiltinImage();
            else if (g_DumpResult == 2 || g_DumpResult == 1) UseBoxImage();
            else UsePlusImage();
        } else if (INKDRAW_DIAG_GLYPH) {
            /* 診断: 状態を絵の形で知らせる。笑顔=座標確定 / 十字=ほぼ確定 / 四角=撃った人は見つかったが座標なし / X=撃った人が見つからない */
            if (g_Locked && haveP) UseBuiltinImage();
            else if (g_HaveLastHit && g_BestScore >= 3) UsePlusImage();
            else if (g_CalibEvents > 0) UseBoxImage();
            else UseErrorImage();
        } else {
            g_TextImg = g_TextOn && g_TextU8[0] && RenderTextBitmap();
            if (!g_TextImg) {
            char selPath[96]; const char* selp = nullptr;
            if (g_ImgSel >= 0 && g_ImgSel < g_ImgN) { /* メニューで選んだ絵を、描くたびに読み直す (ファイルを差し替えるとすぐ反映される) */
                int o = 0; const char* pre = "inkd:/inkdraw/"; while (*pre) selPath[o++] = *pre++;
                for (const char* q = g_ImgNames[g_ImgSel]; *q && o < 94; q++) selPath[o++] = *q;
                selPath[o] = 0; selp = selPath;
            }
            switch (LoadImageFile(selp)) {
                case LoadResult::Loaded: break;
                case LoadResult::NoFile: UseBuiltinImage(); break;
                case LoadResult::MountFailed: UseBoxImage(); break;
                default:                 UseErrorImage(); break;
            }
            }
        }
        if (INKDRAW_CAMPOS && !haveP) {
            static int dumps = 0;
            if (dumps < 4) {
                dumps++;
                volatile u64 here = 0;
                WriteDump2(base, 0, 0, g_LastHit, reinterpret_cast<uintptr_t>(&here));
            }
            /* 十字=一度も探せていない / 四角=探したが見つからない / X=見つけたが今は使えない */
            if (g_ScanRuns == 0) UsePlusImage();
            else if (g_PosObj == 0) UseBoxImage();
            else UseErrorImage();
        }
        if (g_ForceGlyph) {
            switch (g_ForceGlyph) {
                case 1: UseBuiltinImage(); break;
                case 2: UseBoxImage(); break;
                case 3: UseErrorImage(); break;
                default: UsePlusImage(); break;
            }
            g_ForceGlyph = 0;
        }
        g_FillMode = g_FillPending; g_FillPending = 0;
        if (g_FillMode == 1) { g_W = 140; g_H = 140; } /* 全塗り: マップ全体 (約 420 四方) */
        if (g_FillMode == 2) { g_W = 96; g_H = 96; }   /* 隙間なし: 約 480 四方 */ /* 全塗り: 70 x 70 の点で自分の周りを塗る */
        g_CleanMode = g_CleanPending; /* インクリーナー: 絵の四角の範囲を全部塗る。塗るあいだ、自分 (塗った物) のチームを第3チームにする */
        static const int kTeamVals[6] = { -9, 2, 3, -1, 0, 1 };
        const int wantTeam = g_CleanMode ? kTeamVals[g_CleanSel % 6] : (g_DrawTeam == 1 ? 0 : (g_DrawTeam == 2 ? 1 : -9));
        g_TeamOvr = (wantTeam != -9);
        if (g_TeamOvr && !g_CleanTeamSet) {
            /* 塗った物 = PaintMgr+0x2C0 の表 (+0x398 の配列) の [番号]。その +0x18 の先の +0x18 がチームの番号 (解析で確認) */
            const uintptr_t mgr = ReadPaintMgr();
            u16 id; std::memcpy(&id, g_Base.raw + 0x3E, 2);
            s32 kind; std::memcpy(&kind, g_Base.raw + kOffKind, 4);
            uintptr_t tbl = 0, obj = 0, p18 = 0;
            if (mgr && Readable(mgr + 0x2C0, 8)) tbl = *reinterpret_cast<const uintptr_t*>(mgr + 0x2C0);
            if (kind == 2 && tbl && Readable(tbl + 0x390, 0x10) && (id >> 10) <= 4) {
                const s32 n = *reinterpret_cast<const s32*>(tbl + 0x390);
                const uintptr_t arr = *reinterpret_cast<const uintptr_t*>(tbl + 0x398);
                if (id < n && arr && Readable(arr + 8 * id, 8)) obj = *reinterpret_cast<const uintptr_t*>(arr + 8 * id);
            }
            if (obj && Readable(obj + 0x18, 8)) p18 = *reinterpret_cast<const uintptr_t*>(obj + 0x18);
            if (p18 && Readable(p18 + 0x18, 4)) {
                g_CleanTeamPtr = p18 + 0x18;
                g_CleanTeamOrig = *reinterpret_cast<const s32*>(g_CleanTeamPtr);
                *reinterpret_cast<s32*>(g_CleanTeamPtr) = wantTeam;
                g_CleanTeamSet = true;
                g_CleanRestoreAt = 0;
            }
        }
        g_CleanPending = false;
        g_SpiralRun = g_Spiral; g_Spiral = false;
        g_Cursor = 0;
    }

    /* ボタン読み取り側から呼ばれる。A を押した瞬間に (塗らなくても) 描き始め、続きを少しずつ進める。 */
    /* スタート地点: ステージ (塗りの管理) が作り直されたら、最初に取れた足元の座標を覚える */
    static void WarpStartTick() {
        static uintptr_t lastMgr = 0; static u64 nextFind = 0, nextCam = 0, startAfter = 0;
        static float camSnap[3] = {}, liveSnap[3] = {}; static bool snapOk = false;
        const u64 now = NowTick();
        const bool want = g_WarpMark || g_WarpOn || g_BoxOn || g_LookOn || g_GaOn || (g_LoadT && now - g_LoadT < 90ull * 19200000ull); /* エイムボットがオフでも、ロードから 90 秒はカメラと自分の座標を探しておく (途中でオンにしたとき、カメラ探しから始まって動かないことがあった) */
        if (g_ResvReq) { /* 描く場所の予約 */
            g_ResvReq = false;
            if (!SelfValid()) { g_LivePos = 0; FindLivePos(nullptr); }
            float rp[3]; if (SelfPos(rp)) { std::memcpy(g_ResvPos, rp, 12); g_ResvHave = true; g_ResvMsg = 0; } else g_ResvMsg = 1; /* 予約も、足元の座標があればそれで (高さは今までと同じ床 + kLiveHeight) */
        }
        const uintptr_t m = ReadPaintMgr();
        if (m && m != lastMgr && !lastMgr) lastMgr = m; /* 最初の 1 回は覚えるだけ */
        if (m && (m != lastMgr || g_RstReq)) { if (g_RstReq) { g_RstReq = false; g_RstCnt = g_RstCnt + 1; g_RstDoneT = NowTick(); } /* 場面が変わった (またはログリセット) (ロード): 前の場面の地点・座標・カメラはもう使えないので、全部消して「地点を見る」もやめる。座標とカメラも探し直す。
                                    (一瞬 0 になるだけのときは、ロードとみなさない: 前はこれで地点が消え、バグフライの座標もずっと探し中になっていた) */
            lastMgr = m; if (g_LookOn || g_WarpHas[0] || g_WarpHas[1] || g_WarpHas[2]) g_LookMsg = 9; g_WarpHas[0] = g_WarpHas[1] = g_WarpHas[2] = g_WarpHas[3] = false; if (g_LookSlot != 6) g_LookOn = false; g_LivePos = 0; g_CamPos = 0; /* エイムボットはロードしても続ける */ g_FootPos = 0; FlyGrpReset(); g_BalOn = false; g_BalN = 0; g_EnN = 0; g_EnScanNow = true; g_LoadT = now; g_LoadGen = g_LoadGen + 1; g_CamRegLo = g_CamRegHi = 0; g_FootRegLo = g_FootRegHi = 0; g_CamHitN = 0; g_CamRejA[0] = g_CamRejA[1] = g_CamRejA[2] = g_CamRejA[3] = 0; g_EnSelf = 0; /* 前の場面の場所のヒントは捨てる */ /* ロードの直後は、カメラと足元を 1〜2 秒ごとに探し直す (前は失敗が続くと 20〜30 秒待ってしまい、box も視点も止まっていた) */ /* バルーンの box はロードで消す (重いので)。敵は探し直す */ g_WarpReq = false; g_WarpHold = 0; snapOk = false;
            g_LiveConfirmed = false; g_LiveConfAddr = 0; g_LcState = 0; g_LcNextScan = 0; /* 前の場面で「自分」と確かめた座標の場所も忘れる (残っていると、変な所の座標で固定される) */
            startAfter = now + 3ull * 19200000ull; g_StartBlock = false; /* スタート地点は、ロードから 3 秒たってから覚える (出てくる前の座標を覚えないように) */
        }
        if (!m || !want) return;
        if (!LiveValid() && now >= nextFind) { nextFind = now + 38400000ull; g_LivePos = 0; FindLivePos(nullptr); } /* 自分の座標: 2 秒に 1 回探す */
        if ((LiveValid() || now - g_LoadT > 3ull * 19200000ull) && !CamValid() && now >= nextCam) { nextCam = now + 9600000ull; CamFind(); } /* 3 秒から (早めると、ロード中のメモリを読んで落ちた)、0.5 秒ごと */ /* 自分の座標を待たずに、1 秒ごとに探す (カメラが見つかるまで、エイムボットが動かなかった) */ /* カメラ: 座標がわかってから探す (いちばん近いものを選ぶため) */
        { static u64 nextFoot = 0; if (CamValid() && !FootValid() && now >= nextFoot) { nextFoot = now + 38400000ull; FootFind(); } } /* box 用の足元の座標: カメラがわかってから探す */
        if (LiveValid() && CamValid()) { /* 古いカメラ (ロード前のものがメモリに残っていた) を使い続けないように: 自分が 3 以上動いたのに、カメラの追従先がまったく動かなければ探し直す */
            const float* L = reinterpret_cast<const float*>(__atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE)); const float* C = reinterpret_cast<const float*>(g_CamPos);
            if (!snapOk) { std::memcpy(camSnap, C, 12); std::memcpy(liveSnap, L, 12); snapOk = true; }
            else {
                const float lx = L[0] - liveSnap[0], lz = L[2] - liveSnap[2], cxm = C[0] - camSnap[0], czm = C[2] - camSnap[2];
                if (lx * lx + lz * lz > 9.0f) {
                    if (cxm * cxm + czm * czm < 0.0001f) { CamReject(g_CamPos); g_CamPos = 0; nextCam = 0; }
                    snapOk = false;
                } else if (cxm * cxm + czm * czm > 9.0f) { /* 逆に、カメラが 3 以上動いたのに自分の座標がまったく動かない: 座標の場所がちがう (古い物)。探し直す */
                    if (lx * lx + lz * lz < 0.0001f) { g_LivePos = 0; g_LiveConfirmed = false; g_LiveConfAddr = 0; g_LcState = 0; nextFind = 0; }
                    snapOk = false;
                }
            }
        }
        { /* 自分の座標の取り違えを直す: カメラは自分を追いかけるので、自分の座標は追従先の真下にあるはず。横に 3 以上はなれたまま 1 秒続いたら、ほかのプレイヤーの座標を使っている。
             (取り違えていると、カウントダウンのあと動き出したことに気づかず、エイムボットが 60 秒たつまで動かなかった。敵の取り違えなら、その敵を倒すまで直らなかった) */
            static u64 farLT = 0, nextLF = 0; const uintptr_t lp = __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE); const uintptr_t cp = g_CamPos;
            if (lp && cp && LiveValid() && CamValid() && Readable(cp, 12)) {
                const float* L = reinterpret_cast<const float*>(lp); const float* C = reinterpret_cast<const float*>(cp); const float dx = L[0] - C[0], dz = L[2] - C[2];
                if (dx * dx + dz * dz > 9.0f) {
                    if (!farLT) farLT = now;
                    else if (now - farLT > 19200000ull && now >= nextLF) { nextLF = now + 19200000ull; farLT = 0;
                        if (g_LiveConfAddr == lp) { g_LiveConfirmed = false; g_LiveConfAddr = 0; g_LcState = 0; g_LcNextScan = 0; } /* 確かめた座標がはなれているなら、それも違う */
                        const float ref[3] = { C[0], C[1], C[2] }; FindLivePos(ref); }
                } else farLT = 0;
                if (g_LiveConfirmed && g_LiveConfAddr && g_LiveConfAddr != lp && Readable(g_LiveConfAddr, 0x30) && *reinterpret_cast<const uintptr_t*>(g_LiveConfAddr + kLivePosToVt) == MainBase() + kLiveVtable
                    && Plausible(reinterpret_cast<const float*>(g_LiveConfAddr))) { const float* F = reinterpret_cast<const float*>(g_LiveConfAddr); const float fx = F[0] - C[0], fz = F[2] - C[2];
                    if (fx * fx + fz * fz < 9.0f) { g_LiveAlt = false; g_LivePos = g_LiveConfAddr; } } /* 歩いて自分と確かめた座標 (追従先の近く) を優先 */
            } else farLT = 0;
        }
        if (g_WarpHas[3] || g_StartBlock || now < startAfter) return;
        float Ls[3];
        if (CamValid() && SelfPos(Ls)) { /* スタート地点: 自分の座標が、カメラの追従先の近く (4 以内) のときだけ覚える (違う物の座標を覚えないように) */
            const float* L = Ls; const float* C = reinterpret_cast<const float*>(g_CamPos);
            const float dx = L[0] - C[0], dz = L[2] - C[2];
            if (dx * dx + dz * dz < 16.0f) { std::memcpy(g_WarpSlots[3], L, 12); g_WarpHas[3] = true; }
        }
    }
    /* 候補を全部まとめて同じだけ動かす (体の座標は、複数の写しを一緒に動かさないと戻されるため)。上キー = +、下キー = −。 */
    static void TrkRise() {
        const int rd = g_FlyQuiet ? 0 : g_RiseDir; /* 移動の機能が自動で準備したときは、B / ZL で浮かない */
        if (rd == 0) g_DBaseHave = false;
        if (g_LaunchReq) { g_LaunchReq = false; g_LaunchNw = -1; if (!g_ModeOn) { g_ModeOn = true; g_FlyRestart = true; g_FlyNext = 0; g_FlyQuiet = false; } g_LaunchPend = true; } /* 吹っ飛び: 準備ができていなければ、フリーフライの準備から始める */
        if (g_LaunchPend && g_ModeOn && g_TrkStage == 3 && g_NAct > 0) { g_LaunchPend = false; g_LaunchLeft = 45; g_Hover = false; g_LaunchNw = -2; }
        if (!g_ModeOn) { g_Hover = false; g_LaunchPend = false; g_LaunchLeft = 0; g_WarpHold = 0; FlyGrpHoverOff(); return; }
        if (g_MSel >= 0 && g_MSel < g_MN && rd != 0) {
            const uintptr_t a = g_M[g_MSel] + 0;
            const float spd = (g_MN > 8 && g_MSel == 7) ? 1.5f : 0.5f; /* 滑るほうは速く */
            if (Readable(a, 12) && TrkWritable(a)) reinterpret_cast<float*>(a)[1] += spd * static_cast<float>(rd);
            return;
        }
        if (kEnableTrk && g_TrkStage == 3 && g_TestState == 0 && !g_InPre) return; /* 1フレームに1回だけ (フレーム更新の前) 書く: 動きをなめらかに */
        { /* ワープ地点: 記憶 / 戻る (戻るときは、浮遊と同じやり方で、体の写しをまとめて目的の場所に何フレームか固定する。1 回書くだけだとゲームに戻される) */
            const bool ready = kEnableTrk && g_TrkStage == 3 && g_NAct > 0;
            if (!g_WarpOn) { g_WarpReq = false; g_WarpSaveReq = false; g_WarpHoldL = 0; }
            if (g_WarpHold > 0 && !g_Hover) g_WarpHold = 0; /* 浮遊が解けたら (リスポーンなど)、固定もやめる */
            if (g_WarpHold > 0 && ++g_WarpTick > 180) { g_WarpHold = 0; g_Hover = false; g_WarpMsg = 5; } /* 3 秒たっても終わらない: 失敗 */
            { float sp[3]; if (g_WarpSaveReq && (FootValid() || !ready) && SelfPos(sp)) { const int k = g_WarpSaveSlot % 3; std::memcpy(g_WarpSlots[k], sp, 12); g_WarpHas[k] = true; g_WarpMsg = 0; g_WarpSaveReq = false; } } /* 記憶: 足元の座標がわかれば、すぐそこを記憶する */
            if (ready && (g_WarpSaveReq || g_WarpReq)) {
                float L[3];
                if (ReadLive(L)) {
                    if (g_WarpSaveReq) { const int k = g_WarpSaveSlot % 3; std::memcpy(g_WarpSlots[k], L, 12); g_WarpHas[k] = true; g_WarpMsg = 0; }
                    else if (g_WarpReq) {
                        const float ex = g_WarpPos[0] - L[0], ez = g_WarpPos[2] - L[2];
                        if (ex * ex + ez * ez > 240000.0f) g_WarpMsg = 1; /* 離れすぎていると行かない */
                        else { g_WarpMsg = 2; g_WarpHold = 60; g_WarpRetry = 0; g_WarpTick = 0; g_Hover = true; g_AbsOn = false; g_FlyHavePrev = false; }
                    }
                    g_WarpSaveReq = false; g_WarpReq = false;
                }
            }
        }
        if (false && (rd != 0 || FlyGrpHovering()) && g_InPre && g_FlyGroup != -2) { /* (試したやり方: 飛べなくなったのでやめた。前のやり方に戻す) */ /* 体の座標の元 (テストで見つけた組) がわかれば、そこを動かす。カメラの向きは目と追従先から。準備ができていてもいなくても */
            float c3[3]; float mx = 0.0f, mz = 0.0f; const float sx = g_LStickX, sy = g_LStickY;
            if (sx * sx + sy * sy > 0.04f && CamDir3(c3)) { const float h = __builtin_sqrtf(c3[0] * c3[0] + c3[2] * c3[2]); if (h > 0.05f) { const float fx = c3[0] / h, fz = c3[2] / h; mx = (fx * sy - fz * sx) * 0.5f; mz = (fz * sy + fx * sx) * 0.5f; } }
            if (FlyGrpStep(rd, mx, mz)) return;
            if (g_FlyGroup == -1 && rd > 0 && FlyGrpTesting()) return; /* 試している間は、ほかのやり方では書かない (どの組が効いたか分かるように) */
        }
        if (kEnableTrk && g_TrkStage != 3 && rd != 0 && g_InPre && LiveValid()) { /* B / ZL を押している間だけ (歩いて準備しているときは触らない) */
            /* 準備が終わっていなくても飛べるように: 見つけてある足元の座標に、直接書く (準備OKになったら、これまでのやり方に切り替わる) */
            float* f = reinterpret_cast<float*>(__atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE));
            if (!g_DBaseHave) { g_DBaseHave = true; g_HoverBase = f[1]; }
            if (rd < 0 || f[1] - g_HoverBase < 300.0f) f[1] += 0.4f * static_cast<float>(rd);
            const float sx = g_LStickX, sy = g_LStickY;
            if (sx * sx + sy * sy > 0.04f && g_CamFOk) {
                const float vr = g_CamF[0] * sy - g_CamF[1] * sx, vi = g_CamF[0] * sx + g_CamF[1] * sy;
                f[0] += vr * 0.5f; f[2] += vi * 0.5f;
            }
            return;
        }
        const float bsx = g_LStickX, bsy = g_LStickY; const float bmg = __builtin_sqrtf(bsx * bsx + bsy * bsy);
        const bool boostNow = false && (g_HSpd > 0 || g_Wall) && !g_MenuOpen && g_CamFOk && !(g_BtnNow & (1ull << 8)) && bmg > 0.2f && !g_Hover && rd == 0 && g_LaunchLeft <= 0 && !g_YHeld;
        const bool flying = g_Hover || rd != 0 || g_YHeld || g_LaunchLeft > 0 || boostNow;
        if (kEnableTrk && g_TrkStage == 3 && g_TestState == 0 && !flying) { g_FlyHavePrev = false; return; }
        if (kEnableTrk && g_TrkStage == 3 && g_TestState == 0 && flying) {
            float d = 0.0f;
            /* 横: Lスティックの向きを、カメラの向きに合わせて回して動かす。
               カメラの向き F は、歩いているときの「スティックの向き」と「実際に動いた向き」から覚える。
               (xz を複素数 x + i z として、動き = F × (sy + i sx)) */
            float dx = 0.0f, dz = 0.0f;
            {
                const float sx = g_LStickX, sy = g_LStickY;
                const float sm = sx * sx + sy * sy;
                if (sm > 0.04f && g_CamFOk) {
                    /* q = sy + i sx */
                    const float qr = sy, qi = sx;
                    const float vr = g_CamF[0] * qr - g_CamF[1] * qi;
                    const float vi = g_CamF[0] * qi + g_CamF[1] * qr;
                    const float spd = 0.5f; /* 1フレームに進む量 (スティックいっぱいで) */
                    dx = vr * spd; dz = vi * spd;
                }
            }
            if (boostNow) {
                /* 人速度 / 壁抜け: 歩く向きに、体の写しを 1 フレームごとに少しずつ動かす (BugFly の横移動と同じやり方) */
                const float vr = g_CamF[0] * bsy - g_CamF[1] * bsx, vi = g_CamF[0] * bsx + g_CamF[1] * bsy;
                const float nn = __builtin_sqrtf(vr * vr + vi * vi);
                if (nn > 0.01f) { const float ex = ((g_HSpd > 0 ? 0.03f * static_cast<float>(g_HSpd > 20 ? 20 : g_HSpd) : 0.0f) + (g_Wall ? 0.4f : 0.0f)) * (bmg > 1.0f ? 1.0f : bmg); dx = vr / nn * ex; dz = vi / nn * ex; }
            }
            if (g_LaunchLeft > 0 && g_CamFOk) {
                /* 吹っ飛び: スティックを倒していればその向き、倒していなければ前へ */
                float qr = 1.0f, qi = 0.0f; const float sx = g_LStickX, sy = g_LStickY;
                if (sx * sx + sy * sy > 0.04f) { qr = sy; qi = sx; }
                const float vr = g_CamF[0] * qr - g_CamF[1] * qi, vi = g_CamF[0] * qi + g_CamF[1] * qr;
                const float nn = __builtin_sqrtf(vr * vr + vi * vi);
                if (nn > 0.01f) { dx = vr / nn * 1.8f; dz = vi / nn * 1.8f; }
            }
            g_FlyApplied[0] = dx; g_FlyApplied[2] = dz;
            /* 横に動かすのは、足元の座標とほぼ同じ x,z を持つもの (体の位置の写し) だけ。
               ほかの値 (当たり判定の角など) まで横にずらすと、ゲームが落ちることがある。 */
            float L[3] = {}; const bool haveL = ReadLive(L);
            /* B を押したら空中に止まる (ホバリング)。B で上、ZL で下。フリーフライを OFF にすると解ける。 */
            if (haveL) {
                if (!g_Hover && rd != 0) { g_Hover = true; g_HoverY = L[1]; g_HoverBase = L[1]; }
                if (g_Hover) { /* ゆっくり上げ、飛び始めの高さから +10 までに制限 (高すぎると死ぬ)。目標の高さに向けて 1 フレームごとに少しずつ寄せて、なめらかに固定する */
                    g_HoverY += 0.4f * static_cast<float>(rd);
                    if (g_HoverY > g_HoverBase + 300.0f) g_HoverY = g_HoverBase + 300.0f;
                    if (g_HoverY < g_HoverBase - 0.3f) g_HoverY = g_HoverBase - 0.3f; /* 最初の足場の高さより下には行かない (地面を貫通しない) */
                    d = g_HoverY - L[1]; if (d > 3.0f) d = 3.0f; if (d < -3.0f) d = -3.0f; }
            } else d = static_cast<float>(rd);
            if (g_LaunchLeft > 0) { d += 3.0f; g_LaunchLeft--; } /* 吹っ飛び: 45 フレーム、1 フレームに 3 ずつ上へ */
            /* 飛び始めた場所から横に 25 より離れないようにする (ステージの外や壁の中に入ると、ゲームが落ちることがある) */
            if (!g_FlyHavePrev && haveL) { std::memcpy(g_FlyPrev, L, 12); g_FlyHavePrev = true; }
            if (haveL) {
                const float ox = L[0] + dx - g_FlyPrev[0], oz = L[2] + dz - g_FlyPrev[2];
                if (ox * ox + oz * oz > 250000.0f) { dx = 0.0f; dz = 0.0f; }
            }
            const bool horiz = haveL && (dx != 0.0f || dz != 0.0f);
            int nh = 0, nw = 0;
            const bool absMode = haveL && g_Hover && g_LaunchLeft <= 0 && g_NAct <= 4096;
            if (absMode) {
                if (!g_AbsOn || g_AbsN != g_NAct) {
                    g_AbsT[0] = L[0]; g_AbsT[1] = L[1]; g_AbsT[2] = L[2]; g_HoverY = L[1]; if (!g_AbsOn) g_HoverBase = L[1];
                    for (int i = 0; i < g_NAct; i++) {
                        const uintptr_t a = g_Trk[g_Act[i]];
                        float* f = reinterpret_cast<float*>(a);
                        if (Readable(a, 12) && f[0] == f[0] && f[1] == f[1] && f[2] == f[2]) { g_AbsOff[i][0] = f[0] - L[0]; g_AbsOff[i][1] = f[1] - L[1]; g_AbsOff[i][2] = f[2] - L[2];
                            if (g_WarpHold > 0 && !(g_AbsOff[i][0] > -2.1f && g_AbsOff[i][0] < 2.1f && g_AbsOff[i][2] > -2.1f && g_AbsOff[i][2] < 2.1f && g_AbsOff[i][1] > -8.0f && g_AbsOff[i][1] < 8.0f)) g_AbsOff[i][0] = 1e9f; } /* ワープ: 足元のまわりの写しだけをつかむ */
                        else { g_AbsOff[i][0] = 1e9f; g_AbsOff[i][1] = 0.0f; g_AbsOff[i][2] = 0.0f; }
                    }
                    g_AbsOn = true; g_AbsN = g_NAct; g_AbsHoriz = false; g_AbsBad = 0;
                }
                g_AbsT[1] = g_HoverY;
                if (horiz) { if (!g_AbsHoriz) { g_AbsT[0] = L[0]; g_AbsT[2] = L[2]; g_AbsHoriz = true; } g_AbsT[0] += dx; g_AbsT[2] += dz; }
                else g_AbsHoriz = false;
                const bool warpNow = g_WarpHold > 0; /* ワープ地点: 目的の場所に固定する (横も、体のまわりの写しを全部まとめて動かす) */
                if (warpNow) { g_AbsT[0] = g_WarpPos[0]; g_AbsT[1] = g_WarpPos[1] + kWarpUp; g_AbsT[2] = g_WarpPos[2]; g_HoverY = g_WarpPos[1] + kWarpUp; g_AbsHoriz = true; g_WarpHold = g_WarpHold - 1; }
                { /* 目標と実際が大きく離れたまま続く = ワープやリスポーンなどで、体が別の所へ行った: 浮遊をやめる */
                    const float ey = L[1] - g_AbsT[1], ex = L[0] - g_AbsT[0], ez = L[2] - g_AbsT[2];
                    if (!warpNow && (ey > 10.0f || ey < -10.0f || (g_AbsHoriz && (ex * ex + ez * ez > 144.0f)))) { if (++g_AbsBad > 30) { g_AbsOn = false; g_Hover = false; g_AbsBad = 0; } } else g_AbsBad = 0;
                }
                for (int i = 0; i < g_NAct; i++) {
                    if (g_AbsOff[i][0] > 1e8f) continue;
                    const uintptr_t a = g_Trk[g_Act[i]];
                    if (!Readable(a, 12) || !TrkWritable(a)) continue;
                    float* f = reinterpret_cast<float*>(a);
                    if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2])) continue;
                    const float ex = f[0] - L[0], ez = f[2] - L[2], ey = f[1] - L[1];
                    if (!warpNow && !(ex > -1.5f - 0.6f && ex < 1.5f + 0.6f && ez > -1.5f - 0.6f && ez < 1.5f + 0.6f && ey > -8.0f && ey < 8.0f)) continue; /* ワープ中は、つかんだ写しを全部書く */
                    f[1] = g_AbsT[1] + g_AbsOff[i][1]; nw++;
                    if (g_AbsHoriz && (warpNow || (g_AbsOff[i][0] > -0.6f && g_AbsOff[i][0] < 0.6f && g_AbsOff[i][2] > -0.6f && g_AbsOff[i][2] < 0.6f))) { f[0] = g_AbsT[0] + g_AbsOff[i][0]; f[2] = g_AbsT[2] + g_AbsOff[i][2]; nh++; }
                }
                if (warpNow && g_WarpHold == 0) {
                    const float ex = L[0] - g_WarpPos[0], ez = L[2] - g_WarpPos[2];
                    if (ex * ex + ez * ez > 6.25f && g_WarpRetry < 2) { g_WarpRetry = g_WarpRetry + 1; g_WarpHold = 60; g_WarpTick = 0; g_AbsOn = false; } /* 着いていない: やり直す */
                    else { g_Hover = false; g_WarpMsg = (ex * ex + ez * ez > 6.25f) ? 5 : 2; } /* 固定し終わったら、浮遊をやめて降りる */
                }
            } else { g_AbsOn = false; g_AbsHoriz = false; }
            for (int i = 0; i < g_NAct && !absMode; i++) {
                const uintptr_t a = g_Trk[g_Act[i]];
                if (!Readable(a, 12) || !TrkWritable(a)) continue;
                float* f = reinterpret_cast<float*>(a);
                if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2])) continue;
                if (haveL) {
                    /* もう体の位置の写しではなくなった場所 (消えた物の跡地など) には書かない。書くとゲームが落ちることがある。 */
                    const float ex = f[0] - L[0], ez = f[2] - L[2], ey = f[1] - L[1];
                    if (!(ex > -1.5f && ex < 1.5f && ez > -1.5f && ez < 1.5f && ey > -8.0f && ey < 8.0f)) continue;
                } else continue;
                f[1] += d; nw++;
                if (horiz) {
                    const float ex = f[0] - L[0], ez = f[2] - L[2];
                    if (ex > -0.6f && ex < 0.6f && ez > -0.6f && ez < 0.6f) { f[0] += dx; f[2] += dz; nh++; }
                }
            }
            g_FlyNw = nw;
            if (haveL && LiveValid()) { float* lf = reinterpret_cast<float*>(__atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE)); if (absMode) { lf[1] = g_AbsT[1]; if (g_AbsHoriz) { lf[0] = g_AbsT[0]; lf[2] = g_AbsT[2]; } } else { lf[1] += d; if (horiz) { lf[0] += dx; lf[2] += dz; } } } /* 写しに効かないステージでは、足元の座標そのものに書く (準備中の飛び方と同じ) */
            if (g_LaunchLeft > 0 || g_LaunchNw == -2) g_LaunchNw = nw;
            if (nw == 0) { if (++g_FlyZero > 240) { g_FlyZero = 0; g_FlyRestart = true; g_FlyNext = 0; g_Hover = false; } } else g_FlyZero = 0; /* 書ける写しがなくなったら、準備からやり直す */
            {
                /* 診断: 飛んでいる間、約1.5秒ごとに状態を書き出す (最大6回) */
                auto pk = [](float a, float b) -> u64 { u32 x, y; std::memcpy(&x, &a, 4); std::memcpy(&y, &b, 4); return static_cast<u64>(x) | (static_cast<u64>(y) << 32); };
                g_FlyDiag[0] = pk(g_LStickX, g_LStickY) ;
                g_FlyDiag[1] = static_cast<u64>(nh) | (static_cast<u64>(g_NAct) << 20) | (static_cast<u64>(g_CamFOk ? 1 : 0) << 40) | (static_cast<u64>(haveL ? 1 : 0) << 41);
                g_FlyDiag[2] = pk(dx, dz);
                g_FlyDiag[3] = pk(g_CamF[0], g_CamF[1]);
                g_FlyFrames++;
                if (g_FlyDumps < 6 && (g_FlyFrames % 90) == 45) { g_FlyDumps++; const float z3[3] = {}; WriteStatus(0xA00, z3); }
            }
        }
    }
    /* リスポーン (試し): 自分の spl::PlayerDamage を見つけて、体力 (+0x88、満タンで 1000) を 0 にする。
       プレイヤーの表 [自分の番号] の +0x298 がプレイヤー本体。その中に PlayerDamage へのポインタがある (vtable = main+0x5D32218)。 */
    static uintptr_t FindOwnDamage() {
        /* 1) 自分のプレイヤー本体 (表の [自分の番号] +0x298) */
        uintptr_t player = 0;
        if (!LiveValid()) { g_LivePos = 0; FindLivePos(nullptr); } /* 足元の座標がまだなら先に探す (友達と遊ぶときは、プレイヤーが8人いて、番号が分からないと自分のを選べない) */
        if (!g_HaveIdx) { const int fi = FindLocalIdx(); if (fi >= 0) { g_LocalIdx = fi; g_HaveIdx = true; } } /* 自分の番号が分からなければ探す (何番でも動く) */
        if (g_HaveIdx) {
            const uintptr_t base = PlayerTableBase();
            if (base && Readable(base + static_cast<uintptr_t>(g_LocalIdx) * kPlayerStride + 0x298, 8))
                player = *reinterpret_cast<const uintptr_t*>(base + static_cast<uintptr_t>(g_LocalIdx) * kPlayerStride + 0x298);
        }
        {
            /* 1.5) プレイヤー本体の中に PlayerDamage へのポインタがあれば、メモリ全体を探さずにそれを使う (固まる・落ちるのを避ける) */
            const uintptr_t vt0 = MainBase() + 0x5D32218;
            const uintptr_t tb = PlayerTableBase();
            uintptr_t foundD[10] = {}; uintptr_t anyD = 0; int nanyD = 0;
            if (tb) for (int idx = 0; idx < 10; idx++) {
                const uintptr_t ent = tb + static_cast<uintptr_t>(idx) * kPlayerStride;
                if (!Readable(ent + 0x298, 8)) break;
                const uintptr_t pl = *reinterpret_cast<const uintptr_t*>(ent + 0x298);
                if (!pl || (pl & 7) || !Readable(pl, 0x400)) continue;
                const size_t len = Readable(pl, 0x2000) ? 0x2000 : 0x400;
                for (size_t o = 0; o + 8 <= len; o += 8) {
                    const uintptr_t v = *reinterpret_cast<const uintptr_t*>(pl + o);
                    if (v > 0x10000 && !(v & 7) && Readable(v, 0x100) && *reinterpret_cast<const u64*>(v) == vt0 && *reinterpret_cast<const u64*>(v + 8) == vt0 + 0x110) { foundD[idx] = v; break; }
                }
                if (foundD[idx]) { anyD = foundD[idx]; nanyD++; }
            }
            g_RespawnDiag = static_cast<u64>(nanyD) | (1ull << 11);
            if (g_HaveIdx && g_LocalIdx >= 0 && g_LocalIdx < 10 && foundD[g_LocalIdx]) return foundD[g_LocalIdx];
            if (!g_HaveIdx && g_RespIdx >= 0 && g_RespIdx < 10 && foundD[g_RespIdx]) return foundD[g_RespIdx]; /* 自分の番号が分からないときは、メニューで選んだ番号を使う */
            if (nanyD == 1) return anyD;
        }
        /* 2) メモリ全体から PlayerDamage (先頭が vtable = main+0x5D32218) を探す。プレイヤーの人数分ある */
        const uintptr_t vt = MainBase() + 0x5D32218;
        uintptr_t cands[16]; int nc = 0;
        uintptr_t addr = 0;
        for (int guard = 0; guard < 8192 && nc < 16; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            if ((mi.type == 4 || mi.type == 5) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xFF) && mi.size < 0x40000000ull) {
                const u64* q = reinterpret_cast<const u64*>(mi.addr);
                const size_t n = mi.size / 8;
                for (size_t i = 0; i + 1 < n && nc < 16; i++) {
                    if (q[i] != vt || q[i + 1] != vt + 0x110) continue; /* 2 つの vtable が並ぶ形で確かめる */
                    cands[nc++] = mi.addr + i * 8;
                }
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
        g_RespawnDiag = static_cast<u64>(nc) | (static_cast<u64>(g_HaveIdx ? 1 : 0) << 8) | (static_cast<u64>(player ? 1 : 0) << 9);
        if (nc == 0) return 0;
        /* 3) 自分のものを選ぶ: 中に自分のプレイヤー本体へのポインタを持っているもの。1 つしかなければ、それ */
        if (player) {
            for (int k = 0; k < nc; k++) {
                const u64* q = reinterpret_cast<const u64*>(cands[k]);
                for (int j = 2; j < 0x100; j++) if (Readable(reinterpret_cast<uintptr_t>(q + j), 8) && q[j] == player) { g_RespawnDiag |= 1ull << 10; return cands[k]; }
            }
        }
        {
            /* 前の試合の残り (体力が変な値) を除く */
            int w = 0;
            for (int k = 0; k < nc; k++) { const s32 hp = *reinterpret_cast<const s32*>(cands[k] + 0x88); if (Readable(cands[k] + 0x88, 4) && hp > 0 && hp <= 100000) cands[w++] = cands[k]; }
            if (w > 0) nc = w;
        }
        if (nc == 1) return cands[0];
        if (g_RespIdx == 0) return cands[0]; /* 実測では、いちばん低い番地のものが自分 (3 回中 3 回) */
        if (g_HaveIdx && false && g_LocalIdx >= 0 && g_LocalIdx < nc) return cands[g_LocalIdx]; /* 体力の物は、プレイヤー番号の順にならんでいる (3 回の実測で、番号 = 順番) */
        if (LiveValid() && false) {
            /* 自分のプレイヤーの体 (足元の座標の写しを持つ物) を指している候補を探す */
            float lp[3]; std::memcpy(lp, reinterpret_cast<const void*>(g_LivePos), 12);
            int hit = -1, nh = 0;
            for (int k = 0; k < nc; k++) {
                const uintptr_t* q = reinterpret_cast<const uintptr_t*>(cands[k]);
                bool ok = false;
                for (int j = 2; j < 0x100 && !ok; j++) {
                    if (!Readable(reinterpret_cast<uintptr_t>(q + j), 8)) break;
                    const uintptr_t v = q[j];
                    if (v < 0x10000 || (v & 7) || !Readable(v, 0x800)) continue;
                    const float* f = reinterpret_cast<const float*>(v);
                    for (int m = 0; m + 2 < 0x200; m++) {
                        const float a = f[m] - lp[0]; if (!(a > -0.5f && a < 0.5f)) continue;
                        const float b = f[m + 1] - lp[1], c = f[m + 2] - lp[2];
                        if (b > -0.5f && b < 0.5f && c > -0.5f && c < 0.5f) { ok = true; break; }
                    }
                }
                if (ok) { hit = k; nh++; }
            }
            if (nh == 1) return cands[hit];
        }
        if (nc > 0) return cands[g_RespIdx % nc]; /* 自分のものが分からないときは、メニューで選んだ順番のもの */
        return 0;
    }
    static void RespawnTick() {
        if (g_RespStep != 0) { g_RespIdx = (g_RespIdx + g_RespStep) % 8; g_DamageObj = 0; g_RespawnState = 0; g_RespStep = 0; }
        if (g_ReqRespawn) {
            g_ReqRespawn = false;
            { static u64 lastRq = 0; const u64 nw = NowTick(); if (lastRq != 0 && nw - lastRq < 192000000ull) { g_RespIdx = (g_RespIdx + 1) % 8; g_DamageObj = 0; } lastRq = nw; } /* 10 秒以内にもう一度押したら、別の候補に変える (死ななかった = 自分ではなかった) */
            /* 前に見つけたものがまだ生きていれば、そのまま使う (メモリ全体の探索は固まるので、最初の 1 回だけ) */
            {
                const uintptr_t vt = MainBase() + 0x5D32218;
                const uintptr_t o = g_DamageObj;
                if (!(o && Readable(o, 0x100) && *reinterpret_cast<const u64*>(o) == vt && *reinterpret_cast<const u64*>(o + 8) == vt + 0x110)) g_DamageObj = FindOwnDamage();
            }
            g_RespawnShownAt = NowTick();
            if (g_DamageObj) { g_RespawnFrames = 90; g_RespawnState = 1; g_RespawnDiag |= static_cast<u64>(static_cast<u32>(*reinterpret_cast<const s32*>(g_DamageObj + 0x88))) << 32; }
            else g_RespawnState = 2;
        }
        if (g_RespawnState != 0 && NowTick() - g_RespawnShownAt > 57600000ull) g_RespawnState = 0; /* 3 秒たったら表示を戻す */
        if (g_RespawnFrames > 0 && g_DamageObj && Readable(g_DamageObj + 0x88, 4)) {
            *reinterpret_cast<s32*>(g_DamageObj + 0x88) = -1000; /* 体力を 0 より下に (しばらく書き続ける): ちょうど 0 だと、ぎりぎり生き残ることがあった */
            g_RespawnFrames--;
        }
    }
    /* フリーフライの準備を自動で進める: 足元の座標を探す → 1回目の写し集め → 歩いて動いた分で絞る (2回) → 完了。
       手で十字キーを押さなくていい。ナワバリ以外でも動く (塗りを見ていなくても動かす)。 */
    /* 028595E0 (mov x19, x6) で拾った x6 の中 (+0〜+0x1000) から、自分の足元の座標 L と同じ値の float3 を探して、飛ぶときの書き込み先にする。 */
    static bool FlyFromX6(const float* L) {
        int n = 0;
        for (int k = 0; k < 8; k++) {
            const uintptr_t r = g_X6Ring[k];
            if (!r || (r & 3) || !Readable(r, 0x1004) || !TrkWritable(r)) continue;
            for (uintptr_t o = 0; o + 12 <= 0x1000 && n < kMaxTrk; o += 4) {
                const float* c = reinterpret_cast<const float*>(r + o);
                if (!(c[0] == c[0] && c[1] == c[1] && c[2] == c[2])) continue;
                if (!TrkNear(c, L)) continue;
                if (reinterpret_cast<uintptr_t>(c) == g_LivePos) continue;
                g_Trk[n] = reinterpret_cast<uintptr_t>(c);
                std::memcpy(g_TrkVal[n], c, 12);
                n++;
            }
        }
        if (n == 0) return false;
        g_NTrk = n; g_NAct = n; g_Master = -1; g_TestState = 0; g_SplitState = 0; g_BandMode = 0; g_Banded = 0;
        for (int i = 0; i < n; i++) g_Act[i] = i;
        g_TrkStage = 3; g_FlyLiveAddr = g_LivePos;
        return true;
    }
    static void FlyAuto() {
        g_FlyCalls++;
        if (!g_ModeOn) return;
        if (g_FlyRestart) { g_FlyRestart = false; g_TrkStage = 0; }
        const u64 now = NowTick();
        {
            /* 歩いた距離 (表示用) と、スティックを倒していた時間 (座標が動いて見えないときの代わり) */
            float Lq[3]; static u64 lastT = 0;
            if (g_TrkStage >= 1 && g_TrkStage < 3 && ReadLive(Lq)) { const float dx = Lq[0] - g_FlyStepPos[0], dz = Lq[2] - g_FlyStepPos[2]; g_FlyWalkD = __builtin_sqrtf(dx * dx + dz * dz); }
            if (lastT && now - lastT < 1000000ull && !g_MenuOpen && g_LStickX * g_LStickX + g_LStickY * g_LStickY > 0.25f) g_FlyStickT += now - lastT;
            lastT = now;
        }
        if (now < g_FlyNext) { g_FlyWhy = 2; return; }
        if (!LiveValid()) { g_LivePos = 0; g_LiveAlt = false; FindLivePos(nullptr); TryLiveAlt(); { static int fails = 0; if (LiveValid()) fails = 0; else if (fails < 6) fails++; g_FlyNext = now + (g_BgState == 1 ? 1ull : (1ull + static_cast<u64>(fails) * 2ull)) * 19200000ull; } /* 裏で探しているときは 1 秒ごとに結果を見る */ /* 見つからないあいだは、探す間隔を 1 秒から 13 秒まで伸ばす (走査のたびに落ちる危険があるため) */ if (!LiveValid()) { g_FlyWhy = 3; return; } }
        if (g_TrkStage == 3) g_FlyLiveAddr = g_LivePos;
        float L[3];
        if (!ReadLive(L)) { g_FlyWhy = 4; return; }
        if (g_TrkStage == 3) {
            if (g_NAct <= 0) g_TrkStage = 0; else { g_FlyWhy = 5; return; }
        }
        if (false && g_TrkStage == 0 && FlyFromX6(L)) return; /* x6近道は絞り込みなしで外れの写しを混ぜるため停止: 昔 (frame58〜79) と同じ「歩いて絞る」流れに戻す */ /* 028595E0 で拾った x6 の中に自分の座標があれば、歩かずにそれを使う */
        if (g_TrkStage == 0) {
            g_FlyWhy = 6; TrkStep(); /* 1: 写しを集める */
            g_Armed = false; g_ForceGlyph = 0;
            std::memcpy(g_FlyStepPos, L, 12);
            g_FlyNext = now + (g_TrkPend ? 1920000ull : (g_TrkStage == 1 ? 9600000ull : 57600000ull)); /* 裏で集めている間は 0.1 秒ごとに見る */ /* 集まったら 0.5 秒後から、集まらなければ 3 秒後にやり直し */
            return;
        }
        /* 2・3: 4 以上歩いたら絞る */
        const float mx = L[0] - g_FlyStepPos[0], mz = L[2] - g_FlyStepPos[2];
        if (mx * mx + mz * mz < 16.0f) return;
        TrkStep();
        g_Armed = false; g_ForceGlyph = 0;
        std::memcpy(g_FlyStepPos, L, 12);
        if (g_TrkStage == 3) g_FlyLiveAddr = g_LivePos;
        g_FlyNext = now + 9600000ull;
    }
    /* 全塗り (隙間なし): ステージにある「塗れる物」をぜんぶ、物ごとまるごと塗る要求 (kind 2) にして、塗りの待ち行列へ直接入れる。
       ゲーム自身の Paint_PaintSimple は、物の種類が決まった範囲のものしか出さないので、ステージによって塗れない所が出た。
       ここでは種類で選ばず、塗れる物(表の各要素)をすべて対象にする。待ち行列がいっぱいのときは、次のフレームに続きをやる。 */
    static void FillAllObjects(bool erase) {
        if (g_OffPaintRequest != 0x371D1C0) return; /* 11.3.0 以外では呼ばない */
        int idx = g_HaveIdx ? g_LocalIdx : FindLocalIdx();
        if (idx >= 0) { g_LocalIdx = idx; g_HaveIdx = true; }
        int team = idx >= 0 ? (idx >> 2) : 0;
        if (g_DrawTeam == 1) team = 0; else if (g_DrawTeam == 2) team = 1;
        g_FillErase = erase; g_FillTeam = team; g_FillCur = 0; g_FillSeen = 0; g_FillPushed = 0; g_FillSkip = 0; g_FillRun = true; g_FillDiagUntil = NowTick() + 19200000ull * 40;
        for (int i = 0; i < 6; i++) { g_FillTy[i] = -1; g_FillTyN[i] = 0; }
    }
    static void FillAllStep() {
        if (!g_FillRun) return;
        const uintptr_t mgr = ReadPaintMgr();
        if (!mgr || !Readable(mgr + 0x2c0, 8) || !Readable(mgr + 0x2d8, 8)) { g_FillRun = false; return; }
        const uintptr_t om = *reinterpret_cast<const uintptr_t*>(mgr + 0x2c0);
        const uintptr_t q  = *reinterpret_cast<const uintptr_t*>(mgr + 0x2d8);
        if (!om || !q || !Readable(om + 0x390, 0x10) || !Readable(q + 0x300, 0x20)) { g_FillRun = false; return; }
        if (*reinterpret_cast<const u32*>(om + 0x2bc) & 1u) return; /* 物の表を作り直し中: 次のフレームにまわす */
        const s32 cnt = *reinterpret_cast<const s32*>(om + 0x390);
        const uintptr_t arr = *reinterpret_cast<const uintptr_t*>(om + 0x398);
        if (cnt <= 0 || !arr || !Readable(arr, static_cast<size_t>(cnt) * 8)) { g_FillRun = false; return; }
        g_FillSeen = cnt;
        using InitFn = void (*)(void*, int, int);
        using PushFn = void (*)(void*, void*);
        const auto initFn = reinterpret_cast<InitFn>(MainBase() + 0x371CE50);
        const auto pushFn = reinterpret_cast<PushFn>(MainBase() + 0x36EAA2C);
        /* 通信であふれて他の人が落ちないように、1 つずつゆっくり (約 0.1 秒に 1 つ) 出す */
        const u64 nowT = NowTick();
        if (nowT < g_FillNextT) return;
        using SendFn = u64 (*)(void*, void*);
        const auto sendFn = reinterpret_cast<SendFn>(MainBase() + 0x371F940); /* Paint_Request が flag=1 のときに呼ぶ、通信へ送る関数 */
        const uintptr_t net = Readable(mgr + 0x2e8, 8) ? *reinterpret_cast<const uintptr_t*>(mgr + 0x2e8) : 0;
        int budget = 1;
        while (g_FillCur < cnt && budget > 0) {
            const s32 used = *reinterpret_cast<const s32*>(q + 0x300), cap = *reinterpret_cast<const s32*>(q + 0x318);
            if (used + 4 >= cap) break; /* 待ち行列に空きがない: 次のフレームに続ける */
            const int i = g_FillCur++;
            const uintptr_t obj = reinterpret_cast<const uintptr_t*>(arr)[i];
            if (!obj || !Readable(obj + 0x18, 8)) { g_FillSkip++; continue; }
            if (Readable(obj + 0x54, 1)) { /* 物の種類ごとの数を数える (どのステージで塗れないかの手がかり) */
                const int ty = *reinterpret_cast<const u8*>(obj + 0x54); int sl = -1;
                for (int k = 0; k < 6; k++) if (g_FillTy[k] == ty) { sl = k; break; }
                if (sl < 0) for (int k = 0; k < 6; k++) if (g_FillTy[k] < 0) { sl = k; g_FillTy[k] = ty; break; }
                if (sl >= 0) g_FillTyN[sl]++;
            }
            const uintptr_t pt = *reinterpret_cast<const uintptr_t*>(obj + 0x18);
            if (!pt || !Readable(pt + 0x18, 4) || *reinterpret_cast<const s32*>(pt + 0x18) == -1) { g_FillSkip++; continue; } /* ゲームの許可判定と同じ確かめ */
            alignas(16) u8 r[0x60] = {};
            static const int kEraseVals[3] = { 0, 1, 2 };
            const int team = g_FillErase ? kEraseVals[g_EraseSel % 3] : g_FillTeam;
            r[0] = static_cast<u8>((team == -1 || team == 3) ? 8 : team + 8);
            /* +4 はゲームの60Hzのフレーム番号。古い番号だと「古い塗り」として無視され、すでにあるインクの上に重ならない。
               最後に見たゲームの番号から、経った時間ぶん進めた「いまの番号」にする。 */
            const u32 seq = g_HaveSeq ? g_SeqRef + static_cast<u32>((NowTick() - g_SeqTick) / g_SeqTpf) + 30u : static_cast<u32>(NowTick() / 320000ull);
            std::memcpy(r + 4, &seq, 4);
            const float one = 1.0f; std::memcpy(r + 0x24, &one, 4); std::memcpy(r + 0x2C, &one, 4);
            std::memcpy(r + 0x34, &team, 4);
            const u32 kind = 2; std::memcpy(r + 0x38, &kind, 4);
            const u16 id = static_cast<u16>(i); std::memcpy(r + 0x3E, &id, 2);
            const u32 sz = 50, qt = 3; std::memcpy(r + 0x40, &sz, 4); std::memcpy(r + 0x44, &qt, 4);
            r[0x48] = 0xFF;
            initFn(r, 0, 1);
            if (net && kBroadcast) sendFn(reinterpret_cast<void*>(net), r); /* 他の人にも送る (部屋の友達の画面にも塗られる) */
            pushFn(reinterpret_cast<void*>(q), r);
            g_FillPushed++; budget--;
            g_FillNextT = nowT + 864000ull; /* 0.045 秒 */
        }
        if (g_FillCur >= cnt) g_FillRun = false;
    }
    /* 試合情報: 塗りマネージャの状態を読む。ステージ名・ルール名は、メモリの中の文字列から探す (候補) */
    static void InfoScan() {
        /* 読み込み中や、ゲームがメモリを解放している最中に走査すると落ちるので、
           64KB ごとに読めるかを確かめ直しながら (ScanSafe) 探す */
        for (int i = 0; i < 3; i++) { g_InfoStage[i][0] = 0; g_InfoRule[i][0] = 0; }
        int ns = 0, nr = 0;
        const u64 t0 = NowTick();
        MemoryInfo selfmi; u32 selfpg; uintptr_t selfLo = 0, selfHi = 0;
        if (R_SUCCEEDED(svcQueryMemory(&selfmi, &selfpg, reinterpret_cast<uintptr_t>(g_InfoStage)))) { selfLo = selfmi.addr; selfHi = selfmi.addr + selfmi.size; }
        uintptr_t addr = 0;
        for (int guard = 0; guard < 8192 && (ns < 3 || nr < 3); guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            if ((mi.type == 4 || mi.type == 5) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xFF) && mi.size >= 0x100 && mi.size < 0x40000000ull && !(mi.addr >= selfLo && mi.addr < selfHi)) {
                ScanSafe(mi.addr, mi.size / 4, 14, [&](const u32* w, size_t from, size_t to) {
                    for (size_t i = from; i < to && (ns < 3 || nr < 3); i++) {
                        const u32 v = w[i];
                        const bool isStage = (v == 0x5F646C46u); /* "Fld_" */
                        const bool isRule  = (v == 0x75527356u); /* "VsRu" */
                        if (!isStage && !isRule) continue;
                        const u8* c = reinterpret_cast<const u8*>(w + i);
                        char t[48]; int len = 0;
                        while (len < 47 && c[len] >= 0x20 && c[len] < 0x7F) { t[len] = static_cast<char>(c[len]); len++; }
                        if (len >= 47 || c[len] != 0 || len < 6) continue;
                        t[len] = 0;
                        if (isRule) {
                            if (len >= 40 || nr >= 3) continue;
                            bool dup = false; for (int k = 0; k < nr; k++) if (!std::strcmp(g_InfoRule[k], t)) dup = true;
                            if (!dup) { std::memcpy(g_InfoRule[nr], t, static_cast<size_t>(len) + 1); nr++; }
                        } else {
                            if (ns >= 3) continue;
                            bool dup = false; for (int k = 0; k < ns; k++) if (!std::strcmp(g_InfoStage[k], t)) dup = true;
                            if (!dup) { std::memcpy(g_InfoStage[ns], t, static_cast<size_t>(len) + 1); ns++; }
                        }
                    }
                });
            }
            if (end <= addr || end == 0) break;
            addr = end;
            if (NowTick() - t0 > 19200000ull * 2) break; /* 2 秒でやめる */
        }
        g_InfoScanned = 1;
    }
    /* ステータス表示用に、足元の座標の場所だけ探しておく (文字は描く側で毎フレーム作る) */
    static void HudTick() {
        if (!(g_Fx[18] || g_Fx[19])) return;
        static u64 nx = 0; const u64 now = NowTick();
        if (!LiveValid() && now > nx) { nx = now + 57600000ull; g_LivePos = 0; g_LiveAlt = false; FindLivePos(nullptr); TryLiveAlt(); }
    }
    static void InfoTick() {
        if (!g_InfoOn) return;
        static u64 next = 0;
        if (g_InfoReq && StageStable()) { g_InfoReq = false; g_InfoScanned = 0; InfoScan(); } /* 場面が落ち着くまで (20 秒) 待ってから探す */
        const u64 now = NowTick();
        if (now < next) return;
        next = now + 9600000ull;
        const uintptr_t mgr = ReadPaintMgr();
        g_InfoMgr = mgr != 0;
        g_InfoCnt = -1; g_InfoState = -1; g_InfoFlag = -1;
        if (!mgr || !Readable(mgr + 0x2c0, 8)) return;
        const uintptr_t om = *reinterpret_cast<const uintptr_t*>(mgr + 0x2c0);
        if (!om) return;
        if (Readable(om + 0x390, 4)) g_InfoCnt = *reinterpret_cast<const s32*>(om + 0x390);
        if (Readable(om + 0x2b8, 4)) g_InfoFlag = static_cast<int>(*reinterpret_cast<const u32*>(om + 0x2b8) & 1u);
        if (Readable(om + 0x308, 8)) {
            const uintptr_t sp = *reinterpret_cast<const uintptr_t*>(om + 0x308);
            if (sp && Readable(sp + 0x3a8, 4)) g_InfoState = static_cast<int>(*reinterpret_cast<const u32*>(sp + 0x3a8) & 0xFFFFu);
        }
        if (!g_HaveIdx) { const int fi = FindLocalIdx(); if (fi >= 0) { g_LocalIdx = fi; g_HaveIdx = true; } }
    }
    static void DriveFromHid() {
        if (!kDriveFromHid)
            return; /* 塗りを一度も見ていなくても動かす (ナワバリ以外でも使えるように) */
        if (__atomic_exchange_n(&g_Busy, true, __ATOMIC_ACQUIRE))
            return;
        /* 追跡スキャンと、書き換え実験 */
        if (!kEnableTrk) { g_ReqScan = false; g_ReqProbe = false; g_ReqYes = false; g_ReqNo = false; }
        if (g_ReqScan) { g_ReqScan = false; TrkStep(); }
        FlyAuto();
        if (g_FillAllReq) { g_FillAllReq = false; FillAllObjects(false); }
        if (g_EraseReq) { g_EraseReq = false; FillAllObjects(true); }
        FillAllStep();
        InfoTick();
        HudTick();
        UpdateFuncOn();
        if (g_ImgReq && g_Mounted) { g_ImgReq = false; ImgScan(); }
        { static u64 imgTry = 0; if (g_ImgReq && !g_Mounted && NowTick() > imgTry) { imgTry = NowTick() + 19200000ull * 3; LoadImageFile(); } } /* マウントを済ませてから一覧を作る */
        if (g_ReqRefs) {
            g_ReqRefs = false;
            if (!LiveValid()) { g_LivePos = 0; FindLivePos(nullptr); }
            if (LiveValid()) { g_PlrBase = PlayerTableBase(); WriteTrkFile(5); if (g_MN > 0) g_TrkStage = 0; g_ForceGlyph = 1; } else g_ForceGlyph = 3;
            g_Armed = true;
        }
        if (g_ReqProbe && g_MN > 0 && g_TrkStage != 3) {
            /* 右キー: 1つずつ候補を選ぶ。上キー/下キーで、選んだ1つだけの高さを動かす。 */
            g_ReqProbe = false;
            /* 1回目の右キーで、いきなり9番 (浮いた候補) を選ぶ。2回目以降は1つずつ進む。 */
            /* 右キー: 1回目 = 浮く (9番)、2回目 = 滑る (8番)、3回目 = また浮く ... の繰り返し */
            if (g_MN > 8) g_MSel = (g_MSel == 8) ? 7 : 8;
            else g_MSel = (g_MSel + 1) % g_MN;
            g_ForceGlyph = (g_MSel & 1) ? 2 : 4; g_Armed = true;
        }
        if (g_ReqProbe) {
            g_ReqProbe = false;
            if (g_NTrk > 0 && g_TrkStage == 3 && g_Master < 0 && !g_Banded) {
                /* 右キー: 高さの帯を順に切り替える (全部 / 足元 / ... )。体の本体がどの帯にあるか探す。 */
                static const float lo[7] = {-1e9f, -2.55f, -1.95f, -1.65f, -1.35f, -1.05f, -1e9f};
                static const float hi[7] = { 1e9f, -2.0f, -1.65f, -1.35f, -1.05f, -0.8f, 1e9f};
                g_BandMode = 1;
                for (int tries = 0; tries < 8; tries++) {
                    g_BandNo = (g_BandNo + 1) % 7;
                    int k2 = 0;
                    for (int i = 0; i < g_NTrk; i++) {
                        const float dy = g_TrkVal[i][1] - g_BandL1;
                        bool in;
                        if (g_BandNo == 0) in = true;
                        else if (g_BandNo == 6) in = (dy <= -2.55f || dy >= -0.8f);
                        else in = (dy > lo[g_BandNo] && dy <= hi[g_BandNo]);
                        if (in) g_Act[k2++] = i;
                    }
                    if (k2 > 0) { g_NAct = k2; break; }
                }
                g_ForceGlyph = (g_BandNo & 1) ? 4 : 2;
                g_Armed = true;
            } else if (g_NTrk > 0 && g_TrkStage == 3 && g_NAct > 1 && g_Master < 0) {
                /* 右キー: 半分に分ける。もう一度押すと、もう半分に切り替える。 */
                if (g_SplitState == 0) {
                    g_NPar = g_NAct;
                    for (int i = 0; i < g_NPar; i++) g_Par[i] = g_Act[i];
                    const int h = g_NPar / 2;
                    for (int i = 0; i < h; i++) g_Act[i] = g_Par[i];
                    g_NAct = h; g_SplitState = 1; g_ForceGlyph = 4;
                } else if (g_SplitState == 1) {
                    const int h = g_NPar / 2;
                    for (int i = h; i < g_NPar; i++) g_Act[i - h] = g_Par[i];
                    g_NAct = g_NPar - h; g_SplitState = 2; g_ForceGlyph = 2;
                } else {
                    const int h = g_NPar / 2;
                    for (int i = 0; i < h; i++) g_Act[i] = g_Par[i];
                    g_NAct = h; g_SplitState = 1; g_ForceGlyph = 4;
                }
                g_Armed = true;
            } else if (g_Master < 0) { g_ForceGlyph = 3; g_Armed = true; }
        }
        if (g_TrkStage == 3) TrkBisect();
        WarpStartTick();
        TrkRise();
        RespawnTick();
        /* カメラの追従先を上げ下げする (十字キー上/下)。動いた回数を数え、最初と少し後に状態を書き出す。 */
        if (g_RiseDir != 0) {
            g_RiseTicks++;
            if (g_RiseTicks == 2 || g_RiseTicks == 120) { const float z3[3] = {}; CamUpdate(); WriteStatus(0x400, z3); }
        }
        CamUpdate(); WallUpdate();
        if (false && kEnableTrk && g_RiseDir != 0 && g_Master >= 0 && g_TestState == 0) {
            const uintptr_t a = g_Trk[g_Master];
            if (Readable(a, 12) && TrkWritable(a)) reinterpret_cast<float*>(a)[1] += 0.25f * static_cast<float>(g_RiseDir);
        }
        const bool armedNow = g_Armed;
        if (armedNow) g_PressCount++;
        const bool hadTmpl = g_HaveTmpl;
        if (g_Armed && g_HaveTmpl)
            BeginDraw(&g_Tmpl, g_TmplA2);
        if (g_Cursor >= 0)
            EmitDots(kDotsPerCall);
        else if (g_Trail) TrailTick();
        EnInkTick(); /* 相手の座標の下にインクを塗る */
        DiagTick();
        if (armedNow) {
            float tp[3] = {};
            if (hadTmpl) std::memcpy(tp, g_Tmpl.raw + kOffPos, 12);
            const u64 flags = (hadTmpl ? 1u : 0u) | (g_FireHeld ? 2u : 0u) | (PosObjValid() ? 4u : 0u) | (LiveValid() ? 8u : 0u) | (g_HavePosCopy ? 16u : 0u) | (g_Armed ? 32u : 0u) | (g_TmplOwn ? 64u : 0u);
            WritePlayers();
            WriteStatus(flags, tp);
        }
        __atomic_store_n(&g_Busy, false, __ATOMIC_RELEASE);
    }

    /* 毎フレーム: 足元の座標の動きとスティックの向きから、カメラの向きを覚える */
    static void LearnCamDir() {
        float L[3];
        if (!ReadLive(L)) { g_LearnHave = false; return; }
        if (g_LearnHave) {
            const float mx = (L[0] - g_LearnPrev[0]) - g_FlyApplied[0];
            const float mz = (L[2] - g_LearnPrev[2]) - g_FlyApplied[2];
            const float mm = mx * mx + mz * mz;
            const float sx = g_LStickX, sy = g_LStickY;
            const float sm = sx * sx + sy * sy;
            const bool pushed = (g_FlyApplied[0] != 0.0f || g_FlyApplied[2] != 0.0f); /* こちらが動かしたフレームは学習しない (向きが回り続けるのを防ぐ) */
            if (!pushed && mm > 0.0004f && mm < 4.0f && sm > 0.25f) {
                /* Fs = m / q = m * conj(q) / |q|^2,  q = sy + i sx */
                const float qr = sy, qi = sx;
                float fr = (mx * qr + mz * qi), fi = (mz * qr - mx * qi);
                const float fl = __builtin_sqrtf(fr * fr + fi * fi);
                if (fl > 1e-6f) {
                    fr /= fl; fi /= fl;
                    /* 向きが急に大きくずれた観測 (慣性・壁・ノックバックなど) は、続けて何度も出るまで信じない */
                    static int outCnt = 0; static float psx = 0.0f, psy = 0.0f;
                    const bool stable = (sx * psx + sy * psy) > 0.8f * sm; psx = sx; psy = sy;
                    bool skip = !stable;
                    if (g_CamFOk && !skip) { const float dt = fr * g_CamF[0] + fi * g_CamF[1]; if (dt < 0.5f) { if (++outCnt < 15) skip = true; } else outCnt = 0; }
                    if (skip) { std::memcpy(g_LearnPrev, L, 12); g_LearnHave = true; g_FlyApplied[0] = 0.0f; g_FlyApplied[2] = 0.0f; return; }
                    if (g_WarpMark || g_WarpOn) CamDirCalib(fr, fi, sx * sx > 0.25f * sm); /* ワープ地点を使っているときだけ、カメラの向きの値を探す (横に倒しているか) */
                    if (!g_CamFOk) { g_CamF[0] = fr; g_CamF[1] = fi; g_CamFOk = true; }
                    else {
                        float nr = g_CamF[0] * 0.6f + fr * 0.4f, ni = g_CamF[1] * 0.6f + fi * 0.4f;
                        const float nl = __builtin_sqrtf(nr * nr + ni * ni);
                        if (nl > 1e-6f) { g_CamF[0] = nr / nl; g_CamF[1] = ni / nl; }
                    }
                }
            }
        }
        std::memcpy(g_LearnPrev, L, 12);
        g_LearnHave = true;
        g_FlyApplied[0] = 0.0f; g_FlyApplied[2] = 0.0f;
    }

    /* 「飛ぶ」を ON にしたときの探索は、少しずつ (1 フレームに数十領域まで) 進める。一度にやると一瞬固まる */
    static bool LcScanPageSlice() {
        const uintptr_t vt = MainBase() + kLiveVtable;
        int pages = 0;
        for (int guard = 0; guard < 40 && pages < 12000 && g_LcN < kLcMax; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, g_PsAddr))) return true;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && !(mi.attr & 0xC);
            if (ok && mi.size >= 0x1000) {
                uintptr_t a = (mi.addr & ~0xFFFull) + kLivePageOff;
                if (a < mi.addr) a += 0x1000;
                if (a < g_PsAddr) a = ((g_PsAddr - kLivePageOff + 0xFFF) & ~0xFFFull) + kLivePageOff;
                uintptr_t lim = end;
                if (a + static_cast<uintptr_t>(12000 - pages) * 0x1000 < lim) lim = a + static_cast<uintptr_t>(12000 - pages) * 0x1000;
                for (; a + 8 <= lim && g_LcN < kLcMax; a += 0x1000, pages++) {
                    if (*reinterpret_cast<const uintptr_t*>(a) != vt) continue;
                    const uintptr_t pos = a - kLivePosToVt;
                    if (pos < mi.addr) continue;
                    const float* f = reinterpret_cast<const float*>(pos);
                    if (!Plausible(f)) continue;
                    g_LcAddr[g_LcN] = pos; std::memcpy(g_LcPrev[g_LcN], f, 12); g_LcScore[g_LcN] = 0; g_LcN++;
                }
                g_PsAddr = lim;
                if (lim < end) continue;
            } else g_PsAddr = end;
            if (end <= mi.addr || end == 0) return true;
            g_PsAddr = end;
        }
        return g_LcN >= kLcMax;
    }
    static void LcScan() {
        g_LcN = 0;
        const uintptr_t vt = MainBase() + kLiveVtable;
        uintptr_t addr = 0;
        for (int guard = 0; guard < 8192 && g_LcN < kLcMax; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && !(mi.attr & 0xC);
            if (ok && mi.size >= 0x1000) {
                uintptr_t a = (mi.addr & ~0xFFFull) + kLivePageOff;
                if (a < mi.addr) a += 0x1000;
                const uintptr_t scanEnd2 = (mi.size == 0x1741000ull && end - mi.addr > 0x1400000ull) ? mi.addr + 0x1400000ull : end; /* 後ろの方に読むと落ちる部分がある領域 */
                for (; a + 8 <= scanEnd2 && g_LcN < kLcMax; a += 0x1000) {
                    if (*reinterpret_cast<const uintptr_t*>(a) != vt) continue;
                    const uintptr_t pos = a - kLivePosToVt;
                    if (pos < mi.addr) continue;
                    const float* f = reinterpret_cast<const float*>(pos);
                    if (!Plausible(f)) continue;
                    g_LcAddr[g_LcN] = pos; std::memcpy(g_LcPrev[g_LcN], f, 12); g_LcScore[g_LcN] = 0; g_LcN++;
                }
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
    }
    /* フリーフライの準備中だけ動く: 候補が複数あるとき、スティックを倒すと動き、離すと止まるものが自分 */
    /* ステージによって座標の入れ物の位置が 0x948 でないことがあるので、見つからないときは 8 バイトごとに全部探す。
       一度に重くならないよう、1 フレームに 8MB ずつ進める。 */
    static void LcScanSlice() {
        const uintptr_t vt = MainBase() + kLiveVtable;
        size_t budget = 3u << 20; /* 1 フレームに 3MB まで (重くならないように) */
        for (int guard = 0; guard < 256 && budget > 0 && g_LcN < kLcMax; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, g_FbAddr))) { g_FbOn = false; g_FbAddr = 0; g_FbDone++; return; }
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && !(mi.attr & 0xC);
            if (ok && mi.size >= 0x1000) {
                uintptr_t a = (g_FbAddr > mi.addr ? g_FbAddr : mi.addr);
                a = (a + 7) & ~7ull;
                uintptr_t limit = a + budget; if (limit > end || limit < a) limit = end;
                for (; a + 8 <= limit && g_LcN < kLcMax; a += 8) {
                    if ((a & 0xFFF) == 0) { MemoryInfo m2; u32 pg2; if (R_FAILED(svcQueryMemory(&m2, &pg2, a)) || !(m2.perm & Perm_R) || (m2.attr & 0xC)) break; }
                    if (*reinterpret_cast<const uintptr_t*>(a) != vt) continue;
                    if (a < mi.addr + kLivePosToVt) continue;
                    g_FbRaw++;
                    const uintptr_t pos = a - kLivePosToVt;
                    const float* f = reinterpret_cast<const float*>(pos);
                    if (!Plausible(f)) continue;
                    g_LcAddr[g_LcN] = pos; std::memcpy(g_LcPrev[g_LcN], f, 12); g_LcScore[g_LcN] = 0; g_LcN++;
                }
                g_FbBytes += limit - a + 0; g_FbRegions++;
                const size_t used = limit - (g_FbAddr > mi.addr ? g_FbAddr : mi.addr);
                budget = used >= budget ? 0 : budget - used;
                g_FbAddr = limit;
            } else g_FbAddr = end;
            if (end == 0 || end <= mi.addr) { g_FbOn = false; g_FbAddr = 0; g_FbDone++; return; }
        }
    }
    static void LcTick() {
        if (g_MenuOpen) return;
        const float sm = g_LStickX * g_LStickX + g_LStickY * g_LStickY;
        if (g_LiveConfirmed) {
            if (!Readable(g_LiveConfAddr, 0x30) || *reinterpret_cast<const uintptr_t*>(g_LiveConfAddr + kLivePosToVt) != MainBase() + kLiveVtable) { g_LiveConfirmed = false; g_LcN = 0; g_LcState = 0; g_LcConfHave = false; return; }
            /* 確定したあとも見張る: スティックを倒しているのにずっと動かないなら、自分ではない (別の試合の物など) */
            float f[3]; std::memcpy(f, reinterpret_cast<const void*>(g_LiveConfAddr), 12);
            { static int imp = 0; if (!Plausible(f)) { if (++imp > 90) { imp = 0; g_LiveConfirmed = false; g_LcN = 0; g_LcState = 0; g_LcConfHave = false; g_LcNextScan = 0; return; } } else imp = 0; } /* 座標が 0 や変な値のまま続く入れ物は、自分ではない: 探し直す */
            if (g_LcConfHave && sm > 0.36f) {
                const float mx = f[0] - g_LcConfPrev[0], mz = f[2] - g_LcConfPrev[2];
                if (mx * mx + mz * mz > 0.0004f) g_LcBad = 0; else if (++g_LcBad > 240) { g_LiveConfirmed = false; g_LcN = 0; g_LcState = 0; g_LcBad = 0; g_LcConfHave = false; return; }
            }
            std::memcpy(g_LcConfPrev, f, 12); g_LcConfHave = true;
            return;
        }
        if (!g_ModeOn && !g_FbOn && sm < 0.25f) return; /* 歩いていないときは探さない (メモリ全体を調べるので重い) */
        const u64 now = NowTick();
        if (g_FbOn) { LcScanSlice(); if (g_LcN >= kLcMax) g_FbOn = false; if (g_FbOn) return; g_LcState = g_LcN ? 1 : 0; if (g_LcN == 1) { g_LiveConfAddr = g_LcAddr[0]; g_LiveConfirmed = true; g_LiveKey = PaintCtxKey(); g_LcConfHave = false; g_LcBad = 0; g_LcState = 2; g_LcSince = 0; } if (g_LcN == 0) g_LcNextScan = now + 19200000ull * 8; return; }
        if (g_PsOn || g_LcN == 0) {
            if (!g_PsOn) {
                if (now < g_LcNextScan) return;
                g_LcNextScan = now + 19200000ull * 4; /* 見つからなければ 4 秒後にまた */
                g_PsOn = true; g_PsAddr = 0; g_LcN = 0;
            }
            if (!LcScanPageSlice()) return;
            g_PsOn = false; g_LcState = g_LcN ? 1 : 0;
            if (g_LcN == 0) { g_FbOn = true; g_FbAddr = 0; g_FbRaw = 0; g_FbRegions = 0; g_LcNextScan = 0; }
            if (g_LcN == 1) { g_LiveConfAddr = g_LcAddr[0]; g_LiveConfirmed = true; g_LiveKey = PaintCtxKey(); g_LcConfHave = false; g_LcBad = 0; g_LcState = 2; g_LcSince = 0; }
            return;
        }
        { /* 候補が全部消えた / 長いこと決まらない: 探し直す */
            int alive = 0;
            for (int i = 0; i < g_LcN; i++) if (Readable(g_LcAddr[i], 0x30) && *reinterpret_cast<const uintptr_t*>(g_LcAddr[i] + kLivePosToVt) == MainBase() + kLiveVtable) alive++;
            if (g_LcSince == 0) g_LcSince = now;
            if (alive == 0 || now - g_LcSince > 19200000ull * 25) { g_LcN = 0; g_LcNextScan = 0; g_LcSince = 0; return; }
        }
        if (g_HavePosCopy && g_PosCopyTick && now - g_PosCopyTick < 19200000ull * 60) {
            /* 撃った瞬間の自分の位置 (確かな値) に一番近い候補を、自分として決める */
            const float rx = g_PosCopy[0], ry = g_PosCopy[2] + kPosObjHeight, rz = -g_PosCopy[1];
            int nb = -1; float d1 = 1e9f, d2 = 1e9f;
            for (int i = 0; i < g_LcN; i++) {
                if (!Readable(g_LcAddr[i], 0x30) || *reinterpret_cast<const uintptr_t*>(g_LcAddr[i] + kLivePosToVt) != MainBase() + kLiveVtable) continue;
                const float* f = reinterpret_cast<const float*>(g_LcAddr[i]);
                const float dx = f[0] - rx, dz = f[2] - rz, dy = f[1] - ry;
                if (dy > 6.0f || dy < -6.0f) continue;
                const float d = dx * dx + dz * dz;
                if (d < d1) { d2 = d1; d1 = d; nb = i; } else if (d < d2) d2 = d;
            }
            if (nb >= 0 && d1 < 36.0f && (d2 > d1 * 4.0f + 1.0f)) {
                g_LiveConfAddr = g_LcAddr[nb]; g_LiveConfirmed = true; g_LiveKey = PaintCtxKey(); g_LcConfHave = false; g_LcBad = 0; g_LcState = 2; g_LcSince = 0;
                return;
            }
        }
        int best = -1, second = -1;
        for (int i = 0; i < g_LcN; i++) {
            if (!Readable(g_LcAddr[i], 0x30) || *reinterpret_cast<const uintptr_t*>(g_LcAddr[i] + kLivePosToVt) != MainBase() + kLiveVtable) { g_LcScore[i] = -1000; continue; }
            float f[3]; std::memcpy(f, reinterpret_cast<const void*>(g_LcAddr[i]), 12);
            const float mx = f[0] - g_LcPrev[i][0], mz = f[2] - g_LcPrev[i][2];
            const bool moved = (mx * mx + mz * mz) > 0.0004f && (mx * mx + mz * mz) < 25.0f;
            std::memcpy(g_LcPrev[i], f, 12);
            if (sm > 0.36f) g_LcScore[i] += moved ? 1 : -1;
            else if (sm < 0.01f && moved) g_LcScore[i] -= 2;
            if (g_LcScore[i] > 200) g_LcScore[i] = 200;
            if (best < 0 || g_LcScore[i] > g_LcScore[best]) { second = best; best = i; }
            else if (second < 0 || g_LcScore[i] > g_LcScore[second]) second = i;
        }
        if (best >= 0 && g_LcScore[best] >= 15 && (second < 0 || g_LcScore[best] - g_LcScore[second] >= 8)) {
            g_LiveConfAddr = g_LcAddr[best]; g_LiveConfirmed = true; g_LiveKey = PaintCtxKey(); g_LcConfHave = false; g_LcBad = 0; g_LcState = 2; g_LcSince = 0;
        }
    }
    static void PreFrame() {
        LcTick();
        if (g_PendingGlyph) { g_ForceGlyph = g_PendingGlyph; g_PendingGlyph = 0; g_Armed = true; }
        TrkApplyWrites(); LearnCamDir(); g_InPre = true; TrkRise(); g_InPre = false; Ft2Tick();
    }
    static void InstallDrive() { g_DriveFn = &DriveFromHid; g_PreFn = &PreFrame; }

    static u64 Callback(PaintRequest* req, u64 a2) {
        /* 全塗り(隙間なし): ゲームが作った「物まるごと塗る」要求を、ゲームの許可判定 (CheckEnable) を通さずに塗りの待ち行列へ直接入れる。
           許可判定は試合の状態などで断られることがあり、それが「何も起きない」原因になりうるため。 */
        if (g_FillActive) {
            g_FillSeen++;
            const uintptr_t mgr = ReadPaintMgr();
            if (mgr && Readable(mgr + 0x2d8, 8)) {
                void* q = *reinterpret_cast<void**>(mgr + 0x2d8);
                if (q) {
                    using PushFn = void (*)(void*, PaintRequest*);
                    reinterpret_cast<PushFn>(exl::util::modules::GetTargetOffset(0x36EAA2C))(q, req);
                    g_FillPushed++;
                }
            }
            return 0;
        }
        /* 自分が出したドットはそのまま通す。 */
        if (g_Emitting)
            return Orig(req, a2);

        g_TlsCb = ReadTls(); g_CntCb++; g_DgHookPaint++;
        { u32 sq; std::memcpy(&sq, req->raw + 4, 4); if (sq != 0) {
            const u64 nt = NowTick();
            /* ゲームが重いと 60Hz より遅く進む。長く間があいたときに、実際の進み方を測って、番号のずれを防ぐ */
            if (g_HaveSeq && nt - g_SeqTick >= 9600000ull && sq > g_SeqRef + 20u) {
                const u64 tpf = (nt - g_SeqTick) / static_cast<u64>(sq - g_SeqRef);
                if (tpf >= 250000ull && tpf <= 1500000ull) g_SeqTpf = static_cast<u32>((static_cast<u64>(g_SeqTpf) * 3ull + tpf) / 4ull);
            }
            if (!g_HaveSeq || sq != g_SeqRef || nt - g_SeqTick > 320000ull) { g_SeqRef = sq; g_SeqTick = nt; g_HaveSeq = true; g_SeqFrame = g_CntFrame; }
        } }
        /* ステージが変わって PaintMgr が作り直されたら、状態を捨てる。 */
        const uintptr_t mgr = ReadPaintMgr();
        if (mgr != g_LastMgr) {
            g_LastMgr = mgr;
            g_Cursor  = -1;
            g_Armed   = false; g_FillPending = 0; g_FillAllReq = false; g_FillRun = false; /* ボタンを押さないのに描き始めないようにする (以前は自動で描いていた) */
            g_Locked  = false;
            g_PosObj  = 0;
            g_LivePos = 0;
            g_HavePosCopy = false;
            g_CalibEvents = 0;
            g_BestScore = 0;
            g_HaveLastHit = false;
            std::memset(g_ScoreObj, 0, sizeof(g_ScoreObj));
            std::memset(g_ScoreSub, 0, sizeof(g_ScoreSub));
        }

        if (g_FireHeld && IsPointPaint(req)) {
            float h[3];
            std::memcpy(h, req->raw + kOffPos, sizeof(h));
            if (h[0] == h[0] && h[1] == h[1] && h[2] == h[2]) {
                std::memcpy(g_LastHit, h, sizeof(h));
                g_HaveLastHit = true;
                if (kUsePlayerPos)
                    CalibrateWithHit(h, GetKind(req), req->raw[0x3e] | (req->raw[0x3f] << 8));
            }
        }

        if (INKDRAW_CAMPOS && (g_Armed || g_FireHeld)) {
            g_PosObj = 0;      /* 毎回見つけ直す (古いものは使わない) */
            FindPosObj();
            if (g_PosObj) {
                const float* f = reinterpret_cast<const float*>(g_PosObj + 0x10);
                if (f[0] == f[0] && f[1] == f[1] && f[2] == f[2]) {
                    g_PosCopy[0] = f[0]; g_PosCopy[1] = -f[2]; g_PosCopy[2] = f[1] - kPosObjHeight;
                    g_HavePosCopy = true; g_PosCopyTick = NowTick();
                    if (INKDRAW_LIVEPOS && g_FireHeld && !LiveValid())
                        FindLivePos(f);
                }
            }
        }

        if (INKDRAW_SCAN && g_FireHeld && IsPointPaint(req) && g_PosObj && PosObjValid()) {
            const float* f = reinterpret_cast<const float*>(g_PosObj + 0x10);
            if (f[0] == f[0] && f[1] == f[1] && f[2] == f[2]) {
                const float p[3] = { f[0], f[1], f[2] };
                ScanStep(p);
                g_Armed = true; /* 一歩終わったら、笑顔で知らせる */
            }
        }

        /* 敵の色の見本: 自分以外 (相手チームの人や、ステージのしかけ) が出した塗り。自分の番号が分かっているときは、自分の塗りは除く。 */
        const bool otherPaint = req->raw[0] > 15 || (g_HaveIdx && req->raw[0] != static_cast<u8>(g_LocalIdx) && (req->raw[0] >> 2) != (static_cast<u8>(g_LocalIdx) >> 2));
        if (!g_Emitting && IsPointPaint(req) && otherPaint) {
            /* 敵の色の塗り (ステージのしかけなど) を見本にしておく。絵の塗らない部分に使う。 */
            std::memcpy(&g_EnemyTmpl, req, sizeof(g_EnemyTmpl));
            g_EnemyTick = NowTick();
            g_HaveEnemy = true;
        }
        if (!g_Emitting && IsPointPaint(req) && req->raw[0] < 32) {
            float rp[3]; std::memcpy(rp, req->raw + 8, 12);
            const u16 rid = static_cast<u16>(req->raw[0x3e] | (req->raw[0x3f] << 8));
            if (rp[0] == rp[0] && rp[1] == rp[1] && rp[2] == rp[2] && rid != 0xFFFF) {
                int slot = -1; /* 同じ場所・同じ番号の見本は、新しく足さず更新する (1 か所を撃ち続けても、ほかの場所の見本が消えない) */
                for (int k = 0; k < g_FlN; k++) if (g_FlId[k] == rid) { const float ex = g_FlS[k][0] - rp[0], ey = g_FlS[k][1] - rp[1], ez = g_FlS[k][2] - rp[2]; if (ex * ex + ey * ey + ez * ez < 0.36f) { slot = k; break; } }
                if (slot < 0) { slot = g_FlPos; g_FlPos = (g_FlPos + 1) % 256; if (g_FlN < 256) g_FlN++; }
                std::memcpy(g_FlS[slot], rp, 12); g_FlId[slot] = rid; g_FlT[slot] = NowTickF();
            }
        }
        if (!g_Emitting && IsPointPaint(req) && req->raw[0] < 32 && LiveValid()) {
            /* 自分の足元 (3 マス以内) に出た塗りは、撃っていなくても自分の塗りとして見本にする。診断のため、12 マス以内のものも記録する。 */
            const float* lf = reinterpret_cast<const float*>(g_LivePos);
            float rp[3]; std::memcpy(rp, req->raw + 8, 12);
            const float dx = rp[0] - lf[0], dy = rp[1] + lf[2], d2 = dx * dx + dy * dy;
            u32 w44n; std::memcpy(&w44n, req->raw + 0x44, 4);
            if (d2 < 12.0f * 12.0f) { std::memcpy(g_NearRaw, req->raw, 0x60); g_NearN++; }
            if ((!g_TmplOwn || ((NowTick() - g_TmplTick > 20ull * 19200000ull || g_TmplKey != PaintCtxKey()) && (!g_HaveIdx || req->raw[0] == static_cast<u8>(g_LocalIdx)))) && d2 < 3.0f * 3.0f && w44n == 0) { /* 古い見本 (20 秒以上 / 試合が変わった) は、足元の自分の新しい塗りで取り直す */
                std::memcpy(&g_Tmpl, req, sizeof(g_Tmpl)); g_TmplA2 = a2; g_TmplTick = NowTick(); g_TmplKey = PaintCtxKey();
                g_HaveTmpl = true; g_TmplOwn = true; g_LocalIdx = req->raw[0]; g_HaveIdx = true; g_IdxSrc = 1; g_NearCap++;
            }
        }
        if (INKDRAW_HIDDRAW && (!g_HaveTmpl || !g_TmplOwn) && IsPointPaint(req)) {
            /* まだ撃っていなくても、ゲームが出した塗りを絵の元にしておく (ボタンだけで描くため) */
            std::memcpy(&g_Tmpl, req, sizeof(g_Tmpl));
            g_TmplA2 = a2;
            g_TmplTick = NowTick(); g_TmplKey = PaintCtxKey();
            g_HaveTmpl = true;
        }

        if (g_FireHeld && IsPointPaint(req)) {
            std::memcpy(&g_Tmpl, req, sizeof(g_Tmpl));
            g_TmplA2 = a2;
            g_TmplTick = NowTick(); g_TmplKey = PaintCtxKey();
            g_HaveTmpl = true;
            {
                u32 w44; std::memcpy(&w44, req->raw + 0x44, 4);
                bool near = false;
                if (LiveValid()) {
                    const float* lf = reinterpret_cast<const float*>(g_LivePos);
                    float rp[3]; std::memcpy(rp, req->raw + 8, 12);
                    const float dx = rp[0] - lf[0], dy = rp[1] + lf[2];
                    near = dx * dx + dy * dy < 30.0f * 30.0f;
                }
                std::memcpy(g_ShotRaw, req->raw, 0x60); g_ShotN++; if (near) g_ShotNear++;
                /* 撃っている最中で、自分の足元に近い塗りなら、自分の撃った塗り (番号は何番でも) */
                g_TmplOwn = req->raw[0] < 32 && (near || w44 == 0);
                if (g_TmplOwn) g_ShotOwn++;
                if (g_TmplOwn) { g_LocalIdx = req->raw[0]; g_HaveIdx = true; g_IdxSrc = 1; }
            }
        }

        /* 予約中に床塗りが来たら、それを絵の元にする。Orig() が中身を書き換えるので先にコピーする。 */
        if (g_Armed && IsPointPaint(req) && !__atomic_exchange_n(&g_Busy, true, __ATOMIC_ACQUIRE)) {
            if (g_Armed) BeginDraw(req, a2);
            __atomic_store_n(&g_Busy, false, __ATOMIC_RELEASE);
        }

        const u64 result = Orig(req, a2);

        if (g_Cursor >= 0 && !__atomic_exchange_n(&g_Busy, true, __ATOMIC_ACQUIRE)) {
            EmitDots(kDotsPerCall);
            __atomic_store_n(&g_Busy, false, __ATOMIC_RELEASE);
        }

        return result;
    }

};


/* ---- 描画 (NVN) の横取り: ImGui の第1段階 ---------------------------------------
   ゲームは SDK の nvnBootstrapLoader から描画関数を受け取る。そこを横取りして、
   nvnDeviceGetProcAddress と nvnQueuePresentTexture (画面に出す関数) をこちらの関数に差し替える。
   第1段階では、画面に出すたびに数えるだけ (落ちないことの確認)。 */
namespace {
/* 数値を文字にする (小数 dec 桁)。浮動小数の printf に頼らない */
void PutFix(char*& o, float v, int dec) {
    if (v < 0) { *o++ = '-'; v = -v; }
    int sc = 1; for (int i = 0; i < dec; i++) sc *= 10;
    long long iv = static_cast<long long>(v * static_cast<float>(sc) + 0.5f);
    char d[16]; int m = 0; long long ip = iv / sc, fp = iv % sc;
    do { d[m++] = static_cast<char>('0' + ip % 10); ip /= 10; } while (ip && m < 12);
    while (m) *o++ = d[--m];
    if (dec) { *o++ = '.'; for (int i = dec - 1; i >= 0; i--) { int dv = 1; for (int j = 0; j < i; j++) dv *= 10; *o++ = static_cast<char>('0' + (fp / dv) % 10); } }
}
void PutStr(char*& o, const char* t) { while (*t) *o++ = *t++; }
/* ステータスの文字を作る。描く直前 (毎フレーム) に呼ぶ。読むだけなので、描く側のスレッドで動かして安全 */
void HudRefresh() {
    if (!(g_Fx[18] || g_Fx[19] || g_Fx[20] || g_Fx[21] || g_ModeOn || NowTick() < g_FillDiagUntil)) { g_HudN = 0; return; }
    static u64 lastT = 0, fpsT = 0, fpsPres = 0; static float pp[3] = {}; static bool hp = false; static float spd = 0.0f, fps = 0.0f, spdSm = 0.0f;
    const u64 now = NowTick();
    float P[3] = {}; bool have = false;
    if (g_Fx[18] || g_Fx[19] || g_ModeOn) have = LiveValid() && ReadLive(P);
    const float dt = lastT ? static_cast<float>(now - lastT) / 19200000.0f : 0.0f;
    if (dt > 0.0005f) {
        if (have && hp) { const float dx = P[0] - pp[0], dz = P[2] - pp[2]; spd = __builtin_sqrtf(dx * dx + dz * dz) / dt; spdSm += (spd - spdSm) * 0.35f; }
        lastT = now;
    } else if (!lastT) lastT = now;
    if (have) { std::memcpy(pp, P, 12); hp = true; } else hp = false;
    { const u64 pr = nvnhook::g_Presents; const float w = fpsT ? static_cast<float>(now - fpsT) / 19200000.0f : 0.0f;
      if (!fpsT) { fpsT = now; fpsPres = pr; } else if (w >= 0.5f) { fps = static_cast<float>(pr - fpsPres) / w; fpsT = now; fpsPres = pr; } }
    int n = 0;
    auto line = [&](char*& o) { *o = 0; n++; };
    if (g_ModeOn) {
        char* o = g_HudLine[n]; PutStr(o, "飛行 : 状態 "); PutFix(o, static_cast<float>(g_TrkStage), 0); PutStr(o, " 候補"); PutFix(o, static_cast<float>(g_NAct), 0);
        PutStr(o, " 書込"); PutFix(o, static_cast<float>(g_FlyNw < 0 ? 0 : g_FlyNw), 0); PutStr(o, have ? " 座標OK" : " 座標なし"); line(o);
        
        o = g_HudLine[n]; PutStr(o, "入力 : 上下 "); PutFix(o, static_cast<float>(g_RiseDir), 0); PutStr(o, g_Hover ? " 浮遊中" : " 浮遊なし"); PutStr(o, " カメラ"); PutStr(o, g_CamFOk ? "OK" : "未学習"); line(o);
    }
    if (NowTick() < g_FillDiagUntil && g_FillSeen > 0) {
        char* o = g_HudLine[n]; PutStr(o, g_FillErase ? "全消し : 総数 " : "全塗り : 総数 "); PutFix(o, static_cast<float>(g_FillSeen), 0); PutStr(o, " 送信"); PutFix(o, static_cast<float>(g_FillPushed), 0); PutStr(o, " 除外"); PutFix(o, static_cast<float>(g_FillSkip), 0); line(o);
        o = g_HudLine[n]; PutStr(o, "型 :");
        for (int k = 0; k < 6; k++) if (g_FillTy[k] >= 0) { PutStr(o, " "); PutFix(o, static_cast<float>(g_FillTy[k]), 0); PutStr(o, "x"); PutFix(o, static_cast<float>(g_FillTyN[k]), 0); }
        line(o);
    }
    if (g_Fx[18]) { char* o = g_HudLine[n]; if (have) { PutStr(o, "座標 : "); PutFix(o, P[0], 1); PutStr(o, " "); PutFix(o, P[1], 1); PutStr(o, " "); PutFix(o, P[2], 1); } else PutStr(o, "座標 : 取得中..."); line(o); }
    if (g_Fx[19]) { char* o = g_HudLine[n]; PutStr(o, "速度 : "); PutFix(o, spdSm, 1); PutStr(o, " /秒"); line(o); }
    if (g_Fx[20]) { char* o = g_HudLine[n]; PutStr(o, "FPS : "); PutFix(o, fps, 0); PutStr(o, "  間隔 "); PutFix(o, static_cast<float>(g_IntervalGame), 0); line(o); }
    if (g_Fx[21]) {
        static const char* const kBn[16] = { "A", "B", "X", "Y", "LS", "RS", "L", "R", "ZL", "ZR", "+", "-", "Lf", "Up", "Rt", "Dn" };
        char* o = g_HudLine[n]; PutStr(o, "入力操作 : "); const u64 bt = g_HudBtn; bool any = false;
        for (int i = 0; i < 16; i++) if (bt & (1ull << i)) { PutStr(o, kBn[i]); *o++ = ' '; any = true; }
        if (!any) PutStr(o, "なし");
        line(o);
        o = g_HudLine[n]; PutStr(o, "スティック : L("); PutFix(o, g_HudSt[0], 2); PutStr(o, ","); PutFix(o, g_HudSt[1], 2); PutStr(o, ") R("); PutFix(o, g_HudSt[2], 2); PutStr(o, ","); PutFix(o, g_HudSt[3], 2); PutStr(o, ")"); line(o);
    }
    g_HudN = n;
}
}
namespace nvnhook {
    using GenericFn = void* (*)();
    using GetProcFn = void* (*)(const void* device, const char* name);
    using PresentFn = void (*)(void* queue, void* window, int textureIndex);
    using SetTexturesFn = void (*)(void* builder, int num, void* const* textures);
    GetProcFn g_OrigGetProc = nullptr;
    PresentFn g_OrigPresent = nullptr;
    SetTexturesFn g_OrigSetTextures = nullptr;
    volatile u64 g_Presents = 0;
    volatile int g_TexFmtPub = -1;
    volatile u32 g_Flags = 0; /* bit0: Bootstrap / bit1: GetProc / bit2: Present / bit3: 窓のテクスチャを取得 / bit4: 描画の準備完了 / bit5: 準備失敗 */
    const void* g_Device = nullptr;
    void* g_WinTex[8] = {}; int g_WinTexN = 0;

    bool StrEq(const char* a, const char* b) {
        if (!a || !b) return false;
        while (*a && *a == *b) { a++; b++; }
        return *a == *b;
    }

    /* ---- 使う NVN 関数 ---- */
    using PoolBSetDefaults = void (*)(void*);
    using PoolBSetDevice   = void (*)(void*, const void*);
    using PoolBSetStorage  = void (*)(void*, void*, size_t);
    using PoolBSetFlags    = void (*)(void*, int);
    using PoolInit         = bool (*)(void*, const void*);
    using CbInit           = bool (*)(void*, const void*);
    using CbAddCmdMem      = void (*)(void*, const void*, ptrdiff_t, size_t);
    using CbAddCtrlMem     = void (*)(void*, void*, size_t);
    using CbBegin          = void (*)(void*);
    using CbEnd            = u64  (*)(void*);
    using CbSetRT          = void (*)(void*, int, void* const*, const void* const*, const void*, const void*);
    using CbSetRect        = void (*)(void*, int, int, int, int);
    using CbClearColor     = void (*)(void*, int, const float*, int);
    using QSubmit          = void (*)(void*, int, const u64*);
    using TexGetInt        = int  (*)(const void*);
    struct Api {
        PoolBSetDefaults pbDefaults; PoolBSetDevice pbDevice; PoolBSetStorage pbStorage; PoolBSetFlags pbFlags; PoolInit poolInit;
        CbInit cbInit; CbAddCmdMem cbAddCmd; CbAddCtrlMem cbAddCtrl; CbBegin cbBegin; CbEnd cbEnd;
        CbSetRT cbSetRT; CbSetRect cbScissor; CbSetRect cbViewport; CbClearColor cbClear; QSubmit qSubmit;
        TexGetInt texW; TexGetInt texH;
    } g_Api {};

    alignas(4096) u8 g_CmdStorage[3 * 0x100000];
    alignas(8) u8 g_CtrlMem[3][0x10000];
    alignas(8) u8 g_PoolBuilder[0x200];
    alignas(8) u8 g_Pool[0x400];
    alignas(8) u8 g_Cb[0x400];
    int g_Ring = 0;
    bool g_Ready = false, g_Failed = false;

    template<typename T> bool Get(T& out, const char* name) {
        out = reinterpret_cast<T>(g_OrigGetProc(g_Device, name));
        return out != nullptr;
    }
    bool InitDraw() {
        if (g_Ready) return true;
        if (g_Failed || !g_OrigGetProc || !g_Device) return false;
        Api& A = g_Api;
        bool ok = Get(A.pbDefaults, "nvnMemoryPoolBuilderSetDefaults") && Get(A.pbDevice, "nvnMemoryPoolBuilderSetDevice")
               && Get(A.pbStorage, "nvnMemoryPoolBuilderSetStorage") && Get(A.pbFlags, "nvnMemoryPoolBuilderSetFlags")
               && Get(A.poolInit, "nvnMemoryPoolInitialize") && Get(A.cbInit, "nvnCommandBufferInitialize")
               && Get(A.cbAddCmd, "nvnCommandBufferAddCommandMemory") && Get(A.cbAddCtrl, "nvnCommandBufferAddControlMemory")
               && Get(A.cbBegin, "nvnCommandBufferBeginRecording") && Get(A.cbEnd, "nvnCommandBufferEndRecording")
               && Get(A.cbSetRT, "nvnCommandBufferSetRenderTargets") && Get(A.cbScissor, "nvnCommandBufferSetScissor")
               && Get(A.cbViewport, "nvnCommandBufferSetViewport") && Get(A.cbClear, "nvnCommandBufferClearColor")
               && Get(A.qSubmit, "nvnQueueSubmitCommands") && Get(A.texW, "nvnTextureGetWidth") && Get(A.texH, "nvnTextureGetHeight");
        if (!ok) { g_Failed = true; g_Flags |= 32; return false; }
        A.pbDefaults(g_PoolBuilder);
        A.pbDevice(g_PoolBuilder, g_Device);
        A.pbFlags(g_PoolBuilder, 0x2 | 0x20); /* CPU_UNCACHED | GPU_CACHED */
        A.pbStorage(g_PoolBuilder, g_CmdStorage, sizeof(g_CmdStorage));
        if (!A.poolInit(g_Pool, g_PoolBuilder)) { g_Failed = true; g_Flags |= 32; return false; }
        if (!A.cbInit(g_Cb, g_Device)) { g_Failed = true; g_Flags |= 32; return false; }
        g_Ready = true; g_Flags |= 16;
        return true;
    }

    /* 5x7 の小さな文字 (A-Z, 0-9, 空白, ':' '-' '>' ) */
    const u8* Glyph(char c) {
        static const u8 kSp[7] = {0,0,0,0,0,0,0};
        static const u8 kAZ[26][7] = {
            {14,17,17,31,17,17,17},{30,17,17,30,17,17,30},{14,17,16,16,16,17,14},{30,17,17,17,17,17,30},{31,16,16,30,16,16,31},
            {31,16,16,30,16,16,16},{14,17,16,23,17,17,15},{17,17,17,31,17,17,17},{14,4,4,4,4,4,14},{7,2,2,2,2,18,12},
            {17,18,20,24,20,18,17},{16,16,16,16,16,16,31},{17,27,21,21,17,17,17},{17,17,25,21,19,17,17},{14,17,17,17,17,17,14},
            {30,17,17,30,16,16,16},{14,17,17,17,21,18,13},{30,17,17,30,20,18,17},{15,16,16,14,1,1,30},{31,4,4,4,4,4,4},
            {17,17,17,17,17,17,14},{17,17,17,17,17,10,4},{17,17,17,21,21,21,10},{17,17,10,4,10,17,17},{17,17,10,4,4,4,4},{31,1,2,4,8,16,31}};
        static const u8 k09[10][7] = {
            {14,17,19,21,25,17,14},{4,12,4,4,4,4,14},{14,17,1,2,4,8,31},{31,2,4,2,1,17,14},{2,6,10,18,31,2,2},
            {31,16,30,1,1,17,14},{6,8,16,30,17,17,14},{31,1,2,4,8,8,8},{14,17,17,14,17,17,14},{14,17,17,15,1,2,12}};
        static const u8 kColon[7] = {0,12,12,0,12,12,0}, kDash[7] = {0,0,0,31,0,0,0}, kGt[7] = {8,4,2,1,2,4,8};
        if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 32);
        if (c >= 'A' && c <= 'Z') return kAZ[c - 'A'];
        if (c >= '0' && c <= '9') return k09[c - '0'];
        if (c == ':') return kColon; if (c == '-') return kDash; if (c == '>') return kGt;
        return kSp;
    }
    struct Ctx { void* cb; int W, H; };
    void Rect(Ctx& c, int x, int y, int w, int h, float r, float g, float b) {
        const int yy = y; /* このゲームは左上が原点 */
        if (w <= 0 || h <= 0 || x >= c.W || yy >= c.H || x + w <= 0 || yy + h <= 0) return;
        g_Api.cbScissor(c.cb, x, yy, w, h);
        const float col[4] = { r, g, b, 1.0f };
        g_Api.cbClear(c.cb, 0, col, 0xF);
    }
    void Text(Ctx& c, int x, int y, const char* s, int px, float r, float g, float b) {
        for (; *s; s++, x += 6 * px) {
            const u8* gl = Glyph(*s);
            for (int row = 0; row < 7; row++) {
                int col = 0;
                while (col < 5) {
                    if (!(gl[row] & (16 >> col))) { col++; continue; }
                    int run = col; while (run < 5 && (gl[row] & (16 >> run))) run++;
                    Rect(c, x + col * px, y + row * px, (run - col) * px, px, r, g, b);
                    col = run;
                }
            }
        }
    }
    extern void DrawOverlay(Ctx& c); /* 中身は後ろで作る */


    bool SwCopy(void* cb, void* tex, int W, int H); /* 後ろで作る */
    bool MenuVis(); bool FuncVis(); float FuncFade(); extern u64 g_FuncOnT, g_FuncOffT;
    bool HudWanted(); /* ワープの印 (方位計) を出すか */
    bool BoxOrCircle() { return g_CircOn; } /* 円を描くときだけ */
    u64 g_SplashT0 = 0, g_SplashLeaveT = 0, g_SplDoneT = 0; bool g_SplUpd = false; bool g_SplMan = false; /* g_SplMan: メニューから確認した (板の形は最初から固定) */ /* g_SplUpd: 起動の表示の中でアップデートを始めた (ダウンロード中・結果もこの中に出す) */
    bool SplashOn() { /* 起動の表示: 左から入ってきて、自動のアップデート確認が終わるまで (最大 15 秒) まん中にいて、右へ抜けて消える */
        if (!g_SplashT0) return false; const u64 n = NowTick();
        if (g_SplashLeaveT) { const bool on = n - g_SplashLeaveT < 9600000ull; if (!on) g_SplMan = false; return on; }
        const u64 el = n - g_SplashT0; const int us = g_UpdState;
        if (us == 2) g_SplUpd = true;
        if (g_SplDoneT) { if (n - g_SplDoneT > 8640000ull) g_SplashLeaveT = n; return true; } /* バーが最後まで行ってから消える */
        const bool resShown = (us == 4 || us == 5 || us == 6 || us == 8) && n - g_UpdT > 3ull * 19200000ull; /* 結果は 3 秒見せたら消える */
        if (g_SplUpd && (resShown || (us == 0 && !g_UpdManual && el > 9600000ull))) g_SplDoneT = n;
        if (!g_SplUpd && us != 2 && el > 28800000ull && (g_UpdAutoPhase == 2 || us >= 3 || el > 15ull * 19200000ull || (g_UpdAutoPhase == 0 && el > 8ull * 19200000ull))) g_SplDoneT = n; /* アップデートを聞いている間は出しておく */
        return true;
    }
    void SplashManual() { g_SplashT0 = NowTick(); g_SplashLeaveT = 0; g_SplDoneT = 0; g_SplUpd = true; g_SplMan = true; } /* メニューからアップデートを確認: 起動の表示をもう一度出して、その中に出す */
    bool ScareCopy(void* cb, void* tex, int W, int H);
    void Blink() {
        /* 0285DE90: 「mov w0, wzr」(0 を返す) と「mov w0, #1」(1 を返す) を、3 フレームごと (1 秒に 20 回) に入れ替える */
        static bool cur = false;
        bool want = false;
        if (g_BlinkOn) want = ((g_Presents / 3) & 1) != 0;
        (void)want; (void)cur; return; /* 0285DE90 は MarkHookA/B が持っている。ピコピコは MarkHookB の中で切り替える (直接書き換えると、フックの命令を見て自動でオフになっていた) */
        exl::patch::RandomAccessPatcher rp;
        const u32 now = rp.Read<u32>(0x285DE90);
        if (now != 0x2A1F03E0u && now != 0x52800020u) { g_BlinkOn = false; return; } /* 違うバージョンなら触らない */
        rp.Write<u32>(0x285DE90, want ? 0x52800020u : 0x2A1F03E0u);
    }
    using SetIntervalFn = void (*)(void*, int);
    SetIntervalFn g_OrigWinInterval = nullptr, g_OrigBldInterval = nullptr;
    void MyPresent(void* queue, void* window, int textureIndex) {
        g_Presents++;
        if (!g_SplashT0) g_SplashT0 = NowTick();
        Blink();
        { /* 60fps固定の ON/OFF が変わったら、ゲームが前に決めた間隔に戻すか、1 にする */
          static bool applied = false;
          if (g_OrigWinInterval && window && g_Force60 != applied) { applied = g_Force60; g_OrigWinInterval(window, g_Force60 ? 1 : (g_IntervalGame > 0 ? static_cast<int>(g_IntervalGame) : 1)); } }
        if (InitDraw() && textureIndex >= 0 && textureIndex < g_WinTexN && g_WinTex[textureIndex]) {
            void* tex = g_WinTex[textureIndex];
            Api& A = g_Api;
            const int slot = g_Ring; g_Ring = (g_Ring + 1) % 3;
            A.cbAddCmd(g_Cb, g_Pool, slot * 0x100000, 0x100000);
            A.cbAddCtrl(g_Cb, g_CtrlMem[slot], sizeof(g_CtrlMem[slot]));
            A.cbBegin(g_Cb);
            void* const rts[1] = { tex };
            A.cbSetRT(g_Cb, 1, rts, nullptr, nullptr, nullptr);
            Ctx c { g_Cb, A.texW(tex), A.texH(tex) };
            { /* 携帯モードでは、1920x1080 の絵のうち左上の 1280x720 だけが画面に出る (切り取り)。切り取りの大きさを画面の大きさとして使う */
                using CropFn = void (*)(const void*, int*); static CropFn crop = nullptr; static bool tried = false;
                if (!tried) { tried = true; Get(crop, "nvnWindowGetCrop"); }
                if (crop && window) { int r[4] = { 0, 0, 0, 0 }; crop(window, r); if (r[0] == 0 && r[1] == 0 && r[2] >= 320 && r[3] >= 180 && r[2] <= c.W && r[3] <= c.H) { c.W = r[2]; c.H = r[3]; } }
            }
            A.cbViewport(g_Cb, 0, 0, c.W, c.H);
            if (g_ScareShow && ScareCopy(g_Cb, tex, c.W, c.H)) {
            } else if ((MenuVis() || FuncVis() || SplashOn() || HudWanted() || UpdWanted() || BoxOrCircle()) && SwCopy(g_Cb, tex, c.W, c.H)) {
            } else {
                DrawOverlay(c);
            }
            A.cbScissor(g_Cb, 0, 0, c.W, c.H);
            const u64 h = A.cbEnd(g_Cb);
            A.qSubmit(queue, 1, &h);
        }
        g_OrigPresent(queue, window, textureIndex);
    }
    void MySetTextures(void* builder, int num, void* const* textures) {
        g_WinTexN = 0;
        for (int i = 0; i < num && i < 8; i++) g_WinTex[g_WinTexN++] = textures[i];
        g_Flags |= 8;
        g_OrigSetTextures(builder, num, textures);
    }
    /* ゲームが「何フレームに1回、画面を入れ替えるか」を決める関数。広場では 2 (= 30fps) にしているはず。60fps固定がONなら、1 にする */
    void MyWinInterval(void* w, int i) { g_IntervalGame = i; g_WinForInterval = w; g_OrigWinInterval(w, g_Force60 ? 1 : i); }
    void MyBldInterval(void* b, int i) { g_IntervalGame = i; g_OrigBldInterval(b, g_Force60 ? 1 : i); }
    using DevInitFn = bool (*)(void* device, const void* builder);
    DevInitFn g_OrigDevInit = nullptr;
    bool MyDevInit(void* device, const void* builder) {
        const bool r = g_OrigDevInit(device, builder);
        if (r && !g_Device) g_Device = device;
        return r;
    }
    void* MyGetProc(const void* device, const char* name) {
        if (device && !g_Device) g_Device = device;
        void* r = g_OrigGetProc(device, name);
        if (!r) return r;
        if (StrEq(name, "nvnQueuePresentTexture")) { g_OrigPresent = reinterpret_cast<PresentFn>(r); g_Flags |= 4; return reinterpret_cast<void*>(&MyPresent); }
        if (StrEq(name, "nvnWindowSetPresentInterval")) { g_OrigWinInterval = reinterpret_cast<SetIntervalFn>(r); return reinterpret_cast<void*>(&MyWinInterval); }
        if (StrEq(name, "nvnWindowBuilderSetPresentInterval")) { g_OrigBldInterval = reinterpret_cast<SetIntervalFn>(r); return reinterpret_cast<void*>(&MyBldInterval); }
        if (StrEq(name, "nvnWindowBuilderSetTextures")) { g_OrigSetTextures = reinterpret_cast<SetTexturesFn>(r); return reinterpret_cast<void*>(&MySetTextures); }
        if (StrEq(name, "nvnDeviceGetProcAddress")) { g_OrigGetProc = reinterpret_cast<GetProcFn>(r); return reinterpret_cast<void*>(&MyGetProc); }
        if (StrEq(name, "nvnDeviceInitialize")) { g_OrigDevInit = reinterpret_cast<DevInitFn>(r); return reinterpret_cast<void*>(&MyDevInit); }
        return r;
    }

    /* ---- 画面に出すもの: メニュー (なめらかな文字と角の丸い枠) ---- */
    struct Col { float r, g, b; };
    void RectC(Ctx& c, int x, int y, int w, int h, Col k) { Rect(c, x, y, w, h, k.r, k.g, k.b); }
    void RRect(Ctx& c, int x, int y, int w, int h, int r, Col k) {
        if (r * 2 > h) r = h / 2;
        if (r * 2 > w) r = w / 2;
        for (int i = 0; i < r; i++) {
            const float dy = static_cast<float>(r) - (static_cast<float>(i) + 0.5f);
            const int inset = r - static_cast<int>(__builtin_sqrtf(static_cast<float>(r * r) - dy * dy) + 0.5f);
            RectC(c, x + inset, y + i, w - 2 * inset, 1, k);
            RectC(c, x + inset, y + h - 1 - i, w - 2 * inset, 1, k);
        }
        RectC(c, x, y + r, w, h - 2 * r, k);
    }
    void DrawStr(Ctx& c, const menu_text::Str& st, int x, int y, Col fg, Col bg) {
        for (int i = 0; i < st.n; i++) {
            const uint16_t* q = st.runs + i * 4;
            const float a = static_cast<float>(q[3]) / 3.0f;
            const Col k { bg.r + (fg.r - bg.r) * a, bg.g + (fg.g - bg.g) * a, bg.b + (fg.b - bg.b) * a };
            RectC(c, x + q[1], y + q[0], q[2], 1, k);
        }
    }
    /* UTF-8 の文字列を、なめらかなフォントで描く。描いた幅を返す。 */
    int FindGlyph(u32 cp) {
        int lo = 0, hi = font_glyphs::kCount - 1;
        while (lo <= hi) { const int m = (lo + hi) / 2; const u32 v = font_glyphs::kCodes[m]; if (v == cp) return m; if (v < cp) lo = m + 1; else hi = m - 1; }
        return -1;
    }
    int DrawU8(Ctx& c, const char* s, int x, int y, int maxW, Col fg, Col bg) {
        const int x0 = x;
        const u8* p = reinterpret_cast<const u8*>(s);
        while (*p) {
            u32 cp = *p++;
            if (cp >= 0xF0 && p[0] && p[1] && p[2]) { cp = ((cp & 7) << 18) | ((p[0] & 63) << 12) | ((p[1] & 63) << 6) | (p[2] & 63); p += 3; }
            else if (cp >= 0xE0 && p[0] && p[1]) { cp = ((cp & 15) << 12) | ((p[0] & 63) << 6) | (p[1] & 63); p += 2; }
            else if (cp >= 0xC0 && p[0]) { cp = ((cp & 31) << 6) | (p[0] & 63); p += 1; }
            if (cp == '\t') cp = ' ';
            int gi = FindGlyph(cp);
            if (gi < 0) gi = FindGlyph('?');
            if (gi < 0) continue;
            const int adv = font_glyphs::kAdv[gi];
            if (x + adv - x0 > maxW) break;
            const u8* r = font_glyphs::kRuns + font_glyphs::kOff[gi] * 4;
            for (int i = 0; i < font_glyphs::kN[gi]; i++, r += 4) {
                const float a = static_cast<float>(r[3]) / 3.0f;
                const Col k { bg.r + (fg.r - bg.r) * a, bg.g + (fg.g - bg.g) * a, bg.b + (fg.b - bg.b) * a };
                RectC(c, x + r[1], y + r[0], r[2], 1, k);
            }
            x += adv;
        }
        return x - x0;
    }
    void DrawPchPanel(Ctx& c, int px, int py, int pw, int ph) {
        const Col panel { 0.06f, 0.07f, 0.10f }, border { 0.35f, 0.75f, 0.95f };
        RRect(c, px - 3, py - 3, pw + 6, ph + 6, 18, border);
        RRect(c, px, py, pw, ph, 16, panel);
        char head[64]; int k = 0;
        const char* h1 = "pchtxt の中身  行数: "; for (const char* q = h1; *q; q++) head[k++] = *q;
        int nl = g_PchLines; char num[8]; int nn = 0; do { num[nn++] = static_cast<char>('0' + nl % 10); nl /= 10; } while (nl && nn < 7);
        while (nn) head[k++] = num[--nn];
        head[k] = 0;
        DrawU8(c, head, px + 20, py + 14, pw - 40, Col { 1.0f, 1.0f, 1.0f }, panel);
        RectC(c, px + 16, py + 44, pw - 32, 2, Col { 0.2f, 0.35f, 0.45f });
        const int top = py + 54, visible = (ph - 54 - 34) / font_glyphs::kLineH;
        if (g_PchLines == 0) {
            DrawU8(c, "SD:/inkdraw/patches.pchtxt が見つかりません", px + 20, top, pw - 40, Col { 0.8f, 0.6f, 0.6f }, panel);
        }
        int maxScroll = g_PchLines - visible; if (maxScroll < 0) maxScroll = 0;
        if (g_PchScroll > maxScroll) g_PchScroll = maxScroll;
        for (int i = 0; i < visible && g_PchScroll + i < g_PchLines; i++) {
            const int li = g_PchScroll + i;
            const u8 kind = g_PchLineKind[li];
            const Col fg = kind == 0 ? Col { 1.0f, 0.85f, 0.4f } : kind == 1 ? Col { 0.5f, 0.8f, 0.5f } : kind == 2 ? Col { 0.85f, 0.6f, 1.0f } : Col { 0.95f, 0.95f, 0.95f };
            DrawU8(c, g_PchView + g_PchLineOff[li], px + (kind == 0 ? 20 : 32), top + i * font_glyphs::kLineH, pw - 52, fg, panel);
        }
        DrawU8(c, "十字キー上下: スクロール    L / B: 閉じる", px + 20, py + ph - 30, pw - 40, Col { 0.55f, 0.55f, 0.6f }, panel);
    }
    void DrawOverlay(Ctx& c) {
        if (!g_MenuOpen) return;
        const Col panel { 0.07f, 0.07f, 0.11f }, border { 0.85f, 0.35f, 0.95f }, white { 1.0f, 1.0f, 1.0f };
        const Col dim { 0.55f, 0.55f, 0.6f }, selBg { 0.22f, 0.12f, 0.32f }, onBg { 0.20f, 0.70f, 0.40f }, offBg { 0.32f, 0.32f, 0.36f };
        const int x0 = 48, y0 = 48, w = 640, rowH = 50;
        const int h = 70 + rowH * kMenuItems + 50;
        RRect(c, x0 - 3, y0 - 3, w + 6, h + 6, 18, border);   /* 外枠 */
        RRect(c, x0, y0, w, h, 16, panel);
        DrawStr(c, menu_text::kTITLE, x0 + 24, y0 + 16, white, panel);
        RectC(c, x0 + 20, y0 + 58, w - 40, 2, Col { 0.30f, 0.20f, 0.40f });
        const menu_text::Str* labels[kMenuItems] = { &menu_text::kL_FLY, &menu_text::kL_AIR, &menu_text::kL_MOON, &menu_text::kL_GENKI, &menu_text::kL_RESPAWN, &menu_text::kL_FREECAM, &menu_text::kL_DRAW, &menu_text::kL_FILL, &menu_text::kL_FILL2, &menu_text::kL_BLINK, &menu_text::kL_PATCH, &menu_text::kL_MEM, &menu_text::kL_SCALE, &menu_text::kL_POS, &menu_text::kL_CLOSE, &menu_text::kL_BUNNY, &menu_text::kL_LAUNCH, &menu_text::kL_EMOTE, &menu_text::kL_INFO, &menu_text::kL_FX0, &menu_text::kL_FX1, &menu_text::kL_FX2, &menu_text::kL_FX3, &menu_text::kL_FX4, &menu_text::kL_FX5, &menu_text::kL_FX6, &menu_text::kL_FX7, &menu_text::kL_FX8, &menu_text::kL_FX9, &menu_text::kL_FX10, &menu_text::kL_FX11, &menu_text::kL_FX12, &menu_text::kL_FX13, &menu_text::kL_FX14, &menu_text::kL_FX15, &menu_text::kL_FX16, &menu_text::kL_FX17, &menu_text::kL_FX18, &menu_text::kL_FX19, &menu_text::kL_FX20, &menu_text::kL_FX21, &menu_text::kL_IMG, &menu_text::kL_FPS60, &menu_text::kL_ERASE };
        const int states[kMenuItems] = { (g_ModeOn && !g_FlyQuiet) ? 1 : 0, (g_Jump & 1) ? 1 : 0, (g_Jump & 2) ? 1 : 0, -1, -1, -1, -1, -1, -1, g_BlinkOn ? 1 : 0, g_PatchEnabled ? 1 : 0, -1, -1, -1, -1, g_Bunny ? 1 : 0, -1, g_EmoteOn ? 1 : 0, g_InfoOn ? 1 : 0, (g_Fx[0] ? 1 : 0), (g_Fx[1] ? 1 : 0), (g_Fx[2] ? 1 : 0), (g_Fx[3] ? 1 : 0), (g_Fx[4] ? 1 : 0), (g_Fx[5] ? 1 : 0), (g_Fx[6] ? 1 : 0), (g_Fx[7] ? 1 : 0), (g_Fx[8] ? 1 : 0), (g_Fx[9] ? 1 : 0), (g_Fx[10] ? 1 : 0), (g_Fx[11] ? 1 : 0), (g_Fx[12] ? 1 : 0), -1, -1, (g_Fx[15] ? 1 : 0), (g_Fx[16] ? 1 : 0), (g_Fx[17] ? 1 : 0), (g_Fx[18] ? 1 : 0), (g_Fx[19] ? 1 : 0), (g_Fx[20] ? 1 : 0), (g_Fx[21] ? 1 : 0), -1, g_Force60 ? 1 : 0, -1 };
        for (int i = 0; i < kMenuItems; i++) {
            const int y = y0 + 68 + rowH * i;
            const bool sel = (g_MenuSel == i);
            const Col bg = sel ? selBg : panel;
            if (sel) { RRect(c, x0 + 12, y, w - 24, rowH - 6, 10, selBg); RRect(c, x0 + 12, y + 8, 5, rowH - 22, 2, border); }
            const menu_text::Str& L = *labels[i];
            DrawStr(c, L, x0 + 32, y + (rowH - 6 - L.h) / 2, states[i] == 0 ? dim : white, bg);
            if (states[i] >= 0) {
                const menu_text::Str& V = states[i] ? menu_text::kV_ON : menu_text::kV_OFF;
                const int pw = 84, ph = rowH - 18, px = x0 + w - 32 - pw, py = y + 6;
                const Col pill = states[i] ? onBg : offBg;
                RRect(c, px, py, pw, ph, ph / 2, pill);
                DrawStr(c, V, px + (pw - V.w) / 2, py + (ph - V.h) / 2, white, pill);
            }
        }
        DrawStr(c, menu_text::kHELP, x0 + 24, y0 + h - 36, dim, panel);
        if (false && g_PchPanel) {
            int ppx = x0 + w + 20, ppw = 680, pph = 600;
            if (ppx + ppw > c.W - 16) ppw = c.W - 16 - ppx;
            if (ppw < 360) { ppx = x0; ppw = (c.W - 32 < 680) ? c.W - 32 - x0 : 680; } /* 画面がせまいときはメニューの上に重ねる */
            if (y0 + pph > c.H - 16) pph = c.H - 16 - y0;
            DrawPchPanel(c, ppx, y0, ppw, pph);
        }
    }
    /* ==== なめらかな描画: CPU で絵を作って、テクスチャに写す (アンチエイリアス付き) ==== */
    using BufBSetDefaults = void (*)(void*);
    using BufBSetDevice   = void (*)(void*, const void*);
    using BufBSetStorage  = void (*)(void*, const void*, ptrdiff_t, size_t);
    using BufInit         = bool (*)(void*, const void*);
    using BufGetAddr      = u64  (*)(const void*);
    using CbCopyB2T       = void (*)(void*, u64, const void*, const void*, const void*, int);
    using CbSetStride = void (*)(void*, ptrdiff_t);
    struct SwApi { BufBSetDefaults bbDefaults; BufBSetDevice bbDevice; BufBSetStorage bbStorage; BufInit bufInit; BufGetAddr bufAddr; CbCopyB2T copyB2T; TexGetInt texFmt; CbSetStride rowStride; } g_Sw {};
    constexpr int kOvW = 1440, kOvH = 960;                 /* 重ねる絵の最大の大きさ */
    constexpr size_t kPixBytes = static_cast<size_t>(kOvW) * kOvH * 4;
    constexpr size_t kPixSlot = (kPixBytes + 0xFFF) & ~static_cast<size_t>(0xFFF);
    alignas(4096) u8 g_PixStorage[2 * kPixSlot];          /* GPU が読む 2 枚 (交互に使う) */
    /* CPU で描く作業場は、次に使う側の 1 枚をそのまま使う (別に持つと 5.5MB 多く使い、ゲームの起動に必要なメモリが足りなくなる) */
#define g_Scratch (reinterpret_cast<u32*>(g_PixStorage + (static_cast<size_t>(g_SwCur) ^ 1u) * kPixSlot))
    alignas(8) u8 g_PixPoolB[0x200]; alignas(8) u8 g_PixPool[0x400];
    alignas(8) u8 g_BufB[0x200]; alignas(8) u8 g_Buf[2][0x200];
    u64 g_BufAddr[2] = {};
    bool g_SwReady = false, g_SwFailed = false;
    int g_SwCur = 0, g_SwW = 0, g_SwH = 0, g_SwX = 0, g_SwY = 0;
    u32 g_SwHash = 0; int g_TexFmt = -1;
    struct PRect { int x, y, w, h, r; int t = 0; int a = 8; }; /* a: フェード (8 行のうち写す行の数。8 = そのまま) */ bool g_FadeBusy = false; int FadeLv(float f) { if (f < 0.0f) f = 0.0f; if (f > 1.0f) f = 1.0f; f = f * f * (3.0f - 2.0f * f); return static_cast<int>(f * 8.0f + 0.5f); } PRect g_SwRects[6]; int g_SwRectN = 0; unsigned char g_HoleRow[700]; float g_SwSc = 1.0f; /* t=1: 半透明 (文字のない行は写さず、ゲームの画面を見せる) */

    bool InitSw() {
        if (g_SwReady) return true;
        if (g_SwFailed || !g_Ready) return false;
        bool ok = Get(g_Sw.bbDefaults, "nvnBufferBuilderSetDefaults") && Get(g_Sw.bbDevice, "nvnBufferBuilderSetDevice")
               && Get(g_Sw.bbStorage, "nvnBufferBuilderSetStorage") && Get(g_Sw.bufInit, "nvnBufferInitialize")
               && Get(g_Sw.bufAddr, "nvnBufferGetAddress") && Get(g_Sw.copyB2T, "nvnCommandBufferCopyBufferToTexture")
               && Get(g_Sw.texFmt, "nvnTextureGetFormat") && Get(g_Sw.rowStride, "nvnCommandBufferSetCopyRowStride");
        if (!ok) { g_SwFailed = true; return false; }
        g_Api.pbDefaults(g_PixPoolB);
        g_Api.pbDevice(g_PixPoolB, g_Device);
        g_Api.pbFlags(g_PixPoolB, 0x2 | 0x20);
        g_Api.pbStorage(g_PixPoolB, g_PixStorage, sizeof(g_PixStorage));
        if (!g_Api.poolInit(g_PixPool, g_PixPoolB)) { g_SwFailed = true; return false; }
        for (int i = 0; i < 2; i++) {
            g_Sw.bbDefaults(g_BufB);
            g_Sw.bbDevice(g_BufB, g_Device);
            g_Sw.bbStorage(g_BufB, g_PixPool, static_cast<ptrdiff_t>(i * kPixSlot), kPixSlot);
            if (!g_Sw.bufInit(g_Buf[i], g_BufB)) { g_SwFailed = true; return false; }
            g_BufAddr[i] = g_Sw.bufAddr(g_Buf[i]);
        }
        g_SwReady = true; g_Flags |= 64;
        return true;
    }

    /* ---- CPU 側の描画 (色は RGBA8: R が下位バイト) ---- */
    struct Cv { u32* px; int w, h, ox, oy; }; /* ox,oy: 画面上の左上 */
    inline u32 Pack(Col k, float a = 1.0f) {
        auto b = [](float v) { int i = static_cast<int>(v * 255.0f + 0.5f); return static_cast<u32>(i < 0 ? 0 : (i > 255 ? 255 : i)); };
        return b(k.r) | (b(k.g) << 8) | (b(k.b) << 16) | (b(a) << 24);
    }
    inline void Blend(Cv& v, int x, int y, Col k, float a) {
        x -= v.ox; y -= v.oy;
        if (x < 0 || y < 0 || x >= v.w || y >= v.h || a <= 0.0f) return;
        u32& d = v.px[y * v.w + x];
        if (a >= 1.0f) { d = Pack(k); return; }
        const float dr = static_cast<float>(d & 255) / 255.0f, dg = static_cast<float>((d >> 8) & 255) / 255.0f, db = static_cast<float>((d >> 16) & 255) / 255.0f;
        d = Pack(Col { dr + (k.r - dr) * a, dg + (k.g - dg) * a, db + (k.b - db) * a });
    }
    char g_FlyStb[40];
    const char* FlyStatus(char* o) {
        if (g_TrkStage == 3) return "準備OK";
        if (g_TrkStage == 0) return "座標を探し中";
        std::snprintf(o, 40, "歩く %d/2 (%d/4)", g_TrkStage == 1 ? 1 : 2, static_cast<int>(g_FlyWalkD));
        return o;
    }
    void SwChevron(Cv& v, int x, int cy, Col k);
    void SwRect(Cv& v, int x, int y, int w, int h, Col k) {
        const u32 c = Pack(k);
        int x0 = x - v.ox, x1 = x + w - v.ox, y0 = y - v.oy, y1 = y + h - v.oy;
        if (x0 < 0) x0 = 0; if (y0 < 0) y0 = 0; if (x1 > v.w) x1 = v.w; if (y1 > v.h) y1 = v.h;
        for (int yy = y0; yy < y1; yy++) { u32* row = v.px + yy * v.w; for (int xx = x0; xx < x1; xx++) row[xx] = c; }
    }
    /* 角の丸い四角 (ふちをなめらかに) */
    void SwRRect(Cv& v, int x, int y, int w, int h, float r, Col k) {
        if (r * 2 > h) r = h * 0.5f;
        if (r * 2 > w) r = w * 0.5f;
        const int ri = static_cast<int>(r) + 1; /* 角の丸みがある範囲 (ここだけ 1 画素ずつ計算し、残りはまとめて塗る) */
        const u32 solid = Pack(k);
        for (int yy = y; yy < y + h; yy++) {
            const int ry = yy - v.oy; if (ry < 0 || ry >= v.h) continue;
            const bool cornerRow = (yy < y + ri) || (yy >= y + h - ri);
            int fx0 = x, fx1 = x + w; /* まとめて塗る範囲 */
            if (cornerRow) { fx0 = x + ri; fx1 = x + w - ri; }
            { int a0 = fx0 - v.ox, a1 = fx1 - v.ox; if (a0 < 0) a0 = 0; if (a1 > v.w) a1 = v.w; u32* row = v.px + ry * v.w; for (int xx = a0; xx < a1; xx++) row[xx] = solid; }
            if (!cornerRow) continue;
            for (int side = 0; side < 2; side++) {
                const int xs = side ? x + w - ri : x, xe = side ? x + w : x + ri;
                for (int xx = xs; xx < xe; xx++) {
                    const float px = static_cast<float>(xx) + 0.5f, py = static_cast<float>(yy) + 0.5f;
                    float cx = px, cy = py;
                    if (px < x + r) cx = x + r; else if (px > x + w - r) cx = x + w - r;
                    if (py < y + r) cy = y + r; else if (py > y + h - r) cy = y + h - r;
                    const float dx = px - cx, dy = py - cy;
                    const float dist = __builtin_sqrtf(dx * dx + dy * dy);
                    float al = r + 0.5f - dist; if (al > 1.0f) al = 1.0f;
                    if (al > 0.0f) Blend(v, xx, yy, k, al);
                }
            }
        }
    }
    void SwRuns16(Cv& v, const uint16_t* runs, int n, int x, int y, Col fg) {
        for (int i = 0; i < n; i++) { const uint16_t* q = runs + i * 4; const float a = q[3] / 3.0f; for (int k = 0; k < q[2]; k++) Blend(v, x + q[1] + k, y + q[0], fg, a); }
    }
    void SwStr(Cv& v, const menu_text::Str& st, int x, int y, Col fg) { SwRuns16(v, st.runs, st.n, x, y, fg); }
    void SwSwitch(Cv& v, int rx, int cy, bool on, Col ac, Col off, Col knob) { SwRRect(v, rx - 38, cy - 9, 38, 18, 9.0f, on ? ac : off); const int kx = on ? rx - 38 + 21 : rx - 38 + 3; SwRRect(v, kx, cy - 7, 14, 14, 7.0f, knob); }
    void SwChevron(Cv& v, int x, int cy, Col k) { for (int t = 0; t <= 3; t++) { SwRect(v, x + t, cy - t, 2, 2, k); SwRect(v, x + t, cy + t, 2, 2, k); } } /* 小さい「>」 */
    bool g_Marquee = false;
    /* UTF-8 の文字列を出す。幅 maxW に入りきらないときは、ゆっくり左へ流して全部読めるようにする (最初と最後に少し止まる) */
    int SwU8(Cv& v, const char* s, int x, int y, int maxW, Col fg) {
        const int x0 = x;
        int total = 0;
        for (const u8* p = reinterpret_cast<const u8*>(s); *p;) {
            u32 cp = *p++;
            if (cp >= 0xF0 && p[0] && p[1] && p[2]) { cp = ((cp & 7) << 18) | ((p[0] & 63) << 12) | ((p[1] & 63) << 6) | (p[2] & 63); p += 3; }
            else if (cp >= 0xE0 && p[0] && p[1]) { cp = ((cp & 15) << 12) | ((p[0] & 63) << 6) | (p[1] & 63); p += 2; }
            else if (cp >= 0xC0 && p[0]) { cp = ((cp & 31) << 6) | (p[0] & 63); p += 1; }
            if (cp == '\t') cp = ' ';
            int gi = FindGlyph(cp); if (gi < 0) gi = FindGlyph('?'); if (gi < 0) continue;
            total += font_glyphs::kAdv[gi];
        }
        int off = 0;
        if (total > maxW) {
            const int span = total - maxW + 6;                      /* 流す長さ */
            const int scrollMs = span * 1000 / 28;                  /* 1 秒に 28 ドット */
            const int period = 1200 + scrollMs + 1200;
            const int t = static_cast<int>((NowTick() / 19200ull) % static_cast<u64>(period));
            if (t >= 1200) off = (t - 1200 >= scrollMs) ? span : (t - 1200) * 28 / 1000;
            g_Marquee = true;
        }
        const u8* p = reinterpret_cast<const u8*>(s);
        int gx = x - off;
        while (*p) {
            u32 cp = *p++;
            if (cp >= 0xF0 && p[0] && p[1] && p[2]) { cp = ((cp & 7) << 18) | ((p[0] & 63) << 12) | ((p[1] & 63) << 6) | (p[2] & 63); p += 3; }
            else if (cp >= 0xE0 && p[0] && p[1]) { cp = ((cp & 15) << 12) | ((p[0] & 63) << 6) | (p[1] & 63); p += 2; }
            else if (cp >= 0xC0 && p[0]) { cp = ((cp & 31) << 6) | (p[0] & 63); p += 1; }
            if (cp == '\t') cp = ' ';
            int gi = FindGlyph(cp); if (gi < 0) gi = FindGlyph('?'); if (gi < 0) continue;
            const int adv = font_glyphs::kAdv[gi];
            if (gx >= x0 && gx + adv - x0 <= maxW) {
                const u8* r = font_glyphs::kRuns + font_glyphs::kOff[gi] * 4;
                for (int i = 0; i < font_glyphs::kN[gi]; i++, r += 4) { const float a = r[3] / 3.0f; for (int k = 0; k < r[2]; k++) Blend(v, gx + r[1] + k, y + r[0], fg, a); }
            }
            gx += adv;
            if (gx - x0 > maxW + off + 40) break;
        }
        return total > maxW ? maxW : total;
    }

    /* 右端 xr にそろえて出す (ラベルと重ならないよう、使える幅 maxW に収める。長いときは右側を切る) */
    int U8W(const char* s) {
        int w = 0; const u8* p = reinterpret_cast<const u8*>(s);
        while (*p) {
            u32 cp = *p++;
            if (cp >= 0xF0 && p[0] && p[1] && p[2]) { cp = ((cp & 7) << 18) | ((p[0] & 63) << 12) | ((p[1] & 63) << 6) | (p[2] & 63); p += 3; }
            else if (cp >= 0xE0 && p[0] && p[1]) { cp = ((cp & 15) << 12) | ((p[0] & 63) << 6) | (p[1] & 63); p += 2; }
            else if (cp >= 0xC0 && p[0]) { cp = ((cp & 31) << 6) | (p[0] & 63); p += 1; }
            int gi = FindGlyph(cp); if (gi < 0) gi = FindGlyph('?'); if (gi < 0) continue;
            w += font_glyphs::kAdv[gi];
        }
        return w;
    }
    void SwU8R(Cv& v, const char* s, int xr, int y, int maxW, Col fg) {
        int w = 0; const u8* p = reinterpret_cast<const u8*>(s);
        while (*p) {
            u32 cp = *p++;
            if (cp >= 0xF0 && p[0] && p[1] && p[2]) { cp = ((cp & 7) << 18) | ((p[0] & 63) << 12) | ((p[1] & 63) << 6) | (p[2] & 63); p += 3; }
            else if (cp >= 0xE0 && p[0] && p[1]) { cp = ((cp & 15) << 12) | ((p[0] & 63) << 6) | (p[1] & 63); p += 2; }
            else if (cp >= 0xC0 && p[0]) { cp = ((cp & 31) << 6) | (p[0] & 63); p += 1; }
            int gi = FindGlyph(cp); if (gi < 0) gi = FindGlyph('?'); if (gi < 0) continue;
            w += font_glyphs::kAdv[gi];
        }
        if (w > maxW) SwU8(v, s, xr - maxW, y, maxW, fg); /* 入りきらないときは左から流す */
        else SwU8(v, s, xr - w, y, maxW, fg);
    }
    /* 大きめの文字 (sc 倍に、なめらかに拡大して出す)。大きさを変えられるのは、起動の表示などの小さな文字を読みやすくするため */
    int SwU8S(Cv& v, const char* s, int x, int y, float sc, Col fg) {
        static float buf[26 * 40]; float gx = static_cast<float>(x);
        for (const u8* q = reinterpret_cast<const u8*>(s); *q;) {
            u32 cp = *q++;
            if (cp >= 0xF0 && q[0] && q[1] && q[2]) { cp = ((cp & 7) << 18) | ((q[0] & 63) << 12) | ((q[1] & 63) << 6) | (q[2] & 63); q += 3; }
            else if (cp >= 0xE0 && q[0] && q[1]) { cp = ((cp & 15) << 12) | ((q[0] & 63) << 6) | (q[1] & 63); q += 2; }
            else if (cp >= 0xC0 && q[0]) { cp = ((cp & 31) << 6) | (q[0] & 63); q += 1; }
            int gi = FindGlyph(cp); if (gi < 0) gi = FindGlyph('?'); if (gi < 0) continue;
            const int adv = font_glyphs::kAdv[gi], W = adv + 3 > 36 ? 36 : adv + 3, H = 24;
            for (int i = 0; i < 26 * 40; i++) buf[i] = 0.0f;
            const u8* r = font_glyphs::kRuns + font_glyphs::kOff[gi] * 4;
            for (int i = 0; i < font_glyphs::kN[gi]; i++, r += 4) for (int k = 0; k < r[2]; k++) { const int px = r[1] + k, py = r[0]; if (px < W && py < H) buf[(py + 1) * 40 + px + 1] = r[3] / 3.0f; }
            const int dw = static_cast<int>(W * sc) + 1, dh = static_cast<int>(H * sc) + 1, ox = static_cast<int>(gx);
            for (int yy = 0; yy < dh; yy++) for (int xx = 0; xx < dw; xx++) {
                const float sx = (xx + 0.5f) / sc - 0.5f, sy = (yy + 0.5f) / sc - 0.5f; const int ix = static_cast<int>(sx + 1.0f) - 1, iy = static_cast<int>(sy + 1.0f) - 1;
                const float fx = sx - ix, fy = sy - iy; if (ix < -1 || iy < -1 || ix >= W || iy >= H) continue;
                const float* b0 = buf + (iy + 1) * 40 + ix + 1;
                const float a = b0[0] * (1 - fx) * (1 - fy) + b0[1] * fx * (1 - fy) + b0[40] * (1 - fx) * fy + b0[41] * fx * fy;
                if (a > 0.02f) Blend(v, ox + xx, y + yy, fg, a > 1.0f ? 1.0f : a);
            }
            gx += static_cast<float>(adv) * sc;
        }
        return static_cast<int>(gx - static_cast<float>(x) + 0.5f);
    }
    /* 高解像度の文字 (起動の表示の下の文字用)。si = 0: 見出し 28px、1: 説明 20px */
    static const font_hd::G* HdFind(int si, u32 cp) { const font_hd::G* g = si ? font_hd::kG1 : font_hd::kG0; int lo = 0, hi = (si ? font_hd::kN1 : font_hd::kN0) - 1;
        while (lo <= hi) { const int m = (lo + hi) / 2; if (g[m].cp == cp) return &g[m]; if (g[m].cp < cp) lo = m + 1; else hi = m - 1; } return nullptr; }
    static u32 HdNext(const char*& s) { const u8 c = static_cast<u8>(*s++); if (c < 0x80) return c; int n = c >= 0xF0 ? 3 : (c >= 0xE0 ? 2 : 1); u32 cp = c & (0x3F >> n); while (n-- && *s) cp = (cp << 6) | (static_cast<u8>(*s++) & 0x3F); return cp; }
    int HdW(const char* s, int si) { int w = 0; while (*s) { const font_hd::G* g = HdFind(si, HdNext(s)); if (!g) g = HdFind(si, '?'); if (g) w += g->adv; } return w; }
    int HdLineH(int si) { return si ? font_hd::kLineH1 : font_hd::kLineH0; }
    int SwHD(Cv& v, const char* s, int x, int y, int si, Col c) { const int x0 = x;
        while (*s) { const font_hd::G* g = HdFind(si, HdNext(s)); if (!g) g = HdFind(si, '?'); if (!g) continue;
            for (int yy = 0; yy < g->h; yy++) for (int xx = 0; xx < g->w; xx++) { const int k = yy * g->w + xx; const u8 b = font_hd::kPix[g->off + k / 2]; const int a = (k & 1) ? (b >> 4) : (b & 15);
                if (a) Blend(v, x + g->bx + xx, y + g->by + yy, c, static_cast<float>(a) / 15.0f); }
            x += g->adv; }
        return x - x0; }
    int U8WS(const char* s, float sc) { return static_cast<int>(static_cast<float>(U8W(s)) * sc + 0.5f); }
    /* 数値のバー: 細い角丸の溝に、今の値まで色を付ける。center=true なら 0 を真ん中にして左右に伸ばす */
    bool g_BarSel = false; /* 選んでいる行 (明るい帯) に描くとき */
    void SwBar(Cv& v, int x, int y, int w, float t, bool center, Col fill) {
        const Col track = g_BarSel ? Col { 0.70f, 0.71f, 0.75f } : Col { 0.16f, 0.15f, 0.22f };
        fill = Col { 0.65f, 0.45f, 0.95f }; /* 数値バーは全部むらさき */
        const int h = 4;
        SwRRect(v, x, y, w, h, 2.0f, track);
        if (t < -1.0f) t = -1.0f; if (t > 1.0f) t = 1.0f;
        if (center) {
            const int mid = x + w / 2;
            SwRect(v, mid - 1, y - 3, 2, h + 6, Col { 0.45f, 0.42f, 0.55f });
            const int len = static_cast<int>((w / 2) * (t < 0 ? -t : t) + 0.5f);
            if (len > 0) SwRRect(v, t < 0 ? mid - len : mid, y, len, h, 4.0f, fill);
            const int kx = t < 0 ? mid - len : mid + len;
            SwRRect(v, kx - 6, y - 4, 12, h + 8, 6.0f, g_BarSel ? Col { 0.20f, 0.20f, 0.24f } : Col { 1.0f, 1.0f, 1.0f });
        } else {
            const int len = static_cast<int>(w * t + 0.5f);
            if (len > 0) SwRRect(v, x, y, len, h, 4.0f, fill);
            SwRRect(v, x + len - 6, y - 4, 12, h + 8, 6.0f, g_BarSel ? Col { 0.20f, 0.20f, 0.24f } : Col { 1.0f, 1.0f, 1.0f }); /* つまみ: 選んでいる行では暗い色 (明るい帯にとけないように) */
        }
    }
    /* メニュー全体を CPU で描く (大きさ 100% の座標)。描いた範囲の大きさを返す。 */
    u32 g_Base[1000 * 640];                               /* 100% で描く作業場 */
    int g_BaseW = 0, g_BaseH = 0;
    PRect g_BaseRects[6]; int g_BaseRectN = 0;
    int PanelH(int mh) { return mh > 520 ? mh : 520; } /* パッチの一覧は、メニューより縦に長くする */
    /* 「関数表示」: いま有効な機能の一覧を作る */
    static void FAdd(char (*b)[64], int& n, const char* t, int val = -1000) {
        if (n >= 16) return;
        int k = 0; while (t[k] && k < 50) { b[n][k] = t[k]; k++; }
        if (val != -1000) {
            b[n][k++] = ' '; b[n][k++] = ':'; b[n][k++] = ' '; /* 「名前 : 値」 */
            int v = val; if (v < 0) { b[n][k++] = '-'; v = -v; }
            char d[8]; int m = 0; do { d[m++] = static_cast<char>('0' + v % 10); v /= 10; } while (v && m < 6);
            while (m) b[n][k++] = d[--m];
        }
        b[n][k] = 0; n++;
    }
    int BuildFuncList(char (*b)[64]) {
        int n = 0;
        const bool hudAny = g_Fx[18] || g_Fx[19] || g_Fx[20] || g_Fx[21] || g_ModeOn || NowTick() < g_FillDiagUntil;
        if (g_InfoOn || hudAny) {
            for (int i = 0; i < g_HudN && i < 6; i++) FAdd(b, n, g_HudLine[i]);
            if (!g_InfoOn) return n;
            FAdd(b, n, g_InfoMgr ? "塗りマネージャ : あり" : "塗りマネージャ : なし");
            if (g_InfoCnt >= 0) FAdd(b, n, "塗れる物の数", g_InfoCnt);
            if (g_InfoState >= 0) FAdd(b, n, (g_InfoState & ~1) == 2 ? "状態値(2か3=塗れる)" : "状態値(2か3以外=塗れない)", g_InfoState);
            if (g_InfoFlag >= 0) FAdd(b, n, "塗り有効フラグ", g_InfoFlag);
            if (g_HaveIdx) { FAdd(b, n, "自分の番号", g_LocalIdx); FAdd(b, n, "自分のチーム", g_LocalIdx >> 2); }
            FAdd(b, n, g_InfoScanned ? "ステージ名の候補:" : "ステージ名: 検索中...");
            for (int i = 0; i < 3 && g_InfoStage[i][0]; i++) { if (n < 16) { int k = 0; b[n][k++] = ' '; b[n][k++] = ' '; for (int q = 0; g_InfoStage[i][q] && k < 50; q++) b[n][k++] = g_InfoStage[i][q]; b[n][k] = 0; n++; } }
            if (g_InfoScanned) FAdd(b, n, "ルール名の候補:");
            for (int i = 0; i < 3 && g_InfoRule[i][0]; i++) { if (n < 16) { int k = 0; b[n][k++] = ' '; b[n][k++] = ' '; for (int q = 0; g_InfoRule[i][q] && k < 50; q++) b[n][k++] = g_InfoRule[i][q]; b[n][k] = 0; n++; } }
            return n;
        }
        if (g_ModeOn) FAdd(b, n, g_TrkStage == 3 ? "フリーフライ（B 上 / ZL 下）" : (g_TrkStage == 0 ? "フリーフライ（準備: 座標を探し中）" : (g_TrkStage == 1 ? "フリーフライ（準備: 歩いてください 1/2）" : "フリーフライ（準備: もう少し歩く 2/2）")));
        if (g_Jump == 3) FAdd(b, n, "ジャンプ : エア+ムーン");
        else if (g_Jump == 1) FAdd(b, n, "ジャンプ : エアジャンプ");
        else if (g_Jump == 2) FAdd(b, n, "ジャンプ : ムーンジャンプ");
        if (g_FreeCam) FAdd(b, n, "Y座標カメラ", g_FreeCam);
        if (g_Genki) FAdd(b, n, "イカ速", g_Genki);
        if (g_Ruler && n < 16) {
            float q[3];
            if (!g_RulerHave) { if (ReadLive(q)) { g_RulerA[0] = q[0]; g_RulerA[1] = q[1]; g_RulerA[2] = q[2]; g_RulerHave = true; } }
            if (g_RulerHave && ReadLive(q)) {
                const float dx = q[0] - g_RulerA[0], dy = q[1] - g_RulerA[1], dz = q[2] - g_RulerA[2];
                const float h = __builtin_sqrtf(dx * dx + dz * dz), t = __builtin_sqrtf(dx * dx + dy * dy + dz * dz);
                std::snprintf(b[n], 64, "ちんこ長 : %.2f (横 %.2f 高 %.2f)", static_cast<double>(t), static_cast<double>(h), static_cast<double>(dy < 0 ? -dy : dy)); n++;
            } else FAdd(b, n, "ちんこ測定 : 座標なし (先に歩く/撃つ)");
        }
        if (g_BlinkOn) FAdd(b, n, "ピコピコ");
        if (g_DrawEnabled) FAdd(b, n, !g_HaveTmpl ? "絵を描く（先に1回インクを撃つ）" : (LiveValid() ? "絵を描く" : "絵を描く（座標なし）"));
        if (g_PatchEnabled) for (int i = 0; i < g_GrpN && n < 16; i++) if (g_Grp[i].on) FAdd(b, n, g_Grp[i].name);
        return n;
    }
    /* 一覧のパネルを (x, y) に描く。大きさを返す。 */
    int g_FuncMenuA = 8;
    int FuncSlideX(int w) { /* ステータス: メニューと同じく、左からすっと出て、左へすっと戻る */
        const u64 n = NowTick();
        if (g_FuncOn) { float p = g_FuncOnT ? static_cast<float>(n - g_FuncOnT) / 3840000.0f : 1.0f; if (p > 1.0f) p = 1.0f; const float q = 1.0f - p; return -static_cast<int>(q * q * q * static_cast<float>(w)); }
        float p = static_cast<float>(n - g_FuncOffT) / 3840000.0f; if (p > 1.0f) p = 1.0f; return -static_cast<int>(p * p * static_cast<float>(w));
    }
    void SwDrawFunc(Cv& v, int x, int y, int& outW, int& outH) {
        /* メニューと同じ見た目: 暗い板 + グレーのふち (太さ 2)、上にタイトルと線。行は「名前 : 値」を、名前は左 (白)、値は右 (グレー) にそろえる */
        const Col panel { 0.043f, 0.047f, 0.055f }, frame { 0.46f, 0.48f, 0.52f }, line { 0.30f, 0.31f, 0.33f }, white { 0.96f, 0.97f, 0.98f }, dim { 0.62f, 0.64f, 0.69f };
        static char lb[24][64]; static int ln = 0; static int kind = 0; /* 消えていく間は、最後の中身のまま */
        if (g_FuncOn) { ln = BuildFuncList(lb); kind = g_InfoOn ? 2 : ((g_Fx[18] || g_Fx[19] || g_Fx[20] || g_Fx[21] || (g_ModeOn && !g_FlyQuiet) || NowTick() < g_FillDiagUntil) ? 1 : 0); }
        const int n = ln, W = 300, head = 46, row = 30, H = head + row * (n ? n : 1) + 8;
        SwRRect(v, x, y, W, H, 18.0f, frame);
        SwRRect(v, x + 2, y + 2, W - 4, H - 4, 16.0f, panel);
        SwU8(v, kind == 2 ? "試合情報" : (kind == 1 ? "ステータス" : "関数表示"), x + 18, y + (head - font_glyphs::kLineH) / 2, W - 36, white);
        SwRect(v, x + 12, y + head - 6, W - 24, 1, line);
        if (!n) SwU8(v, "有効な機能はありません", x + 18, y + head + (row - font_glyphs::kLineH) / 2, W - 36, dim);
        for (int i = 0; i < n; i++) {
            const int ty = y + head + row * i + (row - font_glyphs::kLineH) / 2; const char* t = lb[i]; int c = -1;
            for (int q = 0; t[q] && t[q + 1] && t[q + 2]; q++) if (t[q] == ' ' && t[q + 1] == ':' && t[q + 2] == ' ') { c = q; break; }
            if (c < 0) { SwU8(v, t, x + 18, ty, W - 36, white); continue; }
            char nm[64]; for (int q = 0; q < c && q < 63; q++) nm[q] = t[q]; nm[c < 63 ? c : 63] = 0;
            const int nw = U8W(nm); SwU8(v, nm, x + 18, ty, W - 36, white);
            int av = W - 36 - nw - 12; if (av < 40) av = 40; SwU8R(v, t + c + 3, x + W - 18, ty, av, dim);
        }
        { const u64 nq = NowTick(); if ((g_FuncOn && g_FuncOnT && nq - g_FuncOnT < 3840000ull) || (!g_FuncOn && g_FuncOffT && nq - g_FuncOffT < 3840000ull)) g_FadeBusy = true; /* 動いている間は毎フレーム描き直す */
          PRect pr { x, y, W, H, 18 }; g_BaseRects[g_BaseRectN++] = pr; (void)g_FuncMenuA; }
        outW = W; outH = H;
    }
