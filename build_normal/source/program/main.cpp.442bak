    float g_CamF[2] = {1.0f, 0.0f}; bool g_CamFOk = false;
    u64 g_FlyDiag[4] = {}; int g_FlyDumps = 0; u64 g_FlyFrames = 0; float g_LearnPrev[3] = {}; bool g_LearnHave = false;
    bool g_PrevRs[64] = {};
    volatile bool g_ReqProbe = false;    /* 十字キー右: 候補を書き換えて、戻されるか調べる */
    PaintRequest g_Tmpl;
    PaintRequest g_EnemyTmpl; bool g_HaveEnemy = false; u64 g_EnemyTick = 0; /* 敵の色の塗り (プレイヤー番号が 8 以上) の見本 */                 /* 最後に自分が撃ったときの塗り要求 (絵の元にする) */
    u64          g_TmplA2 = 0;
    bool         g_HaveTmpl = false;
    bool         g_TmplOwn = false;      /* 見本が「自分で撃った塗り」か (false = ゲームが最初に出した塗り = ステージの仕掛けのもの) */
    volatile bool g_Busy = false;        /* 描く処理の同時実行を防ぐ */
    u64 g_TlsCb = 0, g_TlsFocus = 0, g_TlsPop = 0, g_TlsHid = 0;
    u64 g_CntCb = 0, g_CntFocus = 0, g_CntPop = 0;
    ALWAYS_INLINE u64 ReadTls() { u64 v; asm volatile("mrs %0, tpidrro_el0" : "=r"(v)); return v; }
    void       (*g_PreFn)() = nullptr;
    void       (*g_DriveFn)() = nullptr; /* ボタン読み取り側から描く処理を進める関数 */
    bool         g_Down[64] = {};        /* コントローラーごとの「押している」状態 */

    /* 描く絵。最初は組み込みの絵で、ink.bin があればそれに置き換える。 */
    u8           g_Bits[kMaxImageBytes];
    int          g_W = 0;
    int          g_H = 0;

    ALWAYS_INLINE bool PixelOn(int index) {
        return (g_Bits[index >> 3] >> (7 - (index & 7))) & 1;
    }

    void UseBuiltinImage() {
        g_W = paint_image::kWidth;
        g_H = paint_image::kHeight;
        std::memset(g_Bits, 0, sizeof(g_Bits));
        std::memcpy(g_Bits, paint_image::kBits, sizeof(paint_image::kBits));
    }

    /* 読み込みに失敗したとき: 大きな X を描く (「画像が読めなかった」の目印)。 */
    void UseErrorImage() {
        g_W = 24;
        g_H = 24;
        std::memset(g_Bits, 0, sizeof(g_Bits));
        for (int i = 0; i < 24; i++)
            for (int t = 0; t < 2; t++) {
                const int a = i * 24 + i + t;
                const int b = i * 24 + (23 - i) - t;
                if (i + t < 24) g_Bits[a >> 3] |= static_cast<u8>(0x80 >> (a & 7));
                if (23 - i - t >= 0) g_Bits[b >> 3] |= static_cast<u8>(0x80 >> (b & 7));
            }
    }

    /* SD カードをマウントできなかったときの目印: 四角い枠。 */
    void UseBoxImage() {
        g_W = 20;
        g_H = 20;
        std::memset(g_Bits, 0, sizeof(g_Bits));
        for (int y = 0; y < 20; y++)
            for (int x = 0; x < 20; x++)
                if (x < 2 || y < 2 || x >= 18 || y >= 18) {
                    const int i = y * 20 + x;
                    g_Bits[i >> 3] |= static_cast<u8>(0x80 >> (i & 7));
                }
    }

    void UsePlusImage() {
        g_W = 21;
        g_H = 21;
        std::memset(g_Bits, 0, sizeof(g_Bits));
        for (int y = 0; y < 21; y++)
            for (int x = 0; x < 21; x++)
                if ((x >= 9 && x <= 11) || (y >= 9 && y <= 11)) {
                    const int i = y * 21 + x;
                    g_Bits[i >> 3] |= static_cast<u8>(0x80 >> (i & 7));
                }
    }

    /* ===== 文字を絵に反映: Switch のキーボードで文字を入れ、その文字をインクの絵にする ===== */
    volatile int g_InkSz = 2; volatile int g_ImgK = 4; volatile bool g_YgOn = false; volatile int g_YgMulIdx = 2, g_YgCalls = 0, g_YgStepCalls = 0; volatile uintptr_t g_YgSelf = 0; volatile u32 g_YgState = 0; volatile float g_YgDist = 0.0f, g_YgSpd = 0.0f; float g_YgOut[9] = {};
    void NameLive(const char* cur, const char* nw); char g_RealNick[40] = {}; char g_NameCur[40] = {}; volatile bool g_CrashArm = false; u64 g_CrashArmT = 0; volatile bool g_NameRnd = false; volatile int g_NameRndIv = 1; u64 g_NameRndT = 0; u32 g_NameRndLast = 99; volatile bool g_NameOn = false; volatile int g_KbTarget = 0, g_VibReq = 0; char g_NameU8[40] = {}; volatile bool g_NickHooked = false;
    volatile bool g_TextOn = false; volatile int g_TextReq = 0, g_TextK = 2, g_TextMsg = 0; char g_TextU8[100] = {}; bool g_TextImg = false;
    alignas(16) u8 g_KbArg[0x560];
    int TxFind(u32 cp) {
        int lo = 0, hi = font_glyphs::kCount - 1;
        while (lo <= hi) { const int m = (lo + hi) / 2; const u32 v = font_glyphs::kCodes[m]; if (v == cp) return m; if (v < cp) lo = m + 1; else hi = m - 1; }
        return -1;
    }
    /* 入れた文字 (UTF-8) を 1 ビットの絵にして g_Bits に入れる。入れられたら true */
    bool RenderTextBitmap() {
        const u8* p0 = reinterpret_cast<const u8*>(g_TextU8);
        u32 cps[48]; int n = 0, w = 4;
        for (const u8* p = p0; *p && n < 48;) {
            u32 cp = *p++;
            if (cp >= 0xF0 && p[0] && p[1] && p[2]) { cp = ((cp & 7) << 18) | ((p[0] & 63) << 12) | ((p[1] & 63) << 6) | (p[2] & 63); p += 3; }
            else if (cp >= 0xE0 && p[0] && p[1]) { cp = ((cp & 15) << 12) | ((p[0] & 63) << 6) | (p[1] & 63); p += 2; }
            else if (cp >= 0xC0 && p[0]) { cp = ((cp & 31) << 6) | (p[0] & 63); p += 1; }
            int gi = TxFind(cp); if (gi < 0) gi = TxFind('?'); if (gi < 0) continue;
            if (w + font_glyphs::kAdv[gi] > 335) break;
            cps[n++] = static_cast<u32>(gi); w += font_glyphs::kAdv[gi];
        }
        if (n == 0) return false;
        const int W = w + 2, H = font_glyphs::kLineH + 2;
        if (static_cast<size_t>(W) * H > kMaxImageBytes * 8) return false;
        g_W = W; g_H = H;
        std::memset(g_Bits, 0, (static_cast<size_t>(W) * H + 7) / 8);
        int x = 2;
        for (int k = 0; k < n; k++) {
            const int gi = static_cast<int>(cps[k]);
            const u8* r = font_glyphs::kRuns + font_glyphs::kOff[gi] * 4;
            for (int i = 0; i < font_glyphs::kN[gi]; i++, r += 4) {
                if (r[3] < (font_glyphs::kCodes[gi] >= 0x4E00 ? 1 : 2)) continue; /* 漢字は細い線も残す */
                const int yy = r[0] + 1;
                for (int q = 0; q < r[2]; q++) {
                    const int xx = W - 1 - (x + r[1] + q); /* 左右を反転 (そのままだと鏡文字になる) */
                    if (xx < 0 || xx >= W || yy < 0 || yy >= H) continue;
                    const int bi = yy * W + xx; g_Bits[bi >> 3] |= static_cast<u8>(0x80 >> (bi & 7));
                }
            }
            x += font_glyphs::kAdv[gi];
        }
        return true;
    }

    struct FsApi {
        using OpenFn  = u32  (*)(FileHandle*, const char*, int);
        using SizeFn  = u32  (*)(s64*, FileHandle);
        using ReadFn  = u32  (*)(u64*, FileHandle, s64, void*, u64);
        using CloseFn = void (*)(FileHandle);
        using MountFn = u32  (*)(const char*);
        OpenFn open; SizeFn size; ReadFn read; CloseFn close; MountFn mount;
    };
    FsApi g_Fs {};
    bool  g_Mounted = false;
    bool  g_DumpMounted = false;
    /* 起動したら、タイトルを A ボタンで自動で進める (ON/OFF は SD の inkdraw/autotitle.flag があるかどうか) */
    volatile bool g_AutoTitle = false, g_AutoRun = false, g_AutoDone = false, g_ReqAtSave = false; bool g_AtLoaded = false;
    uintptr_t AtSdk() { return exl::util::HasModule(exl::util::ModuleIndex::Sdk) ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0; }
    bool AtMount(uintptr_t sdk) {
        using MountFn = u32 (*)(const char*); using DirFn = u32 (*)(const char*);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0) rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return false;
            g_DumpMounted = true;
        }
        const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin");
        return true;
    }
    bool AtExists(uintptr_t sdk) {
        using OpenFn = u32 (*)(FileHandle*, const char*, int); using CloseFn = void (*)(FileHandle);
        FileHandle fh { nullptr };
        if (reinterpret_cast<OpenFn>(sdk + kSdkOpenFile)(&fh, "inkd:/inkdraw/autotitle.flag", 1) != 0) return false;
        reinterpret_cast<CloseFn>(sdk + kSdkCloseFile)(fh);
        return true;
    }
    void AtLoadSave(bool save) {
        const uintptr_t sdk = AtSdk();
        if (!sdk || !AtMount(sdk)) return;
        using CreateFn = u32 (*)(const char*, s64); using DelFn = u32 (*)(const char*);
        if (save) {
            if (g_AutoTitle) { if (!AtExists(sdk)) reinterpret_cast<CreateFn>(sdk + 0xA9E70)("inkd:/inkdraw/autotitle.flag", 1); }
            else reinterpret_cast<DelFn>(sdk + 0xA9E80)("inkd:/inkdraw/autotitle.flag");
        } else {
            g_AutoTitle = AtExists(sdk);
            g_AutoRun = g_AutoTitle; /* 起動したときに ON なら、今回のタイトルを自動で進める */
        }
    }

    struct FileCtx { FileHandle fh; };
    u64 g_ImgDiag = 0; /* 画像読み込みの診断: [63:56]=段階 [55:48]=どのファイル [47:40]=Decodeの結果 [31:0]=サイズ */

    bool ReadThunk(void* ctx, uint64_t off, void* buf, uint32_t n) {
        u64 got = 0;
        const u32 rc = g_Fs.read(&got, static_cast<FileCtx*>(ctx)->fh, static_cast<s64>(off), buf, n);
        return rc == 0 && got == n;
    }

    enum class LoadResult { Loaded, NoFile, Failed, MountFailed };

    /* SD カードの画像を読む。ファイルがなければ NoFile、あるのに読めなければ Failed。 */
    LoadResult LoadImageFile(const char* only = nullptr) {
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (sdk == 0)
            return LoadResult::NoFile;

        g_Fs.open  = reinterpret_cast<FsApi::OpenFn>(sdk + kSdkOpenFile);
        g_Fs.size  = reinterpret_cast<FsApi::SizeFn>(sdk + kSdkGetFileSize);
        g_Fs.read  = reinterpret_cast<FsApi::ReadFn>(sdk + kSdkReadFile);
        g_Fs.close = reinterpret_cast<FsApi::CloseFn>(sdk + kSdkCloseFile);
        g_Fs.mount = reinterpret_cast<FsApi::MountFn>(sdk + kSdkMountSdCard);

        if (g_DumpMounted) g_Mounted = true; /* 書き出し用にすでにマウント済みなら、そのまま使う */
        if (!g_Mounted) {
            /* マウントに成功しないと OpenFile がゲームを落とすので、失敗したらファイルは開かない。 */
            u32 rc = g_Fs.mount(kMountName);
            if (rc != 0)
                rc = reinterpret_cast<FsApi::MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0)
                return LoadResult::MountFailed;
            g_Mounted = true;
        }

        g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        const size_t nPaths = only ? 1 : sizeof(kImagePaths) / sizeof(kImagePaths[0]);
        bool onlyInv = false;
        if (only) for (const char* q = only; *q; q++) if (q[0] == '_' && q[1] == 'i' && q[2] == 'n' && q[3] == 'v') onlyInv = true;
        for (size_t k = 0; k < nPaths; k++) {
            FileCtx fc { { nullptr } };
            if (g_Fs.open(&fc.fh, only ? only : kImagePaths[k], 1 /* OpenMode_Read */) != 0)
                continue;
            g_ImgDiag = (1ull << 56) | (static_cast<u64>(k) << 48);

            LoadResult res = LoadResult::Failed;
            s64 size = 0;
            const u32 src_rc = g_Fs.size(&size, fc.fh);
            g_ImgDiag |= static_cast<u64>(static_cast<u32>(size));
            if (src_rc == 0 && size > 0) {
                g_ImgDiag = (g_ImgDiag & ~(0xffull << 56)) | (2ull << 56);
                sdimage::Source src { ReadThunk, &fc, static_cast<uint64_t>(size) };
                static sdimage::Bitmap bmp;
                const int dr = sdimage::Decode(src, only ? onlyInv : kImageInvert[k], bmp);
                g_ImgDiag = (g_ImgDiag & ~(0xffull << 56)) | (3ull << 56) | (static_cast<u64>(dr & 0xff) << 40);
                if (dr == sdimage::Ok && bmp.w > 0 && bmp.h > 0) {
                    g_W = bmp.w;
                    g_H = bmp.h;
                    std::memset(g_Bits, 0, sizeof(g_Bits));
                    std::memcpy(g_Bits, bmp.bits, (static_cast<size_t>(bmp.w) * bmp.h + 7) / 8);
                    res = LoadResult::Loaded;
                }
            }
            g_Fs.close(fc.fh);
            return res;
        }
        return LoadResult::NoFile;
    }
    /* inkdraw フォルダの絵 (png / bmp) の一覧を作る */
    void ImgScan() {
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return;
        if (!g_Mounted) LoadImageFile(); /* マウントを済ませる */
        if (!g_Mounted) return;
        using OpenDirFn = u32 (*)(void**, const char*, int);
        using ReadDirFn = u32 (*)(s64*, void*, void*, s64);
        using CloseDirFn = void (*)(void*);
        void* h = nullptr;
        if (reinterpret_cast<OpenDirFn>(sdk + 0xAB3B0)(&h, "inkd:/inkdraw", 2 /* ファイルだけ */) != 0 || !h) return;
        static u8 ent[8 * 0x310];
        int n = 0;
        for (int guard = 0; guard < 16 && n < 32; guard++) {
            s64 cnt = 0;
            if (reinterpret_cast<ReadDirFn>(sdk + 0xA8F60)(&cnt, ent, h, 8) != 0 || cnt <= 0) break;
            for (s64 e = 0; e < cnt && n < 32; e++) {
                const char* nm = reinterpret_cast<const char*>(ent + e * 0x310);
                int len = 0; while (nm[len] && len < 60) len++;
                if (len < 5 || nm[len]) continue;
                const char c1 = nm[len - 3] | 0x20, c2 = nm[len - 2] | 0x20, c3 = nm[len - 1] | 0x20;
                const bool ok = nm[len - 4] == '.' && ((c1 == 'p' && c2 == 'n' && c3 == 'g') || (c1 == 'b' && c2 == 'm' && c3 == 'p'));
                if (!ok) continue;
                for (int i = 0; i <= len; i++) g_ImgNames[n][i] = nm[i];
                n++;
            }
        }
        reinterpret_cast<CloseDirFn>(sdk + 0xA8ED0)(h);
        /* 今選んでいる絵が消えていたら、自動に戻す */
        g_ImgN = n; if (g_ImgSel >= n) g_ImgSel = -1;
    }

    /* ---- pchtxt (テキスト形式のパッチ) ---------------------------------------
       SD:/inkdraw/patches.pchtxt と patch1.pchtxt 〜 patch9.pchtxt を読んで、main に当てる。
       書式: 先頭の @nsobid-xxxx (ゲーム本体のビルドID。違えば当てない)、@flag offset_shift 0x100、
             @enabled / @disabled / @stop、「オフセット 16進のバイト列」または「オフセット "文字列"」の行。
       モードをオフにすると、元のバイトに戻す。 */
    constexpr const char* kMainBuildId = "28C4287AEE36F749"; /* 11.3.0 の main (クラッシュレポートの Module Id から) */
    struct PchEntry { u32 off; u8 len; u8 grp; bool applied; u8 data[48]; u8 orig[48]; };
    /* パッチのまとまり (直前のコメントを名前にする)。ひとつずつ ON/OFF できる。 */
    struct PchGroup { char name[56]; bool on; s8 file; s32 mS, mE, first; }; /* file: どのファイルか、mS〜mE: そのまとまりの @enabled / @disabled の行 (なければ -1)、first: 最初のパッチの行の頭 */
    volatile bool g_PchSaveReq = false; u64 g_PchSaveT = 0;
    PchGroup g_Grp[64]; int g_GrpN = 0;
    PchEntry g_Pch[256];
    int  g_PchN = 0;
    bool g_PchLoaded = false, g_PchApplied = false;
    /* 画面に一覧を出すための、pchtxt の行 (ファイル名の見出し、コメント、@行、パッチの行) */
    char g_PchView[0x8000]; int g_PchViewLen = 0;
    u16  g_PchLineOff[512]; u8 g_PchLineKind[512]; int g_PchLines = 0; /* kind: 0 = 見出し / 1 = コメント / 2 = @行 / 3 = パッチ */
    void PchViewAdd(const char* t, size_t n, u8 kind) {
        if (g_PchLines >= 512 || g_PchViewLen + 80 >= static_cast<int>(sizeof(g_PchView))) return;
        if (n > 72) n = 72;
        g_PchLineOff[g_PchLines] = static_cast<u16>(g_PchViewLen);
        g_PchLineKind[g_PchLines] = kind;
        g_PchLines++;
        std::memcpy(g_PchView + g_PchViewLen, t, n);
        g_PchViewLen += static_cast<int>(n);
        g_PchView[g_PchViewLen++] = 0;
    }
    u32  g_PchDiag = 0; /* [7:0]=読めたファイル数 [15:8]=ビルドID違いで飛ばした数 [31:16]=行数 */

    int HexVal(char c) {
        if (c >= '0' && c <= '9') return c - '0';
        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
        return -1;
    }
    void ParsePchtxt(const char* t, size_t n, int fileIdx) {
        bool enabled = true, idOk = true; long markS = -1, markE = -1; /* 前のまとまりのあとに出てきた @enabled / @disabled の行 */
        long shift = 0x100; /* pchtxt の多くは offset_shift 0x100 (オフセットは text の先頭から) */
        char pending[56] = {}; bool havePending = false; int curGrp = -1; bool needNew = true;
        size_t p = 0;
        while (p < n) {
            size_t e = p; while (e < n && t[e] != '\n') e++;
            size_t a = p, b = e; const size_t ls = p; /* 行の頭 */
            p = e + 1;
            while (a < b && (t[a] == ' ' || t[a] == '\t' || t[a] == '\r')) a++;
            while (b > a && (t[b - 1] == ' ' || t[b - 1] == '\t' || t[b - 1] == '\r')) b--;
            if (a >= b) continue;
            {
                const u8 kind = (t[a] == '/' || t[a] == '#' || t[a] == ';') ? 1 : (t[a] == '@' ? 2 : 3);
                PchViewAdd(t + a, b - a, kind);
            }
            if (t[a] == '/' || t[a] == '#' || t[a] == ';') {
                /* コメント: 次のパッチのまとまりの名前にする */
                size_t q = a; while (q < b && (t[q] == '/' || t[q] == '#' || t[q] == ';' || t[q] == ' ' || t[q] == '\t' || t[q] == '*')) q++;
                size_t k = 0; while (q < b && k < sizeof(pending) - 1) pending[k++] = t[q++];
                /* 途中で切れた UTF-8 の文字を落とす */
                while (k > 0 && (static_cast<u8>(pending[k - 1]) & 0xC0) == 0x80) k--;
                if (k > 0 && static_cast<u8>(pending[k - 1]) >= 0xC0) k--;
                pending[k] = 0;
                if (k > 0) { havePending = true; needNew = true; }
                continue;
            }
            g_PchDiag += 0x10000;
            if (t[a] == '@') {
                auto starts = [&](const char* k) { size_t q = 0; while (k[q]) { if (a + q >= b || t[a + q] != k[q]) return false; q++; } return true; };
                if (starts("@nsobid-")) {
                    idOk = true;
                    for (int q = 0; q < 16 && a + 8 + q < b; q++) {
                        char c = t[a + 8 + q]; if (c >= 'a' && c <= 'f') c = static_cast<char>(c - 32);
                        if (c != kMainBuildId[q]) { idOk = false; break; }
                    }
                    if (!idOk) g_PchDiag += 0x100;
                } else if (starts("@flag offset_shift")) {
                    size_t q = a + 18; while (q < b && (t[q] == ' ' || t[q] == '\t')) q++;
                    long v = 0; bool hex = false;
                    if (q + 1 < b && t[q] == '0' && (t[q + 1] == 'x' || t[q + 1] == 'X')) { hex = true; q += 2; }
                    for (; q < b; q++) { const int h = hex ? HexVal(t[q]) : (t[q] >= '0' && t[q] <= '9' ? t[q] - '0' : -1); if (h < 0) break; v = v * (hex ? 16 : 10) + h; }
                    shift = v;
                } else if (starts("@enabled")) { enabled = true; needNew = true; markS = static_cast<long>(a); markE = static_cast<long>(b); }
                else if (starts("@disabled")) { enabled = false; needNew = true; markS = static_cast<long>(a); markE = static_cast<long>(b); }
                else if (starts("@stop")) return;
                continue;
            }
            if (!idOk) continue;
            /* オフセット */
            size_t q = a; u64 off = 0; int nd = 0;
            while (q < b && HexVal(t[q]) >= 0) { off = off * 16 + static_cast<u64>(HexVal(t[q])); q++; nd++; }
            if (nd == 0) continue;
            while (q < b && (t[q] == ' ' || t[q] == '\t')) q++;
            PchEntry pe {}; int len = 0;
            if (q < b && t[q] == '"') {
                q++;
                while (q < b && t[q] != '"' && len < 47) pe.data[len++] = static_cast<u8>(t[q++]);
                pe.data[len++] = 0;
            } else {
                while (q + 1 < b && len < 48) {
                    const int h1 = HexVal(t[q]), h2 = HexVal(t[q + 1]);
                    if (h1 < 0 || h2 < 0) break;
                    pe.data[len++] = static_cast<u8>(h1 * 16 + h2);
                    q += 2;
                }
            }
            if (len == 0 || g_PchN >= 256) continue;
            const long addr = static_cast<long>(off) + shift - 0x100; /* main の先頭からの位置 */
            if (addr < 0) continue;
            pe.off = static_cast<u32>(addr); pe.len = static_cast<u8>(len);
            if (needNew || curGrp < 0) {
                if (g_GrpN >= 64) continue;
                curGrp = g_GrpN++;
                PchGroup& G = g_Grp[curGrp];
                if (havePending) { size_t k = 0; while (pending[k] && k < sizeof(G.name) - 1) { G.name[k] = pending[k]; k++; } G.name[k] = 0; }
                else {
                    const char* d = "パッチ "; size_t k = 0; while (*d) G.name[k++] = *d++;
                    int num = curGrp + 1; char tmp[4]; int nn = 0; do { tmp[nn++] = static_cast<char>('0' + num % 10); num /= 10; } while (num && nn < 3);
                    while (nn) G.name[k++] = tmp[--nn];
                    G.name[k] = 0;
                }
                G.on = enabled; G.file = static_cast<s8>(fileIdx); G.mS = static_cast<s32>(markS); G.mE = static_cast<s32>(markE); G.first = static_cast<s32>(ls);
                havePending = false; needNew = false;
            }
            pe.grp = static_cast<u8>(curGrp); pe.applied = false; markS = markE = -1;
            g_Pch[g_PchN++] = pe;
        }
    }
    void LoadPchtxt() {
        if (g_PchLoaded) return;
        g_PchLoaded = true;
        if (LoadImageFile() == LoadResult::MountFailed) return; /* SD のマウント (と関数の用意) をここで済ませる */
        static char buf[0x10000];
        const char* names[] = {
            "inkd:/inkdraw/patches.pchtxt",  "inkd:/inkdraw/patch1.pchtxt", "inkd:/inkdraw/patch2.pchtxt",
            "inkd:/inkdraw/patch3.pchtxt", "inkd:/inkdraw/patch4.pchtxt", "inkd:/inkdraw/patch5.pchtxt",
            "inkd:/inkdraw/patch6.pchtxt", "inkd:/inkdraw/patch7.pchtxt", "inkd:/inkdraw/patch8.pchtxt",
            "inkd:/inkdraw/patch9.pchtxt",
        };
        int fileIdx = -1;
        for (const char* nm : names) {
            fileIdx++;
            FileHandle fh { nullptr };
            if (g_Fs.open(&fh, nm, 1) != 0) continue;
            s64 size = 0;
            if (g_Fs.size(&size, fh) == 0 && size > 0) {
                if (size > static_cast<s64>(sizeof(buf))) size = sizeof(buf);
                u64 got = 0;
                if (g_Fs.read(&got, fh, 0, buf, static_cast<u64>(size)) == 0 && got > 0) {
                    g_PchDiag += 1;
                    {
                        const char* base = nm; for (const char* q = nm; *q; q++) if (*q == '/') base = q + 1;
                        size_t bl = 0; while (base[bl]) bl++;
                        PchViewAdd(base, bl, 0);
                    }
                    if (got < sizeof(buf)) ParsePchtxt(buf, static_cast<size_t>(got), fileIdx); else ParsePchtxt(buf, static_cast<size_t>(got), -1); /* 大きすぎて全部読めなかったファイルは、保存しない */
                }
            }
            g_Fs.close(fh);
        }
    }
    /* それぞれのパッチを、(全体のスイッチ && まとまりのスイッチ) に合わせて当てる/戻す */
    void ApplyPchtxt(bool globalOn) {
        const uintptr_t mainSize = exl::util::GetMainModuleInfo().m_Rodata.GetEnd() - exl::util::GetMainModuleInfo().m_Total.m_Start;
        const uintptr_t base = exl::util::GetMainModuleInfo().m_Total.m_Start;
        const uintptr_t endAll = exl::util::GetMainModuleInfo().m_Total.GetEnd();
        exl::patch::RandomAccessPatcher rp;
        bool any = false;
        for (int i = 0; i < g_PchN; i++) {
            PchEntry& pe = g_Pch[i];
            const bool want = globalOn && pe.grp < g_GrpN && g_Grp[pe.grp].on;
            if (want == pe.applied) { any = any || pe.applied; continue; }
            if (pe.off + pe.len > mainSize) {
                const uintptr_t a2 = base + pe.off;
                if (a2 + pe.len > endAll) continue;
                u8* m = reinterpret_cast<u8*>(a2);
                for (int k = 0; k < pe.len; k++) { if (want) { pe.orig[k] = m[k]; m[k] = pe.data[k]; } else m[k] = pe.orig[k]; }
            } else {
                for (int k = 0; k < pe.len; k++) {
                    if (want) { pe.orig[k] = rp.Read<u8>(pe.off + k); rp.Write<u8>(pe.off + k, pe.data[k]); }
                    else      { rp.Write<u8>(pe.off + k, pe.orig[k]); }
                }
            }
            pe.applied = want;
            any = any || want;
        }
        g_PchApplied = any;
    }
    /* 元気数値: 02846068 の「fcsel s1, s1, s2, eq」を「ldr s1, (近くの空き場所)」に替えて、そこに数値 (1〜100) を置く。0 なら元に戻す。 */
    constexpr u32 kGenkiOff = 0x2846068, kGenkiCave = 0x2759F98, kGenkiOrig = 0x1E220C21;
    bool g_GenkiPatched = false; u32 g_GenkiPrev = 0x1E220C21; u32 g_GenkiFail = 0;
    void GenkiApply(int v) {
        exl::patch::RandomAccessPatcher rp;
        if (v <= 0) {
            if (g_GenkiPatched) { rp.Write<u32>(kGenkiOff, g_GenkiPrev); g_GenkiPatched = false; }
            return;
        }
        if (!g_GenkiPatched) {
            /* 元の命令 (fcsel) か、pchtxt で当てた「fmov s1, #数値」のときだけ書き換える。戻すときは、その時の命令に戻す。 */
            const u32 cur = rp.Read<u32>(kGenkiOff);
            const bool okInsn = cur == kGenkiOrig || (cur & 0xFFE01FFFu) == 0x1E201001u;
            if (!okInsn || rp.Read<u32>(kGenkiCave - 8) != 0xD65F03C0u) { g_GenkiFail = cur; g_Genki = 0; return; }
            g_GenkiPrev = cur;
        }
        const float f = static_cast<float>(v);
        u32 bits; std::memcpy(&bits, &f, 4);
        rp.Write<u32>(kGenkiCave, bits);
        if (!g_GenkiPatched) {
            const s32 imm19 = (static_cast<s32>(kGenkiCave) - static_cast<s32>(kGenkiOff)) / 4;
            rp.Write<u32>(kGenkiOff, 0x1C000000u | ((static_cast<u32>(imm19) & 0x7FFFFu) << 5) | 1u); /* ldr s1, =数値 */
            g_GenkiPatched = true;
        }
    }

    /* 人速度: 0284605C の「fmov s2, #1.0」(イカ泳ぎ以外の速さ倍率) を「ldr s2, (空き場所)」に替える。0 なら元に戻す。倍率 = 1 + 値 x 0.5 */
    constexpr u32 kHSpdOff = 0x284605C, kHSpdCave = 0x2759F94, kHSpdOrig = 0x1E2E1002;
    bool g_HSpdPatched = false;
    void HSpdApply(int v) {
        exl::patch::RandomAccessPatcher rp;
        if (v <= 0) { if (g_HSpdPatched) { rp.Write<u32>(kHSpdOff, kHSpdOrig); g_HSpdPatched = false; } return; }
        if (!g_HSpdPatched) {
            const u32 cur = rp.Read<u32>(kHSpdOff);
            if (cur != kHSpdOrig || rp.Read<u32>(kHSpdCave - 4) != 0xD65F03C0u) { g_HSpdFail = cur; g_HSpd = 0; return; }
        }
        const float f = 1.0f + 0.5f * static_cast<float>(v > 20 ? 20 : v);
        u32 bits; std::memcpy(&bits, &f, 4);
        rp.Write<u32>(kHSpdCave, bits);
        if (!g_HSpdPatched) {
            const s32 imm19 = (static_cast<s32>(kHSpdCave) - static_cast<s32>(kHSpdOff)) / 4;
            rp.Write<u32>(kHSpdOff, 0x1C000000u | ((static_cast<u32>(imm19) & 0x7FFFFu) << 5) | 2u); /* ldr s2, =倍率 */
            g_HSpdPatched = true;
        }
    }

    /* ---- ジャンプスケア ----------------------------------------------------------
       SD:/inkdraw/scare/ の png / bmp (色つき) を、ON のあいだ、ランダムな間隔で画面いっぱいに数秒だけ出す。 */
    constexpr int kScW = 16, kScH = 16; /* ジャンプスケアはメニューから消したので使われない。メモリを空けるため、受け皿を最小にした (大きいとゲームの起動で落ちた) */
    volatile bool g_ScareOn = false, g_ScareNow = false, g_ScareShow = false; volatile int g_ScareInt = 1;
    char g_ScareNames[16][64]; int g_ScareN = 0; bool g_ScareScanned = false;
    u32 g_ScareImg[kScW * kScH]; int g_ScareW = 0, g_ScareH = 0; bool g_ScareReady = false, g_ScareRendered = false;
    u64 g_ScareAt = 0, g_ScareUntil = 0, g_ScareRetry = 0; int g_ScareLast = -1;
    u32 g_ScareSum[kScW * kScH * 4]; u16 g_ScareTx[8192]; int g_ScareSw = 0, g_ScareSh = 0, g_ScareTw = 0, g_ScareTh = 0;
    void ScarePxInit(int w, int h) {
        g_ScareSw = w; g_ScareSh = h;
        int tw = w, th = h;
        if (w > kScW || h > kScH) {
            const long long a = static_cast<long long>(kScW) * h, b = static_cast<long long>(kScH) * w; /* 縦横どちらかが枠に合うように縮める */
            if (a <= b) { tw = kScW; th = static_cast<int>(static_cast<long long>(h) * kScW / w); } else { th = kScH; tw = static_cast<int>(static_cast<long long>(w) * kScH / h); }
            if (tw < 1) tw = 1; if (th < 1) th = 1;
        }
        g_ScareTw = tw; g_ScareTh = th;
        std::memset(g_ScareSum, 0, static_cast<size_t>(tw) * th * 16);
        for (int x = 0; x < w && x < 8192; x++) g_ScareTx[x] = static_cast<u16>((static_cast<long long>(x) * tw) / w);
    }
    void ScarePx(int x, int y, int r, int g, int b, int a) {
        if (x >= 8192 || g_ScareSh <= 0) return;
        const int ty = static_cast<int>((static_cast<long long>(y) * g_ScareTh) / g_ScareSh);
        u32* c = g_ScareSum + (static_cast<size_t>(ty) * g_ScareTw + g_ScareTx[x]) * 4;
        if (a < 255) { r = r * a / 255; g = g * a / 255; b = b * a / 255; } /* すきまは黒 */
        c[0] += static_cast<u32>(r); c[1] += static_cast<u32>(g); c[2] += static_cast<u32>(b); c[3]++;
    }
    void ScareScan() {
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return;
        if (!g_Mounted) LoadImageFile();
        if (!g_Mounted) return;
        using OpenDirFn = u32 (*)(void**, const char*, int);
        using ReadDirFn = u32 (*)(s64*, void*, void*, s64);
        using CloseDirFn = void (*)(void*);
        g_ScareN = 0;
        void* h = nullptr;
        if (reinterpret_cast<OpenDirFn>(sdk + 0xAB3B0)(&h, "inkd:/inkdraw/scare", 2) != 0 || !h) return;
        static u8 ent[8 * 0x310];
        int n = 0;
        for (int guard = 0; guard < 8 && n < 16; guard++) {
            s64 cnt = 0;
            if (reinterpret_cast<ReadDirFn>(sdk + 0xA8F60)(&cnt, ent, h, 8) != 0 || cnt <= 0) break;
            for (s64 e = 0; e < cnt && n < 16; e++) {
                const char* nm = reinterpret_cast<const char*>(ent + e * 0x310);
                int len = 0; while (nm[len] && len < 60) len++;
                if (len < 5 || nm[len]) continue;
                const char c1 = nm[len - 3] | 0x20, c2 = nm[len - 2] | 0x20, c3 = nm[len - 1] | 0x20;
                const bool ok = nm[len - 4] == '.' && ((c1 == 'p' && c2 == 'n' && c3 == 'g') || (c1 == 'b' && c2 == 'm' && c3 == 'p'));
                if (!ok) continue;
                for (int i = 0; i <= len; i++) g_ScareNames[n][i] = nm[i];
                n++;
            }
        }
        reinterpret_cast<CloseDirFn>(sdk + 0xA8ED0)(h);
        g_ScareN = n;
    }
    bool ScareLoad(int idx) {
        char path[128]; const char* pre = "inkd:/inkdraw/scare/"; int k = 0;
        while (pre[k]) { path[k] = pre[k]; k++; }
        for (int i = 0; g_ScareNames[idx][i] && k < 126; i++) path[k++] = g_ScareNames[idx][i];
        path[k] = 0;
        FileCtx fc { { nullptr } };
        if (g_Fs.open(&fc.fh, path, 1) != 0) return false;
        bool ok = false; s64 size = 0;
        if (g_Fs.size(&size, fc.fh) == 0 && size > 0) {
            sdimage::Source src { ReadThunk, &fc, static_cast<uint64_t>(size) };
            static sdimage::Bitmap bmp;
            sdimage::g_PxInit = ScarePxInit; sdimage::g_PxSink = ScarePx;
            const int dr = sdimage::Decode(src, false, bmp);
            sdimage::g_PxInit = nullptr; sdimage::g_PxSink = nullptr;
            if (dr == sdimage::Ok && g_ScareTw > 0 && g_ScareTh > 0) {
                for (int i = 0; i < g_ScareTw * g_ScareTh; i++) {
                    const u32* c = g_ScareSum + static_cast<size_t>(i) * 4;
                    const u32 n = c[3] ? c[3] : 1;
                    g_ScareImg[i] = (c[0] / n) | ((c[1] / n) << 8) | ((c[2] / n) << 16) | 0xFF000000u;
                }
                g_ScareW = g_ScareTw; g_ScareH = g_ScareTh; ok = true;
            }
        }
        g_Fs.close(fc.fh);
        return ok;
    }
    void ScareTick() {
        const u64 now = NowTick();
        if (!g_ScareOn) { if (g_ScareShow) g_ScareShow = false; g_ScareReady = false; g_ScareAt = 0; return; }
        if (!g_ScareScanned) { ScareScan(); g_ScareScanned = true; }
        if (g_ScareShow) { if (now >= g_ScareUntil) { g_ScareShow = false; g_ScareReady = false; g_ScareAt = 0; } return; }
        if (g_ScareN < 0 || g_ScareN > 16) { g_ScareN = 0; g_ScareScanned = false; g_ScareRetry = now + 5ull * 19200000ull; } /* 値が壊れていたら捨てて、あとで探し直す */
        if (g_ScareN == 0 || now < g_ScareRetry) { g_ScareNow = false; return; }
        static u32 rnd = 0x9E3779B9u;
        rnd ^= rnd << 13; rnd ^= rnd >> 17; rnd ^= rnd << 5; rnd += static_cast<u32>(now);
        if (!g_ScareReady) {
            int idx = static_cast<int>((rnd >> 4) % static_cast<u32>(g_ScareN));
            if (idx < 0 || idx >= 16) idx = 0;
            if (g_ScareN > 1 && idx == g_ScareLast) idx = (idx + 1) % g_ScareN;
            if (!ScareLoad(idx)) { g_ScareRetry = now + 10ull * 19200000ull; g_ScareNow = false; return; }
            g_ScareLast = idx; g_ScareReady = true;
            static const u32 kBase[5] = { 10, 30, 60, 120, 300 };
            const u32 b = kBase[g_ScareInt % 5];
            const u32 ms = b * 500u + (rnd >> 8) % (b * 1000u); /* 0.5〜1.5 倍のあいだでランダム */
            g_ScareAt = now + static_cast<u64>(ms) * 19200ull;
        }
        if (g_ScareNow) { g_ScareNow = false; g_ScareAt = now; }
        if (now >= g_ScareAt) {
            g_ScareShow = true; g_ScareRendered = false;
            g_ScareUntil = now + static_cast<u64>(1200u + (rnd >> 12) % 900u) * 19200ull; /* 1.2〜2.1 秒 */
        }
    }
    int GspMul(int ix) { if (ix < 0) ix = 0; if (ix > 49) ix = 49; return ix + 1; }
    void GspText(char* o, int ix) {
        if (g_GspCalls == 0) std::snprintf(o, 40, "%d倍 未呼出", GspMul(ix));
        else std::snprintf(o, 40, "%d倍 w%u", GspMul(ix), static_cast<unsigned>(g_GspW1));
    }
    int SelCount() { return g_SelPanel == 1 ? g_ImgN + 1 : (g_SelPanel == 2 ? kTplN : (g_SelPanel == 3 ? 3 : (g_SelPanel == 4 ? 4 : (g_SelPanel == 5 ? 4 : (g_SelPanel == 12 ? 10 : (g_SelPanel == 9 ? 4 : (g_SelPanel == 10 ? 3 : (g_SelPanel == 11 ? 5 : (g_SelPanel == 6 ? 3 : (g_SelPanel == 7 ? 4 : (g_SelPanel == 8 ? 2 : 0))))))))))); }
    void SelApply() {
        if (g_SelPanel == 1) { g_ImgSel = g_SelCur - 1; g_ImgReq = true; }
        else if (g_SelPanel == 2) g_UzuStyle = g_SelCur % kTplN;
        else if (g_SelPanel == 3) g_EraseSel = g_SelCur % 3;
        else if (g_SelPanel == 4) g_TrP = g_SelCur % 4; /* インクの道の形 */
        else if (g_SelPanel == 6) g_TrW = g_SelCur % 3; /* インクの道の太さ */
        else if (g_SelPanel == 5) { static const int kSub[4] = { 9, 10, 12, 11 }; g_SelPanel = kSub[g_SelCur & 3]; g_SelCur = 0; g_SelScroll = 0; } /* ワープ地点: カテゴリを開く */
        else if (g_SelPanel == 12) { /* 地点を見る: 選んだ地点を毎フレーム追いかける。最後の行でやめる */
            if (g_SelCur == 6) { g_SelPanel = 12; return; } /* 向く範囲: 左右で変える (L では閉じない) */
            if (g_SelCur == 9) { g_LookAHold = !g_LookAHold; return; } /* A押しの間だけ: オン/オフ */
            if (g_SelCur == 8) { g_LookSlot = 5; g_LookOn = true; g_LookMsg = 0; g_EnScanNow = true; return; } /* いちばん近い敵を見る */
            if (g_SelCur == 7) { g_LookSlot = 4; g_LookOn = true; g_LookMsg = 0; g_BalScanNow = true; return; } /* いちばん近いイカバルーンを見る */
            if (g_SelCur == 5) g_GyroRange = (g_GyroRange + 1) % 6; /* ジャイロ切替距離: L で順に変える */
            else if (g_SelCur >= 4) { g_LookOn = false; g_LookMsg = 0; }
            else { const int c = g_SelCur & 3; if (g_WarpHas[c]) { g_LookSlot = c; g_LookOn = true; g_LookMsg = 0; } else g_LookMsg = 4; }
        }
        else if (g_SelPanel >= 9 && g_SelPanel <= 11) { /* ワープ地点の中身 */
            auto on = [] { if (!g_ModeOn) { g_ModeOn = true; g_FlyQuiet = true; if (!TrkReady()) { g_FlyRestart = true; g_FlyNext = 0; } } g_WarpOn = true; };
            const int c = g_SelCur;
            if (g_SelPanel == 9) { if (g_WarpHas[c & 3]) { on(); std::memcpy(g_WarpPos, g_WarpSlots[c & 3], 12); g_WarpReq = true; g_WarpMsg = 0; } else g_WarpMsg = 4; }
            else if (g_SelPanel == 10) { on(); g_WarpSaveSlot = c % 3; g_WarpSaveReq = true; g_WarpMsg = 0; g_WarpMark = true; } /* 記憶したら印も出す */
            else if (c == 0) g_WarpMark = !g_WarpMark;
            else { g_WarpOn = false; g_WarpHas[0] = g_WarpHas[1] = g_WarpHas[2] = g_WarpHas[3] = false; g_LookOn = false; g_StartBlock = true; /* スタート地点も消す (次のロードでまた覚える) */ g_WarpMsg = 0; g_WarpHold = 0; g_WarpHoldL = 0; g_WarpReq = false; g_WarpSaveReq = false; if (g_FlyQuiet) { g_ModeOn = false; g_FlyQuiet = false; } }
        }
        else if (g_SelPanel == 7) g_ImgRot = g_SelCur & 3; /* 絵の向き */
        else if (g_SelPanel == 8) { /* 描く場所の予約 */
            if (g_SelCur == 0) { g_ResvReq = true; g_ResvMsg = 0; } /* 足元の座標は、毎フレームの処理 (WarpStartTick) で読む */
            else { g_ResvHave = false; g_ResvMsg = 0; }
        }
    }
    volatile int g_RstMsg = 0; volatile u64 g_RstT = 0;
    void SettingsReset() { /* 設定をぜんぶ最初の状態に戻す */
        g_UiScale = 100; g_UiX = 0; g_UiY = 0; g_LookOn = false; g_LookMsg = 0; g_AimTgt = 0; g_LookAHold = false; g_CircOn = false; g_CircR = 30; g_LookRange = 9; g_LeadLv = 0;
        g_EnOn = false; g_BalOn = false; g_BoxOn = false; g_LineOn = true; g_FovLv = 0; g_FovSel = 0; g_Fx[4] = 0;
        for (int q = 0; q < kCatCount; q++) g_CatSel[q] = 0;
        g_RstMsg = 1; g_RstT = NowTick();
    }
    void DynInput(int it, bool act, bool lf, bool rt) {
        if (it == kDynDth) { if (act) DthPress(); return; }
        if (it == kDynTeam) { if (act) TsPress(); return; } /* チームサーチ */
        if (it == kDynAsari) { if (act) AsrPress(); return; } /* アサリサーチ */
        if (it == kDynAsrDet) { if (act) AdPress(); return; } /* アサリ詳細サーチ */
        if (it == kDynAsrDiff) { if (act) DfPress(); return; } /* アサリ差分サーチ */
        if (it == kDynReset) { if (act) SettingsReset(); return; }
        if (it >= kDynPch && it < kDynPch + 64) { if ((act || rt || lf) && it - kDynPch < g_GrpN) { g_Grp[it - kDynPch].on = !g_Grp[it - kDynPch].on; g_ReqPatchApply = true; g_PchSaveReq = true; g_PchSaveT = NowTick(); } return; }
        if (it == kDynPchMsg) return;
        if (it == kDynLogClr) { if (act) g_LogClrReq = true; return; }
        if (it == kDynTrail) { if (act) g_Trail = !g_Trail; return; }
        auto quiet = [] { if (!g_ModeOn) { g_ModeOn = true; g_FlyQuiet = true; if (!TrkReady()) { g_FlyRestart = true; g_FlyNext = 0; } } }; /* 座標の準備を始める (B / ZL では浮かない) */
        if (it == kDynWarp) { if (act || rt) { g_SelPanel = 5; g_SelCur = 0; g_SelScroll = 0; } return; } /* 右に選択パネルを開く: 戻る / 記憶する / 印・消す */
        if (it == kDynGcLkBal) { if (act) { if (g_LookOn && g_LookSlot == 4) g_LookOn = false; else { g_LookSlot = 4; g_LookOn = true; g_LookMsg = 0; g_BalScanNow = true; } } return; } /* いちばん近いバルーンを見る */
        if (it == kDynGcLkEn) { if (act) { if (g_LookOn && g_LookSlot == 5) g_LookOn = false; else { g_LookSlot = 5; g_LookOn = true; g_LookMsg = 0; g_EnScanNow = true; } } return; } /* いちばん近い敵を見る */
        if (it == kDynGcRange) { if (lf && g_LookRange > 0) g_LookRange = g_LookRange - 1; if (rt && g_LookRange < 19) g_LookRange = g_LookRange + 1; return; } /* 追従範囲 (= 向く範囲) */
        if (it == kDynGcCirc) { int c2 = g_CircR; if (lf) c2--; if (rt) c2++; if (act) c2 += 10; if (c2 > 100) c2 = act ? 1 : 100; if (c2 < 1) c2 = 1; g_CircR = c2; return; } /* 円の大きさ: 左右で 1 ずつ (長押しで続けて)、L で 10 ずつ */
        if (it == kDynGcAim) { if (act) { if (g_LookOn && g_LookSlot == 6) g_LookOn = false; else { g_LookSlot = 6; g_LookOn = true; g_LookMsg = 0; g_EnScanNow = true; g_BalScanNow = true; } } return; } /* エイムボット: オン / オフ */
        if (it == kDynBalSum) { if (act) g_BalSumReq = true; return; }
        if (it == kDynClam) { if (act) ClamPress(); return; } /* アサリ集め */ /* バルーン召喚: L で、見つかったイカバルーンを全部、自分の足元のまわりへ */
        if (it == kDynGcTgt) { if (act || rt) g_AimTgt = (g_AimTgt + 1) % 3; if (lf) g_AimTgt = (g_AimTgt + 2) % 3; g_EnScanNow = true; g_BalScanNow = true; return; } /* ねらう相手: 敵 / バルーン / 両方 */
        if (it == kDynGcLead) { if (lf && g_LeadLv > 0) g_LeadLv = g_LeadLv - 1; if (rt && g_LeadLv < 20) g_LeadLv = g_LeadLv + 1; if (act) g_LeadLv = g_LeadLv ? 0 : 10; return; } /* 偏差射撃: 左右で強さ、L で なし ⇔ 10 */
        if (it == kDynGcCircOn) { if (act) g_CircOn = !g_CircOn; return; } /* 円: 出す / 出さない (出さないときは、円の中かどうかを見ない) */
        if (it == kDynGcA) { if (act) g_LookAHold = !g_LookAHold; return; } /* A長押しの間だけ */
        if (it == kDynFov) { int v2 = g_FovLv; if (lf && v2 > 0) v2--; if (rt && v2 < 12) v2++; if (act) { if (!v2) v2 = 6; else if (g_FovN > 0) g_FovSel = (g_FovSel + 1) % g_FovN; } g_FovLv = v2; return; } /* 視野の広さ: 左右で変える、L で次の候補を試す (変わる候補を探す) */ /* 視野の広さ: 左右で変える、L で そのまま ⇔ 85 度 */
        if (it == kDynGcWarp) { if (act) { /* 敵の近くへワープ: いちばん近い敵の、こちらから見て向こう側 1.5 の所へ */
                float me[3]; int best = -1; float bd = 1e30f, bp[3] = {};
                if (SelfPos(me)) for (int k = 0; k < g_EnN; k++) { float p2[3]; if (!EnPos(k, p2)) continue; const float dx = p2[0] - me[0], dz = p2[2] - me[2], d = dx * dx + dz * dz; if (d < bd) { bd = d; best = k; std::memcpy(bp, p2, 12); } }
                if (best < 0) { g_EnWarpMsg = 1; g_EnWantUntil = NowTick() + 60ull * 19200000ull; g_EnScanNow = true; return; }
                const float dx = bp[0] - me[0], dz = bp[2] - me[2], dl = __builtin_sqrtf(dx * dx + dz * dz); const float ux = dl > 0.1f ? dx / dl : 0.0f, uz = dl > 0.1f ? dz / dl : 0.0f;
                if (!g_ModeOn) { g_ModeOn = true; g_FlyQuiet = true; if (!TrkReady()) { g_FlyRestart = true; g_FlyNext = 0; } } g_WarpOn = true;
                g_WarpPos[0] = bp[0] + ux * 1.5f; g_WarpPos[1] = bp[1] + 2.27f /* kLiveHeight (床から自分の座標までの高さ) */; g_WarpPos[2] = bp[2] + uz * 1.5f; g_WarpReq = true; g_WarpMsg = 0; g_EnWarpMsg = 0; } return; }
        if (it == kDynEnInk) { if (act) { g_EnInkOn = !g_EnInkOn; if (g_EnInkOn) g_EnScanNow = true; } return; } /* 相手の座標の下にインクを塗る */
        if (it == kDynLkRec) { if (act) g_LkOn = !g_LkOn; return; } /* エイムボットの記録 */
        if (it == kDynGaAim) { if (act) { g_GaOn = !g_GaOn; if (g_GaOn) { g_EnScanNow = true; g_BalScanNow = true; } } return; }
        if (it == kDynRstBtn) { if (act) g_RstReq = true; return; } /* ログリセット */ /* エイムボット（ジャイロ） */
        if (it == kDynGyRec) { if (act) g_GrOn = !g_GrOn; return; } /* ジャイロ記録 */
        if (it == kDynKbRec) { if (act) { g_KbOn = !g_KbOn; KbReset(g_KbOn); } return; } /* ノックバック記録 */
        if (it == kDynZr) { if (act) g_Fx[4] = g_Fx[4] ? 0 : 1; return; } /* ZR押しっぱなし: メニューを閉じている間、ZR を押し続ける */
        if (it == kDynFt2) { if (act && (g_Ft2Step == 0 || g_Ft2Step >= 9)) g_Ft2Step = 1; return; } /* 飛び方テスト: L で始める */
        if (it == kDynAddr) { if (act && (g_AsStep == 0 || g_AsStep >= 9)) { g_AsStep = 1; g_AsN = 0; g_AsSample = 0; } return; } /* アドレスサーチ: L で始める */
        if (it == kDynUpd) { if (act && g_UpdState != 1 && g_UpdState != 2 && g_UpdState != 3) { g_UpdManual = true; g_UpdMsg = 0; g_UpdErr = 0; nvnhook::SplashManual(); } return; } /* 起動の表示と同じ板で、確認からダウンロード・結果まで出す */ /* アップデート確認: L で今すぐ確かめる */
        if (it == kDynCamScan) { if (act && g_ScanStep == 0) { g_ScanStep = 1; g_ScanMsg = 0; } return; } /* 視点探し: L で始める */
        if (it == kDynImgRot) { if (act || rt) { g_SelPanel = 7; g_SelCur = g_ImgRot & 3; g_SelScroll = 0; } return; }
        if (it == kDynResv) { if (act || rt) { g_SelPanel = 8; g_SelCur = g_ResvHave ? 1 : 0; g_SelScroll = 0; } return; }
        if (it == kDynTrW) { if (act || rt) { g_SelPanel = 6; g_SelCur = g_TrW % 3; g_SelScroll = 0; } return; } /* 右に選択パネルを開いて選ぶ */
        if (it == kDynTrP) { if (act || rt) { g_SelPanel = 4; g_SelCur = g_TrP & 3; g_SelScroll = 0; } return; } /* 右に選択パネルを開いて選ぶ (全塗り・インク消しと同じ) */
        if (it == kDynMenuCol) { int v = g_MenuCol; if (act) v = 0; if (lf) v = (v + 5) % 6; if (rt) v = (v + 1) % 6; g_MenuCol = v; return; }
        if (it == kDynSpdV) {
            const uintptr_t o = g_SpdObj;
            if (o && Readable(o + 0x40, 0x1c0)) {
                float* f = reinterpret_cast<float*>(o + 0x40);
                if (!g_SpdHave) { for (int q = 0; q < 112; q++) g_SpdOrigAll[q] = f[q]; g_SpdHave = true; g_SpdMul = 1.0f; }
                /* 小数らしい値 (0.05〜500) で、ポインタの一部でないものだけ、書き換える。それ以外には絶対に書かない (ゲームが更新している値を古い値で上書きすると落ちる) */
                auto scalable = [&](int k) -> bool {
                    const float ov = g_SpdOrigAll[k]; const float av = ov < 0 ? -ov : ov;
                    u32 lo, hi; std::memcpy(&lo, &g_SpdOrigAll[k & ~1], 4); std::memcpy(&hi, &g_SpdOrigAll[k | 1], 4);
                    if (hi >= 1u && hi <= 0x7Fu && lo != 0u) return false;
                    if ((k & ~1) >= 2) { u32 plo, phi; std::memcpy(&plo, &g_SpdOrigAll[(k & ~1) - 2], 4); std::memcpy(&phi, &g_SpdOrigAll[(k & ~1) - 1], 4); (void)plo; (void)phi; }
                    return av >= 0.05f && av <= 500.0f;
                };
                float m = g_SpdMul;
                if (act) { for (int q = 0; q < 4; q++) { const int k = g_SpdGrp * 4 + q; if (scalable(k)) f[k] = g_SpdOrigAll[k]; } g_SpdGrp = (g_SpdGrp + 1) % 28; m = 1.0f; g_SpdMul = 1.0f; }
                else if (lf) m *= 0.8f; else if (rt) m *= 1.25f;
                if (m < 0.2f) m = 0.2f; if (m > 8.0f) m = 8.0f;
                if (m != g_SpdMul) { g_SpdMul = m; for (int q = 0; q < 4; q++) { const int k = g_SpdGrp * 4 + q; if (scalable(k)) f[k] = g_SpdOrigAll[k] * m; } }
            }
            return;
        }
        if (it == kDynHSpd) { int v = g_HSpd; if (lf && v > 0) v--; if (rt && v < 20) v++; if (act) v = v == 0 ? g_HSpdLast : 0; if (v != g_HSpd) { if (v > 0) g_HSpdLast = v; g_HSpd = v; g_HSpdReq = true; } return; }
        if (it == kDynInkSz) { if (g_InkSz > 5) g_InkSz = 5; if (lf && g_InkSz > 1) g_InkSz = g_InkSz - 1; if (rt && g_InkSz < 5) g_InkSz = g_InkSz + 1; if (act) g_InkSz = g_InkSz % 5 + 1; return; } /* インクの大きさ 1〜10 (5 = これまでの大きさ) */
        if (it == kDynImgSz) { if (lf && g_ImgK > 1) g_ImgK = g_ImgK - 1; if (rt && g_ImgK < 8) g_ImgK = g_ImgK + 1; if (act) g_ImgK = g_ImgK % 8 + 1; return; }
        if (it == kDynName) { if (act) { g_NameOn = !g_NameOn; if (g_NameOn && !g_NameU8[0]) { g_KbTarget = 1; g_TextReq = 1; }
            else if (g_NameOn) { const char* const from = g_NameCur[0] ? g_NameCur : g_RealNick; if (from[0] && std::strcmp(from, g_NameU8) != 0) NameLive(from, g_NameU8); std::memcpy(g_NameCur, g_NameU8, sizeof(g_NameCur)); }
            else if (g_NameCur[0] && g_RealNick[0]) { NameLive(g_NameCur, g_RealNick); std::memcpy(g_NameCur, g_RealNick, sizeof(g_NameCur)); } } if (rt) { g_KbTarget = 1; g_TextReq = 1; } return; }
        if (it == kDynText) { if (act) { g_TextOn = !g_TextOn; if (g_TextOn && !g_TextU8[0]) { g_KbTarget = 0; g_TextReq = 1; } } if (rt) { g_KbTarget = 0; g_TextReq = 1; } if (lf) g_TextK = g_TextK % 4 + 1; return; }
        if (it == kDynMark) { if (act) g_MarkOn = !g_MarkOn; return; }
        if (it == kDynFlk) { if (act) g_Flk = !g_Flk; return; }
        if (it == kDynWall) { if (act) g_Wall = !g_Wall; return; }
        if (it == kDynCrash) { /* 強制終了: L 1 回で、ゲームをわざと落とす */
            if (act) { volatile u64* bad = reinterpret_cast<volatile u64*>(NowTick() & 0); *bad = 1; }
            return;
        }
        if (it == kDynNameRnd) { /* 名前ランダム: 一定の間隔で、名前を入れ替える。左右: 間隔 */
            if (act) { g_NameRnd = !g_NameRnd; g_NameRndT = 0; }
            if (rt) g_NameRndIv = (g_NameRndIv + 1) % 5; if (lf) g_NameRndIv = (g_NameRndIv + 4) % 5;
            return;
        }
        if (it == kDynRuler) { /* ものさし(ちんこ測定): 入れた場所から今いる場所までの長さを測る。右: 測り直し */
            if (act) { g_Ruler = !g_Ruler; if (g_Ruler) { float q[3]; g_RulerHave = ReadLive(q); if (g_RulerHave) { g_RulerA[0] = q[0]; g_RulerA[1] = q[1]; g_RulerA[2] = q[2]; } } else g_RulerHave = false; UpdateFuncOn(); }
            if (rt && g_Ruler) { float q[3]; g_RulerHave = ReadLive(q); if (g_RulerHave) { g_RulerA[0] = q[0]; g_RulerA[1] = q[1]; g_RulerA[2] = q[2]; } }
            return; }
        if (it == kDynAuto) { if (act) { g_AutoTitle = !g_AutoTitle; g_ReqAtSave = true; } return; }
        if (it == kDynFlow) { if (act) g_FlowOn = !g_FlowOn; if (lf || rt) g_FlowMode = (g_FlowMode == 2) ? 1 : 2; return; }
        if (it == kDynGsp) { if (act) g_Gsp = !g_Gsp; if (lf && g_GspIdx > 0) g_GspIdx = g_GspIdx - 1; if (rt && g_GspIdx < 49) g_GspIdx = g_GspIdx + 1; return; }
        if (it == kDynUzu) { if (rt) { g_SelPanel = 2; g_SelCur = g_UzuStyle % kTplN; g_SelScroll = 0; } if (act && g_HaveTmpl) { g_Spiral = true; g_Armed = true; } return; }
        if (it >= kDynEmo && it < kDynEmo + 5) { if (act) g_EmoFire = it - kDynEmo; return; }
        if (it == kDyn) { if (act) { g_ScareOn = !g_ScareOn; if (g_ScareOn) { g_ScareScanned = false; g_ScareReady = false; } } return; }
        if (it == kDyn + 1) { if (lf && g_ScareInt > 0) { g_ScareInt = g_ScareInt - 1; g_ScareReady = false; } if (rt && g_ScareInt < 4) { g_ScareInt = g_ScareInt + 1; g_ScareReady = false; } return; }
        if (it == kDyn + 2) { if (act) { if (!g_ScareOn) { g_ScareOn = true; g_ScareScanned = false; } g_ScareNow = true; } return; }
    }
    /* ボタン読み取りのたびに呼ばれる (タイトル画面やロビーでも動く)。パッチの読み込みと、モードの切り替えをここで行う。 */
    volatile bool g_TickBusy = false;
    bool Readable(uintptr_t addr, size_t len);
    void MemEditTick();
    void JumpApply(int mode);
    volatile bool g_FrameFallback = false;
    void FlowTick();
    void HidTick() {
        ExtraTick();
        UpdTick();
        SettingsTick();
        AsTick();
        Ft2Tick();
        BalTick();
        ClamTick(); /* アサリ集め */
        if (g_TextReq) { g_TextReq = 0; TextKeyboard(); }
        if (__atomic_exchange_n(&g_TickBusy, true, __ATOMIC_ACQUIRE)) return;
        {
            /* 毎フレームの更新 (FrameHook) が動かないステージでは、ボタン読み取りの側から代わりに動かす */
            static u64 lastCnt = ~0ull; static int stall = 0;
            if (g_CntFrame != lastCnt) { lastCnt = g_CntFrame; stall = 0; g_FrameFallback = false; }
            else if (++stall > 20) { g_FrameFallback = true; static u64 lastRun = 0; const u64 nw = NowTick(); if (nw - lastRun >= 300000ull) { lastRun = nw; if (g_PreFn) g_PreFn(); if (g_DriveFn) g_DriveFn(); } } /* 1 フレーム (約 16ms) に 1 回だけ */
        }
        if (!g_PchLoaded) { LoadPchtxt(); ApplyPchtxt(g_PatchEnabled); }
        if (g_ReqPatchApply) { g_ReqPatchApply = false; ApplyPchtxt(g_PatchEnabled); }
        if (g_GenkiReq) { g_GenkiReq = false; GenkiApply(g_Genki); }
        if (g_HSpdReq) { g_HSpdReq = false; } /* 人速度はフックで効かせる */
        ScareTick();
        DthTick();
        if (g_MemEditReq) MemEditTick();
        FlowTick();
        if (g_JumpReq) { g_JumpReq = false; JumpApply(g_Jump); }
        if (g_CleanTeamSet && g_CleanRestoreAt && NowTick() >= g_CleanRestoreAt) {
            if (g_CleanTeamPtr && Readable(g_CleanTeamPtr, 4)) *reinterpret_cast<s32*>(g_CleanTeamPtr) = g_CleanTeamOrig;
            g_CleanTeamSet = false; g_CleanRestoreAt = 0;
        }
        __atomic_store_n(&g_TickBusy, false, __ATOMIC_RELEASE);
    }

    ALWAYS_INLINE s32 GetKind(const PaintRequest* req) {
        s32 kind;
        std::memcpy(&kind, req->raw + kOffKind, sizeof(kind));
        return kind;
    }

    /* 位置を直接指定した塗り (撃った弾が床に当たったとき) か。 */
    ALWAYS_INLINE bool IsPointPaint(const PaintRequest* req) {
        return req->raw[kOffObjFlag] == 0 || GetKind(req) == kKindPoint;
    }


    /* ---- 自分の座標を探す (実行中の自動キャリブレーション) -------------------- */
    /* 塗り要求には「撃った人」の種類 (+0x38) と番号 (+0x3e) が入っている。
       種類 3 なら PaintMgr+696 の配列 (+704 + 8*番号)、種類 2 なら PaintMgr+704 の配列 (+920 の先 [番号]) に
       その人のオブジェクトがある (解析で確認)。そのオブジェクトの中、またはそこから1段たどった先に、
       撃った場所の近くの値 (float 3つ) が何度も並んでいる場所があれば、それが自分の座標。 */
    constexpr size_t kObjFloats  = 1024;  /* オブジェクト本体: 先頭 0x1000 バイト */
    constexpr int    kPtrFields  = 512;   /* 本体の中のポインタ (先頭 0x1000 バイト分)  */
    constexpr size_t kSubFloats  = 256;   /* 1段先: 先頭 0x400 バイト */
    constexpr float  kNearRange  = 18.0f;
    constexpr int    kLockHits   = 6;
#ifndef INKDRAW_USE_PLAYER_POS
#define INKDRAW_USE_PLAYER_POS 0
#endif
    constexpr bool   kUsePlayerPos = INKDRAW_USE_PLAYER_POS;
    constexpr float  kMaxPlayerDist = 30.0f;

    u8   g_ScoreObj[kObjFloats][2];
    u8   g_ScoreSub[kPtrFields][kSubFloats][2];
    int  g_CalibEvents = 0;
    int  g_BestScore = 0;
    bool g_Locked = false;
    int  g_LockRegion = 0, g_LockOff = 0, g_LockPerm = 0; /* 領域 0 = 本体、1.. = ポインタ [n-1] の先 */
    s32  g_ShKind = 0; u32 g_ShId = 0;                    /* 最後に撃った人 */
    float g_LastHit[3] = {};
    bool  g_HaveLastHit = false;

    bool Readable(uintptr_t addr, size_t len) {
        if (addr < 0x10000 || (addr & 3))
            return false;
        MemoryInfo mi;
        u32 page;
        if (R_FAILED(svcQueryMemory(&mi, &page, addr)))
            return false;
        if (mi.type == MemType_Unmapped || !(mi.perm & Perm_R) || (mi.attr & 0xC) /* 端末共有・キャッシュなしの領域は読まない (GPU 用で、読むと落ちる) */)
            return false;
        return addr + len <= mi.addr + mi.size;
    }
    /* ジャンプ: 1 = Air Jump (028AB918 の b.ne を nop)、2 = Moon Jump (02859614 の mov w12,#0x270e を mov w12,#0)、3 = 両方。
       番地は IDA の番地そのまま (main の先頭からの位置)。元の命令を確かめてから書き換える。 */
    void JumpApply(int mode) {
        constexpr u32 kAirOff = 0x28AB918, kMoonOff = 0x2859614;
        constexpr u32 kAirOrig = 0x5400E661u, kAirVal = 0xD503201Fu, kMoonOrig = 0x5284E1CCu, kMoonVal = 0x5280000Cu;
        if (g_OffPaintRequest != 0x371D1C0) { g_Jump = 0; return; } /* 11.3.0 以外では触らない */
        exl::patch::RandomAccessPatcher rp;
        const u32 a = rp.Read<u32>(kAirOff), m = rp.Read<u32>(kMoonOff);
        if ((a != kAirOrig && a != kAirVal) || (m != kMoonOrig && m != kMoonVal)) { g_Jump = 0; return; } /* 違う命令なら触らない */
        if (a != ((mode & 1) ? kAirVal : kAirOrig)) rp.Write<u32>(kAirOff, (mode & 1) ? kAirVal : kAirOrig);
        if (m != ((mode & 2) ? kMoonVal : kMoonOrig)) rp.Write<u32>(kMoonOff, (mode & 2) ? kMoonVal : kMoonOrig);
    }
    bool Writable(uintptr_t addr, size_t len) {
        if (!Readable(addr, len)) return false;
        MemoryInfo mi; u32 page;
        if (R_FAILED(svcQueryMemory(&mi, &page, addr))) return false;
        return (mi.perm & Perm_W) != 0;
    }
    /* メモリサーチ: 選んだ行の値を 1 つ変える (16進/整数は ±1、小数は ±0.1) */
    void MemEditTick() {
        if (!g_MemEditReq) return;
        g_MemEditReq = false;
        const uintptr_t a = g_MemBase + 4 + 4 * static_cast<uintptr_t>(g_MemSel);
        if (!g_MemBase || !Writable(a, 4)) return;
        if (g_MemType == 1) { float f; std::memcpy(&f, reinterpret_cast<void*>(a), 4); f += 0.1f * g_MemEditDir; std::memcpy(reinterpret_cast<void*>(a), &f, 4); }
        else *reinterpret_cast<volatile s32*>(a) += g_MemEditDir;
    }

    uintptr_t ReadPaintMgr();

    /* 撃った人のオブジェクトを返す。わからなければ 0。 */
    uintptr_t GetShooter(s32 kind, u32 id) {
        const uintptr_t mgr = ReadPaintMgr();
        if (!Readable(mgr + 696, 16))
            return 0;
        if (kind == 3) {
            const uintptr_t Q = *reinterpret_cast<uintptr_t*>(mgr + 696);
            if (!Q || id >= 0x100 || !Readable(Q + 704 + 8 * id, 8))
                return 0;
            return *reinterpret_cast<uintptr_t*>(Q + 704 + 8 * id);
        }
        if (kind == 2) {
            const uintptr_t P = *reinterpret_cast<uintptr_t*>(mgr + 704);
            if (!P || !Readable(P + 904, 24))
                return 0;
            const s32 cnt = *reinterpret_cast<s32*>(P + 912);
            const uintptr_t arr = *reinterpret_cast<uintptr_t*>(P + 920);
            if (cnt <= 0 || id >= static_cast<u32>(cnt) || !Readable(arr + 8 * id, 8))
                return 0;
            return *reinterpret_cast<uintptr_t*>(arr + 8 * id);
        }
        return 0;
    }

    ALWAYS_INLINE bool Near(float v, float t) {
        const float d = v - t;
        return d > -kNearRange && d < kNearRange;
    }
    ALWAYS_INLINE float Absf(float v) { return v < 0 ? -v : v; }

    ALWAYS_INLINE void Vote(const float* f, size_t n, u8 (*score)[2], int region, const float* h) {
        for (size_t k = 0; k + 2 < n; k++) {
            const float x = f[k], y = f[k + 1], z = f[k + 2];
            if (!(x == x) || !(y == y) || !(z == z))
                continue;
            if (!Near(x, h[0]))
                continue;
            if (Near(y, h[1]) && Near(z, h[2])) {
                if (Absf(x - h[0]) < 0.05f && Absf(y - h[1]) < 0.05f && Absf(z - h[2]) < 0.05f)
                    continue; /* 着地点そのものを持っている場所は除く */
                if (score[k][0] < 255) {
                    const int v = ++score[k][0];
                    if (v > g_BestScore) g_BestScore = v;
                    if (!g_Locked && v >= kLockHits && v * 2 >= g_CalibEvents) {
                        g_Locked = true; g_LockRegion = region; g_LockOff = static_cast<int>(k); g_LockPerm = 0;
                    }
                }
            }
            if (Near(y, h[2]) && Near(z, h[1])) {
                if (Absf(x - h[0]) < 0.05f && Absf(z - h[1]) < 0.05f && Absf(y - h[2]) < 0.05f)
                    continue;
                if (score[k][1] < 255) {
                    const int v = ++score[k][1];
                    if (v > g_BestScore) g_BestScore = v;
                    if (!g_Locked && v >= kLockHits && v * 2 >= g_CalibEvents) {
                        g_Locked = true; g_LockRegion = region; g_LockOff = static_cast<int>(k); g_LockPerm = 1;
                    }
                }
            }
        }
    }

    /* 自分の撃った塗りの着地点 h を見るたびに呼ぶ。kind/id はその要求の撃った人。 */
    void CalibrateWithHit(const float* h, s32 kind, u32 id) {
        g_ShKind = kind;
        g_ShId = id;
        if (g_Locked || g_CalibEvents >= 300)
            return;
        const uintptr_t obj = GetShooter(kind, id);
        if (!obj || !Readable(obj, kObjFloats * 4))
            return;
        g_CalibEvents++;
        Vote(reinterpret_cast<const float*>(obj), kObjFloats, g_ScoreObj, 0, h);
        for (int j = 0; j < kPtrFields; j++) {
            const uintptr_t t = *reinterpret_cast<const uintptr_t*>(obj + 8 * j);
            if (t < 0x10000 || (t & 3) || !Readable(t, kSubFloats * 4))
                continue;
            Vote(reinterpret_cast<const float*>(t), kSubFloats, g_ScoreSub[j], j + 1, h);
            if (g_Locked) break;
        }
    }


    /* ---- 自分の座標 (1.13.0 用): 撃った瞬間のスタックにある、ある種類のオブジェクトの +0x10 に (x, 高さ, z) がある --------- */
    constexpr uintptr_t kPosObjVtable = 0x5C65698; /* main 先頭からのオフセット */
    constexpr float kPosObjHeight = 2.54f;           /* 床からこの分だけ高い */
    uintptr_t g_PosObj = 0;
    float g_PosCopy[3] = {};
    bool  g_HavePosCopy = false; u64 g_PosCopyTick = 0;

    uintptr_t MainBase() {
        return exl::util::GetModuleInfo(exl::util::ModuleIndex::Main).m_Total.m_Start;
    }

    /* Switch のソフトウェアキーボードを呼んで、入れた文字を g_TextU8 に入れる (ゲームが使っているのと同じ nn::swkbd の関数。
       関数の場所は main の GOT (+0x4E8BBF0〜) に実行時に入る) */
    void TextKeyboard() {
        struct KbStr { void* p; u64 n; };
        using FnSize = u64 (*)(); using FnWork = u64 (*)(bool); using FnPreset = void (*)(void*, int);
        using FnInit8 = void (*)(void*, const char*); using FnShow = u32 (*)(KbStr*, const void*);
        const uintptr_t b = MainBase();
        auto GotAt = [&](u64 off) -> uintptr_t { return b + off; /* PLT の入口 (遅延解決のため、GOT を直接読まない) */ };
        const uintptr_t aTc = GotAt(0x4E8BBF0), aWork = GotAt(0x4E8BC00), aStr = GotAt(0x4E8BC10), aPre = GotAt(0x4E8BC30), aIni = GotAt(0x4E8BC40), aShow = GotAt(0x4E8BC50);
        if (!aTc || !aWork || !aStr || !aPre || !aIni || !aShow) { g_TextMsg = 1; return; }
        const u64 tcSz = reinterpret_cast<FnSize>(aTc)(), wkSz = reinterpret_cast<FnWork>(aWork)(false), stSz = reinterpret_cast<FnSize>(aStr)();
        if (tcSz > 0x400000 || wkSz > 0x400000 || stSz > 0x400000) { g_TextMsg = 2; return; }
        using FnAA = void* (*)(size_t, size_t); using FnFree = void (*)(void*);
        const FnAA aa = reinterpret_cast<FnAA>(b + 0xA77C20); const FnFree fr = reinterpret_cast<FnFree>(b + 0xA77B40);
        auto up = [](u64 v) -> size_t { return static_cast<size_t>((v + 0xFFF) & ~0xFFFull); };
        u8* const kbWork = static_cast<u8*>(aa(0x1000, up(wkSz))); u8* const kbCheck = static_cast<u8*>(aa(0x1000, up(tcSz))); u8* const kbStr = static_cast<u8*>(aa(0x1000, up(stSz)));
        if (!kbWork || !kbCheck || !kbStr) { if (kbWork) fr(kbWork); if (kbCheck) fr(kbCheck); if (kbStr) fr(kbStr); g_TextMsg = 4; return; }
        std::memset(kbWork, 0, up(wkSz)); std::memset(kbCheck, 0, up(tcSz)); std::memset(kbStr, 0, up(stSz));
        std::memset(g_KbArg, 0, sizeof(g_KbArg));
        char* const dst = g_KbTarget ? g_NameU8 : g_TextU8; const int lim = g_KbTarget ? 32 : 90; /* 名前は、ゲームの名前の入れ物が 33 バイト (終わりの 0 を含む) なので 32 バイトまで */
        reinterpret_cast<FnPreset>(aPre)(g_KbArg, 2); /* プレイヤーを通報する入力と同じ設定 (ローマ字入力が使える) */
        g_KbArg[0x1a] = 1; /* 予測変換 (かな漢字の候補) を有効にする (isPredictionEnabled) */
        *reinterpret_cast<u32*>(g_KbArg + 0x1c) = 0; /* プリセット2 は「Mii の名前に使える文字だけ」(0x100) に制限するので、制限をなくして漢字も入れられるようにする */
        *reinterpret_cast<u64*>(g_KbArg + 0x3ac) = 0x100000018ull; /* 文字数: 最大 24 (ゲームの使い方と同じ並び) */
        *reinterpret_cast<u64*>(g_KbArg + 0x518) = reinterpret_cast<u64>(kbWork);
        *reinterpret_cast<u64*>(g_KbArg + 0x520) = wkSz;
        *reinterpret_cast<u64*>(g_KbArg + 0x528) = reinterpret_cast<u64>(kbCheck);
        *reinterpret_cast<u64*>(g_KbArg + 0x530) = tcSz;
        static char ini[100]; std::memcpy(ini, dst, g_KbTarget ? sizeof(g_NameU8) : sizeof(ini)); ini[99] = 0;
        reinterpret_cast<FnInit8>(aIni)(g_KbArg, ini);
        KbStr out { kbStr, stSz };
        const u32 rc = reinterpret_cast<FnShow>(aShow)(&out, g_KbArg);
        if (rc != 0) { g_TextMsg = ((rc & 0x3fffff) == 0x29f) ? 0 : 3; fr(kbWork); fr(kbCheck); fr(kbStr); return; }
        /* UTF-16 -> UTF-8 */
        const u16* u = reinterpret_cast<const u16*>(out.p ? out.p : kbStr);
        int o = 0;
        for (int i = 0; u[i] && i < 64 && o < lim; i++) {
            u32 c = u[i];
            if (c >= 0xD800 && c < 0xDC00 && u[i + 1]) { c = 0x10000 + ((c - 0xD800) << 10) + (u[i + 1] - 0xDC00); i++; }
            if (c < 0x80) dst[o++] = static_cast<char>(c);
            else if (c < 0x800) { dst[o++] = static_cast<char>(0xC0 | (c >> 6)); dst[o++] = static_cast<char>(0x80 | (c & 63)); }
            else if (c < 0x10000) { dst[o++] = static_cast<char>(0xE0 | (c >> 12)); dst[o++] = static_cast<char>(0x80 | ((c >> 6) & 63)); dst[o++] = static_cast<char>(0x80 | (c & 63)); }
            else { dst[o++] = '?'; }
        }
        dst[o] = 0; g_TextMsg = 0; fr(kbWork); fr(kbCheck); fr(kbStr);
        if (g_KbTarget && dst[0]) { const char* const from = g_NameCur[0] ? g_NameCur : g_RealNick; if (from[0] && std::strcmp(from, g_NameU8) != 0) NameLive(from, g_NameU8); std::memcpy(g_NameCur, g_NameU8, sizeof(g_NameCur)); } /* 入れた名前を、その場でゲームの中にも反映する */
        if (!dst[0]) { if (g_KbTarget) g_NameOn = false; else g_TextOn = false; }
    }
    bool PosObjValid(); bool LiveValid(); bool ReadLive(float* out);
    /* ステージの中で 20 秒たつまでは、メモリの走査をしない (読み込み中にゲームがメモリを解放して、走査中に落ちるのを避ける) */
    static bool StageStable() {
        static u64 since = 0, lastOk = 0; const u64 nw = NowTick();
        if (PosObjValid() || LiveValid()) { lastOk = nw; if (since == 0) since = nw; }
        else if (nw - lastOk > 3ull * 19200000ull) since = 0; /* 座標が一瞬取れないだけなら、待ちをやり直さない */
        return since != 0 && nw - since > 20ull * 19200000ull;
    }
    static const int kFlowOff[14] = { 0xd0, 0xd4, 0xd8, 0xdc, 0x58, 0x6c, 0x64, 0x68, 0x70, 0x74, 0xa4, 0x88, 0x54, 0x50 };
    static bool FlowPlausible(uintptr_t a) {
        const float* f = reinterpret_cast<const float*>(a + 0xd0);
        for (int i = 0; i < 4; i++) if (!(f[i] >= 0.0f && f[i] <= 5000.0f)) return false;
        const float act = *reinterpret_cast<const float*>(a + 0xc8);
        return act >= 0.0f && act <= 100000.0f;
    }
    void FlowTick() {
        static uintptr_t cur = 0; static bool wasOn = false; static u64 nextPass = 0; static bool flowDone = false;
        const bool on = g_FlowOn;
        const uintptr_t vt = MainBase() + 0x5D706F8;
        if (on) {
            /* GUI の機能のオン/オフが変わったら、5 秒のあいだ加点を大きくして、イカフローが出やすくする */
            static u64 prevH = ~0ull; u64 h = 1469598103934665603ull;
            auto mixb = [&](u64 v) { h = (h ^ v) * 1099511628211ull; };
            mixb(g_ModeOn); mixb(static_cast<u64>(g_Jump)); mixb(g_Bunny); mixb(g_BlinkOn); mixb(g_PatchEnabled); mixb(g_Gsp); mixb(g_InfoOn); mixb(g_EmoteOn);
            for (int q = 0; q < 24; q++) mixb(static_cast<u64>(g_Fx[q]));
            for (int q = 0; q < g_GrpN; q++) mixb(g_Grp[q].on);
            if (prevH != ~0ull && h != prevH && g_FlowMode == 1) g_FlowUntil = NowTick() + 5ull * 19200000ull;
            prevH = h;
        }
        if (on) {
            for (int i = 0; i < g_FlowN; i++) {
                const uintptr_t o = g_FlowObj[i];
                if (!Readable(o, 0x140) || *reinterpret_cast<const uintptr_t*>(o) != vt) {
                    g_FlowObj[i] = g_FlowObj[g_FlowN - 1]; std::memcpy(g_FlowOrig[i], g_FlowOrig[g_FlowN - 1], sizeof(g_FlowOrig[i])); g_FlowN--; i--; continue;
                }
                const int md = g_FlowMode;
                for (int k = 0; k < 14; k++) {
                    const float want = (k >= 4 && (md == 2 || (md == 1 && NowTick() < g_FlowUntil))) ? 1000.0f : g_FlowOrig[i][k];
                    float* f = reinterpret_cast<float*>(o + kFlowOff[k]);
                    if (*f != want) *f = want;
                }
            }
            if (g_FlowN == 0) flowDone = false;
            if (flowDone) { wasOn = true; return; }
            if (!StageStable()) { cur = 0; wasOn = true; return; }
            const u64 nw = NowTick();
            if (cur == 0 && nw < nextPass) { wasOn = true; return; }
            size_t budget = 1u << 20;
            for (int guard = 0; guard < 512 && budget > 0; guard++) {
                MemoryInfo mi; u32 pg;
                if (R_FAILED(svcQueryMemory(&mi, &pg, cur))) { cur = 0; nextPass = nw + 5ull * 19200000ull; break; }
                const uintptr_t end = mi.addr + mi.size;
                const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && !(mi.attr & 0xC);
                uintptr_t next = end;
                if (ok && mi.size >= 0x1000) {
                    uintptr_t a = (cur > mi.addr ? cur : mi.addr); a = (a + 7) & ~7ull;
                    uintptr_t lim = a + 0x1000; if (lim > end || lim < a) lim = end;
                    MemoryInfo m2; u32 p2;
                    if (R_SUCCEEDED(svcQueryMemory(&m2, &p2, a)) && (m2.perm & Perm_R) && !(m2.attr & 0xC) && m2.addr + m2.size >= lim) {
                        for (; a + 8 <= lim; a += 8) {
                            if (*reinterpret_cast<const uintptr_t*>(a) != vt) continue;
                            if (g_FlowN >= 8) continue; g_FlowHits++; if (!Readable(a, 0x140)) continue; if (!FlowPlausible(a)) { if (g_FlowRej++ == 0) { std::memcpy(&g_FlowRejV[0], reinterpret_cast<const void*>(a + 0xc8), 4); std::memcpy(&g_FlowRejV[1], reinterpret_cast<const void*>(a + 0xd0), 4); std::memcpy(&g_FlowRejV[2], reinterpret_cast<const void*>(a + 0xd4), 4); std::memcpy(&g_FlowRejV[3], reinterpret_cast<const void*>(a + 0xf0), 4); } continue; }
                            bool dup = false; for (int i = 0; i < g_FlowN; i++) if (g_FlowObj[i] == a) dup = true;
                            if (dup) continue;
                            g_FlowObj[g_FlowN] = a;
                            if (g_FlowN > 0) std::memcpy(g_FlowOrig[g_FlowN], g_FlowOrig[0], sizeof(g_FlowOrig[0]));
                            else for (int k = 0; k < 14; k++) g_FlowOrig[g_FlowN][k] = *reinterpret_cast<const float*>(a + kFlowOff[k]);
                            g_FlowN++;
                        }
                    }
                    budget = budget > 0x1000 ? budget - 0x1000 : 0;
                    next = lim;
                }
                cur = next;
                if (end == 0 || next == 0) { cur = 0; flowDone = g_FlowN > 0; g_FlowPasses++; nextPass = nw + 5ull * 19200000ull; break; }
            }
        } else if (wasOn) {
            for (int i = 0; i < g_FlowN; i++) {
                const uintptr_t o = g_FlowObj[i];
                if (Readable(o, 0x140) && *reinterpret_cast<const uintptr_t*>(o) == vt) for (int k = 0; k < 14; k++) *reinterpret_cast<float*>(o + kFlowOff[k]) = g_FlowOrig[i][k];
            }
            g_FlowN = 0; cur = 0; nextPass = 0;
        }
        wasOn = on;
    }
    bool PosObjValid() {
        const uintptr_t po = g_PosObj; /* 1 回だけ読む (確かめたあとに 0 にされて落ちた) */
        if (!po || !Readable(po, 0x40))
            return false;
        return *reinterpret_cast<const uintptr_t*>(po) == MainBase() + kPosObjVtable;
    }
    int g_ScanRuns = 0, g_ScanFound = 0;
    bool IsPosObjAt(uintptr_t v, uintptr_t vt) {
        if (v < 0x1000000ull || (v & 7) || (v >> 40))
            return false;
        if (!Readable(v, 0x40))
            return false;
        return *reinterpret_cast<const uintptr_t*>(v) == vt;
    }
    void FindPosObj() {
        volatile u64 here = 0;
        const uintptr_t sp = reinterpret_cast<uintptr_t>(&here) & ~7ull;
        size_t len = 0x1000;
        while (len >= 0x200 && !Readable(sp, len))
            len >>= 1;
        if (len < 0x200)
            return;
        g_ScanRuns++;
        const uintptr_t vt = MainBase() + kPosObjVtable;
        for (size_t o = 0; o + 8 <= len; o += 8) {
            const uintptr_t v = *reinterpret_cast<const uintptr_t*>(sp + o);
            if (IsPosObjAt(v, vt)) { g_PosObj = v; g_ScanFound++; return; }
        }
        /* スタックのポインタの先 (0x200 バイト) にあるポインタも調べる */
        for (size_t o = 0; o + 8 <= len; o += 8) {
            const uintptr_t v = *reinterpret_cast<const uintptr_t*>(sp + o);
            if (v < 0x1000000ull || (v & 7) || (v >> 40) || !Readable(v, 0x200))
                continue;
            for (size_t k = 0; k < 0x200; k += 8) {
                const uintptr_t w = *reinterpret_cast<const uintptr_t*>(v + k);
                if (IsPosObjAt(w, vt)) { g_PosObj = w; g_ScanFound++; return; }
            }
        }
    }


    /* ---- 自分の座標 (常に更新される場所) ---- */
    constexpr uintptr_t kLiveVtable = 0x5ED1810; /* main 先頭からのオフセット */
    constexpr uintptr_t kLivePosToVt = 0x28;      /* 座標 (float x3) の 0x28 先に vtable がある */
    constexpr uintptr_t kLivePageOff = 0x948;     /* vtable のあるアドレスの、ページ内の位置 */
    constexpr float kLiveHeight = 2.27f;          /* 座標の高さ - 床の高さ */
    uintptr_t g_LivePos = 0; bool g_LiveAlt = false; /* true = 撃ったときに見つけた「位置の物 (+0x10)」を足元の座標の代わりに使っている */
    /* 前回の探索で見つけた候補 (動いたかどうかを見るため) と、診断用の情報 */
    uintptr_t g_PrevAddr[4] = {};
    float     g_PrevVal[4][3] = {};
    int       g_PrevN = 0;
    uintptr_t g_CandAddr[4] = {};
    int       g_OriginSrc = 0;   /* 0 = 見本の位置 / 1 = 最後に撃った場所 / 2 = 足元 (live) */
    int       g_PressCount = 0;

    /* 座標として使えそうな値か: 数値で、極端に大きくなく、全部ほぼ0 (未初期化など) でもない。 */
    ALWAYS_INLINE bool Plausible(const float* f) {
        float m = 0.0f;
        for (int i = 0; i < 3; i++) {
            const float v = f[i];
            if (!(v == v)) return false;
            const float a = v < 0.0f ? -v : v;
            if (a > 2000.0f) return false;
            if (a > m) m = a;
        }
        return m > 0.05f;
    }

    /* 広場など、同じ種類の物 (他のプレイヤー・NPC) が何人もいるとき、スティックを倒したときに動くものを自分として選ぶ */
    constexpr int kLcMax = 64;
    uintptr_t g_LcAddr[kLcMax] = {}; float g_LcPrev[kLcMax][3] = {}; int g_LcScore[kLcMax] = {}; int g_LcN = 0;
    u64 g_LcSince = 0; volatile int g_FlyCalls = 0, g_FlyWhy = 0; bool g_FbOn = false; uintptr_t g_FbAddr = 0; int g_FbRaw = 0, g_FbDone = 0, g_FbRegions = 0; u64 g_FbBytes = 0; bool g_LiveConfirmed = false; uintptr_t g_LiveConfAddr = 0; u64 g_LcNextScan = 0; volatile int g_LcState = 0; /* 0=未 1=候補を集めた 2=自分と確定 */
    bool LiveValid() {
        /* 別のスレッドが途中で g_LivePos を 0 にすることがあるので、1回だけ読んで使う */
        const uintptr_t lp = __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE);
        if (!lp || !Readable(lp, 0x30))
            return false;
        if (g_LiveAlt) return PosObjValid() && lp == g_PosObj + 0x10 && Plausible(reinterpret_cast<const float*>(lp));
        if (*reinterpret_cast<const uintptr_t*>(lp + kLivePosToVt) != MainBase() + kLiveVtable)
            return false;
        return Plausible(reinterpret_cast<const float*>(lp));
    }
    /* 足元の座標を安全に読む (読めたら true) */
    bool ReadLive(float* out) {
        const uintptr_t lp = __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE);
        if (!lp || !Readable(lp, 0x30)) return false;
        if (g_LiveAlt) { if (!PosObjValid() || lp != g_PosObj + 0x10) return false; }
        else if (*reinterpret_cast<const uintptr_t*>(lp + kLivePosToVt) != MainBase() + kLiveVtable) return false;
        std::memcpy(out, reinterpret_cast<const void*>(lp), 12);
        return out[0] == out[0] && out[1] == out[1] && out[2] == out[2];
    }

    /* 撃った瞬間の座標 p1 (x,高さ,z) の近くにあるものを探す。 */
    int g_LiveCount = 0; /* 見つかった候補の数 (基準なしのとき) */
    float g_LiveCands[4][3] = {};
    void FindLivePosSync(const float* p1) {
        if (!p1 && g_LiveConfirmed && g_LiveConfAddr && Readable(g_LiveConfAddr, 0x30)
            && *reinterpret_cast<const uintptr_t*>(g_LiveConfAddr + kLivePosToVt) == MainBase() + kLiveVtable
            && Plausible(reinterpret_cast<const float*>(g_LiveConfAddr))) { g_LiveAlt = false; g_LivePos = g_LiveConfAddr; return; }
        static u64 scanFailT = 0; static uintptr_t liveRegLo = 0, liveRegHi = 0; /* 前に見つけた場所のある領域を先に調べる (全体の走査は、ゲームが解放中のメモリを読んで落ちやすいので、なるべくしない) */
        const bool fullThrottled = !p1 && scanFailT && NowTick() - scanFailT < 76800000ull; /* 全体の探索が空振りなら、4 秒は全体を探し直さない */
        uintptr_t bestLo = 0, bestHi = 0; bool ranFull = false;
        float camRef[3]; const uintptr_t cpR = g_CamPos; const bool haveCamRef = !p1 && cpR && CamValid() && Readable(cpR, 12); if (haveCamRef) std::memcpy(camRef, reinterpret_cast<const void*>(cpR), 12); /* カメラの追従先 (自分の真上) */
        const uintptr_t vt = MainBase() + kLiveVtable;
        uintptr_t best = 0;
        float bestD = 1e9f;
        g_LiveCount = 0;
        std::memset(g_LiveCands, 0, sizeof(g_LiveCands));
        std::memset(g_CandAddr, 0, sizeof(g_CandAddr));
        for (int pass = 0; pass < 2; pass++) {
        if (pass == 0 && (p1 || !liveRegHi)) continue;
        if (pass == 1 && (best || fullThrottled)) break;
        if (pass == 1) ranFull = true;
        uintptr_t addr = pass == 0 ? liveRegLo : 0;
        for (int guard = 0; guard < 8192; guard++) {
            MemoryInfo mi;
            u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr)))
                break;
            if (pass == 0 && mi.addr >= liveRegHi) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9)
                         && (mi.perm & Perm_R) && !(mi.attr & 0xC) /* 端末共有・キャッシュなしの領域は読まない (GPU 用で、読むと落ちる) */;
            if (ok && mi.size >= 0x1000) {
                uintptr_t a = (mi.addr & ~0xFFFull) + kLivePageOff;
                if (a < mi.addr) a += 0x1000;
                unsigned pgc = 0;
                /* 大きさがちょうど 0x1741000 の領域は、後ろの方に読むと落ちる部分がある (4 回のクラッシュが、すべてこの大きさの領域の 21MB 付近だった)。前の 20MB だけ調べる。 */
                const uintptr_t scanEnd = (mi.size == 0x1741000ull && end - mi.addr > 0x1400000ull) ? mi.addr + 0x1400000ull : end;
                for (; a + 8 <= scanEnd; a += 0x1000) {
                    if ((pgc++ & 0u) == 0u) { /* 前の領域は 1 ページごと、全体は 16KB ごとに読めるか確かめ直す (ゲームが走査中に解放して落ちるのを防ぐ) */
                        MemoryInfo m3; u32 p3;
                        if (R_FAILED(svcQueryMemory(&m3, &p3, a)) || !(m3.perm & Perm_R) || (m3.attr & 0xC) || m3.type == MemType_Unmapped) break;
                    }
                    if (*reinterpret_cast<const uintptr_t*>(a) != vt)
                        continue;
                    const uintptr_t pos = a - kLivePosToVt;
                    if (pos < mi.addr)
                        continue;
                    const float* f = reinterpret_cast<const float*>(pos);
                    if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2]))
                        continue;
                    if (!p1) {
                        /* 基準がないときは、最初に見つかったものを使う (候補が1つなら確実) */
                        if (g_LiveCount < 4) { std::memcpy(g_LiveCands[g_LiveCount], f, 12); g_CandAddr[g_LiveCount] = pos; }
                        g_LiveCount++;
                        /* 位置が0や意味のない値のものは本物ではない。 */
                        if (!Plausible(f))
                            continue;
                        /* 前回の探索から動いたものを優先する (動いている = 今も更新されている = 本物)。 */
                        float score = 0.0f;
                        bool moved = false;
                        for (int k = 0; k < g_PrevN; k++) {
                            if (g_PrevAddr[k] != pos) continue;
                            const float mx = f[0] - g_PrevVal[k][0], mz = f[2] - g_PrevVal[k][2];
                            const float mv = mx * mx + mz * mz;
                            if (mv > 0.25f) { moved = true; score = -mv; }
                        }
                        if (!moved && g_HaveTmpl) {
                            float hp[3]; std::memcpy(hp, g_Tmpl.raw + kOffPos, 12);
                            const float dx = f[0] - hp[0], dz = f[2] + hp[1];
                            score = dx * dx + dz * dz;
                        }
                        if (haveCamRef) { const float dx = f[0] - camRef[0], dz = f[2] - camRef[2]; score = dx * dx + dz * dz; } /* 前は最初に見つかった物を選んでいて、味方や敵の座標を自分と取り違えることがあった */
                        if (!best || score < bestD) { best = pos; bestD = score; bestLo = mi.addr; bestHi = end; }
                        continue;
                    }
                    if (!Plausible(f))
                        continue;
                    const float dx = f[0] - p1[0], dz = f[2] - p1[2], dy = f[1] - p1[1];
                    const float d = dx * dx + dz * dz;
                    if (d < 9.0f && dy < 4.0f && dy > -4.0f && d < bestD) {
                        bestD = d;
                        best = pos; bestLo = mi.addr; bestHi = end;
                    }
                }
            }
            if (end <= addr || end == 0)
                break;
            addr = end;
        }
        }
        if (best && bestHi) { liveRegLo = bestLo; liveRegHi = bestHi; }
        if (!p1) {
            g_PrevN = g_LiveCount < 4 ? g_LiveCount : 4;
            for (int k = 0; k < g_PrevN; k++) {
                g_PrevAddr[k] = g_CandAddr[k];
                std::memcpy(g_PrevVal[k], g_LiveCands[k], 12);
            }
        }
        if (!p1 && ranFull) scanFailT = best ? 0 : NowTick();
        if (best) { g_LiveAlt = false; g_LivePos = best; }
        else if (!p1 && !g_FbOn && g_LcN == 0 && !g_LiveConfirmed) { g_FbOn = true; g_FbAddr = 0; g_FbRaw = 0; g_FbRegions = 0; } /* 決まった位置に無いステージ: 全体をゆっくり探す */
    }

    /* 足元の座標が見つからないステージ用: 撃ったときに見つけた「位置の物」が今も生きていれば、その +0x10 を足元の座標として使う */
    void FindLivePos(const float* p1) { /* 自分の座標を探す: 覚えている場所がまだ使えればそれを使い、だめなら裏の流れで探す (ゲームを止めない) */
        if (!p1 && g_LiveConfirmed && g_LiveConfAddr && Readable(g_LiveConfAddr, 0x30)
            && *reinterpret_cast<const uintptr_t*>(g_LiveConfAddr + kLivePosToVt) == MainBase() + kLiveVtable
            && Plausible(reinterpret_cast<const float*>(g_LiveConfAddr))) { g_LiveAlt = false; g_LivePos = g_LiveConfAddr; return; }
        if (!BgRequest(p1 ? 8u : 4u, p1)) FindLivePosSync(p1);
    }
    void TryLiveAlt() {
        if (LiveValid()) return;
        if (PosObjValid()) {
            const float* f = reinterpret_cast<const float*>(g_PosObj + 0x10);
            if (Plausible(f)) { g_LiveAlt = true; g_LivePos = g_PosObj + 0x10; }
        }
    }
    /* 自分の座標を塗り要求の座標系 (a,b,c) で返す。わからなければ false。 */
    bool GetPlayerPos(float* out) {
        { /* 足元の座標 (床の高さ。ロードしても同じ物を探せる: アドレスサーチで見つけた main+0x5BF8770 の +0x18) があれば、いちばんにそれを使う。なければ探す (2 秒に 1 回) */
            static u64 nextF = 0, nextC = 0; const u64 now = NowTick();
            if (!FootValid()) {
                if (!CamValid() && LiveValid() && now >= nextC) { nextC = now + 38400000ull; CamFind(); }
                if (CamValid() && now >= nextF) { nextF = now + 38400000ull; FootFind(); }
            }
            if (FootValid()) { const float* f = reinterpret_cast<const float*>(g_FootPos); out[0] = f[0]; out[1] = -f[2]; out[2] = f[1]; return true; }
        }
        if (g_LiveConfirmed && g_LiveConfAddr && g_LivePos != g_LiveConfAddr && Readable(g_LiveConfAddr, 0x30)
            && *reinterpret_cast<const uintptr_t*>(g_LiveConfAddr + kLivePosToVt) == MainBase() + kLiveVtable
            && Plausible(reinterpret_cast<const float*>(g_LiveConfAddr))) { g_LiveAlt = false; g_LivePos = g_LiveConfAddr; } /* 歩いて自分と確かめた座標を優先 */
        if (INKDRAW_LIVEPOS && !LiveValid()) {
            if (g_HavePosCopy) {
                const float ref[3] = { g_PosCopy[0], g_PosCopy[2] + kPosObjHeight, -g_PosCopy[1] };
                FindLivePos(ref);
                if (!LiveValid()) FindLivePos(nullptr); /* 動いた後は古い位置の近くにいないので、全体から探す */
            } else {
                FindLivePos(nullptr);
            }
        }
        if (INKDRAW_LIVEPOS) TryLiveAlt();
        if (INKDRAW_LIVEPOS && LiveValid()) {
            const float* f = reinterpret_cast<const float*>(g_LivePos);
            out[0] = f[0]; out[1] = -f[2]; out[2] = f[1] - (g_LiveAlt ? kPosObjHeight : kLiveHeight);
            return true;
        }
        if (INKDRAW_CAMPOS) {
            if (PosObjValid()) {
                const float* f = reinterpret_cast<const float*>(g_PosObj + 0x10);
                if (f[0] == f[0] && f[1] == f[1] && f[2] == f[2]) {
                    out[0] = f[0]; out[1] = -f[2]; out[2] = f[1] - kPosObjHeight;
                    g_PosCopy[0] = out[0]; g_PosCopy[1] = out[1]; g_PosCopy[2] = out[2];
                    g_HavePosCopy = true; g_PosCopyTick = NowTick();
                    return true;
                }
            }
            if (g_HavePosCopy) { /* 最後に見つけたときの座標 */
                out[0] = g_PosCopy[0]; out[1] = g_PosCopy[1]; out[2] = g_PosCopy[2];
                return true;
            }
            return false;
        }
        if (!kUsePlayerPos || !g_Locked || !g_HaveLastHit)
            return false;
        const uintptr_t obj = GetShooter(g_ShKind, g_ShId);
        if (!obj || !Readable(obj, kObjFloats * 4))
            return false;
        const float* f;
        if (g_LockRegion == 0) {
            f = reinterpret_cast<const float*>(obj) + g_LockOff;
        } else {
            const uintptr_t t = *reinterpret_cast<const uintptr_t*>(obj + 8 * (g_LockRegion - 1));
            if (t < 0x10000 || (t & 3) || !Readable(t, kSubFloats * 4))
                return false;
            f = reinterpret_cast<const float*>(t) + g_LockOff;
        }
        const float a = f[0];
        const float b = g_LockPerm == 0 ? f[1] : f[2];
        if (!(a == a) || !(b == b))
            return false;
        const float da = a - g_LastHit[0], db = b - g_LastHit[1];
        if (da * da + db * db > kMaxPlayerDist * kMaxPlayerDist)
            return false;
        out[0] = a;
        out[1] = b;
        out[2] = g_LastHit[2]; /* 高さは最後に塗った床 */
        return true;
    }

    uintptr_t ReadPaintMgr() {
        return *reinterpret_cast<uintptr_t*>(exl::util::modules::GetTargetOffset(g_OffPaintMgrPtr));
    }

    /* 試合 (ステージ) が変わると、塗りの管理物が作り直される。古い見本や座標は使えなくなるので、見分けるための値 */
    uintptr_t PaintCtxKey() {
        const uintptr_t mgr = ReadPaintMgr();
        if (!mgr || !Readable(mgr + 0x2c0, 8)) return mgr;
        const uintptr_t om = *reinterpret_cast<const uintptr_t*>(mgr + 0x2c0);
        return mgr * 31u ^ om;
    }
    void ScanButton();

    /* Lスティック (-1..1)。いちばん大きく倒しているコントローラーの値を使う。 */
    float g_StkX[64] = {}, g_StkY[64] = {}; volatile float g_LStickX = 0.0f, g_LStickY = 0.0f; volatile float g_RStkX = 0.0f, g_RStkY = 0.0f; bool CamValid();
    ALWAYS_INLINE void OnStick(u32 id, s32 x, s32 y) {
        g_StkX[id & 63] = static_cast<float>(x) / 32767.0f;
        g_StkY[id & 63] = static_cast<float>(y) / 32767.0f;
        float bx = 0.0f, by = 0.0f, bm = 0.0f;
        for (int i = 0; i < 64; i++) {
            const float m = g_StkX[i] * g_StkX[i] + g_StkY[i] * g_StkY[i];
            if (m > bm) { bm = m; bx = g_StkX[i]; by = g_StkY[i]; }
        }
        g_LStickX = bx; g_LStickY = by;
    }

    ALWAYS_INLINE void OnButtons(u32 id, u64 buttons) {
        g_BtnById[id & 63] = buttons; { u64 o = 0; for (int q = 0; q < 64; q++) o |= g_BtnById[q]; g_BtnNow = o; } /* 実際に押されているボタン (下で消す前) */
        if (g_AutoRun && !g_AutoDone && buttons != 0) g_AutoDone = true; /* 自分で何か押したら、自動はやめる */
        {
            /* Lスティック押し込み + 十字キー下: 画面のメニューを開く/閉じる */
            const u64 prev = g_PrevMenuBtn[id & 63];
            g_PrevMenuBtn[id & 63] = buttons;
            u64 edge = buttons & ~prev;
            if (g_UpdState == 7) { /* 「再起動しますか?」: A で はい、B で いいえ */
                if (edge & 1ull) g_UpdRestartReq = true; else if (edge & 2ull) { g_UpdState = 4; g_UpdT = NowTick(); }
                return;
            }
            if (g_UpdState == 2) { /* 「アップデートしますか?」: A で はい、B で いいえ */
                if (edge & 1ull) g_UpdState = 3; else if (edge & 2ull) g_UpdState = 0;
                return;
            }
            if (g_MenuOpen) {
                /* 十字キーを押し続けると、くり返し動く。長く押すほど速くなる。 */
                u64 now; asm volatile("mrs %0, cntpct_el0" : "=r"(now));
                const u64 kMs = 19200; /* 1 ミリ秒 (19.2MHz) */
                const int bits[4] = { 13, 15, 12, 14 };
                for (int d = 0; d < 4; d++) {
                    const u64 m = 1ull << bits[d];
                    if (!(buttons & m)) continue;
                    if (edge & m) { g_HoldStart[id & 63][d] = now; g_HoldNext[id & 63][d] = now + 350 * kMs; continue; }
                    if (now >= g_HoldNext[id & 63][d]) {
                        edge |= m;
                        const u64 held = (now - g_HoldStart[id & 63][d]) / kMs;
                        u64 iv = held > 2500 ? 15 : (held > 1500 ? 30 : (held > 800 ? 60 : 110));
                        g_HoldNext[id & 63][d] = now + iv * kMs;
                    }
                }
            }
            /* メニューの操作: L で開く / L で決定 / Lスティック押し込みで閉じる / Y で一覧から戻る。
               メニューを開いていても、入力はゲームにもそのまま渡す (スプラの操作ができる)。 */
            constexpr u64 kUp = 1ull << 13, kDn = 1ull << 15, kLf = 1ull << 12, kRt = 1ull << 14, kY = 1ull << 3, kL = 1ull << 6, kLS = 1ull << 4;
            if (g_MenuOpen) { g_RiseUp[id & 63] = false; g_RiseDn[id & 63] = false; g_RiseDir = 0; } /* メニュー中は上下の入力を止める (押しっぱなしのまま残らないように) */
            /* ロビー (LobbyVersus / LobbyCoop) では L はゲームのメニューに使うので、R を押しながら L で開く。
               0x60F6528 = ゲームが「ロビーの場面か」を入れておく 1 バイト (11.3.0, 場面の名前が LobbyVersus / LobbyCoop のとき 1) */
            const bool inLobby = g_OffPaintRequest == 0x371D1C0 && *reinterpret_cast<const volatile u8*>(exl::util::modules::GetTargetOffset(0x60F6528)) != 0;
            if (!g_MenuOpen && (edge & kL) && (!inLobby || (buttons & (1ull << 7)))) { g_MenuOpen = true; g_OpenEdge = true; g_UiMove = false; g_PchPanel = false; g_MemPanel = false; g_SelPanel = 0; return; }
            if (g_MenuOpen && (edge & kLS)) {
                /* Lスティック押し込み: ひとつ戻る (位置の移動 → 一覧 → カテゴリの一覧 → メニューを閉じる) */
                g_LsSwallow = true;
                if (g_UiMove) g_UiMove = false;
                else if (g_SelPanel) g_SelPanel = 0;
                else if (g_PchPanel || g_MemPanel) { g_PchPanel = false; g_MemPanel = false; }
                else if (g_Cat >= 0) { int ms = 0; for (int q = 0; q < kCatCount; q++) if (kTopOrder[q] == g_Cat) { ms = q; break; } g_MenuSel = ms; g_Cat = -1; }
                else g_MenuOpen = false;
                return;
            }
            if (g_MenuOpen && g_UiMove) {
                /* 位置を動かしている間: 十字キー (Lスティックでも動く)。L で決定 */
                if (buttons & kUp) g_UiY -= 6; if (buttons & kDn) g_UiY += 6;
                if (buttons & kLf) g_UiX -= 6; if (buttons & kRt) g_UiX += 6;
                if (edge & kL) g_UiMove = false;
                return;
            }
            if (g_MenuOpen && g_SelPanel) {
                /* 右に開いた選択: 上下で選ぶ、L で決定、左で閉じる */
                const int n = SelCount();
                if (n > 0) {
                    if (edge & kUp) g_SelCur = (g_SelCur + n - 1) % n;
                    if (edge & kDn) g_SelCur = (g_SelCur + 1) % n;
                    if (edge & kL) { const int sp = g_SelPanel; SelApply(); if (g_SelPanel == sp && !(sp == 12 && g_SelCur == 6)) g_SelPanel = 0; } /* 決定。中のカテゴリを開いたときは閉じない */
                    if ((edge & kRt) && g_SelPanel == 5) SelApply(); /* ワープ地点の一覧: 右でも開く */
                }
                if (g_SelPanel == 12 && g_SelCur == 6 && (edge & (kLf | kRt))) { if ((edge & kLf) && g_LookRange > 0) g_LookRange = g_LookRange - 1; if ((edge & kRt) && g_LookRange < 19) g_LookRange = g_LookRange + 1; return; } /* 向く範囲: 左右で変える */
                if (edge & kLf) { if (g_SelPanel >= 9 && g_SelPanel <= 12) { static const int kBack[4] = { 0, 1, 3, 2 }; g_SelCur = kBack[g_SelPanel - 9]; g_SelPanel = 5; } else g_SelPanel = 0; } /* 中のカテゴリからは一覧へ戻る */
                return;
            }
            if (g_MenuOpen && g_PchPanel) {
                /* パッチの一覧: 上下で選ぶ、L で ON/OFF、Y か 左 で戻る */
                if (g_GrpN > 0) {
                    if (edge & kUp) g_PchSel = (g_PchSel + g_GrpN - 1) % g_GrpN;
                    if (edge & kDn) g_PchSel = (g_PchSel + 1) % g_GrpN;
                    if (edge & (kL | kRt)) { g_Grp[g_PchSel].on = !g_Grp[g_PchSel].on; g_ReqPatchApply = true; }
                }
                if (edge & kLf) g_PchPanel = false;
                return;
            }
            if (g_MenuOpen && g_MemPanel) {
                /* メモリサーチ: 上下で行を選ぶ、左右で値を変える、L で表示の形 (16進/小数/整数) を切り替え、Y で戻る */
                if (edge & kUp) g_MemSel = g_MemSel > 0 ? g_MemSel - 1 : kMemRows - 1;
                if (edge & kDn) g_MemSel = g_MemSel < kMemRows - 1 ? g_MemSel + 1 : 0;
                if (edge & kL) g_MemType = (g_MemType + 1) % 3;
                if (edge & (kLf | kRt)) { g_MemEditDir = (edge & kRt) ? 1 : -1; g_MemEditReq = true; }
                return;
            }
            if (g_MenuOpen) {
                const int cnt = PageCount();
                if (g_MenuSel >= cnt) g_MenuSel = 0;
                if (edge & kUp) g_MenuSel = (g_MenuSel + cnt - 1) % cnt;
                if (edge & kDn) g_MenuSel = (g_MenuSel + 1) % cnt;
                if (g_Cat >= 0 && g_Cat < kCatCount) g_CatSel[g_Cat] = g_MenuSel; /* 選んだ場所を覚える */
                const bool act = (edge & kL) != 0, lf = (edge & kLf) != 0, rt = (edge & kRt) != 0;
                { /* 円の大きさ: 左右を長押ししている間、続けて変える (0.35 秒後から 1 秒に 20 段) */
                    static u64 hT = 0, rT = 0; const u64 nw = NowTick();
                    if (g_Cat >= 0 && PageItem(g_MenuSel) == kDynGcCirc && (buttons & (kLf | kRt))) {
                        if (edge & (kLf | kRt)) hT = nw;
                        else if (hT && nw - hT > 6720000ull && nw - rT > 960000ull) { rT = nw; int c2 = g_CircR + ((buttons & kRt) ? 1 : -1); if (c2 < 1) c2 = 1; if (c2 > 100) c2 = 100; g_CircR = c2; }
                    } else hT = 0;
                }
                
                if (g_Cat < 0) { if (g_MenuSel >= kCatCount) { DynInput(kDynUpd, act, lf, rt); return; } if (act || rt) { g_Cat = kTopOrder[g_MenuSel % kCatCount]; g_MenuSel = g_CatSel[g_Cat]; if (g_MenuSel >= PageCount()) g_MenuSel = 0; } return; } /* カテゴリを開く (いちばん下は「アップデートを確認」) */
                bool fxh = false;
                { const int it = PageItem(g_MenuSel); if (it >= kFxBase && it < kFxBase + kFxN) { FxInput(it - kFxBase, act, lf, rt); fxh = true; } else if (it >= kDyn) { DynInput(it, act, lf, rt); fxh = true; } }
                if (!fxh) switch (PageItem(g_MenuSel)) {
                    case kItFly: if (act) { if (g_ModeOn && g_FlyQuiet) { g_FlyQuiet = false; UpdateFuncOn(); break; } /* ワープ用に裏で動いていた: そのまま BugFly として ON にする */
                        if (g_ModeOn && g_WarpOn) { g_FlyQuiet = true; UpdateFuncOn(); break; } /* BugFly を OFF: ワープ地点を使っているので、座標の準備は裏で続ける */
                        g_ModeOn = !g_ModeOn; g_FlyQuiet = false; if (g_ModeOn && !TrkReady()) { g_FlyRestart = true; g_FlyNext = 0; g_LcNextScan = 0; } /* 準備OKのままなら、やり直さない (ワープ地点の準備も消さない) */ /* ON にしたら (確定済みの座標は捨てない)、座標の写しを探す準備を自動で始める */ } break;
                    case kItAir: if (act) { g_Jump ^= 1; g_JumpReq = true; } break;
                    case kItMoon: if (act) { g_Jump ^= 2; g_JumpReq = true; } break;
                    case kItFill: if (act && g_HaveTmpl) { g_FillPending = 1; g_Armed = true; } break; /* 見本がないときは予約しない (あとで撃ったときに勝手に始まるのを防ぐ) */
                    case kItFill2: if (act) g_FillAllReq = true; break; /* 塗りの見本がなくても使える */
                    case kItPatch: if (act) { g_PatchEnabled = !g_PatchEnabled; g_ReqPatchApply = true; } if (rt) g_PchPanel = true; break;
                    case kItMem: if (act || rt) { g_MemBase = g_X6Latest; g_MemPanel = true; } break;
                    case kItDraw: if (act && g_HaveTmpl) g_Armed = true; /* L で絵を描く */ if (lf) g_DrawTeam = (g_DrawTeam + 2) % 3; if (rt) g_DrawTeam = (g_DrawTeam + 1) % 3; break;
                    case kItScale: if (lf && g_UiScale > 50) g_UiScale -= 10; if ((rt || act) && g_UiScale < 150) g_UiScale += 10; break;
                    case kItPos: if (act) g_UiMove = true; break;
                    case kItRespawn: if (act) g_ReqRespawn = true; if (lf || rt) g_RespStep = rt ? 1 : 7; break;
                    case kItBunny: if (act) g_Bunny = !g_Bunny; if (lf || rt) g_BunnyMode = g_BunnyMode ? 0 : 1; break;
                    case kItLaunch: if (act) g_LaunchReq = true; break;
                    case kItEmote: if (act) g_EmoteOn = !g_EmoteOn; break;
                    case kItErase: if (rt) { g_SelPanel = 3; g_SelCur = g_EraseSel % 3; g_SelScroll = 0; } if (act) g_EraseReq = true; break;
                    case kItImage: if (act) g_ImgReq = true; if (rt) { g_SelPanel = 1; g_SelCur = g_ImgSel + 1; g_SelScroll = 0; } break;
                    case kItInfo: if (act) { g_InfoOn = !g_InfoOn; UpdateFuncOn(); if (g_InfoOn) g_InfoReq = true; } if (rt && g_InfoOn) g_InfoReq = true; break;
                    case kItFreeCam: {
                        int fv = g_FreeCam;
                        if (lf) fv = fv > -100 ? fv - 1 : -100;
                        if (rt) fv = fv < 100 ? fv + 1 : 100;
                        if (act) fv = fv == 0 ? g_FreeCamLast : 0;
                        if (fv != 0) g_FreeCamLast = fv;
                        g_FreeCam = fv;
                        break;
                    }
                    case kItClean:
                        if (lf) g_CleanSel = (g_CleanSel + 5) % 6;
                        if (rt) g_CleanSel = (g_CleanSel + 1) % 6;
                        if (act) { g_CleanPending = true; g_Armed = true; }
                        break;
                    case kItBlink: if (act) g_BlinkOn = !g_BlinkOn; break; /* ON/OFF は L だけ (十字キーでは切り替わらない) */
                    case kItSpeed: {
                        int v = g_Genki;
                        if (lf) v = v > 1 ? v - 1 : (v == 1 ? 0 : 0);
                        if (rt) v = v < 100 ? (v == 0 ? 1 : v + 1) : 100;
                        if (act) v = v == 0 ? g_GenkiLast : 0;
                        if (v != g_Genki) { if (v > 0) g_GenkiLast = v; g_Genki = v; g_GenkiReq = true; }
                        break;
                    }
                    default: if (act) g_MenuOpen = false; break;
                }
                return;
            }
            if (!g_ModeOn) buttons &= ~((1ull << 1) | (1ull << 3) | (1ull << 5) | (1ull << 8) | (1ull << 12) | (1ull << 13) | (1ull << 14) | (1ull << 15)); /* オフ: 手順と飛ぶ操作を無効に */
            if (!g_DrawEnabled) buttons &= ~((1ull << 0) | (1ull << 4) | (1ull << 5)); /* 絵を描く操作を無効に */
        }
        const bool down = (buttons & kComboMaskSticks) == kComboMaskSticks; /* A では描かない (メニューの「絵を描く」を L で実行) */
        g_Fire[id & 63] = (buttons & kFireMask) != 0;
        g_BtnSeen |= buttons; /* 全部のコントローラーのボタンを合わせる (別のコントローラーの 0 で消えないように) */
        /* Yボタンを押している間は、十字キーで横 (x / z) に動かす。ほかの十字キーの働きは止める。 */
        const bool yh = (buttons & (1ull << 3)) != 0;
        {
            const bool dl = (buttons & (1ull << 12)) != 0, dr = (buttons & (1ull << 14)) != 0;
            if (dl && !g_PrevDL[id & 63] && !yh && !g_ModeOn) g_ReqScan = true;
            if (dr && !g_PrevDR[id & 63] && !yh) g_ReqProbe = true;
            g_PrevDL[id & 63] = dl; g_PrevDR[id & 63] = dr;
            const bool rs = (buttons & (1ull << 5)) != 0 && (buttons & (1ull << 4)) == 0;
            if (rs && !g_PrevRs[id & 63]) g_ReqRefs = true;
            g_PrevRs[id & 63] = rs;
            const bool upE = (buttons & (1ull << 13)) != 0, dnE = (buttons & (1ull << 15)) != 0;
            if (upE && !g_PrevUpE[id & 63] && !yh) g_ReqYes = true;
            if (dnE && !g_PrevDnE[id & 63] && !yh) g_ReqNo = true;
            g_PrevUpE[id & 63] = upE; g_PrevDnE[id & 63] = dnE;
        }
        g_RiseUp[id & 63] = (buttons & (1ull << 1)) != 0; /* Bボタン: 上へ */
        g_PadDp[id & 63] = static_cast<u32>((buttons >> 12) & 15); /* 十字キー: 視点移動に使う */
        g_RiseDn[id & 63] = (buttons & (1ull << 8)) != 0; /* ZLボタン: 下へ */
        g_HX[id & 63] = 0; g_HZ[id & 63] = 0;
        g_YHeldArr[id & 63] = yh;
        { bool a = false; for (int i = 0; i < 64; i++) a = a || g_YHeldArr[i]; g_YHeld = a; }
        {
            bool up = false, dn = false;
            int hx = 0, hz = 0;
            for (int i = 0; i < 64; i++) {
                up = up || g_RiseUp[i]; dn = dn || g_RiseDn[i];
                if (g_HX[i]) hx = g_HX[i];
                if (g_HZ[i]) hz = g_HZ[i];
            }
            g_RiseDir = up ? 1 : (dn ? -1 : 0);
            g_HDirX = hx; g_HDirZ = hz;
        }
        bool anyFire = false;
        for (int i = 0; i < 64; i++) anyFire = anyFire || g_Fire[i];
        g_FireHeld = anyFire;
        bool& prev = g_Down[id & 63];
        if (down && !prev) {
            g_Armed = true;
            if (INKDRAW_SCAN) ScanButton();
        }
        prev = down;
    }

}

namespace { void HidTick(); void HidInject(u64 b, u64& orm, u64& clr); void HidApply(u64 b, u8* out, s32 n); }
/* ---- ボタン読み取り: nn::hid::GetNpadStates を横取りして、押された瞬間を見る ---------- */
#define INKDRAW_HID_HOOK(NAME) \
    HOOK_DEFINE_TRAMPOLINE(NAME) { \
        static s32 Callback(u8* out, s32 count, const u32* id) { \
            const s32 n = Orig(out, count, id); \
            if (n > 0 && out != nullptr && id != nullptr) { \
                u64 buttons; \
                std::memcpy(&buttons, out + 8, sizeof(buttons)); \
                s32 lsx, lsy; std::memcpy(&lsx, out + 0x10, 4); std::memcpy(&lsy, out + 0x14, 4); \
                OnStick(*id, lsx, lsy); \
                { s32 rsx, rsy; std::memcpy(&rsx, out + 0x18, 4); std::memcpy(&rsy, out + 0x1c, 4); if (g_Flk && !g_MenuOpen && CamValid()) { g_RStkX = static_cast<float>(rsx) / 32767.0f; g_RStkY = static_cast<float>(rsy) / 32767.0f; for (s32 k = 0; k < n; k++) std::memset(out + 0x28 * k + 0x18, 0, 8); } else { g_RStkX = 0.0f; g_RStkY = 0.0f; } } /* 視点移動中は、右スティックをゲームに渡さず、カメラの追従先を動かすのに使う */ \
                OnButtons(*id, buttons); \
                HidTick(); \
                if (g_LsSwallow && !(buttons & (1ull << 4))) g_LsSwallow = false; \
                { const u64 mk = (g_UpdState == 2 ? ((0xFull << 12) | 3ull | (1ull << 6)) : 0ull) | (g_MenuOpen ? ((0xFull << 12) | (1ull << 6)) : 0ull) | ((g_MenuOpen || g_LsSwallow) ? (1ull << 4) : 0ull) | ((g_LookAHold && g_LookOn && g_LookSlot == 6) ? 1ull : 0ull); /* A長押しの間だけ: ON の間は A をゲームに渡さない */ \
                  if (mk) for (s32 k = 0; k < n; k++) { u64 bb; std::memcpy(&bb, out + 0x28 * k + 8, 8); bb &= ~mk; std::memcpy(out + 0x28 * k + 8, &bb, 8); } } /* メニュー操作中は十字キーを、メニューを閉じるLスティック押し込みもゲームに渡さない */ \
                HidApply(buttons, out, n); \
                g_TlsHid = ReadTls(); \
            } \
            return n; \
        } \
    };

INKDRAW_HID_HOOK(HidFullKey)

/* 名前を変える: nn::account::GetNickname の結果を、入れた名前に書き換える */
/* ジャイロの読み取り (nn::hid::GetSixAxisSensorStates) を横取りして、地点を見るときだけ角速度に値を足す。状態 1 つは 0x60 バイト、角速度は +0x1C */
HOOK_DEFINE_TRAMPOLINE(SixAxisHook) {
    static s32 Callback(u8* st, s32 count, const void* handle) {
        const s32 n = Orig(st, count, handle);
        g_GyroCalls = g_GyroCalls + 1;
        const float w = g_GyroW; const int ax = g_GyroAx % 3;
        static bool capA[4] = {}; static u8 baseA[4][0x60]; static float thA[4] = {}; static uintptr_t hA[4] = {}; static int hnA = 0; int hi = -1; { const uintptr_t hv = reinterpret_cast<uintptr_t>(handle); for (int q = 0; q < hnA; q++) if (hA[q] == hv) hi = q; if (hi < 0) { if (hnA < 4) { hi = hnA++; } else hi = 3; hA[hi] = hv; capA[hi] = false; } }
        bool& cap = capA[hi]; u8* base = baseA[hi]; float& th = thA[hi];
        if (st && n > 0 && g_GyroVirt) { /* 本物のジャイロを止める: 止めたときの向きのまま、こちらの回転 (th 回転ぶん) だけを伝える */
            if (!cap) { std::memcpy(base, st + 0x60 * (n - 1), 0x60); th = 0.0f; cap = true; }
            for (s32 k = 0; k < n; k++) {
                u8* e = st + 0x60 * k; s64 dt; std::memcpy(&dt, e, 8); if (dt <= 0 || dt > 100000000ll) dt = 5000000ll;
                th += w * static_cast<float>(dt) * 1e-9f;
                std::memcpy(e + 0x10, base + 0x10, 0x60 - 0x10); /* 時間と番号は本物のまま、残りは止めたときの値 */
                float* av = reinterpret_cast<float*>(e + 0x1C); av[0] = 0.0f; av[1] = 0.0f; av[2] = 0.0f; av[ax] = w;
                float* an = reinterpret_cast<float*>(e + 0x28); an[ax] += th;
                float* dr = reinterpret_cast<float*>(e + 0x34); const float a = th * 6.2831853f, cs = __builtin_cosf(a), sn = __builtin_sinf(a);
                const int i1 = (ax + 1) % 3, i2 = (ax + 2) % 3; /* 軸 ax のまわりに回す (ほかの 2 本の向きを回す) */
                for (int j = 0; j < 3; j++) { const float p1 = dr[i1 * 3 + j], p2 = dr[i2 * 3 + j]; dr[i1 * 3 + j] = p1 * cs + p2 * sn; dr[i2 * 3 + j] = -p1 * sn + p2 * cs; }
            }
        } else {
            cap = false;
            if (st && n > 0 && (w > 1e-4f || w < -1e-4f)) for (s32 k = 0; k < n; k++) { float* av = reinterpret_cast<float*>(st + 0x60 * k + 0x1C); av[ax] += w; }
        }
        if (st && n > 0 && (g_GaOn || g_GrOn)) { /* エイムボット（ジャイロ）/ ジャイロ記録 */
            static struct { uintptr_t h; s64 sn; } tb[4]; static int tn = 0; int ti = -1; static float thP[4][3] = {}; static u32 seenR = 0; if (g_GaPRst != seenR) { seenR = g_GaPRst; for (int q = 0; q < 4; q++) thP[q][0] = thP[q][1] = thP[q][2] = 0.0f; } const uintptr_t hv = reinterpret_cast<uintptr_t>(handle);
            for (int q = 0; q < tn; q++) if (tb[q].h == hv) ti = q; if (ti < 0 && tn < 4) { ti = tn++; tb[ti].h = hv; tb[ti].sn = -1; }
            for (s32 k = 0; k < n; k++) {
                u8* e = st + 0x60 * k; s64 dt, sn; std::memcpy(&dt, e, 8); std::memcpy(&sn, e + 8, 8); if (dt <= 0 || dt > 100000000ll) dt = 5000000ll;
                float* av = reinterpret_cast<float*>(e + 0x1C); const float d = static_cast<float>(dt) * 1e-9f;
                const bool fresh = ti >= 0 && sn > tb[ti].sn; /* 同じ測りを 2 回数えない */
                for (int a = 0; a < 3; a++) { if (fresh) { g_GrReal[a] = av[a]; g_GaInt[a] += (av[a] + g_GaW[a]) * d; } }
                if (ti >= 0) { /* 追っている間は、本物のジャイロを止める (止めた時の向きのまま。コントローラーごと) */
                    static bool lc[4] = {}; static u8 lb[4][0x60];
                    if (g_GaOn && g_GaLock) { if (!lc[ti]) { std::memcpy(lb[ti], st + 0x60 * (n - 1), 0x60); lc[ti] = true; } std::memcpy(e + 0x10, lb[ti] + 0x10, 0x50); av[0] = 0.0f; av[1] = 0.0f; av[2] = 0.0f; } else lc[ti] = false; }
                for (int a = 0; a < 3; a++) if (g_GaOn) av[a] += g_GaW[a];
                if (ti >= 0) { /* 向きに重ねる回転 (回転数) を軸ごとに積み、角度と向きの行列に足す */
                    if (!g_GaOn) { thP[ti][0] = thP[ti][1] = thP[ti][2] = 0.0f; }
                    else for (int a = 0; a < 3; a++) { if (fresh) thP[ti][a] += g_GaPW[a] * d; const float t = thP[ti][a]; if (t > 1e-6f || t < -1e-6f) {
                        float* an = reinterpret_cast<float*>(e + 0x28); an[a] += t; float* dr = reinterpret_cast<float*>(e + 0x34); const float ang = t * 6.2831853f, cs2 = __builtin_cosf(ang), sn2 = __builtin_sinf(ang);
                        const int i1 = (a + 1) % 3, i2 = (a + 2) % 3; for (int j = 0; j < 3; j++) { const float p1 = dr[i1 * 3 + j], p2 = dr[i2 * 3 + j]; dr[i1 * 3 + j] = p1 * cs2 + p2 * sn2; dr[i2 * 3 + j] = -p1 * sn2 + p2 * cs2; } } } }
                if (fresh) tb[ti].sn = sn;
            }
        }
        return n;
    }
};
HOOK_DEFINE_TRAMPOLINE(NickHook) {
    static void Callback(char* nick, const void* uid) {
        Orig(nick, uid);
        if (nick && nick[0]) { int o = 0; while (nick[o] && o < 32) { g_RealNick[o] = nick[o]; o++; } g_RealNick[o] = 0; }
        if (g_NameOn && g_NameU8[0] && nick) { int o = 0; while (g_NameU8[o] && o < 32) { nick[o] = g_NameU8[o]; o++; } nick[o] = 0; }
    }
};

namespace {
    void NameLive(const char* cur, const char* nw);
    void ExtraTick() {
        if (g_LogClrReq) {
            g_LogClrReq = false;
            /* ログ全消去: SD の inkdraw/bin の中身 (診断のログ) を全部消す */
            const uintptr_t sdk = AtSdk();
            if (!sdk || !AtMount(sdk)) g_LogClrState = 2;
            else { using CleanFn = u32 (*)(const char*); g_LogClrState = reinterpret_cast<CleanFn>(sdk + 0xAA4C0)("inkd:/inkdraw/bin") == 0 ? 1 : 2; }
        }
        if (g_NameRnd) {
            static const char* const kRn[28] = { "ファントム", "シャドウ", "ナイトメア", "ヴォイド", "クロノス", "レイジ", "ネメシス", "エクリプス", "ヴァルキリー", "アビス", "ストライカー", "ゴースト", "オメガ", "ジョーカー", "カオス", "ルシファー", "サイレント", "ディアブロ", "ハイドラ", "バンシー", "ノヴァ", "ラグナロク", "スペクター", "ヴェノム", "ゼノン", "Phantom", "Eclipse", "NEMESIS" };
            static const u32 kIvS[5] = { 2, 5, 10, 30, 60 };
            const u64 now = NowTick();
            if (g_NameRndT == 0 || now - g_NameRndT >= static_cast<u64>(kIvS[g_NameRndIv % 5]) * 19200000ull) {
                g_NameRndT = now;
                u32 r = static_cast<u32>(now ^ (now >> 17)) * 2654435761u; r ^= r >> 15; u32 k = r % 28; if (k == g_NameRndLast) k = (k + 1) % 28; g_NameRndLast = k;
                char tmp[40] = {}; int o = 0; for (const char* q = kRn[k]; *q && o < 32; q++) tmp[o++] = *q;
                std::memcpy(g_NameU8, tmp, sizeof(tmp)); g_NameOn = true;
                if (!g_NameCur[0]) std::memcpy(g_NameCur, g_RealNick, sizeof(g_NameCur));
                if (g_NameCur[0]) { NameLive(g_NameCur, g_NameU8); std::memcpy(g_NameCur, g_NameU8, sizeof(g_NameCur)); }
            }
        }
        {
            static int atWait = 0;
            if (!g_AtLoaded) { if (++atWait > 150) { g_AtLoaded = true; AtLoadSave(false); } }
            else if (g_ReqAtSave) { g_ReqAtSave = false; AtLoadSave(true); }
        }
        { const uintptr_t pm = ReadPaintMgr(); g_InBattle = pm && Readable(pm + 0x2d8, 8) && *reinterpret_cast<const uintptr_t*>(pm + 0x2d8) != 0; }
        const uintptr_t b = MainBase();
        auto GotAt = [&](u64 off) -> uintptr_t { return b + off; /* PLT の入口 (遅延解決のため、GOT を直接読まない) */ };
        /* 名前のフック (ゲームが動いて関数の場所が入ってから、1回だけ) */
        if (!g_NickHooked) {
            static int wait = 0;
            if (++wait > 300) {
                const uintptr_t fn = GotAt(0x4E8B330);
                if (fn > 0x1000 && Readable(fn, 8)) { g_NickHooked = true; NickHook::InstallAtPtr(fn); }
            }
        }
        /* 振動: 決定を押したら 0.12 秒だけ震わせる */
        static u64 offAt = 0; static u32 vh[16]; static int vn = -1;
        const u64 now = NowTick();
        if (g_VibReq || offAt) {
            const uintptr_t aGet = GotAt(0x4E8E160), aInit = GotAt(0x4E8E180), aSend = GotAt(0x4E8E1C0), aSty = GotAt(0x4E8BA20);
            if (aGet > 0x1000 && aInit > 0x1000 && aSend > 0x1000 && aSty > 0x1000) {
                using FnGet = int (*)(u32*, int, const u32&, u32); using FnInit = void (*)(const u32&); using FnSend = void (*)(const u32&, const float*); using FnSty = u32 (*)(const u32&);
                if (vn < 0 && g_VibReq) {
                    vn = 0;
                    static const u32 ids[2] = { 0u, 0x20u };
                    for (int k = 0; k < 2; k++) {
                        const u32 sty = reinterpret_cast<FnSty>(aSty)(ids[k]);
                        for (int bit = 0; bit < 5; bit++) if ((sty >> bit) & 1) {
                            u32 t[2] = {}; const int n = reinterpret_cast<FnGet>(aGet)(t, 2, ids[k], 1u << bit);
                            for (int q = 0; q < n && q < 2 && vn < 16; q++) { reinterpret_cast<FnInit>(aInit)(t[q]); vh[vn++] = t[q]; }
                        }
                    }
                }
                if (g_VibReq) { g_VibReq = 0; static const float on[4] = { 0.6f, 160.0f, 0.6f, 320.0f }; for (int i = 0; i < vn; i++) reinterpret_cast<FnSend>(aSend)(vh[i], on); offAt = now + 2304000ull; }
                else if (offAt && now >= offAt) { offAt = 0; static const float off[4] = { 0.0f, 160.0f, 0.0f, 320.0f }; for (int i = 0; i < vn; i++) reinterpret_cast<FnSend>(aSend)(vh[i], off); }
            } else { g_VibReq = 0; offAt = 0; }
        }
    }
}
INKDRAW_HID_HOOK(HidHandheld)
INKDRAW_HID_HOOK(HidJoyDual)
INKDRAW_HID_HOOK(HidJoyLeft)
INKDRAW_HID_HOOK(HidJoyRight)


/* ---- 候補: ゲームが毎フレーム呼びそうな SDK の関数。どのスレッドで動くか記録して、描くのにも使う ---- */
u64 g_TlsFrame = 0, g_CntFrame = 0;
namespace {
/* ゲームに渡すボタンを足したり消したりする (メニューを開いているあいだは何もしない) */
void HidInject(u64 b, u64& orm, u64& clr) {
    static u64 prevD = 0, untilF = 0, dirBit = 0; static u32 rnd = 0x2545F491u;
    rnd ^= rnd << 13; rnd ^= rnd >> 17; rnd ^= rnd << 5; rnd += static_cast<u32>(NowTick());
    if (g_Bunny) {
        /* バニーホップ: 着地した瞬間に B を押して、すぐ次のジャンプ (スティックを倒さなくても、メニューを開いていても動く)。イカのときは ZL も押しっぱなし。
           着地は、足元の高さが止まったら (座標が使えないときは 0.25 秒ごとの時計で代用) */
        static float prevY = 0.0f; static bool haveY = false; static int still = 0; static u64 lastS = 0, pressUntil = 0, nextOk = 0;
        const u64 nowMs = NowTick() / 19200ull;
        if (g_BunnyMode) orm |= 1ull << 8;
        if (nowMs - lastS >= 8) {
            lastS = nowMs;
            float Lb[3];
            if (ReadLive(Lb)) { if (haveY && __builtin_fabsf(Lb[1] - prevY) < 0.03f) still++; else still = 0; prevY = Lb[1]; haveY = true; }
            else { haveY = false; still = (nowMs % 250) < 16 ? 2 : 0; }
        }
        if (nowMs >= nextOk && still >= 2 && nowMs >= pressUntil) { pressUntil = nowMs + 60; nextOk = nowMs + 130; still = 0; }
        if (nowMs < pressUntil) orm |= 1ull << 1;
    }
    if (g_AutoRun && !g_AutoDone) {
        static u64 t0 = 0; const u64 ms = NowTick() / 19200ull;
        if (!t0) t0 = ms;
        if (ms - t0 > 150000) g_AutoDone = true; /* 150 秒たったらやめる */
        else if (((ms - t0) % 800) < 120) orm |= 1ull; /* A ボタンを 0.8 秒ごとに押す */
    }
    if (g_MenuOpen) { prevD = 0; return; }
    { static u64 emoUntil = 0, emoBit = 0; const u64 emoMs = NowTick() / 19200ull;
      if (g_EmoFire >= 0) { const int e = g_EmoFire; g_EmoFire = -1; emoBit = 1ull << (12 + (e >= 4 ? static_cast<int>((rnd >> 8) & 3) : e)); emoUntil = emoMs + 150; }
      if (emoMs < emoUntil) orm |= emoBit; } /* エモート一覧から選んだ十字キーを、メニューを閉じたあとに押す */
    if (g_EmoteOn) {
        /* ランダムエモート: 十字キーを押すと、上下左右のどれかをランダムに押したことにする */
        const u64 dp = b & (0xFull << 12);
        const u64 edge = dp & ~prevD; prevD = dp;
        const u64 nowMs = NowTick() / 19200ull;
        if (edge && nowMs >= untilF) { dirBit = 1ull << (12 + ((rnd >> 8) & 3)); untilF = nowMs + 150; }
        clr |= 0xFull << 12;
        if (nowMs < untilF) orm |= dirBit;
    }
}
/* 入力を書き換えてゲームに渡す: 連打・固定・入れ替え・スティックの加工。メニューを開いているあいだは何もしない。 */
void HidApply(u64 b, u8* out, s32 n) {
    g_HudBtn = b;
    { s32 st[4]; std::memcpy(st, out + 0x10, 16); for (int i = 0; i < 4; i++) g_HudSt[i] = static_cast<float>(st[i]) / 32767.0f; }
    u64 io = 0, ic = 0;
    HidInject(b, io, ic);
    const bool menu = g_MenuOpen;
    const u64 ms = NowTick() / 19200ull;
    if (!menu) {
        if (g_Fx[0] && (ms % 140) < 70) io |= 1ull << 0;   /* A */
        if (g_Fx[1] && (ms % 140) < 70) io |= 1ull << 2;   /* X */
        if (g_Fx[2] && (ms % 140) < 70) io |= 1ull << 3;   /* Y */
        if (g_Fx[3] && (ms % 140) < 70) io |= 1ull << 7;   /* R (サブウェポン) */
        if (g_Fx[4]) io |= 1ull << 9;                      /* ZR 押しっぱなし (撃ち続ける) */
        if (g_Fx[5]) io |= 1ull << 8;                      /* ZL 押しっぱなし (イカのまま) */
        if (g_Fx[6] && (ms % 200) < 70) io |= 1ull << 1;   /* B (ジャンプ) */
        if (g_Fx[7] && (ms % 1200) < 150) io |= 1ull << 13;/* 十字キー上 (カモン) */
        if (g_Fx[8] && (ms % 1200) < 150) io |= 1ull << 15;/* 十字キー下 (ナイス) */
        if (g_Fx[9] && (ms % 400) < 120) io |= 1ull << 5;  /* 右スティック押し込み (スペシャル) */
    }
    if (NowTick() - g_FrameT > 19200000ull) LookTick(); /* 地点を見るは、ふだんはゲームの毎フレーム更新のすぐあと (座標とカメラがそろった瞬間) に 1 回だけ動かす。毎フレーム更新が 1 秒以上動かない場面だけ、ここで動かす (0.1 秒の引っかかりで動かすと、古いカメラの値で変な方向へ向き、同時に入って落ちた) */
    ScanTick();
    const bool lookFx = (g_LookOn && g_LookActive) || g_ScanStep != 0 || g_GaLock; /* g_GaLock: エイムボット（ジャイロ）が敵を追っている間は、右スティックを 0 にする */ /* 向く範囲の外では、自分の操作のまま */
    const bool stickFx = !menu && (g_Fx[10] || g_Fx[11] || g_Fx[12] || g_Fx[13] || g_Fx[14] || g_Fx[15]);
    const bool swapFx = !menu && (g_Fx[16] || g_Fx[17]);
    if (!(io || ic || stickFx || swapFx || lookFx)) return;
    for (s32 k = 0; k < n; k++) {
        u64 bb; std::memcpy(&bb, out + 0x28 * k + 8, 8);
        if (!menu && g_Fx[16]) { const u64 a = bb & 1ull, c = (bb >> 1) & 1ull; bb = (bb & ~3ull) | c | (a << 1); }
        if (!menu && g_Fx[17]) { const u64 a = (bb >> 8) & 1ull, c = (bb >> 9) & 1ull; bb = (bb & ~(3ull << 8)) | (c << 8) | (a << 9); }
        bb = (bb & ~ic) | io;
        std::memcpy(out + 0x28 * k + 8, &bb, 8);
        if (stickFx) {
            s32 st[4]; std::memcpy(st, out + 0x28 * k + 0x10, 16);
            long long lx = st[0], ly = st[1], rx = st[2], ry = st[3];
            if (g_Fx[15]) { /* ふらふら歩き: 0.3 秒ごとに向きがずれる */
                u32 h = static_cast<u32>(ms / 300) * 2654435761u; h ^= h >> 15;
                lx += static_cast<int>(h & 0x3FFF) - 0x2000; ly += static_cast<int>((h >> 14) & 0x3FFF) - 0x2000;
            }
            if (g_Fx[11]) { /* 全力ダッシュ: 少しでも倒したら、いっぱいまで倒したことにする */
                const float mag = __builtin_sqrtf(static_cast<float>(lx * lx + ly * ly));
                if (mag > 6000.0f) { const float sc = 32767.0f / mag; lx = static_cast<long long>(lx * sc); ly = static_cast<long long>(ly * sc); }
            }
            if (g_Fx[10]) { lx = -lx; ly = -ly; }
            if (g_Fx[12]) ry = -ry;
            const int pct = 100 + g_Fx[14];
            if (pct != 100) { rx = rx * pct / 100; ry = ry * pct / 100; }
            if (g_Fx[13]) rx += static_cast<long long>(g_Fx[13]) * 4000;
            auto cl = [](long long v) -> s32 { return v > 32767 ? 32767 : (v < -32767 ? -32767 : static_cast<s32>(v)); };
            st[0] = cl(lx); st[1] = cl(ly); st[2] = cl(rx); st[3] = cl(ry);
            std::memcpy(out + 0x28 * k + 0x10, st, 16);
        }
        if (lookFx) { s32 st[4]; std::memcpy(st, out + 0x28 * k + 0x10, 16); st[2] = g_LookRx; st[3] = g_LookRy; if (g_ScanStep) { st[0] = 0; st[1] = 0; } std::memcpy(out + 0x28 * k + 0x10, st, 16); } /* 地点を見る / 視点探し */
    }
}
}
namespace nvnhook { extern volatile u64 g_Presents; extern volatile u32 g_Flags; extern volatile int g_TexFmtPub; }
/* ゲーム本体の毎フレーム更新 (main+0x3737640)。塗りリクエストと同じスレッドで動く。ここから描く。 */
HOOK_DEFINE_TRAMPOLINE(FrameHook) {
    static u64 Callback(u64 a0, u64 a1, u64 a2, u64 a3, u64 a4, u64 a5, u64 a6, u64 a7, double f0, double f1, double f2, double f3) {
        if (g_PreFn) g_PreFn();
        const u64 r = Orig(a0, a1, a2, a3, a4, a5, a6, a7, f0, f1, f2, f3);
        g_TlsFrame = ReadTls(); g_CntFrame++;
        if (g_BgClear) { const u32 cm = __atomic_exchange_n(&g_BgClear, 0u, __ATOMIC_ACQ_REL); if (cm & 1u) g_CamPos = 0; if (cm & 2u) g_FootPos = 0; if (cm & 4u) __atomic_store_n(&g_LivePos, static_cast<uintptr_t>(0), __ATOMIC_RELEASE); }
        if (g_CircOn) { /* 円: この瞬間のカメラと座標を写しておく (描くときに読むと、次のフレームの途中の値が混ざって体からずれる) */
            const uintptr_t cp = g_CamPos, fp = g_FootPos; /* 1 回だけ読んで使う (途中で変わっても落ちないように) */
            const bool cOk = cp && CamValid() && Readable(cp - 0xC, 24); const bool fOk = fp && FootValid() && Readable(fp, 12); const uintptr_t lp0 = __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE); const bool lOk = fOk || (lp0 && LiveValid() && Readable(lp0, 12));
            float cam[6], lv[3];
            if (cOk) std::memcpy(cam, reinterpret_cast<const void*>(cp - 0xC), 24);
            if (fOk) { std::memcpy(lv, reinterpret_cast<const void*>(fp), 12); lv[1] += kLiveHeight; } /* 足元 (床の高さ) の座標があれば、それを使う (box は kLiveHeight を引いて床にするので、足しておく) */
            else if (lOk) std::memcpy(lv, reinterpret_cast<const void*>(lp0), 12);
            __atomic_add_fetch(&g_SnapSeq, 1u, __ATOMIC_ACQ_REL);
            if (cOk) std::memcpy(g_SnapCam, cam, 24); if (lOk) std::memcpy(g_SnapLive, lv, 12); g_SnapCamOk = cOk; g_SnapLiveOk = lOk;
            __atomic_add_fetch(&g_SnapSeq, 1u, __ATOMIC_ACQ_REL);
        }
        { /* 視野の広さ: カメラの縦の画角 (追従先の +0x20、ふだんは 55.0) を、毎フレーム書く。やめたら 55.0 に戻す */
            /* 画角は、度 (55)・ラジアン (0.96)・その半分・tan などで持っていることがある。カメラの前後 0x4000 から、今の画角に合う値を全部候補にして、選んだ 1 つにだけ書く */
            static intptr_t off[24]; static u8 typ[24]; static float orig[24]; static bool wrote[24]; static uintptr_t base = 0; static int prevSel = -1;
            const int lv = g_FovLv;
            auto conv = [](float deg, int t) { const float r = deg * 0.017453293f; switch (t) { case 0: return deg; case 1: return r; case 2: return deg * 0.5f; case 3: return r * 0.5f; case 4: return __builtin_sinf(r * 0.5f) / __builtin_cosf(r * 0.5f); default: return __builtin_cosf(r * 0.5f) / __builtin_sinf(r * 0.5f); } };
            if (CamValid() && (lv > 0 || prevSel >= 0)) {
                if (base != g_CamPos) { base = g_CamPos; g_FovN = 0; g_FovSel = 0; prevSel = -1; for (int k = 0; k < 24; k++) wrote[k] = false;
                    const uintptr_t lo = g_CamPos - 0x4000; int n = 0; off[n] = 0x20; typ[n] = 0; n++;
                    if (Readable(lo, 0x8000)) { const float* F = reinterpret_cast<const float*>(lo);
                        for (int q = 0; q < 0x2000 && n < 24; q++) { const intptr_t o = static_cast<intptr_t>(q * 4) - 0x4000; if (o == 0x20) continue; const float v = F[q];
                            for (int t = 0; t < 6; t++) { const float w = conv(55.0f, t); const float e = v - w < 0 ? w - v : v - w; if (e < w * 0.002f) { off[n] = o; typ[n] = static_cast<u8>(t); n++; break; } } } }
                    g_FovN = n; }
                const int sel = g_FovSel < g_FovN ? g_FovSel : 0;
                if (prevSel >= 0 && prevSel != sel && wrote[prevSel] && Writable(base + off[prevSel], 4)) { *reinterpret_cast<float*>(base + off[prevSel]) = orig[prevSel]; wrote[prevSel] = false; } /* 前の候補は元の値に戻す */
                if (g_FovN > 0 && Writable(base + off[sel], 4)) { float* fv = reinterpret_cast<float*>(base + off[sel]);
                    if (lv > 0) { if (!wrote[sel]) { orig[sel] = *fv; wrote[sel] = true; } *fv = conv(55.0f + 5.0f * static_cast<float>(lv), typ[sel]); prevSel = sel; }
                    else if (wrote[sel]) { *fv = orig[sel]; wrote[sel] = false; prevSel = -1; } }
            }
        }
        g_FrameT = NowTick(); LookTick(); /* 毎フレーム 1 回: 相手と自分とカメラの、このフレームの座標で向きを決める */
        if (g_DriveFn) g_DriveFn();
        return r;
    }
};
HOOK_DEFINE_TRAMPOLINE(FocusHook) {
    static u32 Callback() {
        const u32 r = Orig();
        g_TlsFocus = ReadTls(); g_CntFocus++;
        if (g_DriveFn) g_DriveFn();
        return r;
    }
};
HOOK_DEFINE_TRAMPOLINE(PopHook) {
    static bool Callback(u32* out) {
        const bool r = Orig(out);
        g_TlsPop = ReadTls(); g_CntPop++;
        if (g_DriveFn) g_DriveFn();
        return r;
    }
};

namespace {

    /* ゲームが動き出す前 (exl_main) に、1回だけ入れる。同じ関数に2回フックを入れると
       自分自身を呼び続けて落ちるので、必ず1回だけにする。 */
    void InstallHid() {
        if (!exl::util::HasModule(exl::util::ModuleIndex::Sdk))
            return;
        const uintptr_t sdk = exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start;
        for (int i = 0; i < kHidCount; i++) {
            const uintptr_t fn = sdk + kSdkHid[i];
            if (*reinterpret_cast<const u32*>(fn) != kSdkHidFirst[i])
                continue;
            if (__atomic_exchange_n(&g_HidDone[i], true, __ATOMIC_ACQ_REL))
                continue;
            switch (i) {
                case 0: HidFullKey::InstallAtPtr(fn);  break;
                case 1: HidHandheld::InstallAtPtr(fn); break;
                case 2: HidJoyDual::InstallAtPtr(fn);  break;
                case 3: HidJoyLeft::InstallAtPtr(fn);  break;
                default: HidJoyRight::InstallAtPtr(fn); break;
            }
        }
    }

}

namespace {
    /* ---- 診断: 状態を SD カードに書き出す (INKDRAW_DUMP=1 のときだけ) --------- */
    /* SD のいちばん上に inkdump_XXXXXXXX.bin を作る。解析用。 */
    constexpr uintptr_t kSdkCreateFile = 0xA9E70; /* nn::fs::CreateFile(const char*, long)                    */
    constexpr uintptr_t kSdkWriteFile  = 0xA9530; /* nn::fs::WriteFile(FileHandle, long, const void*, ulong, const WriteOption&) */
    constexpr uintptr_t kSdkFlushFile  = 0xA9660; /* nn::fs::FlushFile(FileHandle)                            */
    constexpr size_t kDumpHead = 0x200;
    constexpr size_t kDumpObj  = 0x1000;
    constexpr size_t kDumpSub  = 0x100;
    constexpr size_t kDumpPtrs = 512;
    constexpr size_t kDumpSize = kDumpHead + kDumpObj + kDumpPtrs * (8 + kDumpSub);
    u8 g_DumpBuf[kDumpSize];
    u32 g_DumpResult = 0xFFFFFFFF;

    void HexName(char* out, u32 v) {
        const char* p = "inkd:/inkdraw/bin/inkdump_";
        while (*p) *out++ = *p++;
        for (int i = 7; i >= 0; i--) *out++ = "0123456789abcdef"[(v >> (i * 4)) & 15];
        const char* e = ".bin";
        while (*e) *out++ = *e++;
        *out = 0;
    }

    u32 WriteDump(const PaintRequest* base, s32 kind, u32 id, const float* hit, uintptr_t shooter) {
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return 1;
        using MountFn  = u32 (*)(const char*);
        using CreateFn = u32 (*)(const char*, s64);
        using OpenFn   = u32 (*)(FileHandle*, const char*, int);
        using WriteFn  = u32 (*)(FileHandle, s64, const void*, u64, const s32*);
        using FlushFn  = u32 (*)(FileHandle);
        using CloseFn  = void (*)(FileHandle);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0)
                rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return 2;
            g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        }

        std::memset(g_DumpBuf, 0, sizeof(g_DumpBuf));
        u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t));
        u64* hd = reinterpret_cast<u64*>(g_DumpBuf);
        hd[0] = 0x31504D554B4E49ull;           /* "INKUMP1" */
        hd[1] = t;
        hd[2] = static_cast<u64>(static_cast<u32>(kind));
        hd[3] = id;
        hd[4] = shooter;
        const uintptr_t mgr = ReadPaintMgr();
        hd[5] = mgr;
        hd[6] = Readable(mgr + 696, 16) ? *reinterpret_cast<uintptr_t*>(mgr + 696) : 0;
        hd[7] = Readable(mgr + 696, 16) ? *reinterpret_cast<uintptr_t*>(mgr + 704) : 0;
        std::memcpy(g_DumpBuf + 0x40, hit, 12);
        std::memcpy(g_DumpBuf + 0x50, base->raw, kReqSize);
        hd[0x1F] = g_Locked ? 1 : 0;

        if (shooter && Readable(shooter, kDumpObj)) {
            std::memcpy(g_DumpBuf + kDumpHead, reinterpret_cast<const void*>(shooter), kDumpObj);
            for (size_t j = 0; j < kDumpPtrs; j++) {
                const uintptr_t pv = *reinterpret_cast<const uintptr_t*>(shooter + 8 * j);
                u8* dst = g_DumpBuf + kDumpHead + kDumpObj + j * (8 + kDumpSub);
                std::memcpy(dst, &pv, 8);
                if (pv >= 0x10000 && !(pv & 3) && Readable(pv, kDumpSub))
                    std::memcpy(dst + 8, reinterpret_cast<const void*>(pv), kDumpSub);
                else
                    std::memset(dst + 8, 0xEE, 0);
            }
        }

        char name[48];
        HexName(name, static_cast<u32>(t >> 4));
        const auto create = reinterpret_cast<CreateFn>(sdk + kSdkCreateFile);
        const auto open   = reinterpret_cast<OpenFn>(sdk + kSdkOpenFile);
        const auto write  = reinterpret_cast<WriteFn>(sdk + kSdkWriteFile);
        const auto flush  = reinterpret_cast<FlushFn>(sdk + kSdkFlushFile);
        const auto close  = reinterpret_cast<CloseFn>(sdk + kSdkCloseFile);
        if (create(name, static_cast<s64>(kDumpSize)) != 0) return 3;
        FileHandle fh { nullptr };
        if (open(&fh, name, 2 /* Write */) != 0) return 4;
        const s32 opt = 0;
        const u32 wr = write(fh, 0, g_DumpBuf, kDumpSize, &opt);
        flush(fh);
        close(fh);
        return wr == 0 ? 0 : 5;
    }

    /* ---- 診断2: スタック (呼び出し元) と、そこから辿れるオブジェクトを書き出す ---- */
    constexpr size_t kStkBytes = 0x1000;
    constexpr size_t kL1Len = 0x200, kL2Len = 0x100;
    constexpr size_t kL1Max = 160, kL2Max = 400;
    constexpr size_t kStkEntry = 16 + kL1Len;
    constexpr size_t kStkSize = kDumpHead + kStkBytes + (kL1Max + kL2Max) * kStkEntry;
    u8 g_StkBuf[kStkSize];
    uintptr_t g_Seen[kL1Max + kL2Max];

    bool LooksHeap(uintptr_t v, size_t len) {
        if (v < 0x1000000ull || (v & 7) || (v >> 40)) return false;
        return Readable(v, len);
    }

    u32 WriteDump2(const PaintRequest* base, s32 kind, u32 id, const float* hit, uintptr_t sp) {
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return 1;
        using MountFn  = u32 (*)(const char*);
        using CreateFn = u32 (*)(const char*, s64);
        using OpenFn   = u32 (*)(FileHandle*, const char*, int);
        using WriteFn  = u32 (*)(FileHandle, s64, const void*, u64, const s32*);
        using FlushFn  = u32 (*)(FileHandle);
        using CloseFn  = void (*)(FileHandle);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0)
                rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return 2;
            g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        }
        std::memset(g_StkBuf, 0, sizeof(g_StkBuf));
        u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t));
        u64* hd = reinterpret_cast<u64*>(g_StkBuf);
        hd[0] = 0x32504D554B4E49ull; /* "INKUMP2" */
        hd[1] = t;
        hd[2] = static_cast<u64>(static_cast<u32>(kind));
        hd[3] = id;
        hd[4] = sp;
        hd[5] = ReadPaintMgr();
        hd[6] = kStkBytes; hd[7] = kStkSize;
        std::memcpy(g_StkBuf + 0x40, hit, 12);
        std::memcpy(g_StkBuf + 0x50, base->raw, kReqSize);
        hd[0x1E] = exl::util::GetModuleInfo(exl::util::ModuleIndex::Main).m_Total.m_Start;
        hd[0x1F] = sdk;

        const size_t stkLen = Readable(sp & ~3ull, kStkBytes) ? kStkBytes : 0;
        if (stkLen) std::memcpy(g_StkBuf + kDumpHead, reinterpret_cast<const void*>(sp & ~3ull), stkLen);
        u8* ent = g_StkBuf + kDumpHead + kStkBytes;
        size_t nseen = 0, n1 = 0, n2 = 0;
        auto put = [&](uintptr_t pv, size_t len, u32 lvl) -> const u8* {
            for (size_t k = 0; k < nseen; k++) if (g_Seen[k] == pv) return nullptr;
            if (nseen >= kL1Max + kL2Max) return nullptr;
            g_Seen[nseen++] = pv;
            u64* e = reinterpret_cast<u64*>(ent);
            e[0] = pv; e[1] = (static_cast<u64>(len) << 8) | lvl;
            std::memcpy(ent + 16, reinterpret_cast<const void*>(pv), len);
            const u8* data = ent + 16;
            ent += kStkEntry;
            return data;
        };
        const u8* l1[kL1Max]; size_t nl1 = 0;
        for (size_t o = 0; o + 8 <= stkLen && n1 < kL1Max; o += 8) {
            uintptr_t pv = *reinterpret_cast<const uintptr_t*>((sp & ~3ull) + o);
            if (!LooksHeap(pv, kL1Len)) continue;
            const u8* d = put(pv, kL1Len, 1);
            if (d) { l1[nl1++] = d; n1++; }
        }
        for (size_t i = 0; i < nl1 && n2 < kL2Max; i++) {
            for (size_t o = 0; o + 8 <= kL1Len && n2 < kL2Max; o += 8) {
                uintptr_t pv = *reinterpret_cast<const uintptr_t*>(l1[i] + o);
                if (!LooksHeap(pv, kL2Len)) continue;
                if (put(pv, kL2Len, 2)) n2++;
            }
        }
        hd[8] = n1; hd[9] = n2;
        hd[10] = g_ScanRuns; hd[11] = g_ScanFound; hd[12] = g_PosObj; hd[13] = g_FireHeld ? 1 : 0;

        char name[48];
        const char* p = "inkd:/inkdraw/bin/inkstk_"; char* q = name;
        while (*p) *q++ = *p++;
        for (int i = 7; i >= 0; i--) *q++ = "0123456789abcdef"[(static_cast<u32>(t >> 4) >> (i * 4)) & 15];
        *q++ = '.'; *q++ = 'b'; *q++ = 'i'; *q++ = 'n'; *q = 0;
        const auto create = reinterpret_cast<CreateFn>(sdk + kSdkCreateFile);
        const auto open   = reinterpret_cast<OpenFn>(sdk + kSdkOpenFile);
        const auto write  = reinterpret_cast<WriteFn>(sdk + kSdkWriteFile);
        const auto flush  = reinterpret_cast<FlushFn>(sdk + kSdkFlushFile);
        const auto close  = reinterpret_cast<CloseFn>(sdk + kSdkCloseFile);
        if (create(name, static_cast<s64>(kStkSize)) != 0) return 3;
        FileHandle fh { nullptr };
        if (open(&fh, name, 2) != 0) return 4;
        const s32 opt = 0;
        const u32 wr = write(fh, 0, g_StkBuf, kStkSize, &opt);
        flush(fh);
        close(fh);
        return wr == 0 ? 0 : 5;
    }

    /* ---- 診断3: メモリ全体から「自分の座標」に追従する数値を探す (INKDRAW_SCAN=1) ---- */
    constexpr int kMaxCand = 60000;
    uintptr_t g_Cand[kMaxCand];
    float g_CandVal[kMaxCand][3];
    int g_NCand = 0, g_ScanStage = 0;
    float g_ScanRef[3] = {};
    constexpr float kScanR = 2.0f, kScanRY = 3.5f;
    constexpr int kOutMax = 96;
    constexpr size_t kCtx = 0x180;
    constexpr size_t kScanOutSize = 0x100 + kOutMax * (8 + kCtx);
    u8 g_ScanOut[kScanOutSize];

    ALWAYS_INLINE bool NearRef(const float* p, const float* r) {
        const float dx = p[0] - r[0], dy = p[1] - r[1], dz = p[2] - r[2];
        return dx <= kScanR && dx >= -kScanR && dz <= kScanR && dz >= -kScanR && dy <= kScanRY && dy >= -kScanRY;
    }

    void ScanHeap(const float* ref) {
        g_NCand = 0;
        uintptr_t addr = 0;
        for (int guard = 0; guard < 8192; guard++) {
            MemoryInfo mi;
            u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr)))
                break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9)
                         && (mi.perm & Perm_R) && !(mi.attr & 0xC) /* 端末共有・キャッシュなしの領域は読まない (GPU 用で、読むと落ちる) */ && (mi.perm & Perm_W);
            if (ok && mi.size >= 32) {
                const float* f = reinterpret_cast<const float*>(mi.addr);
                const size_t n = mi.size / 4 - 3;
                const float lo = ref[0] - kScanR, hi = ref[0] + kScanR;
                for (size_t i = 0; i < n; i++) {
                    const float a = f[i];
                    if (!(a >= lo && a <= hi)) continue;
                    if (a > -0.05f && a < 0.05f) continue;
                    const float b = f[i + 1], c = f[i + 2];
                    if (b > -0.05f && b < 0.05f) continue;
                    if (c > -0.05f && c < 0.05f) continue;
                    if (NearRef(f + i, ref) && g_NCand < kMaxCand) {
                        g_CandVal[g_NCand][0] = a; g_CandVal[g_NCand][1] = b; g_CandVal[g_NCand][2] = c;
                        g_Cand[g_NCand++] = reinterpret_cast<uintptr_t>(f + i);
                    }
                }
            }
            if (end <= addr || end == 0)
                break;
            addr = end;
        }
    }

    void FilterCands(const float* ref) {
        int k = 0;
        for (int i = 0; i < g_NCand; i++) {
            const uintptr_t a = g_Cand[i];
            if (Readable(a, 12) && NearRef(reinterpret_cast<const float*>(a), ref)) {
                const float* f = reinterpret_cast<const float*>(a);
                g_CandVal[k][0] = f[0]; g_CandVal[k][1] = f[1]; g_CandVal[k][2] = f[2];
                g_Cand[k++] = a;
            }
        }
        g_NCand = k;
    }

    u32 WriteScanFile(const float* prev, const float* cur, int before) {
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return 1;
        using MountFn  = u32 (*)(const char*);
        using CreateFn = u32 (*)(const char*, s64);
        using OpenFn   = u32 (*)(FileHandle*, const char*, int);
        using WriteFn  = u32 (*)(FileHandle, s64, const void*, u64, const s32*);
        using FlushFn  = u32 (*)(FileHandle);
        using CloseFn  = void (*)(FileHandle);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0)
                rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return 2;
            g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        }
        std::memset(g_ScanOut, 0, sizeof(g_ScanOut));
        u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t));
        u64* hd = reinterpret_cast<u64*>(g_ScanOut);
        hd[0] = 0x314E43534B4E49ull; /* "INKSCN1" */
        hd[1] = t;
        hd[2] = exl::util::GetModuleInfo(exl::util::ModuleIndex::Main).m_Total.m_Start;
        hd[3] = static_cast<u64>(g_ScanStage);
        hd[4] = static_cast<u64>(before);
        hd[5] = static_cast<u64>(g_NCand);
        std::memcpy(g_ScanOut + 0x50, prev, 12);
        std::memcpy(g_ScanOut + 0x40, cur, 12);
        int n = 0;
        u8* ent = g_ScanOut + 0x100;
        for (int i = 0; i < g_NCand && n < kOutMax; i++) {
            const uintptr_t a = g_Cand[i];
            const uintptr_t start = a - 0x80;
            std::memcpy(ent, &a, 8);
            if (Readable(start & ~3ull, kCtx))
                std::memcpy(ent + 8, reinterpret_cast<const void*>(start & ~3ull), kCtx);
            ent += 8 + kCtx;
            n++;
        }
        hd[7] = static_cast<u64>(n);

        char name[48];
        const char* p = "inkd:/inkdraw/bin/inkscn_"; char* q = name;
        while (*p) *q++ = *p++;
        for (int i = 7; i >= 0; i--) *q++ = "0123456789abcdef"[(static_cast<u32>(t >> 4) >> (i * 4)) & 15];
        *q++ = '.'; *q++ = 'b'; *q++ = 'i'; *q++ = 'n'; *q = 0;
        const auto create = reinterpret_cast<CreateFn>(sdk + kSdkCreateFile);
        const auto open   = reinterpret_cast<OpenFn>(sdk + kSdkOpenFile);
        const auto write  = reinterpret_cast<WriteFn>(sdk + kSdkWriteFile);
        const auto flush  = reinterpret_cast<FlushFn>(sdk + kSdkFlushFile);
        const auto close  = reinterpret_cast<CloseFn>(sdk + kSdkCloseFile);
        if (create(name, static_cast<s64>(kScanOutSize)) != 0) return 3;
        FileHandle fh { nullptr };
        if (open(&fh, name, 2) != 0) return 4;
        const s32 opt = 0;
        const u32 wr = write(fh, 0, g_ScanOut, kScanOutSize, &opt);
        flush(fh);
        close(fh);
        return wr == 0 ? 0 : 5;
    }

    /* 状態: 0=最初 / 1=場所Aで候補を集めた / 2,3,4=撃たずに動いたものだけ残した回数 / 4のあとの撃ちで確定して0に戻る */
    bool g_ScanBusy = false;

    /* 撃った瞬間の自分の座標 p (x, 高さ, z) */
    u32 ScanStep(const float* p) {
        if (__atomic_exchange_n(&g_ScanBusy, true, __ATOMIC_ACQUIRE))
            return 0;
        u32 rc = 0;
        const bool badRef = !(p[1] > 1.0f || p[1] < -1.0f);
        if (badRef) {
            /* 座標がおかしい (高さが0付近) ときは使わない */
        } else if (g_ScanStage == 0) {
            ScanHeap(p);
            std::memcpy(g_ScanRef, p, 12);
            g_ScanStage = 1;
        } else if (g_ScanStage == 4) {
            const int before = g_NCand;
            FilterCands(p);
            float prev[3]; std::memcpy(prev, g_ScanRef, 12);
            g_ScanStage = 5;
            rc = WriteScanFile(prev, p, before);
            g_ScanStage = 0; /* 最後まで終わった: 次はやり直し */
        }
        __atomic_store_n(&g_ScanBusy, false, __ATOMIC_RELEASE);
        return rc;
    }

    /* 撃たずに動いたあと、L+R を押したとき: 値が動いたものだけ残す。 */
    void ScanButton() {
        if (g_ScanStage < 1 || g_ScanStage > 3)
            return;
        if (__atomic_exchange_n(&g_ScanBusy, true, __ATOMIC_ACQUIRE))
            return;
        const int before = g_NCand;
        int k = 0;
        for (int i = 0; i < g_NCand; i++) {
            const uintptr_t a = g_Cand[i];
            if (!Readable(a, 12)) continue;
            const float* f = reinterpret_cast<const float*>(a);
            if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2])) continue;
            const float dx = f[0] - g_CandVal[i][0], dz = f[2] - g_CandVal[i][2];
            if (dx * dx + dz * dz < 9.0f) continue; /* 動いていない = 着弾点のコピーなど */
            if (f[0] > 300.0f || f[0] < -300.0f || f[2] > 300.0f || f[2] < -300.0f) continue;
            g_CandVal[k][0] = f[0]; g_CandVal[k][1] = f[1]; g_CandVal[k][2] = f[2];
            g_Cand[k++] = a;
        }
        g_NCand = k;
        g_ScanStage++;
        const float zero[3] = {};
        WriteScanFile(g_ScanRef, zero, before);
        if (g_NCand == 0)
            g_ScanStage = 0;
        __atomic_store_n(&g_ScanBusy, false, __ATOMIC_RELEASE);
    }

    /* ---- 診断4: L+R を押した瞬間の内部状態を書き出す ---- */
    u8 g_StatBuf[0x200];
    int g_StatCount = 0;
    u32 WriteStatus(u64 flags, const float* tmplPos) {
        if (g_StatCount >= 12) return 9;
        g_StatCount++;
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return 1;
        using MountFn  = u32 (*)(const char*);
        using CreateFn = u32 (*)(const char*, s64);
        using OpenFn   = u32 (*)(FileHandle*, const char*, int);
        using WriteFn  = u32 (*)(FileHandle, s64, const void*, u64, const s32*);
        using FlushFn  = u32 (*)(FileHandle);
        using CloseFn  = void (*)(FileHandle);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0)
                rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return 2;
            g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        }
        std::memset(g_StatBuf, 0, sizeof(g_StatBuf));
        u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t));
        u64* hd = reinterpret_cast<u64*>(g_StatBuf);
        hd[0] = 0x31545441534B4Eull; /* "NKSTAT1" */
        hd[1] = t;
        hd[2] = flags;
        hd[3] = static_cast<u64>(g_ScanRuns);
        hd[4] = g_PosObj;
        hd[5] = g_LivePos;
        hd[6] = static_cast<u64>(g_LiveCount);
        hd[7] = static_cast<u64>(static_cast<s64>(g_Cursor));
        hd[8] = g_LastMgr;
        hd[9] = g_TlsCb; hd[10] = g_TlsFocus; hd[11] = g_TlsPop; hd[12] = g_TlsHid; hd[13] = ReadTls();
        hd[14] = g_CntCb; hd[15] = g_CntFocus; hd[16] = g_CntPop; hd[17] = g_TlsFrame; hd[18] = g_CntFrame;
        hd[0x20] = g_TmplA2; hd[0x21] = g_BaseA2; hd[0x22] = static_cast<u64>(g_OriginSrc); hd[0x23] = static_cast<u64>(g_PressCount);
        for (int k = 0; k < 4; k++) hd[0x24 + k] = (flags == 0xA00) ? g_FlyDiag[k] : g_CandAddr[k];
        std::memcpy(g_StatBuf + 0x140, g_Origin, 12);
        std::memcpy(g_StatBuf + 0x150, g_LastHit, 12);
        hd[0x2c] = g_HaveLastHit ? 1 : 0;
        hd[0x13] = g_ImgDiag;
        hd[0x0f] = static_cast<u64>(g_GenkiFail) | (static_cast<u64>(g_GenkiPrev) << 32);
        hd[0x0e] = g_RespawnDiag; hd[0x0d] = g_DamageObj;
        hd[0x11] = nvnhook::g_Presents | (static_cast<u64>(nvnhook::g_Flags) << 56);
        hd[0x10] = static_cast<u64>(static_cast<u32>(nvnhook::g_TexFmtPub));
        hd[0x12] = static_cast<u64>(g_PchDiag) | (static_cast<u64>(g_PchN) << 32) | (static_cast<u64>(g_PchApplied ? 1 : 0) << 48) | (static_cast<u64>(g_ModeOn ? 1 : 0) << 49);
        hd[0x2d] = 0x3934314D4152ull; /* "FRAM91" */
        std::memcpy(g_StatBuf + 0x170, g_Tmpl.raw, kReqSize);
        { u32 ob; std::memcpy(&ob, &g_CamOff, 4); hd[0x3e] = static_cast<u64>(ob); }
        hd[0x3a] = g_RiseTicks; hd[0x3b] = g_CamPos; hd[0x3c] = static_cast<u64>(g_CamHits); hd[0x3d] = g_BtnSeen;
        {
            u32 b1 = 0, b2 = 0;
            if (g_LivePos && Readable(g_LivePos, 0x10)) std::memcpy(&b1, reinterpret_cast<const void*>(g_LivePos + 4), 4);
            if (g_CamPos && Readable(g_CamPos, 0x20)) std::memcpy(&b2, reinterpret_cast<const void*>(g_CamPos + 4), 4);
            hd[0x3f] = static_cast<u64>(b1) | (static_cast<u64>(b2) << 32);
        }
        std::memcpy(g_StatBuf + 0xA0, tmplPos, 12);
        std::memcpy(g_StatBuf + 0xB0, g_PosCopy, 12);
        std::memcpy(g_StatBuf + 0xD0, g_LiveCands, sizeof(g_LiveCands));
        if (g_LivePos && Readable(g_LivePos, 12))
            std::memcpy(g_StatBuf + 0xC0, reinterpret_cast<const void*>(g_LivePos), 12);
        char name[48];
        const char* p = "inkd:/inkdraw/bin/inkstat_"; char* q = name;
        while (*p) *q++ = *p++;
        for (int i = 7; i >= 0; i--) *q++ = "0123456789abcdef"[(static_cast<u32>(t >> 4) >> (i * 4)) & 15];
        *q++ = '.'; *q++ = 'b'; *q++ = 'i'; *q++ = 'n'; *q = 0;
        const auto create = reinterpret_cast<CreateFn>(sdk + kSdkCreateFile);
        const auto open   = reinterpret_cast<OpenFn>(sdk + kSdkOpenFile);
        const auto write  = reinterpret_cast<WriteFn>(sdk + kSdkWriteFile);
        const auto flush  = reinterpret_cast<FlushFn>(sdk + kSdkFlushFile);
        const auto close  = reinterpret_cast<CloseFn>(sdk + kSdkCloseFile);
        if (create(name, static_cast<s64>(sizeof(g_StatBuf))) != 0) return 3;
        FileHandle fh { nullptr };
        if (open(&fh, name, 2) != 0) return 4;
        const s32 opt = 0;
        const u32 wr = write(fh, 0, g_StatBuf, sizeof(g_StatBuf), &opt);
        flush(fh);
        close(fh);
        return wr == 0 ? 0 : 5;
    }


    /* ---- 自分のプレイヤー番号 ----------------------------------------------------- */
    /* 塗り要求の先頭1バイト (+0x00) = プレイヤー番号 (0〜7)。実行側が 0xF0 バイト刻みのプレイヤー表を引いて色を決める (逆アセンブルで確認)。
       ステージの仕掛けの塗りは 9 などで、プレイヤーに結びつかず、敵の色になる。
       撃たずに自分の色で描くには、この番号を自分のものにすればよい。 */
    constexpr uintptr_t kPlayerTableSlot = 0x5F1D698; /* main 先頭からのオフセット: 表の管理者を指す変数へのポインタ */
    constexpr uintptr_t kPlayerStride    = 0xF0;
    constexpr uintptr_t kPlayerObjOff    = 0x298;
    constexpr int       kDefaultLocalIdx = 1;         /* 手がかりが何もないときの仮の番号 (この部屋で撃ったときの番号) */
    int       g_LocalIdx = kDefaultLocalIdx;
    int       g_IdxSrc = 0;                           /* 0 = 仮の値 / 1 = 自分で撃った塗りから / 2 = 座標の探索から */
    bool      g_HaveIdx = false;                      /* 自分で撃った塗りから番号が分かったか */
    uintptr_t g_PlrObj[8] = {};
    s32       g_PlrReg[8] = {};
    s32       g_PlrOff[8] = {};
    uintptr_t g_PlrBase = 0;

    uintptr_t PlayerTableBase() {
        const uintptr_t slot = MainBase() + kPlayerTableSlot;
        if (!Readable(slot, 8)) return 0;
        const uintptr_t g = *reinterpret_cast<const uintptr_t*>(slot);
        if (!Readable(g, 8)) return 0;
        const uintptr_t m = *reinterpret_cast<const uintptr_t*>(g);
        if (!Readable(m, 16)) return 0;
        const uintptr_t base = *reinterpret_cast<const uintptr_t*>(m + 8);
        if (!Readable(base, 8 * kPlayerStride)) return 0;
        return base;
    }

    /* 足元の座標 (live) を持っているプレイヤーを探す。見つかれば番号、なければ -1。 */
    int FindLocalIdx() {
        std::memset(g_PlrObj, 0, sizeof(g_PlrObj));
        std::memset(g_PlrReg, 0, sizeof(g_PlrReg));
        std::memset(g_PlrOff, 0, sizeof(g_PlrOff));
        g_PlrBase = PlayerTableBase();
        if (!g_PlrBase || !LiveValid()) return -1;
        float lp[3];
        std::memcpy(lp, reinterpret_cast<const void*>(g_LivePos), 12);
        int found = -1, nfound = 0;
        for (int idx = 0; idx < 8; idx++) {
            const uintptr_t ent = g_PlrBase + idx * kPlayerStride;
            const uintptr_t obj = *reinterpret_cast<const uintptr_t*>(ent + kPlayerObjOff);
            g_PlrObj[idx] = obj;
            s32 region = -2, off = 0;
            if (obj) {
                region = -3;
                if (Readable(obj, kObjFloats * 4)) {
                    region = -1;
                    auto search = [&](const float* f, size_t n, s32 reg) -> bool {
                        for (size_t k = 0; k + 2 < n; k++) {
                            const float a = f[k] - lp[0];
                            if (!(a > -0.5f && a < 0.5f)) continue;
                            const float b = f[k + 1] - lp[1], c = f[k + 2] - lp[2];
                            const float b2 = f[k + 1] - lp[2], c2 = f[k + 2] - lp[1];
                            if ((b > -0.5f && b < 0.5f && c > -0.5f && c < 0.5f) ||
                                (b2 > -0.5f && b2 < 0.5f && c2 > -0.5f && c2 < 0.5f)) {
                                region = reg; off = static_cast<s32>(k);
                                return true;
                            }
                        }
                        return false;
                    };
                    if (!search(reinterpret_cast<const float*>(obj), kObjFloats, 0)) {
                        for (int j = 0; j < kPtrFields; j++) {
                            const uintptr_t tp = *reinterpret_cast<const uintptr_t*>(obj + 8 * j);
                            if (tp < 0x10000 || (tp & 3) || !Readable(tp, kSubFloats * 4)) continue;
                            if (search(reinterpret_cast<const float*>(tp), kSubFloats, j + 1)) break;
                        }
                    }
                }
            }
            g_PlrReg[idx] = region; g_PlrOff[idx] = off;
            if (region >= 0) { found = idx; nfound++; }
        }
        return nfound == 1 ? found : -1; /* 1人だけ見つかったときだけ信じる */
    }

    /* ---- 診断5: プレイヤー表の探索結果と、表の中身を書き出す --------------------------- */
    u8 g_PlrBuf[0x300];
    int g_PlrCount = 0;
    u32 WritePlayers() {
        if (g_PlrCount >= 12) return 9;
        g_PlrCount++;
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return 1;
        using MountFn  = u32 (*)(const char*);
        using CreateFn = u32 (*)(const char*, s64);
        using OpenFn   = u32 (*)(FileHandle*, const char*, int);
        using WriteFn  = u32 (*)(FileHandle, s64, const void*, u64, const s32*);
        using FlushFn  = u32 (*)(FileHandle);
        using CloseFn  = void (*)(FileHandle);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0)
                rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return 2;
            g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        }
        std::memset(g_PlrBuf, 0, sizeof(g_PlrBuf));
        u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t));
        u64* hd = reinterpret_cast<u64*>(g_PlrBuf);
        hd[0] = 0x32524C504B4E49ull; /* "INKPLR2" */
        hd[1] = t;
        hd[2] = MainBase() + kPlayerTableSlot;
        hd[3] = g_PlrBase;
        hd[4] = static_cast<u64>(g_LocalIdx);
        hd[5] = static_cast<u64>(g_IdxSrc);
        hd[6] = g_HaveIdx ? 1 : 0;
        hd[7] = LiveValid() ? 1 : 0;
        if (LiveValid()) std::memcpy(g_PlrBuf + 0x40, reinterpret_cast<const void*>(g_LivePos), 12);
        for (int idx = 0; idx < 8; idx++) {
            u8* e = g_PlrBuf + 0x50 + 0x40 * idx; /* 1人分: 0x40 バイト */
            std::memcpy(e, &g_PlrObj[idx], 8);
            std::memcpy(e + 8, &g_PlrReg[idx], 4);
            std::memcpy(e + 12, &g_PlrOff[idx], 4);
            if (g_PlrBase && Readable(g_PlrBase + idx * kPlayerStride, 0x30))
                std::memcpy(e + 16, reinterpret_cast<const void*>(g_PlrBase + idx * kPlayerStride), 0x30); /* 表の1件の先頭 */
        }
        char name[48];
        const char* pn = "inkd:/inkdraw/bin/inkplr_"; char* q = name;
        while (*pn) *q++ = *pn++;
        for (int i = 7; i >= 0; i--) *q++ = "0123456789abcdef"[(static_cast<u32>(t >> 4) >> (i * 4)) & 15];
        *q++ = '.'; *q++ = 'b'; *q++ = 'i'; *q++ = 'n'; *q = 0;
        const auto create = reinterpret_cast<CreateFn>(sdk + kSdkCreateFile);
        const auto open   = reinterpret_cast<OpenFn>(sdk + kSdkOpenFile);
        const auto write  = reinterpret_cast<WriteFn>(sdk + kSdkWriteFile);
        const auto flush  = reinterpret_cast<FlushFn>(sdk + kSdkFlushFile);
        const auto close  = reinterpret_cast<CloseFn>(sdk + kSdkCloseFile);
        if (create(name, static_cast<s64>(sizeof(g_PlrBuf))) != 0) return 3;
        FileHandle fh { nullptr };
        if (open(&fh, name, 2) != 0) return 4;
        const s32 opt = 0;
        const u32 wr = write(fh, 0, g_PlrBuf, sizeof(g_PlrBuf), &opt);
        flush(fh);
        close(fh);
        return wr == 0 ? 0 : 5;
    }

    /* ---- 追跡スキャン: 足元の座標 (live) に追従する値を全部集めて、書き換えが戻されるか調べる ---------- */
    constexpr int   kMaxTrk  = 4096;
    constexpr int   kTrkFile = 1024;
    constexpr float kTrkTolH = 1.5f, kTrkTolV = 3.5f, kTrkMove = 3.0f;
    uintptr_t g_Trk[kMaxTrk];
    float     g_TrkVal[kMaxTrk][3];
    float     g_TrkAfter[kMaxTrk][3];
    u8        g_TrkFlag[kMaxTrk];
    int       g_NTrk = 0, g_TrkStage = 0, g_ProbeState = 0, g_TrkOverflow = 0, g_TrkFiles = 0;
    bool TrkReady() { return g_TrkStage == 3; }
    int       g_ForceGlyph = 0;  /* 1 = 笑顔 / 2 = 四角 / 3 = X / 4 = 十字 : 進み具合の合図 */
    u8        g_TrkBuf[0x100 + kTrkFile * 40];
    int   g_Act[kMaxTrk];
    float g_TestOrig[kMaxTrk];
    uintptr_t g_M[32]; int g_MN = 0, g_MSel = -1;
    float g_BandL1 = 0.0f; int g_BandMode = 0, g_BandNo = 0, g_Banded = 0;
    int   g_Par[kMaxTrk]; int g_NPar = 0, g_SplitState = 0;
    int   g_NAct = 0, g_TestN = 0, g_TestFrames = 0, g_TestState = 0, g_Master = -1;

    ALWAYS_INLINE bool TrkNear(const float* c, const float* L) {
        const float dx = c[0] - L[0], dy = c[1] - L[1], dz = c[2] - L[2];
        return dx > -kTrkTolH && dx < kTrkTolH && dz > -kTrkTolH && dz < kTrkTolH && dy > -kTrkTolV && dy < kTrkTolV;
    }
    bool TrkWritable(uintptr_t a) {
        MemoryInfo mi; u32 pg;
        return R_SUCCEEDED(svcQueryMemory(&mi, &pg, a)) && (mi.perm & Perm_R) && !(mi.attr & 0xC) /* 端末共有・キャッシュなしの領域は読まない (GPU 用で、読むと落ちる) */ && (mi.perm & Perm_W) && a + 12 <= mi.addr + mi.size;
    }

    /* 領域を 64KB ずつ、そのつど「いま読めるか」を調べ直しながら走査する (走査中にゲームが領域を手放すと落ちるため)。
       fn(w, from, to): 開始位置が from 以上 to 未満の範囲では、w[idx .. idx+over) を読んでよい。 */
    template <class F> static void ScanSafe(uintptr_t base, size_t words, size_t over, F&& fn) {
        const u32* w = reinterpret_cast<const u32*>(base);
        size_t i = 0;
        { MemoryInfo m0; u32 p0; if (R_SUCCEEDED(svcQueryMemory(&m0, &p0, base)) && m0.size == 0x1741000ull && m0.addr == base && words * 4 > 0x1400000ull) words = 0x1400000ull / 4; } /* 後ろの方に読むと落ちる部分がある領域は、前の 20MB だけ */
        while (i + over <= words) {
            MemoryInfo m2; u32 pg2;
            const uintptr_t ca = base + i * 4;
            if (R_FAILED(svcQueryMemory(&m2, &pg2, ca)) || !(m2.perm & Perm_R) || (m2.attr & 0xC)) return;
            if (m2.size == 0x1741000ull && ca >= m2.addr + 0x1400000ull) return; /* 後ろの方に読むと落ちる部分がある領域: どこから調べはじめても、その部分は読まない */
            const uintptr_t cend = m2.addr + m2.size;
            uintptr_t lim = ca + 0x1000; if (lim > cend) lim = cend; /* 4KB ごと (裏の流れで探していて、ゲームが手放した所を読んで落ちたため細かく) */ /* 16KB ごとに読めるか確かめ直す (ゲームが走査中にメモリを解放して落ちるのを減らす) */
            const size_t avail = (lim - ca) / 4;
            if (avail < over) { if (lim >= cend) return; i += avail ? avail : 1; continue; }
            size_t cnt = avail - over + 1;
            const size_t most = words - over + 1 - i; if (cnt > most) cnt = most;
            fn(w, i, i + cnt);
            i += cnt;
        }
    }
    /* 名前をリアルタイムで入れ替える: ゲームの中にある今の名前 (UTF-8 / UTF-16) を探して、新しい名前に書き換える。
       探すのは重いので、見つけた場所は覚えておき、次からはそこだけ書き換える。 */
    static int U8To16(const char* s8, unsigned short* o, int lim) {
        int n = 0;
        for (const unsigned char* q = reinterpret_cast<const unsigned char*>(s8); *q && n < lim;) {
            unsigned c = *q;
            if (c < 0x80) { q += 1; } else if ((c >> 5) == 6 && q[1]) { c = ((c & 0x1F) << 6) | (q[1] & 0x3F); q += 2; } else if ((c >> 4) == 14 && q[1] && q[2]) { c = ((c & 0x0F) << 12) | ((q[1] & 0x3F) << 6) | (q[2] & 0x3F); q += 3; } else { q += 1; continue; }
            o[n++] = static_cast<unsigned short>(c);
        }
        o[n] = 0; return n;
    }
    void NameLive(const char* cur, const char* nw) {
        static uintptr_t h8[24], h16[24]; static int n8 = 0, n16 = 0; static u64 lastScan = 0;
        const int l8 = static_cast<int>(std::strlen(cur)), nl8 = static_cast<int>(std::strlen(nw));
        unsigned short c16[40], w16[40]; const int l16 = U8To16(cur, c16, 36), nl16 = U8To16(nw, w16, 36);
        if (l8 < 4 || l16 < 2) return;
        auto put8 = [&](uintptr_t a) -> bool {
            if (!Writable(a, 40)) return false;
            u8* q = reinterpret_cast<u8*>(a);
            if (std::memcmp(q, cur, static_cast<size_t>(l8) + 1) != 0) return false;
            int cap = l8 + 1; while (cap < 33 && q[cap] == 0) cap++;
            int w = nl8; if (w > cap - 1) { w = cap - 1; while (w > 0 && (static_cast<u8>(nw[w]) & 0xC0) == 0x80) w--; }
            for (int i = 0; i < w; i++) q[i] = static_cast<u8>(nw[i]);
            for (int i = w; i < cap; i++) q[i] = 0;
            return true;
        };
        auto put16 = [&](uintptr_t a) -> bool {
            if (!Writable(a, 48)) return false;
            unsigned short* q = reinterpret_cast<unsigned short*>(a);
            if (std::memcmp(q, c16, (static_cast<size_t>(l16) + 1) * 2) != 0) return false;
            int cap = l16 + 1; while (cap < 17 && q[cap] == 0) cap++;
            int w = nl16 < cap - 1 ? nl16 : cap - 1;
            for (int i = 0; i < w; i++) q[i] = w16[i];
            for (int i = w; i < cap; i++) q[i] = 0;
            return true;
        };
        int ok = 0;
        for (int i = 0; i < n8; i++) if (put8(h8[i])) ok++;
        for (int i = 0; i < n16; i++) if (put16(h16[i])) ok++;
        const u64 now = NowTick();
        if (ok > 0 || (lastScan && now - lastScan < 8ull * 19200000ull)) return;
        lastScan = now; n8 = 0; n16 = 0;
        MemoryInfo selfmi; u32 selfpg; uintptr_t selfLo = 0, selfHi = 0;
        if (R_SUCCEEDED(svcQueryMemory(&selfmi, &selfpg, reinterpret_cast<uintptr_t>(g_NameU8)))) { selfLo = selfmi.addr; selfHi = selfmi.addr + selfmi.size; }
        u32 f8 = 0, f16 = 0; std::memcpy(&f8, cur, 4); f16 = static_cast<u32>(c16[0]) | (static_cast<u32>(c16[1]) << 16);
        uintptr_t addr = 0;
        for (int guard = 0; guard < 8192; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool rok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC) && !(mi.addr >= selfLo && mi.addr < selfHi) && mi.size >= 0x100;
            if (rok) {
                ScanSafe(mi.addr, mi.size / 4, 12, [&](const u32* w, size_t from, size_t to) {
                    for (size_t i = from; i < to; i++) {
                        const u32 v = w[i];
                        if (v != f8 && v != f16) continue;
                        const uintptr_t a = reinterpret_cast<uintptr_t>(w + i);
                        if (v == f8 && n8 < 24 && std::memcmp(w + i, cur, static_cast<size_t>(l8) + 1) == 0) h8[n8++] = a;
                        else if (v == f16 && n16 < 24 && std::memcmp(w + i, c16, (static_cast<size_t>(l16) + 1) * 2) == 0) h16[n16++] = a;
                    }
                });
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
        for (int i = 0; i < n8; i++) put8(h8[i]);
        for (int i = 0; i < n16; i++) put16(h16[i]);
    }
    int g_TcNW = 0, g_TcOther = 0, g_TcWide = 0, g_TcRuns = 0;
    volatile bool g_TrkPend = false, g_TrkBgDone = false; float g_TrkRef[3] = {}; /* 写し集めを裏の流れに頼んでいる */
    void TrkCollect(const float* L) {
        g_NTrk = 0; g_TrkOverflow = 0; g_TcNW = 0; g_TcOther = 0; g_TcWide = 0; g_TcRuns++;
        MemoryInfo selfmi; u32 selfpg;
        uintptr_t selfLo = 0, selfHi = 0;
        if (R_SUCCEEDED(svcQueryMemory(&selfmi, &selfpg, reinterpret_cast<uintptr_t>(&g_NTrk)))) { selfLo = selfmi.addr; selfHi = selfmi.addr + selfmi.size; }
        uintptr_t addr = 0;
        for (int guard = 0; guard < 8192; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9)
                         && (mi.perm & Perm_R) && !(mi.attr & 0xC) /* 端末共有・キャッシュなしの領域は読まない (GPU 用で、読むと落ちる) */ && (mi.perm & Perm_W) && !(mi.addr >= selfLo && end <= selfHi && selfHi);
            if (ok && mi.size >= 16) {
                const float* f = reinterpret_cast<const float*>(mi.addr);
                const size_t n = mi.size / 4 - 3;
                const float lo = L[0] - kTrkTolH, hi = L[0] + kTrkTolH;
                ScanSafe(mi.addr, mi.size / 4, 3, [&](const u32*, size_t from, size_t to) {
                    if (g_TrkOverflow) return;
                    for (size_t i = from; i < to; i++) {
                        const float a = f[i];
                        if (!(a >= lo && a <= hi)) continue;
                        const float* c = f + i;
                        if (!(c[1] == c[1] && c[2] == c[2])) continue;
                        if (!TrkNear(c, L)) continue;
                        if (reinterpret_cast<uintptr_t>(c) == g_LivePos) continue;
                        if (g_NTrk >= kMaxTrk) { g_TrkOverflow = 1; return; }
                        g_Trk[g_NTrk] = reinterpret_cast<uintptr_t>(c);
                        std::memcpy(g_TrkVal[g_NTrk], c, 12);
                        g_NTrk++;
                    }
                });
                (void)n;
            }
            if (g_TrkOverflow) break;
            if (end <= addr || end == 0) break;
            addr = end;
        }
    }

    void TrkFilter(const float* L) {
        int k = 0;
        for (int i = 0; i < g_NTrk; i++) {
            const uintptr_t a = g_Trk[i];
            if (!Readable(a, 12)) continue;
            const float* c = reinterpret_cast<const float*>(a);
            if (!(c[0] == c[0] && c[1] == c[1] && c[2] == c[2])) continue;
            if (!TrkNear(c, L)) continue;
            const float mx = c[0] - g_TrkVal[i][0], mz = c[2] - g_TrkVal[i][2];
            if (mx * mx + mz * mz < kTrkMove * kTrkMove) continue; /* 動いていない = 追従していない */
            g_Trk[k] = a;
            std::memcpy(g_TrkVal[k], c, 12);
            k++;
        }
        g_NTrk = k;
    }

    u32 WriteTrkFile(int kind) {
        if (g_TrkFiles >= 16) return 9;
        g_TrkFiles++;
        const uintptr_t sdk = exl::util::HasModule(exl::util::ModuleIndex::Sdk)
            ? exl::util::GetModuleInfo(exl::util::ModuleIndex::Sdk).m_Total.m_Start : 0;
        if (!sdk) return 1;
        using MountFn  = u32 (*)(const char*);
        using CreateFn = u32 (*)(const char*, s64);
        using OpenFn   = u32 (*)(FileHandle*, const char*, int);
        using WriteFn  = u32 (*)(FileHandle, s64, const void*, u64, const s32*);
        using FlushFn  = u32 (*)(FileHandle);
        using CloseFn  = void (*)(FileHandle);
        if (!g_DumpMounted) {
            u32 rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCard)(kMountName);
            if (rc != 0)
                rc = reinterpret_cast<MountFn>(sdk + kSdkMountSdCardDbg)(kMountName);
            if (rc != 0) return 2;
            g_DumpMounted = true; { using DirFn = u32 (*)(const char*); const auto mk = reinterpret_cast<DirFn>(sdk + 0xAA010); mk("inkd:/inkdraw"); mk("inkd:/inkdraw/bin"); }
        }
        std::memset(g_TrkBuf, 0, sizeof(g_TrkBuf));
        u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t));
        u64* hd = reinterpret_cast<u64*>(g_TrkBuf);
        hd[0] = 0x314B52544B4E49ull; /* "INKTRK1" */
        hd[1] = t;
        hd[2] = static_cast<u64>(kind);          /* 1 = 最終候補 / 2 = 書き換え実験の結果 */
        hd[3] = static_cast<u64>(g_NTrk);
        hd[4] = static_cast<u64>(g_TrkStage);
        hd[5] = static_cast<u64>(g_TrkOverflow);
        hd[6] = g_LivePos;
        hd[7] = MainBase();
        if (g_LivePos && Readable(g_LivePos, 12)) std::memcpy(g_TrkBuf + 0x40, reinterpret_cast<const void*>(g_LivePos), 12);
        int n = g_NTrk < kTrkFile ? g_NTrk : kTrkFile;
        size_t sz;
        if (kind == 3) {
            /* 絞り込んだ1つの前後 0x400 バイトを書き出す (どんな構造の中にあるか調べるため) */
            n = 0;
            const uintptr_t m = (g_Master >= 0) ? g_Trk[g_Master] : 0;
            hd[8] = m;
            const uintptr_t start = (m & ~3ull) - 0x200;
            if (m && Readable(start, 0x400)) std::memcpy(g_TrkBuf + 0x100, reinterpret_cast<const void*>(start), 0x400);
            sz = 0x100 + 0x400;
        } else if (kind == 5) {
            /* プレイヤー表から、ポインタを幅優先でたどって、足元の座標の近くの座標 (x,y,z) を探す。見つけた経路を書き出す。 */
            n = 0;
            static uintptr_t nodeAddr[6000]; static s32 nodeParent[6000]; static u16 nodePoff[6000];
            static uintptr_t hashTab[8192];
            std::memset(hashTab, 0, sizeof(hashTab));
            int nn = 0, nm = 0;
            g_MN = 0; g_MSel = -1;
            float Lp[3] = {};
            if (g_LivePos && Readable(g_LivePos, 12)) std::memcpy(Lp, reinterpret_cast<const void*>(g_LivePos), 12);
            hd[8] = g_LivePos;
            const uintptr_t mb = MainBase();
            auto visit = [&](uintptr_t a, s32 par, u16 po) -> void {
                if (nn >= 6000) return;
                const size_t h0 = ((a >> 4) * 0x9E3779B1ull) & 8191;
                for (size_t k = 0; k < 8192; k++) {
                    const size_t h = (h0 + k) & 8191;
                    if (hashTab[h] == a) return;
                    if (hashTab[h] == 0) { hashTab[h] = a; break; }
                }
                nodeAddr[nn] = a; nodeParent[nn] = par; nodePoff[nn] = po; nn++;
            };
            if (g_PlrBase) for (int idx = 0; idx < 8; idx++) visit(g_PlrBase + idx * kPlayerStride, -1, 0);
            for (int cur = 0; cur < nn && nm < 32; cur++) {
                const uintptr_t a = nodeAddr[cur];
                if (!Readable(a, 0x400)) continue;
                const float* f = reinterpret_cast<const float*>(a);
                for (int k = 0; k + 2 < 0x400 / 4 && nm < 32; k++) {
                    const float dx = f[k] - Lp[0];
                    if (!(dx > -3.0f && dx < 3.0f)) continue;
                    const float dz = f[k + 2] - Lp[2], dy = f[k + 1] - Lp[1];
                    if (!(dz > -3.0f && dz < 3.0f && dy > -6.0f && dy < 6.0f)) continue;
                    u8* e = g_TrkBuf + 0x100 + 0xA0 * nm;
                    const u64 ma = a + 4 * k;
                    std::memcpy(e, &ma, 8);
                    u64 depth = 0; int c2 = cur;
                    while (c2 >= 0 && depth < 8) {
                        const u64 na = nodeAddr[c2], po = nodePoff[c2];
                        std::memcpy(e + 16 + 16 * depth, &na, 8);
                        std::memcpy(e + 24 + 16 * depth, &po, 8);
                        depth++; c2 = nodeParent[c2];
                    }
                    std::memcpy(e + 8, &depth, 8);
                    {
                        bool dup = false;
                        for (int q2 = 0; q2 < g_MN; q2++) if (g_M[q2] == ma) { dup = true; break; }
                        if (!dup && g_MN < 32) g_M[g_MN++] = ma;
                    }
                    nm++;
                }
                const u64* q = reinterpret_cast<const u64*>(a);
                for (int k = 0; k < 0x400 / 8; k++) {
                    const u64 v = q[k];
                    if (v < 0x100000 || (v & 7) || (v >= mb && v < mb + 0x7000000)) continue;
                    if (v > 0x7fffffffffull) continue;
                    if (Readable(v, 8)) visit(v, cur, static_cast<u16>(k * 8));
                }
            }
            hd[9] = static_cast<u64>(nm);
            hd[10] = static_cast<u64>(nn);
            {
                /* 左キー3回で絞った候補 (体と一緒に動く値) のうち、表からたどれる塊の中にあるものを選ぶ */
                int nr2 = 0;
                static uintptr_t reach[32];
                if (g_TrkStage == 3) {
                    for (int i = 0; i < g_NTrk && nr2 < 32; i++) {
                        const uintptr_t sa = g_Trk[i];
                        for (int j = 0; j < nn; j++) {
                            if (sa >= nodeAddr[j] && sa + 12 <= nodeAddr[j] + 0x400) { reach[nr2++] = sa; break; }
                        }
                    }
                }
                hd[11] = static_cast<u64>(nr2);
                hd[12] = static_cast<u64>(g_NTrk);
                if (nr2 > 0) { g_MN = 0; for (int i = 0; i < nr2; i++) g_M[g_MN++] = reach[i]; }
            }
            std::memcpy(g_TrkBuf + 0x100 + 0xA0 * 32, g_M, sizeof(g_M));
            sz = 0x100 + 0xA0 * 32 + 0x100;
        } else if (kind == 4) {
            /* 生きた座標の前後 0x800 バイトと、その近くを指しているポインタの一覧 (誰がこの塊を持っているか調べる) */
            n = 0;
            const uintptr_t c = g_LivePos;
            const uintptr_t lo = (c & ~7ull) - 0x200, hi = (c & ~7ull) + 0x100;
            hd[8] = c;
            const uintptr_t start = (c & ~7ull) - 0x400;
            if (c && Readable(start, 0x800)) std::memcpy(g_TrkBuf + 0x100, reinterpret_cast<const void*>(start), 0x800);
            MemoryInfo selfmi; u32 selfpg;
            uintptr_t selfLo = 0, selfHi = 0;
            if (R_SUCCEEDED(svcQueryMemory(&selfmi, &selfpg, reinterpret_cast<uintptr_t>(&g_NTrk)))) { selfLo = selfmi.addr; selfHi = selfmi.addr + selfmi.size; }
            int nr = 0;
            uintptr_t addr = 0;
            for (int guard = 0; guard < 8192 && nr < 40 && c; guard++) {
                MemoryInfo mi; u32 page;
                if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
                const uintptr_t end = mi.addr + mi.size;
                const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9)
                             && (mi.perm & Perm_R) && !(mi.attr & 0xC) /* 端末共有・キャッシュなしの領域は読まない (GPU 用で、読むと落ちる) */ && (mi.perm & Perm_W) && !(mi.addr >= selfLo && end <= selfHi && selfHi);
                if (ok && mi.size >= 16) {
                    const u64* q = reinterpret_cast<const u64*>(mi.addr);
                    const size_t cnt = mi.size / 8;
                    for (size_t i = 0; i < cnt && nr < 40; i++) {
                        const u64 v = q[i];
                        if (v < lo || v >= hi) continue;
                        const uintptr_t ha = mi.addr + i * 8;
                        if (ha >= start && ha < start + 0x800) continue;
                        u8* e = g_TrkBuf + 0x900 + 0x80 * nr;
                        std::memcpy(e, &ha, 8);
                        std::memcpy(e + 8, &v, 8);
                        const uintptr_t cs = ha - 0x30;
                        if (cs >= mi.addr && cs + 0x70 <= end) std::memcpy(e + 16, reinterpret_cast<const void*>(cs), 0x70);
                        nr++;
                    }
                }
                if (end <= addr || end == 0) break;
                addr = end;
            }
            hd[9] = static_cast<u64>(nr);
            sz = 0x900 + 0x80 * 40;
        } else {
            for (int i = 0; i < n; i++) {
                u8* e = g_TrkBuf + 0x100 + 40 * i;
                std::memcpy(e, &g_Trk[i], 8);
                std::memcpy(e + 8, g_TrkVal[i], 12);
                std::memcpy(e + 20, g_TrkAfter[i], 12);
                std::memcpy(e + 32, &g_TrkFlag[i], 1);
            }
            sz = 0x100 + static_cast<size_t>(n) * 40;
        }
        char name[48];
        const char* pn = "inkd:/inkdraw/bin/inktrk_"; char* q = name;
        while (*pn) *q++ = *pn++;
        for (int i = 7; i >= 0; i--) *q++ = "0123456789abcdef"[(static_cast<u32>(t >> 4) >> (i * 4)) & 15];
        *q++ = '.'; *q++ = 'b'; *q++ = 'i'; *q++ = 'n'; *q = 0;
        const auto create = reinterpret_cast<CreateFn>(sdk + kSdkCreateFile);
        const auto open   = reinterpret_cast<OpenFn>(sdk + kSdkOpenFile);
        const auto write  = reinterpret_cast<WriteFn>(sdk + kSdkWriteFile);
        const auto flush  = reinterpret_cast<FlushFn>(sdk + kSdkFlushFile);
        const auto close  = reinterpret_cast<CloseFn>(sdk + kSdkCloseFile);
        if (create(name, static_cast<s64>(sz)) != 0) return 3;
        FileHandle fh { nullptr };
        if (open(&fh, name, 2) != 0) return 4;
        const s32 opt = 0;
        const u32 wr = write(fh, 0, g_TrkBuf, sz, &opt);
        flush(fh);
        close(fh);
        return wr == 0 ? 0 : 5;
    }

    void CamFind();
    /* 十字キー左を押すたびに1歩進める。合図: 十字 = 集めた / 四角 = 1回絞った / 笑顔 = 最終候補を書き出した / X = 0件 */
    void TrkStep() {
        if (g_TrkStage == 3 && g_BandMode) {
            g_BandMode = 0; g_Banded = 1; g_ForceGlyph = 4; g_Armed = true;
            if (g_NAct == 1) { g_Master = g_Act[0]; WriteTrkFile(3); g_ForceGlyph = 1; }
            return;
        }
        if (g_TrkStage == 3 && g_SplitState != 0) {
            /* 今の半分を確定する。1つになったら、周りを書き出して笑顔。 */
            g_SplitState = 0;
            g_ForceGlyph = 4; g_Armed = true;
            if (g_NAct == 1) { g_Master = g_Act[0]; WriteTrkFile(3); g_ForceGlyph = 1; }
            return;
        }
        if (!LiveValid()) { g_LivePos = 0; g_LiveAlt = false; FindLivePos(nullptr); TryLiveAlt(); }
        if (!LiveValid()) { g_ForceGlyph = 3; g_Armed = true; return; }
        float L[3];
        std::memcpy(L, reinterpret_cast<const void*>(g_LivePos), 12);
        if (g_TrkStage == 0 || g_TrkStage >= 3) {
            if (g_TrkPend) { if (!g_TrkBgDone) return; g_TrkPend = false; } /* 裏で集め終わるまで待つ (ゲームは止めない) */
            else { std::memcpy(g_TrkRef, L, 12); g_TrkBgDone = false; if (BgRequest(32u, nullptr)) { g_TrkPend = true; return; } TrkCollect(L); }
            g_TrkStage = 1;
            g_ForceGlyph = g_NTrk > 0 ? 4 : 3;
            if (g_NTrk == 0) g_TrkStage = 0;
        } else if (g_TrkStage == 1) {
            TrkFilter(L);
            g_TrkStage = 2;
            g_ForceGlyph = g_NTrk > 0 ? 2 : 3;
            if (g_NTrk == 0) g_TrkStage = 0;
        } else {
            TrkFilter(L);
            g_TrkStage = 3;
            /* カメラの塊 (前後 0x400 バイト) は候補から外す。体の座標だけを探すため。 */
            CamFind();
            if (g_CamHitN > 0) {
                int k = 0;
                for (int i = 0; i < g_NTrk; i++) {
                    bool skip = false;
                    for (int h = 0; h < g_CamHitN; h++) {
                        const uintptr_t lo = g_CamHitAddr[h] - 0x400, hi = g_CamHitAddr[h] + 0x400;
                        if (g_Trk[i] >= lo && g_Trk[i] < hi) { skip = true; break; }
                    }
                    if (skip) continue;
                    g_Trk[k] = g_Trk[i];
                    std::memcpy(g_TrkVal[k], g_TrkVal[i], 12);
                    k++;
                }
                g_NTrk = k;
            }
            std::memset(g_TrkAfter, 0, sizeof(g_TrkAfter));
            std::memset(g_TrkFlag, 0, sizeof(g_TrkFlag));
            if (g_NTrk > 0) WriteTrkFile(1);
            g_NAct = g_NTrk; g_Master = -1; g_TestState = 0; g_SplitState = 0;
            for (int i = 0; i < g_NTrk; i++) g_Act[i] = i;
            g_BandL1 = L[1]; g_BandMode = 0; g_BandNo = 0; g_Banded = 0;
            g_ForceGlyph = g_NTrk > 0 ? 1 : 3;
            if (g_NTrk == 0) g_TrkStage = 0;
        }
        g_Armed = true;
    }

    /* 二分探索: 十字キー右 = 候補の前半の高さを 0.5 秒だけ +6 にする。体が動いたら十字キー上、動かなければ下。 */

    /* 揺らしの書き込み。フレーム更新の前後の両方から呼ぶ (ゲームが読む前に値を置くため)。 */
    void TrkApplyWrites() {
        if (g_TestState != 1) return;
        for (int i = 0; i < g_TestN; i++) {
            const int idx = g_Act[i];
            const uintptr_t a = g_Trk[idx];
            if (!Readable(a, 12) || !TrkWritable(a)) continue;
            const float off = (g_TestFrames >= 40) ? 0.0f : (g_TestFrames <= 20 ? 2.0f : -2.0f);
            reinterpret_cast<float*>(a)[1] = g_TestOrig[idx] + off;
        }
    }

    void TrkBisect() {
        if (g_TestState == 2) {
            if (g_ReqYes || g_ReqNo) {
                const bool yes = g_ReqYes;
                g_ReqYes = false; g_ReqNo = false;
                if (yes) {
                    g_NAct = g_TestN;
                } else {
                    const int rest = g_NAct - g_TestN;
                    for (int i = 0; i < rest; i++) g_Act[i] = g_Act[g_TestN + i];
                    g_NAct = rest;
                }
                g_TestState = 0;
                g_ForceGlyph = yes ? 4 : 2; /* 十字 = 動いた側に絞った / 四角 = 動かない側を捨てた */
                g_Armed = true;
                if (g_NAct == 1) {
                    g_Master = g_Act[0];
                    WriteTrkFile(3);
                    g_ForceGlyph = 1;
                } else if (g_NAct <= 0) {
                    g_ForceGlyph = 3;
                    g_TrkStage = 0;
                }
            }
        } else {
            g_ReqYes = false; g_ReqNo = false;
        }
        if (g_ProbeState == 1) {
            g_ProbeState = 0;
            if (g_TestState == 0 && g_NAct > 1) {
                g_TestN = g_NAct / 2;
                for (int i = 0; i < g_TestN; i++) {
                    const int idx = g_Act[i];
                    g_TestOrig[idx] = 0.0f;
                    if (Readable(g_Trk[idx], 12)) g_TestOrig[idx] = reinterpret_cast<const float*>(g_Trk[idx])[1];
                }
                g_TestState = 1; g_TestFrames = 0;
            }
        }
        if (g_TestState == 1) {
            g_TestFrames++;
            TrkApplyWrites();
            if (g_TestFrames >= 45) g_TestState = 2;
        }
    }

    /* ---- カメラを上げる ------------------------------------------------------------- */
    bool CamSigAt(const u32* w) {
        float f0; std::memcpy(&f0, w, 4);
        return f0 > 20.0f && f0 < 130.0f && w[1] == 0x40e66666u && w[2] == 0x40d9999au && w[3] == 0x40800000u &&
               w[4] == 0x40100000u && w[5] == 0x40100000u && w[6] == 0x40300000u && w[7] == 0x3f800000u && w[8] == 0x3f000000u;
    }
    bool CamValid() { /* 裏の流れが途中でカメラの場所を 0 にして、表がそれを読んで落ちていた (0x20 番地)。場所は 1 回だけ読み、消すのは表の流れだけ */
        const uintptr_t cp = g_CamPos;
        if (!cp || !Readable(cp, 0x48)) return false;
        if (!CamSigAt(reinterpret_cast<const u32*>(cp + 0x20))) return false;
        const float* f = reinterpret_cast<const float*>(cp);
        if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2])) return false;
        if (ReadTls() != g_TlsFrame) return true; /* 表 (ゲームの毎フレーム) の流れでなければ、見るだけ */
        { /* 追従先が自分から横に 8 以上はなれたままが 1.5 秒続いたら、違うカメラ (試合が始まる前の演出のカメラ など) なので、探し直す */
            static u64 farT = 0; const uintptr_t lp = __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE);
            if (lp && Readable(lp, 12)) { const float* L = reinterpret_cast<const float*>(lp); const float dx = f[0] - L[0], dz = f[2] - L[2];
                if (L[0] == L[0] && dx * dx + dz * dz > 64.0f) { const u64 nw = NowTick(); if (!farT) farT = nw; else if (nw - farT > 28800000ull) { farT = 0; CamReject(cp); if (g_CamPos == cp) g_CamPos = 0; return false; } } else farT = 0; }
        }
        return true;
    }
    void CamFindScan();
    void CamFind() { /* メモリ全体を調べるので重い: 1 秒に 1 回まで。見つからないことが続いたら 20 秒に 1 回 (一定間隔で固まらないように) */
        { const uintptr_t lp = __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE); /* 前に見つけた候補から、自分の近く (8 以内) のカメラを選ぶ (すぐ終わる) */
          if (lp && LiveValid()) { const float* L = reinterpret_cast<const float*>(lp);
            for (int h = 0; h < g_CamHitN && h < 8; h++) { const uintptr_t a = g_CamHitAddr[h]; if (!a || a == g_CamRejA[0] || a == g_CamRejA[1] || a == g_CamRejA[2] || a == g_CamRejA[3] || !Readable(a, 0x48) || !CamSigAt(reinterpret_cast<const u32*>(a + 0x20))) continue;
                const float* f = reinterpret_cast<const float*>(a); const float dx = f[0] - L[0], dz = f[2] - L[2]; if (dx * dx + dz * dz < 64.0f) { g_CamPos = a; return; } } } }
        static u64 nextT = 0; static int fails = 0; const u64 now = NowTick(); if (now < nextT) return;
        CamFindScan(); if (CamValid()) fails = 0; else fails++;
        nextT = now + ((fails > 2 && now - g_LoadT > 40ull * 19200000ull) ? 20ull : 1ull) * 19200000ull;
    }
    static uintptr_t g_CamRegLo = 0, g_CamRegHi = 0; /* 前にカメラが見つかった領域 (次はそこから先に調べる) */
    void CamFindScanSync() {
        MemoryInfo selfmi; u32 selfpg;
        uintptr_t selfLo = 0, selfHi = 0;
        if (R_SUCCEEDED(svcQueryMemory(&selfmi, &selfpg, reinterpret_cast<uintptr_t>(&g_CamOff)))) { selfLo = selfmi.addr; selfHi = selfmi.addr + selfmi.size; }
        const bool haveLive = LiveValid();
        float L[3] = {};
        if (haveLive) std::memcpy(L, reinterpret_cast<const void*>(g_LivePos), 12);
        g_CamHits = 0; g_CamHitN = 0;
        uintptr_t best = 0; float bestD = 1e30f; uintptr_t bLo = 0, bHi = 0;
        for (int pass = 0; pass < 2 && !best; pass++) { /* 0: 前に見つかった領域だけ、1: 全体 */
        if (pass == 0 && !g_CamRegHi) continue;
        uintptr_t addr = pass == 0 ? g_CamRegLo : 0;
        for (int guard = 0; guard < 8192; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            if (pass == 0 && mi.addr >= g_CamRegHi) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9)
                         && (mi.perm & Perm_R) && !(mi.attr & 0xC) /* 端末共有・キャッシュなしの領域は読まない (GPU 用で、読むと落ちる) */ && (mi.perm & Perm_W) && !(mi.addr >= selfLo && end <= selfHi && selfHi);
            if (ok && mi.size >= 0x80) {
                const u32* w = reinterpret_cast<const u32*>(mi.addr);
                const size_t n = mi.size / 4;
                ScanSafe(mi.addr, n, 9, [&](const u32* w, size_t from, size_t to) {
                    for (size_t i = from < 8 ? 8 : from; i < to; i++) {
                        if (w[i + 1] != 0x40e66666u) continue; /* (+0 の 55.0 は視野の広さで変わるので、次の値で探す) */
                        if (!CamSigAt(w + i)) continue;
                        const float* f = reinterpret_cast<const float*>(w + i - 8);
                        if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2] && f[3] == f[3])) continue;
                        const float dy = f[1] - f[3];
                        if (!(dy > -1.0f && dy < 1.0f)) continue; /* 実機の例では +0xC に同じ高さが並んでいた */
                        g_CamHits++;
                        if (g_CamHitN < 8) g_CamHitAddr[g_CamHitN++] = reinterpret_cast<uintptr_t>(f);
                        float d = 0.0f;
                        if (haveLive) { const float dx = f[0] - L[0], dz = f[2] - L[2]; d = dx * dx + dz * dz; }
                        if (!best || d < bestD) { best = reinterpret_cast<uintptr_t>(f); bestD = d; bLo = mi.addr; bHi = end; }
                    }
                });
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
        if (pass == 0 && best && haveLive && bestD > 64.0f) best = 0; /* 前の領域で見つかっても、自分から 8 より遠ければ違う物 (ロード前の残り): 全体を探す */
        }
        if (best) { g_CamRegLo = bLo; g_CamRegHi = bHi; }
        if (best) g_CamPos = best;
    }
    void CamFindScan() { if (!BgRequest(1u, nullptr)) CamFindScanSync(); } /* 裏の流れで探す */
    /* カメラの向きの値を探す: 歩いて覚えた向き (横) と、毎回ほぼ同じ向きを指している長さ 1 の値を、カメラの近くのメモリから探す。
       見つかれば、立ち止まってカメラだけを回したときも、その値から今の向きがわかる。 */
    static uintptr_t g_CdBase = 0; static int g_CdOff = -1, g_CdSign = 1, g_CdEv = 0; static u8 g_CdScore[1024], g_CdSide[1024], g_CdBad[1024];
    /* side: スティックを横に倒して歩いたとき。キャラクターの体の向きは横を向くが、カメラの向きは変わらないので、ここで体の向きの値を振り落とす */
    static void CamDirCalib(float fr, float fi, bool side) {
        if (!CamValid()) return;
        const uintptr_t base = g_CamPos - 0x800;
        if (base != g_CdBase) { g_CdBase = base; g_CdOff = -1; g_CdEv = 0; std::memset(g_CdScore, 0, sizeof(g_CdScore)); std::memset(g_CdSide, 0, sizeof(g_CdSide)); std::memset(g_CdBad, 0, sizeof(g_CdBad)); }
        if (g_CdOff >= 0 || !Readable(base, 0x1000)) return;
        g_CdEv++;
        const float* f = reinterpret_cast<const float*>(base);
        for (int i = 0; i + 2 < 1024; i++) {
            if (g_CdBad[i]) continue;
            const float a = f[i], b = f[i + 1], c = f[i + 2];
            if (!(a == a && b == b && c == c)) continue;
            const float m = a * a + b * b + c * c; if (m < 0.95f || m > 1.05f) continue;
            const float h = __builtin_sqrtf(a * a + c * c); if (h < 0.3f) continue;
            const float dd = (a * fr + c * fi) / h;
            if (dd > 0.97f || dd < -0.97f) {
                if (g_CdScore[i] < 255) g_CdScore[i]++;
                if (side && g_CdSide[i] < 255) g_CdSide[i]++;
                if (g_CdScore[i] >= 8 && g_CdSide[i] >= 3 && g_CdScore[i] * 10 >= g_CdEv * 8) { g_CdOff = i; g_CdSign = dd > 0 ? 1 : -1; return; } /* 横歩きでも 3 回以上合った */
            } else if (side) { g_CdScore[i] = 0; g_CdSide[i] = 0; } /* 横歩きで外れた = 体の向きなど: やり直し */
        }
    }
    /* 見つけた値を捨てて、探し直す (右スティックで回しても変わらなかったとき) */
    static void CamDirReject() { if (g_CdOff >= 0) g_CdBad[g_CdOff] = 1; g_CdOff = -1; g_CdEv = 0; std::memset(g_CdScore, 0, sizeof(g_CdScore)); std::memset(g_CdSide, 0, sizeof(g_CdSide)); }
    /* カメラの向き (前向き、長さ 1、上が +y)。カメラの値が見つかっているときだけ */
    /* カメラの目 = 追従先の 0xC 前の float 3 つ、見ている点 = 追従先 (+0)。目 → 見ている点 がカメラの向き (方位計で前後を確かめた: 逆にすると印が反対側に出る) */
    static bool CamEye(float* e) {
        const uintptr_t cp = g_CamPos; /* 1 回だけ読む (ほかの流れで 0 にされて落ちた) */
        if (!cp || !CamValid() || !Readable(cp - 0xC, 24)) return false;
        const float* f = reinterpret_cast<const float*>(cp - 0xC);
        const float dx = f[3] - f[0], dy = f[4] - f[1], dz = f[5] - f[2], m = dx * dx + dy * dy + dz * dz;
        if (!(m == m) || m < 1.0f || m > 1600.0f) return false; /* 1〜40 の距離のときだけ (違う値を読んだときに使わない) */
        e[0] = f[0]; e[1] = f[1]; e[2] = f[2]; return true;
    }
    bool CamDir3(float* o) {
        { float e[3]; const uintptr_t cpt = g_CamPos; if (cpt && CamEye(e) && Readable(cpt, 12)) { /* 目から見ている点への向き (いちばん正確) */
            const float* t = reinterpret_cast<const float*>(cpt); const float dx = t[0] - e[0], dy = t[1] - e[1], dz = t[2] - e[2], m = __builtin_sqrtf(dx * dx + dy * dy + dz * dz);
            o[0] = dx / m; o[1] = dy / m; o[2] = dz / m; return true; } }
        if (g_ScanFix && CamValid()) { /* 視点探しで見つけた場所 */
            const uintptr_t a = g_CamPos + static_cast<intptr_t>(g_ScanRel);
            if (Readable(a, 12)) { const float* f = reinterpret_cast<const float*>(a); const float sg = static_cast<float>(g_ScanSign); o[0] = f[0] * sg; o[1] = f[1] * sg; o[2] = f[2] * sg; const float m = o[0] * o[0] + o[1] * o[1] + o[2] * o[2]; if (m > 0.9f && m < 1.1f) return true; }
        }
        if (g_CdOff < 0 || !CamValid() || g_CamPos - 0x800 != g_CdBase || !Readable(g_CdBase + g_CdOff * 4, 12)) return false;
        const float* f = reinterpret_cast<const float*>(g_CdBase) + g_CdOff; const float sg = static_cast<float>(g_CdSign);
        o[0] = f[0] * sg; o[1] = f[1] * sg; o[2] = f[2] * sg; return o[0] == o[0] && o[1] == o[1] && o[2] == o[2];
    }
    static float LookAtan2(float y, float x) { /* 度 (おおよそ) */
        const float ax = x < 0 ? -x : x, ay = y < 0 ? -y : y; if (ax < 1e-6f && ay < 1e-6f) return 0.0f;
        const float a = (ax > ay ? ay / ax : ax / ay); const float s2 = a * a; float r = ((-0.0464964749f * s2 + 0.15931422f) * s2 - 0.327622764f) * s2 * a + a;
        if (ay > ax) r = 1.5707963f - r; if (x < 0) r = 3.1415927f - r; if (y < 0) r = -r; return r * 57.29578f;
    }
    /* 地点を見る: 毎フレーム、地点を追いかけ続ける (やめるまで)。
       精度のために、「スティックをこれだけ倒したら、1 フレームでカメラが何度回ったか」を毎フレーム測って覚え (向きの逆設定も含めて)、
       そこから「このフレームでずれの 6 割を詰める倒し量」を逆算する。ずれが小さくても、スティックの遊びを越える最低限は倒す。
       自分で右スティックを動かしている間は、自分の操作を優先する (離すとまた追いかける)。 */
    static float LookWrap(float a) { while (a > 180.0f) a -= 360.0f; while (a < -180.0f) a += 360.0f; return a; }
    static void SdWriteAsync(const char* name, const void* p, u32 len); static bool UpdWrite(uintptr_t sdk, const char* name, const void* data, u32 len); static int UpdReadSmall(uintptr_t sdk, const char* name, char* out, int cap); static uintptr_t UpdSdk(); static bool UpdMount(uintptr_t sdk);
    /* 地点を見るの記録: 使っている間の値を 1 フレーム 1 行で覚え、やめたとき (か 600 行たまったとき) に SD の inkdraw/bin/lookdbg.txt に書く */
    static char g_LkLog[320 * 1024]; static int g_LkLen = 0, g_LkRows = 0; static bool g_LkSaved = false; static float g_LkDz = 0.0f; /* 記録は古い行から捨てて、最近の約 9 秒を残す。エイムボットを OFF にしたときに書く */
    static void LkSave() {
        if (!g_LkOn || g_LkLen <= 0 || g_LkSaved) return; g_LkSaved = true;
        SdWriteAsync("inkd:/inkdraw/bin/lookdbg.txt", g_LkLog, static_cast<u32>(g_LkLen));
    }
    template <class... A> static void LkPut(const char* f, A... a) {
        if (!g_LkOn || g_LkSaved) return;
        if (g_LkLen > static_cast<int>(sizeof(g_LkLog)) - 600) { /* いっぱい: 見出しは残して、古い半分の行を捨てる */
            int h = 0, nl = 0; while (h < g_LkLen && nl < 2) { if (g_LkLog[h] == '\n') nl++; h++; }
            int m = h + (g_LkLen - h) / 2; while (m < g_LkLen && g_LkLog[m - 1] != '\n') m++;
            std::memmove(g_LkLog + h, g_LkLog + m, static_cast<size_t>(g_LkLen - m)); g_LkLen -= (m - h);
        }
        const int room = static_cast<int>(sizeof(g_LkLog)) - g_LkLen - 1; if (room <= 0) return;
        int r = std::snprintf(g_LkLog + g_LkLen, static_cast<size_t>(room) + 1, f, a...); if (r < 0) r = 0; if (r > room) r = room; g_LkLen += r; /* 1 行が長すぎて切れたときも、はみ出さない (変な値が入ると 1 行が 600 文字をこえていた) */
    }
    /* カメラの角度の値を自動で探す: 追従先の前 0x1800 〜 後ろ 0x400 の float を毎フレーム見て、
       カメラの向き (左右 / 上下) が動いているあいだ 40 フレーム続けて同じ角度になっている値を見つける (符号や 90 度ずれの決まりも試す)。
       見つけたら、書き込んで本当にカメラが向くかを確かめ、向かなければその値は捨てて探し直す */
    constexpr int kAngN = 0x1C00 / 4; constexpr intptr_t kAngBack = 0x1800;
    struct AngF { int off = -1, var = 0, ok = 0, fail = 0; float last = 0.0f, prevWant = 0.0f; bool have = false, wrote = false; u8 sc[kAngN][8]; u8 bad[kAngN][8]; };
    static AngF g_AY, g_AP; static uintptr_t g_AngBase = 0;
    static const float kAngCst[4] = { 0.0f, 1.5707963f, 3.1415927f, -1.5707963f };
    static float AngWrap(float a) { while (a > 3.1415927f) a -= 6.2831853f; while (a < -3.1415927f) a += 6.2831853f; return a; }
    static void AngReset(AngF& a, bool full) { a.off = -1; a.ok = 0; a.fail = 0; a.have = false; a.wrote = false; std::memset(a.sc, 0, sizeof(a.sc)); if (full) std::memset(a.bad, 0, sizeof(a.bad)); }
    static void AngScan(AngF& a, float cur, int nv) {
        if (a.off >= 0) return;
        if (!a.have) { a.last = cur; a.have = true; return; }
        const float dv = AngWrap(cur - a.last); a.last = cur;
        if (dv < 0.002f && dv > -0.002f) return; /* 止まっているフレームは数えない (たまたま同じ値の定数を拾わないように) */
        const float* F = reinterpret_cast<const float*>(g_CamPos - kAngBack);
        for (int i = 0; i < kAngN; i++) {
            const float v = F[i];
            if (!(v == v) || v > 50.0f || v < -50.0f) { std::memset(a.sc[i], 0, 8); continue; }
            for (int k = 0; k < nv; k++) {
                if (a.bad[i][k]) continue;
                const float d = AngWrap((k & 1 ? -v : v) + kAngCst[k >> 1] - cur);
                if (d < 0.01f && d > -0.01f) { if (++a.sc[i][k] >= 40) { a.off = i; a.var = k; a.ok = 0; a.fail = 0; a.wrote = false; return; } }
                else a.sc[i][k] = 0;
            }
        }
    }
    /* 見つけた値に want を書く。書いたあと、カメラが本当にその角度になるかを数えて、ならなければ捨てる */
    static bool AngWrite(AngF& a, float cur, float want, bool wrapIt) {
        if (a.off < 0) return false;
        const uintptr_t ad = g_CamPos - kAngBack + 4 * static_cast<uintptr_t>(a.off);
        if (!Writable(ad, 4)) { AngReset(a, false); return false; }
        if (a.wrote) {
            const float e = AngWrap(cur - a.prevWant);
            if (e < 0.06f && e > -0.06f) { a.ok++; a.fail = 0; }
            else if (++a.fail > (a.ok ? 30 : 8)) { a.bad[a.off][a.var] = 1; AngReset(a, false); return false; } /* 書いても向かない = カメラを動かす値ではない */
        }
        float* P = reinterpret_cast<float*>(ad);
        const float sg = (a.var & 1) ? -1.0f : 1.0f, cst = kAngCst[a.var >> 1];
        float v = sg * (want - cst);
        if (wrapIt) v = P[0] + AngWrap(v - P[0]);
        P[0] = v; a.prevWant = want; a.wrote = true;
        return true;
    }
    /* カメラの向きのベクトルを自動で探す: 追従先の前後の float 3 つの組で、長さ 1 のもののうち、
       カメラが動いているあいだ 40 フレーム続けて「カメラの向き (または逆向き / 水平の向き / 水平の逆向き)」と同じものを全部覚える。
       地点を見るときは、それら全部に地点の向きを書き、本当にカメラが向いたかを確かめる (向かなければ全部捨てて探し直す) */
    struct VecF { u8 sc[kAngN][4]; u8 bad[kAngN][4]; int n = 0, ok = 0, fail = 0, banN = 0; int idx[24]; u8 typ[24]; bool wrote = false, have = false; float pw[3] = {}, lc[3] = {}; };
    static VecF g_VF; static float g_VecTolCos = 0.998f; /* 書いた向きになったかを見るときの許す角度 (cos) */
    static int g_VGoodI = -1, g_VGoodK = 0; static u64 g_VRetryT = 0, g_VClearT = 0; /* 一度ちゃんと効いた場所 (たまに失敗しても捨てず、少し休んでからまた使う) */
    static void VecReset(bool full) { g_VF.n = 0; g_VF.ok = 0; g_VF.fail = 0; g_VF.wrote = false; g_VF.have = false; std::memset(g_VF.sc, 0, sizeof(g_VF.sc)); if (full) std::memset(g_VF.bad, 0, sizeof(g_VF.bad)); }
    static void VecScan(const float* c) {
        VecF& V = g_VF;
        if (!V.have) { V.lc[0] = c[0]; V.lc[1] = c[1]; V.lc[2] = c[2]; V.have = true; return; }
        const float mv = __builtin_fabsf(c[0] - V.lc[0]) + __builtin_fabsf(c[1] - V.lc[1]) + __builtin_fabsf(c[2] - V.lc[2]);
        V.lc[0] = c[0]; V.lc[1] = c[1]; V.lc[2] = c[2];
        if (mv < 0.003f || V.ok > 0) return; /* 止まっているフレームは数えない。うまく動いたあとは探さない */
        const float hh = __builtin_sqrtf(c[0] * c[0] + c[2] * c[2]); if (hh < 0.1f) return;
        const float ref[4][3] = { { c[0], c[1], c[2] }, { -c[0], -c[1], -c[2] }, { c[0] / hh, 0.0f, c[2] / hh }, { -c[0] / hh, 0.0f, -c[2] / hh } };
        const float* F = reinterpret_cast<const float*>(g_CamPos - kAngBack);
        for (int i = 0; i + 2 < kAngN; i++) {
            const float a = F[i], b = F[i + 1], d = F[i + 2], m = a * a + b * b + d * d;
            if (!(m > 0.97f && m < 1.03f)) { std::memset(V.sc[i], 0, 4); continue; }
            for (int k = 2; k < 4; k++) { /* 水平の向き (左右だけ) を 1 か所ずつ試す。上下も入った向きは、カメラの回転の行列の一部のことがあり、書くとカメラが傾くので書かない。上下はスティックで合わせる */
                if (V.bad[i][k]) continue;
                const float e = __builtin_fabsf(a - ref[k][0]) + __builtin_fabsf(b - ref[k][1]) + __builtin_fabsf(d - ref[k][2]);
                if (e < 0.02f) {
                    if (V.sc[i][k] < 255 && ++V.sc[i][k] == 40 && V.n < 24) { bool have = false; for (int q = 0; q < V.n; q++) if (V.idx[q] == i && V.typ[q] == k) have = true; if (!have) { V.idx[V.n] = i; V.typ[V.n] = static_cast<u8>(k); V.n++; } }
                } else V.sc[i][k] = 0;
            }
        }
    }
    /* 見つけたベクトル全部に、向き w (長さ 1) を書く。full: 上下も入ったベクトルがあるか */
    static bool VecWrite(const float* c, const float* w, bool* full) {
        VecF& V = g_VF; *full = false;
        if (V.n == 0 || V.banN >= 4) { /* 書ける場所がない: 時間がたつとキレが悪くなっていた (一時的な失敗で、効く場所まで捨てていた) ので、休んでから戻す */
            const u64 nw = NowTick();
            if (nw >= g_VRetryT) {
                if (g_VGoodI >= 0 && g_VGoodI + 2 < kAngN) { V.idx[0] = g_VGoodI; V.typ[0] = static_cast<u8>(g_VGoodK); V.n = 1; V.banN = 0; V.ok = 0; V.fail = 0; V.wrote = false; } /* 効いた場所をもう一度 */
                if (nw - g_VClearT > 5ull * 19200000ull) { g_VClearT = nw; std::memset(V.bad, 0, sizeof(V.bad)); V.banN = 0; } /* だめだった印も 5 秒ごとに消して、探し直せるようにする */
                g_VRetryT = nw + 9600000ull;
            }
            if (V.n == 0 || V.banN >= 4) return false;
        }
        if (V.wrote) { /* 前のフレームで書いた向きに、カメラ (左右) が本当になったか */
            const float h1 = __builtin_sqrtf(c[0] * c[0] + c[2] * c[2]), h2 = __builtin_sqrtf(V.pw[0] * V.pw[0] + V.pw[2] * V.pw[2]);
            const float dd = (h1 > 0.05f && h2 > 0.05f) ? (c[0] * V.pw[0] + c[2] * V.pw[2]) / (h1 * h2) : 1.0f;
            if (dd > g_VecTolCos) { V.ok++; V.fail = 0; if (V.ok >= 30) { g_VGoodI = V.idx[0]; g_VGoodK = V.typ[0]; } }
            else if (++V.fail > (V.ok ? 30 : 8)) { /* 試していた 1 か所は効かなかった: それだけ捨てて、次の候補へ (一度ちゃんと効いた場所は捨てずに、少し休む) */
                const bool good = V.idx[0] == g_VGoodI && V.typ[0] == g_VGoodK; if (!good) { V.bad[V.idx[0]][V.typ[0]] = 1; V.banN++; } else g_VRetryT = NowTick() + 9600000ull; for (int q = 1; q < V.n; q++) { V.idx[q - 1] = V.idx[q]; V.typ[q - 1] = V.typ[q]; } V.n--;
                V.ok = 0; V.fail = 0; V.wrote = false; return false; }
        }
        const float hw = __builtin_sqrtf(w[0] * w[0] + w[2] * w[2]); if (hw < 0.05f) return false;
        const float hc = __builtin_sqrtf(c[0] * c[0] + c[2] * c[2]);
        for (int q = 0; q < V.n && q < 1; q++) { /* 1 つずつ試す: 一度に 1 か所だけ書く (たくさん書くとカメラがあばれる) */
            const uintptr_t ad = g_CamPos - kAngBack + 4 * static_cast<uintptr_t>(V.idx[q]);
            if (!Writable(ad, 12)) { V.idx[q] = V.idx[V.n - 1]; V.typ[q] = V.typ[V.n - 1]; V.n--; q--; continue; }
            float* P = reinterpret_cast<float*>(ad); const int k = V.typ[q];
            { /* 書く前に確かめる: 今もカメラの向き (か前に書いた向き) が入っているときだけ書く。違うものに変わっていたら (場面が変わって別のデータになった)、もう書かない */
                float r1[3], r2[3]; const float sg = (k & 1) ? -1.0f : 1.0f;
                if (k < 2) { r1[0] = sg * c[0]; r1[1] = sg * c[1]; r1[2] = sg * c[2]; r2[0] = sg * V.pw[0]; r2[1] = sg * V.pw[1]; r2[2] = sg * V.pw[2]; }
                else { const float hp = __builtin_sqrtf(V.pw[0] * V.pw[0] + V.pw[2] * V.pw[2]); const float h1 = hc > 0.05f ? hc : 1.0f, h2 = hp > 0.05f ? hp : 1.0f;
                       r1[0] = sg * c[0] / h1; r1[1] = 0.0f; r1[2] = sg * c[2] / h1; r2[0] = sg * V.pw[0] / h2; r2[1] = 0.0f; r2[2] = sg * V.pw[2] / h2; }
                const float m = P[0] * P[0] + P[1] * P[1] + P[2] * P[2];
                const float e1 = __builtin_fabsf(P[0] - r1[0]) + __builtin_fabsf(P[1] - r1[1]) + __builtin_fabsf(P[2] - r1[2]);
                const float e2 = V.wrote ? __builtin_fabsf(P[0] - r2[0]) + __builtin_fabsf(P[1] - r2[1]) + __builtin_fabsf(P[2] - r2[2]) : 9.0f;
                if (!(m > 0.97f && m < 1.03f) || (e1 > 0.15f && e2 > 0.02f)) { if (!(V.idx[q] == g_VGoodI && k == g_VGoodK)) V.bad[V.idx[q]][k] = 1; else g_VRetryT = NowTick() + 9600000ull; V.idx[q] = V.idx[V.n - 1]; V.typ[q] = V.typ[V.n - 1]; V.n--; q--; continue; }
            }
            if (k < 2) { const float sg = k ? -1.0f : 1.0f; P[0] = sg * w[0]; P[1] = sg * w[1]; P[2] = sg * w[2]; *full = true; }
            else { const float sg = k == 3 ? -1.0f : 1.0f; P[0] = sg * w[0] / hw; P[1] = 0.0f; P[2] = sg * w[2] / hw; }
        }
        if (V.n == 0) { V.ok = 0; V.fail = 0; V.wrote = false; return false; }
        V.pw[0] = w[0]; V.pw[1] = w[1]; V.pw[2] = w[2]; V.wrote = true;
        return true;
    }
    /* 毎フレーム (地点を見るを使っていなくても) カメラの向きを見て、向きの値を探しておく */
    /* 試合の始まり: リスポーンの箱に乗って動かされている間は、自分の座標もカメラも勝手に動き、box がでたらめになる (自分の box が画面の下に固まる)。
       向きの学習も、箱の動きで間違えて覚えてしまい、直るまで時間がかかっていた。ロードのあと、自分でスティックを倒して動き出す (= カウントダウンが終わる) まで、
       box・エイムボット・向きの学習は待つ。60 秒たったら、動かなくても使えるようにする */
    extern u64 g_TmObjS, g_TmObjE; static void EbDump(const char* fname, int bytes = 0x1000, int maxN = 32); u64 g_TmEnOk = 0, g_TmBoxEn = 0;
    static bool BattleGate() {
        static u64 tmCam = 0, tmSelf = 0, tmEn = 0, tmOpen = 0; static bool wroteOpen = false, wroteEn = false, dumpA = false, dumpB = false, wroteFin = false;
        static u32 gen = 0xFFFFFFFFu; static bool open = true; static u64 tUpd = 0; static float lp[3] = {}; static bool hp = false; static int cnt = 0;
        const u64 now = NowTick();
        if (gen != g_LoadGen) { gen = g_LoadGen; open = g_LoadT == 0; hp = false; cnt = 0; tUpd = 0; tmCam = tmSelf = tmEn = tmOpen = 0; wroteOpen = wroteEn = dumpA = dumpB = wroteFin = false; g_TmObjS = g_TmObjE = 0; g_TmEnOk = 0; g_TmBoxEn = 0; }
        if (open) {
            if (g_LoadT && tmOpen && !tmCam && CamValid()) tmCam = now;
            if (g_LoadT && tmOpen && !wroteFin && now - tmOpen > 35ull * 19200000ull) { wroteFin = true; wroteOpen = false; } /* 35 秒後に、時間の記録をもう一度書く */
            if (g_LoadT && tmOpen && !wroteEn && now - tmOpen < 30ull * 19200000ull) { if (!tmEn && g_EnN > 0) tmEn = now; if (tmEn && now - tmOpen > 4ull * 19200000ull) { wroteEn = true; wroteOpen = false; } } /* 開いたあと、敵が見つかった時刻もあとで書く */
            if (g_LoadT && tmOpen) { /* 開いてから 5 秒後と 25 秒後に、見つけた敵の体を全部書く (数えている体・数えていない体の違いを調べる用) */
                (void)dumpA; (void)dumpB; }
            if (g_LoadT && tmOpen && !wroteOpen) { /* 時間の記録: ロードからの ms */
                wroteOpen = true; char b[480]; auto ms = [&](u64 t) { return t ? static_cast<long>((t - g_LoadT) / 19200ull) : -1L; };
                const int n = std::snprintf(b, sizeof(b), "ロードから (ms)\nカメラが見つかった %ld\n自分の座標が見つかった %ld\n物探し 始め %ld 終わり %ld\n敵の体が見つかった %ld\n最初の敵が使えるようになった %ld\n最初の敵のボックスを描いた %ld\nカウントダウンのあと動き出した %ld\n", ms(tmCam), ms(tmSelf), ms(g_TmObjS), ms(g_TmObjE), ms(tmEn), ms(g_TmEnOk), ms(g_TmBoxEn), ms(tmOpen));
                const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) UpdWrite(sdk, "inkd:/inkdraw/bin/timing.txt", b, static_cast<u32>(n));
            }
            return true;
        }
        if (now - g_LoadT > 12ull * 19200000ull) { open = true; if (!tmOpen) tmOpen = now; g_EnScanNow = true; return true; } /* 動き出したことに気づけなくても、20 秒で使えるようにする (前は 60 秒) */
        if (tUpd && now - tUpd < 1920000ull) return false;
        tUpd = now;
        float p[3];
        if (!tmCam && CamValid()) tmCam = now; if (!tmEn && g_EnN > 0) tmEn = now;
        { float q[3]; if (!tmSelf && SelfPos(q)) tmSelf = now; }
        bool okP = false; { const uintptr_t cp = g_CamPos; if (cp && CamValid() && Readable(cp, 12)) { std::memcpy(p, reinterpret_cast<const void*>(cp), 12); okP = true; } else okP = SelfPos(p); } /* カメラの追従先は必ず自分なので、まずそれで見る (自分の座標はほかのプレイヤーと取り違えていることがある) */
        if (now - g_LoadT < 6ull * 19200000ull || !okP) { hp = false; cnt = 0; return false; } /* 読み込みの直後 6 秒は見ない */
        const float sx = g_LStickX, sy = g_LStickY;
        if (hp && sx * sx + sy * sy > 0.16f) { const float dx = p[0] - lp[0], dz = p[2] - lp[2], d2 = dx * dx + dz * dz; if (d2 > 0.0025f && d2 < 4.0f) cnt++; else if (cnt > 0) cnt--; } else if (cnt > 0) cnt--; /* スティックを倒していて、0.1 秒で 5cm 以上動く */
        std::memcpy(lp, p, 12); hp = true;
        if (cnt >= 5) { open = true; tmOpen = now; g_EnScanNow = true; g_BalScanNow = true; } /* 動き出したら、すぐ敵を探し直す */
        return open;
    }
    static void AngTick() {
        static u64 lt = 0; const u64 now = NowTick(); if (now - lt < 200000ull) return; lt = now;
        if (!CamValid() || !Readable(g_CamPos - kAngBack, static_cast<size_t>(kAngN) * 4)) return;
        if (g_AngBase != g_CamPos) { g_AngBase = g_CamPos; VecReset(true); }
        float c[3]; if (!CamDir3(c)) return;
        const float ch = __builtin_sqrtf(c[0] * c[0] + c[2] * c[2]); if (ch < 0.05f) return;
        const float D2R = 0.017453293f;
        (void)D2R; VecScan(c);
        { /* 向きを直接書く場所が使えなくなったまま (4 か所失敗して書くのをやめた / 候補が 0) が 5 秒続いたら、失敗の記録を消して探し直す。
             前はそのままずっとスティックだけで回していたので、時間がたつと視点が遅く (スティックの最高速度で) しか回らなくなっていた */
            static u64 weakT = 0; const u64 nw = NowTick();
            if (g_VF.banN >= 4 || g_VF.n == 0) { if (!weakT) weakT = nw; else if (nw - weakT > 96000000ull) { if (g_VF.banN >= 4) VecReset(true); else std::memset(g_VF.bad, 0, sizeof(g_VF.bad)); g_VF.banN = 0; weakT = 0; } }
            else weakT = 0;
        }
    }
    /* ジャイロ切替距離の中: 本物のジャイロを止めたぶん、右スティックの上下をジャイロの上下に変えて伝える (スティックで上下を動かせるように) */
    /* 地点を見るの向く先 (覚えた座標と同じ形: 床 + kLiveHeight)。4 = いちばん近いイカバルーン (倒されて消えたら、次に近いバルーンへ) */
    bool EnSquid(int k); bool EnMovedOnce(int k);
    static bool LookTarget(float* T) {
        const int sl = g_LookSlot;
        if (sl == 6) { /* エイムボット: 円を出しているときは「円の中で、いちばんまん中に近い相手」、円なしのときは「いちばん近い相手」(360 度どこでも)。
                          今の相手は少しえこひいきして、すぐには乗りかえない (行ったり来たりしないように) */
            static int ck = -1, ci = -1; float me[3]; if (!SelfPos(me)) return false;
            float E[3], c[3]; const bool cam = CamEye(E) && CamDir3(c);
            const float R = 2.8f + 2.8f * static_cast<float>(g_LookRange < 0 ? 0 : (g_LookRange > 19 ? 19 : g_LookRange)), maxD = R * 3.0f;
            float th = 0.52f; const uintptr_t cpq = g_CamPos; if (cpq && CamValid() && Readable(cpq + 0x20, 4)) { const float q = *reinterpret_cast<const float*>(cpq + 0x20); /* 1 回だけ読む (確かめたあとに 0 にされて落ちた) */ if (q > 20.0f && q < 120.0f) { const float ha = q * 0.5f * 0.017453293f; th = __builtin_sinf(ha) / __builtin_cosf(ha); } }
            const float kc = static_cast<float>(g_CircR) / 100.0f * th;
            int bk = -1, bi = -1; float bs = 1e30f, bp[3] = {};
            for (int kind = 0; kind < 2; kind++) {
                if ((kind == 0 && g_AimTgt == 1) || (kind == 1 && g_AimTgt == 0)) continue;
                const int n = kind == 0 ? g_EnN : g_BalN;
                for (int k = 0; k < n; k++) {
                    float pp[3]; if (!(kind == 0 ? EnPos(k, pp) : BalPos(k, pp))) continue; if (kind == 0 && !EnMovedOnce(k)) continue; /* 一度も動いていない体は狙わない (変な方向に向いていた) */
                    const float dx = pp[0] - me[0], dz = pp[2] - me[2], hd2 = dx * dx + dz * dz; if (hd2 > maxD * maxD) continue;
                    const bool cur = kind == ck && k == ci; float sc;
                    if (g_CircOn && cam) {
                        const float vx = pp[0] - E[0], vy = pp[1] + 0.9f - E[1], vz = pp[2] - E[2], t = vx * c[0] + vy * c[1] + vz * c[2]; if (t <= 0.3f) continue;
                        const float p2 = vx * vx + vy * vy + vz * vz - t * t, a = __builtin_sqrtf(p2 > 0.0f ? p2 : 0.0f) / t; const float lim = cur ? kc * 1.5f + 0.03f : kc;
                        if (a > lim) continue; sc = hd2 * (cur ? 0.5f : 1.0f); /* 円の中の相手のうち、いちばん近い相手 (前は円のまん中に近い相手で、近くの敵に向かなかった) */
                    } else sc = hd2 * (cur ? 0.5f : 1.0f);
                    if (sc < bs) { bs = sc; bk = kind; bi = k; std::memcpy(bp, pp, 12); }
                }
            }
            if (bk < 0) { ck = -1; ci = -1; return false; }
            ck = bk; ci = bi; float sp[3]; std::memcpy(sp, bp, 12);
            if (bk == 0) { /* 敵: 速さを測って、偏差射撃のときは先を狙う。潜伏中は低く */
                static int vk = -1; static float pv[3], vel[3]; static u64 pt = 0; const u64 nw = NowTick();
                if (vk != bi || !pt || nw - pt > 9600000ull) { vk = bi; std::memcpy(pv, sp, 12); vel[0] = vel[1] = vel[2] = 0.0f; pt = nw; }
                else if (nw - pt >= 150000ull) { const float dt = static_cast<float>(nw - pt) / 19200000.0f; for (int q = 0; q < 3; q++) { const float vq = (sp[q] - pv[q]) / dt; vel[q] = (vq > 40.0f || vq < -40.0f) ? 0.0f : vel[q] * 0.6f + vq * 0.4f; } std::memcpy(pv, sp, 12); pt = nw; }
                float sv[3] = { vel[0], vel[1], vel[2] };
                { /* 敵の座標は通信で数フレームおきにまとめて進む (階段のような動き) ので、そのまま向くと視点が途切れ途切れに吸い付く。速さも含めてなめらかにした位置を向く (一定の速さで動く敵には遅れない) */
                    static int fk = -1; static float fp[3], fv[3]; static u64 ft = 0;
                    const float jx = sp[0] - fp[0], jy = sp[1] - fp[1], jz = sp[2] - fp[2];
                    if (fk != bi || !ft || nw - ft > 9600000ull || jx * jx + jy * jy + jz * jz > 9.0f) { fk = bi; std::memcpy(fp, sp, 12); fv[0] = fv[1] = fv[2] = 0.0f; ft = nw; } /* 相手が変わった / 0.5 秒あいた / 3 以上とんだ (ワープ・復活): そこから始める */
                    else if (nw > ft) { float dt = static_cast<float>(nw - ft) / 19200000.0f; if (dt > 0.1f) dt = 0.1f; ft = nw;
                        for (int q = 0; q < 3; q++) { const float pr = fp[q] + fv[q] * dt, rr = sp[q] - pr; fp[q] = pr + 0.25f * rr; float v2 = fv[q] + 0.035f * rr / dt; if (v2 > 30.0f) v2 = 30.0f; if (v2 < -30.0f) v2 = -30.0f; fv[q] = v2; } }
                    std::memcpy(sp, fp, 12); std::memcpy(sv, fv, 12); }
                const int lv = g_LeadLv; if (lv > 0) { const float dx = sp[0] - me[0], dz = sp[2] - me[2], d = __builtin_sqrtf(dx * dx + dz * dz); float ls = static_cast<float>(lv) * 0.1f * d / 60.0f; if (ls > 1.0f) ls = 1.0f; sp[0] += sv[0] * ls; sp[1] += sv[1] * ls * 0.5f; sp[2] += sv[2] * ls; }
                if (EnSquid(bi)) sp[1] -= 0.9f; /* イカ状態: 体のまん中 (床から 0.9) ではなく、イカのまん中 (床の高さ) を狙う */
            }
            T[0] = sp[0]; T[1] = sp[1] + kLiveHeight; T[2] = sp[2]; return true;
        }
        if (sl == 5) { /* いちばん近い敵 (3 以上近い敵が出てきたときだけ乗りかえる) */
            static int esel = -1; float me[3]; if (!SelfPos(me)) return false;
            float sp[3]; float curD = 1e30f; if (esel >= 0 && EnPos(esel, sp)) { const float dx = sp[0] - me[0], dz = sp[2] - me[2]; curD = dx * dx + dz * dz; } else esel = -1;
            int best = -1; float bestD = 1e30f;
            for (int k = 0; k < g_EnN; k++) { float bp[3]; if (!EnPos(k, bp)) continue; const float dx = bp[0] - me[0], dz = bp[2] - me[2], d = dx * dx + dz * dz; if (d < bestD) { bestD = d; best = k; } }
            if (best < 0) { esel = -1; return false; }
            if (esel < 0 || bestD + 9.0f < curD) esel = best;
            if (!EnPos(esel, sp)) return false;
            T[0] = sp[0]; T[1] = sp[1] + kLiveHeight; T[2] = sp[2]; return true;
        }
        if (sl != 4) { if (!g_WarpHas[sl & 3]) return false; std::memcpy(T, g_WarpSlots[sl & 3], 12); return true; }
        static int sel = -1; float me[3]; if (!SelfPos(me)) return false;
        float sp[3]; float curD = 1e30f; if (sel >= 0 && BalPos(sel, sp)) { const float dx = sp[0] - me[0], dz = sp[2] - me[2]; curD = dx * dx + dz * dz; } else sel = -1;
        int best = -1; float bestD = 1e30f;
        for (int k = 0; k < g_BalN; k++) { float bp[3]; if (!BalPos(k, bp)) continue; const float dx = bp[0] - me[0], dz = bp[2] - me[2], d = dx * dx + dz * dz; if (d < bestD) { bestD = d; best = k; } }
        if (best < 0) { sel = -1; return false; }
        if (sel < 0 || bestD + 9.0f < curD) sel = best; /* 今のバルーンより 3 以上近いものがあるときだけ乗りかえる (行ったり来たりしないように) */
        if (!BalPos(sel, sp)) return false;
        T[0] = sp[0]; T[1] = sp[1] + kLiveHeight; T[2] = sp[2]; return true;
    }
    static bool AGyro() { return g_LookAHold && (g_BtnNow & 1ull); } /* A長押しの間だけ: A を押している間は、ジャイロを止めてスティックで動かす */
    static bool GyroRangeIn() {
        if (AGyro()) return true;
        static const float kRange[6] = { 0.0f, 3.0f, 5.0f, 10.0f, 20.0f, 30.0f };
        float Lp[3], Tw[3]; const int ri = g_GyroRange; if (!g_LookOn || ri <= 0 || ri >= 6 || !LookTarget(Tw) || !SelfPos(Lp)) return false;
        const float pdx = Tw[0] - Lp[0], pdy = Tw[1] - Lp[1], pdz = Tw[2] - Lp[2];
        return pdx * pdx + pdy * pdy + pdz * pdz <= kRange[ri] * kRange[ri];
    }
    static float GyroUserW() {
        const float sy = g_HudSt[3]; if (sy < 0.15f && sy > -0.15f) return 0.0f;
        const float k = g_GyroKg > 0.2f || g_GyroKg < -0.2f ? g_GyroKg : 6.0f;
        float w = sy * 3.0f / k; if (w > 0.6f) w = 0.6f; if (w < -0.6f) w = -0.6f; return w; /* いっぱいに倒すと 1 フレームに 3 度 */
    }
    static void AimStartLog() { /* SD の inkdraw/bin/aimstart.txt: ロードから 90 秒の間、0.5 秒ごとに「エイムボットが動く条件」を 1 行ずつ。90 秒で書く */
        static char b[24 * 1024]; static int n = 0; static u32 gen = 0xFFFFFFFFu; static u64 lt = 0; static bool done = false;
        const u64 now = NowTick(); if (!g_LoadT) return;
        if (gen != g_LoadGen) { gen = g_LoadGen; n = std::snprintf(b, sizeof(b), "inkdraw 試合の始まり 記録 (版 %d)\n秒 | カメラ 足元 座標 | 自分-追従先 | 敵の数 使える敵 | 狙っている 理由 | エイムON\n", kInkVer); lt = 0; done = false; }
        if (done || now - lt < 9600000ull) return; lt = now;
        const float t = static_cast<float>(now - g_LoadT) / 19200000.0f;
        if (t > 90.0f) { done = true; if (g_LookOn) SdWriteAsync("inkd:/inkdraw/bin/aimstart.txt", b, static_cast<u32>(n)); return; }
        float sd = -1.0f; { const uintptr_t lp = __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE); if (lp && LiveValid() && CamValid()) { const float* A = reinterpret_cast<const float*>(lp); const float* B = reinterpret_cast<const float*>(g_CamPos); sd = __builtin_sqrtf((A[0] - B[0]) * (A[0] - B[0]) + (A[2] - B[2]) * (A[2] - B[2])); } }
        int use = 0; { float q[3]; for (int k = 0; k < g_EnN; k++) if (EnPos(k, q)) use++; }
        if (n < static_cast<int>(sizeof(b)) - 200) n += std::snprintf(b + n, sizeof(b) - n, "%.1f | %d %d %d | %.1f | %d %d | %d %d | %d\n", static_cast<double>(t), CamValid() ? 1 : 0, FootValid() ? 1 : 0, LiveValid() ? 1 : 0, static_cast<double>(sd), static_cast<int>(g_EnN), use, g_LookActive ? 1 : 0, static_cast<int>(g_LookWhy), g_LookOn ? 1 : 0);
    }
    constexpr int kStDz = 4800; struct StAx { int h[7]; float K, r; float sxy, sxx; }; static StAx g_StX = {}, g_StY = {}; static int g_StDirectN = 99; /* スティックの遅れの計算: 左右・上下それぞれ、最近 7 フレームに倒した量と、1 あたり何度回るか。g_StDirectN: 左右を直接書いてからのフレーム数 */
    /* ---- エイムボット（ジャイロ）: カメラの向き (左右・上下) と敵への向きのずれを、ジャイロの角速度を足して詰める。
       3 軸のジャイロが左右・上下をどれだけ回すか (G: 度/回転) は、オンにした最初の 0.5 秒ほど 1 軸ずつ小さく動かして測り、そのあとも回った量との差で直し続ける。
       ジャイロ記録 (デバッグ) がオンの間は、1 フレームごとの様子を inkdraw/bin/gyrec.txt に書く (ジャイロ操作でないときも、本物の角速度とカメラの動きが分かる) */
    static char g_GaTxt[300 * 1024]; static u32 g_GaLen = 0, g_GaSaved = 0; static u64 g_GaSaveT = 0, g_GaT0 = 0;
    static bool WrBusyNow(); static void KbTick();
    static void GaSave() { if (g_GaLen == g_GaSaved || WrBusyNow()) return; g_GaSaved = g_GaLen; int l = static_cast<int>(g_GaLen);
        l += std::snprintf(g_GaTxt + l, sizeof(g_GaTxt) - l - 1, "G(度/回転) 上下: %.1f %.1f %.1f | 左右: %.1f %.1f %.1f | 状態 %d\n", static_cast<double>(g_GaG[1][0]), static_cast<double>(g_GaG[1][1]), static_cast<double>(g_GaG[1][2]), static_cast<double>(g_GaG[0][0]), static_cast<double>(g_GaG[0][1]), static_cast<double>(g_GaG[0][2]), static_cast<int>(g_GaSt));
        SdWriteAsync("inkd:/inkdraw/bin/gyrec.txt", g_GaTxt, static_cast<u32>(l)); }
    static void GaTick() {
        static u64 lastT = 0; static bool was = false, haveP = false, vset = false; static float py = 0.0f, pp = 0.0f; static int pn = 0; static bool learned = false, pitchOk = false;
        static float Wp[3] = {}, Wvp = 0.0f, SU = 0.0f, SD = 0.0f, Wh[4] = {};
        const bool on = g_GaOn, rec = g_GrOn; const u64 now = NowTick(); const int PN = 60;
        if (!on && !rec) { g_GaLock = false; g_GaW[0] = g_GaW[1] = g_GaW[2] = 0.0f; g_GaPW[0] = g_GaPW[1] = g_GaPW[2] = 0.0f; if (was) { was = false; GaSave(); } haveP = false; pn = 0; g_GaSt = 0; return; }
        if (now - g_GaSaveT > 3ull * 19200000ull) { g_GaSaveT = now; GaSave(); }
        if (!was) { was = true; haveP = false; pn = PN; learned = true; pitchOk = true; g_GaG[0][0] = 0.0f; g_GaG[0][1] = 0.0f; g_GaG[0][2] = -1080.0f; g_GaG[1][0] = 140.0f; g_GaG[1][1] = 0.0f; g_GaG[1][2] = 0.0f; g_GaLen = 0; g_GaSaved = 0; g_GaRows = 0; g_GaT0 = now; g_GaSaveT = now;
            g_GaLen = static_cast<u32>(std::snprintf(g_GaTxt, sizeof(g_GaTxt), "inkdraw ジャイロ記録 (版 %d)\n秒 | カメラ 左右 上下(度) | 前回からの変化(度) | 敵へのずれ 左右 上下(度) | 本物の角速度 xyz(回転/秒) | 足した角速度 xyz | 回った量 xyz(回転) | 止めて動かす軸 速さ\n", kInkVer)); }
        if (now - lastT < 200000ull) return; const float dtS = static_cast<float>(now - lastT) / 19200000.0f; lastT = now;
        float c[3]; if (!CamDir3(c)) { g_GaLock = false; g_GaW[0] = g_GaW[1] = g_GaW[2] = 0.0f; haveP = false; return; }
        const float ch = __builtin_sqrtf(c[0] * c[0] + c[2] * c[2]); if (ch < 0.05f) { g_GaLock = false; g_GaW[0] = g_GaW[1] = g_GaW[2] = 0.0f; haveP = false; return; }
        const float yaw = LookAtan2(c[2], c[0]), pit = LookAtan2(c[1], ch);
        float dY = 0.0f, dP = 0.0f; const bool okd = haveP && dtS < 0.1f; if (okd) { dY = LookWrap(yaw - py); dP = pit - pp; } py = yaw; pp = pit; haveP = true;
        float u[3]; for (int a = 0; a < 3; a++) u[a] = (g_GrReal[a] + Wp[a]) * dtS; /* 回った量 = (本物 + 足した角速度) x 1 フレームの時間 */
        /* 効きを覚える: 左右 = 角速度を足す方式 (3 軸を 1 軸ずつ)、上下 = 本物を止めて動かす方式 (3 軸を 1 軸ずつ。上下は角速度ではなく向きで決まるらしい)。
           1 軸ごとに 12 フレーム動かし、動き残りの 8 フレームまで足して、効き (度/回転) を出す */
        if (on && pn == 0) { SU = 0.0f; SD = 0.0f; }
        if (on && okd && pn < PN) { const int ph = pn / 20; if (ph < 3) { SU += u[ph]; SD += dY; } else { SU += Wvp * dtS; SD += dP; }
            if (pn % 20 == 19) { const float g = (SU > 0.002f || SU < -0.002f) ? SD / SU : 0.0f; if (ph < 3) g_GaG[0][ph] = g; else g_GaG[1][ph - 3] = g; SU = 0.0f; SD = 0.0f; } }
        float W[3] = { 0.0f, 0.0f, 0.0f }; float ey = 0.0f, ep = 0.0f; bool have = false; bool virt = false; int vax = 0; float vw = 0.0f;
        if (on) {
            if (g_LookOn) g_GaSt = 4;
            else if (pn < PN) { g_GaSt = 1; const int ph = pn / 20; if (ph < 3) { if (pn % 20 < 12) W[ph] = 0.2f; } else { virt = true; vax = ph - 3; vw = pn % 20 < 12 ? 0.08f : 0.0f; }
                pn++; if (pn >= PN) { float n0 = 0.0f, n1 = 0.0f; for (int a = 0; a < 3; a++) { n0 += g_GaG[0][a] * g_GaG[0][a]; n1 += g_GaG[1][a] * g_GaG[1][a]; } learned = n0 > 1e4f; (void)n1; g_GaG[1][0] = 140.0f; g_GaG[1][1] = 0.0f; g_GaG[1][2] = 0.0f; pitchOk = true; /* 上下は X 軸 336 度/回転 (本物の記録から) */ g_GaPRst = g_GaPRst + 1; /* 測り終わり: 重ねた回転を戻す */ } }
            else if (!learned) { g_GaSt = 3; if (++pn > 600) pn = 0; /* 効かない (モーション操作がオフ?): ときどき測り直す */ }
            else {
                float Tt[3]; const int sv = g_LookSlot; g_LookSlot = 6; const bool okT = LookTarget(Tt); g_LookSlot = sv;
                float Lb[3]; const uintptr_t cpl = g_CamPos; const bool okL = cpl && CamValid() && Readable(cpl, 12); if (okL) std::memcpy(Lb, reinterpret_cast<const void*>(cpl), 12);
                if (!okT || !okL || (g_LookAHold && !(g_BtnNow & 1ull))) g_GaSt = 5;
                else {
                    const float hdRaw = __builtin_sqrtf((Tt[0] - Lb[0]) * (Tt[0] - Lb[0]) + (Tt[2] - Lb[2]) * (Tt[2] - Lb[2])), kAimLeft = 0.35f * (hdRaw < 4.0f ? hdRaw / 4.0f : 1.0f), rgx = -c[2] / ch, rgz = c[0] / ch;
                    const float dx = (Tt[0] - rgx * kAimLeft) - Lb[0], dyy = (Tt[1] - kLiveHeight + 0.9f) - Lb[1], dz = (Tt[2] - rgz * kAimLeft) - Lb[2], hd = __builtin_sqrtf(dx * dx + dz * dz);
                    if (hd < 0.5f) g_GaSt = 5;
                    else { g_GaSt = 2; have = true; ey = LookWrap(LookAtan2(dz, dx) - yaw); ep = LookAtan2(dyy, hd) - pit;
                        { static float pe = 0.0f; static int bad = 0; const float er = (ey < 0 ? -ey : ey) + (ep < 0 ? -ep : ep); if (er > pe + 0.3f && er > 3.0f) bad++; else if (er < pe) bad = 0; pe = er; if (bad >= 25) { bad = 0; g_GaSt = 6; g_GaPRst = g_GaPRst + 1; } } /* ずれが広がり続けたら (効きが違う): やめて測り直す */
                        const float f = 0.25f / dtS; /* 遅れがあるので 1 フレームに詰めるのはずれの 15% (大きいと行き過ぎて左右にゆれる) */ const float* G0 = g_GaG[0]; const float* G1 = g_GaG[1];
                        { /* 左右: 角速度を足す。3 軸のうち効きの大きい軸にかたよらせて配る (最小の角速度) */
                            float m = 100.0f; for (int a = 0; a < 3; a++) m += G0[a] * G0[a]; static float vY = 0.0f; vY = vY * 0.5f + (dY / dtS) * 0.5f; float ry = (ey - 0.05f * vY) * (0.6f / dtS); if (ry > 1500.0f) ry = 1500.0f; if (ry < -1500.0f) ry = -1500.0f; const float v = ry / m; /* 1 秒に 200 度まで */
                            for (int a = 0; a < 3; a++) { float w = G0[a] * v; if (w > 3.0f) w = 3.0f; if (w < -3.0f) w = -3.0f; if (ey < 0.03f && ey > -0.03f) w = 0.0f; W[a] = w; } }
                        if (pitchOk) { /* 上下: 本物のジャイロを止めて、効きの大きい軸だけ動かす */
                            int ap = 0; for (int a = 1; a < 3; a++) if (G1[a] * G1[a] > G1[ap] * G1[ap]) ap = a;
                            static float vP = 0.0f; vP = vP * 0.5f + (dP / dtS) * 0.5f; float rp = (ep - 0.05f * vP) * (0.25f / dtS); if (rp > 1000.0f) rp = 1000.0f; if (rp < -1000.0f) rp = -1000.0f; float w = rp / G1[ap]; if (w > 8.0f) w = 8.0f; if (w < -8.0f) w = -8.0f; if (ep < 0.03f && ep > -0.03f) w = 0.0f; virt = true; vax = ap; vw = w; } }
                }
            }
        } else g_GaSt = 0;
        g_GaW[0] = W[0]; g_GaW[1] = W[1]; g_GaW[2] = W[2]; Wp[0] = W[0]; Wp[1] = W[1]; Wp[2] = W[2]; Wvp = virt ? vw : 0.0f; for (int i = 3; i > 0; i--) Wh[i] = Wh[i - 1]; Wh[0] = (virt && vax == 0) ? vw : 0.0f;
        g_GaPW[0] = g_GaPW[1] = g_GaPW[2] = 0.0f; if (on && !g_LookOn && virt) g_GaPW[vax] = vw;
        { static int hold = 0; if (on && !g_LookOn && g_GaSt == 2) hold = 20; else if (hold > 0) hold--; g_GaLock = on && !g_LookOn && hold > 0; } /* 敵を追っている間 (切れても 20 回分は続ける) */ /* 上下: 向きに重ねる回転の速さ */
        if ((rec || on) && g_GaLen < sizeof(g_GaTxt) - 600) { static u32 sk = 0; if ((sk++ & 1u) == 0) { g_GaRows = g_GaRows + 1;
            g_GaLen += static_cast<u32>(std::snprintf(g_GaTxt + g_GaLen, sizeof(g_GaTxt) - g_GaLen - 400, "%.2f | %.1f %.1f | %.2f %.2f | %.2f %.2f | %.3f %.3f %.3f | %.3f %.3f %.3f | %.4f %.4f %.4f | %d %.3f\n", static_cast<double>(now - g_GaT0) / 19200000.0, static_cast<double>(yaw), static_cast<double>(pit), static_cast<double>(dY), static_cast<double>(dP), static_cast<double>(have ? ey : 0.0f), static_cast<double>(have ? ep : 0.0f),
                static_cast<double>(g_GrReal[0]), static_cast<double>(g_GrReal[1]), static_cast<double>(g_GrReal[2]), static_cast<double>(W[0]), static_cast<double>(W[1]), static_cast<double>(W[2]), static_cast<double>(u[0]), static_cast<double>(u[1]), static_cast<double>(u[2]), virt ? vax : -1, static_cast<double>(vw))); } }
    }
    static void LookTickBody();
    void LookTick() { /* 2 つの流れ (ゲーム・HID) から同時に入らない。入っている最中なら、今回は何もしない */
        static volatile int busy = 0; if (__atomic_exchange_n(&busy, 1, __ATOMIC_ACQUIRE)) return;
        LookTickBody(); GaTick(); KbTick(); __atomic_store_n(&busy, 0, __ATOMIC_RELEASE);
    }
    static void LookTickBody() {
        static u64 lastT = 0; static bool was = false, haveP = false;
        static float kx = 1.2e-4f, ky = 1.0e-4f; /* スティック 1 あたりの、1 フレームで回る角度 (度)。符号で向きの逆設定も表す */
        static bool haveP2Init = false; static float pYaw = 0.0f, pPit = 0.0f; static int pCx = 0, pCy = 0, nX = 0, nY = 0; /* nX, nY: 測った回数 (最初の 3 回はそのまま使う) */
        AngTick();
        struct AimSave { char m[8]; float kx, ky; s32 nX, nY, vgi, vgk, pgi, pgk; };
        static bool aimLoaded = false; static u64 aimSavedT = 0;
        auto aimSave = [&] { const uintptr_t sdk = UpdSdk(); if (!sdk || !UpdMount(sdk)) return; AimSave a; std::memcpy(a.m, "INKAIM01", 8); a.kx = kx; a.ky = ky; a.nX = nX; a.nY = nY; a.vgi = g_VGoodI; a.vgk = g_VGoodK; a.pgi = -1; a.pgk = 0; /* 上下を直接書く場所は使わない (328 と同じ: 上下はスティックで合わせる) */ UpdWrite(sdk, "inkd:/inkdraw/bin/aim.dat", &a, sizeof(a)); };
        if (g_LookOn && !aimLoaded) { /* 前に覚えた回る速さと、向きを直接書ける場所を読む (使い始めの数秒、視点がおかしくならないように) */
            aimLoaded = true; const uintptr_t sdk = UpdSdk();
            if (sdk && UpdMount(sdk)) { AimSave a; if ((UpdReadSmall(sdk, "inkd:/inkdraw/bin/aim.dat", reinterpret_cast<char*>(&a), sizeof(a)) == static_cast<int>(sizeof(a))) && std::memcmp(a.m, "INKAIM01", 8) == 0) {
                if (a.kx == a.kx && a.kx > -1e-3f && a.kx < 1e-3f && (a.kx > 2e-6f || a.kx < -2e-6f)) { kx = a.kx; nX = a.nX > 3 ? 3 : a.nX; }
                if (a.ky == a.ky && a.ky > -1e-3f && a.ky < 1e-3f && (a.ky > 2e-6f || a.ky < -2e-6f)) { ky = a.ky; nY = a.nY > 3 ? 3 : a.nY; }
                if (g_VGoodI < 0 && a.vgi >= 0 && a.vgi + 2 < kAngN && (a.vgk == 2 || a.vgk == 3)) { g_VGoodI = a.vgi; g_VGoodK = a.vgk; } } }
        }
        { static int sVg = -2; if (g_LookOn && g_VGoodI >= 0 && g_VGoodI != sVg) { sVg = g_VGoodI; aimSavedT = NowTick(); aimSave(); } } /* 向きを直接書ける場所が見つかったら、すぐ保存 */
        if (g_LookOn && nX >= 3 && nY >= 3 && (!aimSavedT || NowTick() - aimSavedT > 60ull * 19200000ull)) { aimSavedT = NowTick(); aimSave(); } /* 覚えたら 1 分に 1 回まで書いておく */
