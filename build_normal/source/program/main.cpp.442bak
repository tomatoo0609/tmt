    static u8 g_EbBuf[512 + 32 * (32 + 0x1000) + 64]; /* チームサーチ / 敵の体の記録 / アサリサーチ で使う入れ物 */
    static void EbDump(const char* fname, int bytes, int maxN) { /* 見つけた「敵の体」を全部 (数えている物も、数えていない物も) 0x1000 バイトずつ SD の inkdraw/bin/enemybodies.bin に書く。ステージの地面などに出る偽物の box と本物の違いを探すため */
