                if (gen != g_LoadGen) { g_DfMsg = 6; return; }
                MemoryInfo mi; u32 page; if (R_FAILED(svcQueryMemory(&mi, &page, cur))) break;
                const uintptr_t end = mi.addr + mi.size; if (end <= cur || end == 0) break;
                const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC) && !(mi.addr < selfHi && end > selfLo);
                if (ok && mi.size >= 0x80) {
                    ScanSafe(mi.addr, mi.size / 4, 3, [&](const u32* w, size_t a, size_t b) {
                        for (size_t i = a; i < b && n < kDfMax; i++) {
                            float x; std::memcpy(&x, w + i, 4); const float dx = x - mx; if (!(dx < 5.0f && dx > -5.0f)) continue;
                            float z; std::memcpy(&z, w + i + 2, 4); const float dz = z - mz; if (!(dz < 5.0f && dz > -5.0f)) continue;
                            float y; std::memcpy(&y, w + i + 1, 4); const float dy = y - fy; if (!(dy < 3.0f && dy > -1.5f)) continue;
                            g_DfAddr[n] = mi.addr + i * 4; g_DfOld[n][0] = x; g_DfOld[n][1] = y; g_DfOld[n][2] = z; n++;
