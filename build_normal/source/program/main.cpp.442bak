    static char g_UpdHost[96], g_UpdPath[160]; static u32 g_UpdGotLen = 0, g_UpdWantLen = 0; /* エラー 41 のとき: 届いた大きさと、あるはずの大きさ */ static bool g_UpdOwnSsl = false; /* SSL を自分で準備したか (終わったら片付ける) */
    static u8* g_UpdBuf = nullptr; static u32 g_UpdCap = 0, g_UpdLen = 0;
    static u32 UpdCrc(const u8* p, u32 n) { u32 c = 0xFFFFFFFFu; for (u32 i = 0; i < n; i++) { c ^= p[i]; for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u))); } return ~c; }
    /* https://g_UpdHost/g_UpdPath/rel を取ってきて g_UpdBuf に入れる。0 なら成功、それ以外は失敗の番号 */
    static int UpdFetch(const char* rel, u32 maxLen, bool progress) {
        UpdApi& u = g_Ua;
        if (!g_UpdBuf || g_UpdCap < maxLen + 8192) {
            if (g_UpdBuf) u.freeF(g_UpdBuf);
            g_UpdCap = maxLen + 8192; g_UpdBuf = static_cast<u8*>(u.mallocF(g_UpdCap));
            if (!g_UpdBuf) { g_UpdCap = 0; return 10; }
        }
        g_UpdLen = 0;
        static u8 sa[16]; static bool saOk = false; /* 調べた住所は覚えておく (2 回目は調べない) */
        if (!saOk) {
            int last = 0;
            for (int tr = 0; tr < 6 && !saOk; tr++) { /* 失敗したら、少し待って調べ直す (ヒントあり / なし を交互に) */
                if (tr) u.sleepNs(700000000ll);
                u8 hints[0x30] = {}; const s32 fam = 2, typ = 1; std::memcpy(hints + 4, &fam, 4); std::memcpy(hints + 8, &typ, 4);
                void* res = nullptr;
