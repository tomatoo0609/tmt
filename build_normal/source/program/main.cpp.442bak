            const u64 a = ob; std::memcpy(out + ol, &a, 8); ol += 8; std::memcpy(out + ol, &acc, 4); ol += 4; std::memcpy(out + ol, reinterpret_cast<const void*>(ob + kEnOff), 12); ol += 12;
            const u32 mv = g_EnMoved[k], pl = g_EnPool[k]; std::memcpy(out + ol, &mv, 4); ol += 4; std::memcpy(out + ol, &pl, 4); ol += 4;
            std::memcpy(out + ol, reinterpret_cast<const void*>(ob), static_cast<size_t>(bytes)); ol += bytes; n++;
        }
        const u32 nn = static_cast<u32>(n); std::memcpy(out + cpos, &nn, 4);
        { std::memcpy(out + ol, "INKSELF1", 8); ol += 8; const u64 se = g_EnSelf; std::memcpy(out + ol, &se, 8); ol += 8; const u32 by = static_cast<u32>(bytes); std::memcpy(out + ol, &by, 4); ol += 4; } /* 自分の体 (分かっていれば) と、1 つの大きさ */
        if (CamValid() && Readable(g_CamPos - 0x40, 0x100)) { std::memcpy(out + ol, "INKCAM01", 8); ol += 8; const u64 ca = g_CamPos; std::memcpy(out + ol, &ca, 8); ol += 8; std::memcpy(out + ol, reinterpret_cast<const void*>(g_CamPos - 0x40), 0x100); ol += 0x100; } /* カメラの値 (目・追従先・画角など) */
