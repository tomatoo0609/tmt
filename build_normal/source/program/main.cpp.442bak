/* ノックバック記録の見張り: オフのときは何もしない。LR は呼び元の戻り先 (main の先頭からの位置で記録する) */
static inline void KbHook(exl::hook::InlineFloatCtx* c, u32 id, bool hasVec) {
    if (!g_KbOn) return;
    u64 x[4] = { c->X[0], c->X[1], c->X[2], c->X[3] }; const float s[3] = { c->S[0], c->S[1], c->S[2] };
    const uintptr_t mb = MainBase(); const uintptr_t lr = c->X[30];
    KbPut(id, static_cast<u32>(lr >= mb ? lr - mb : lr), x, s, hasVec ? static_cast<uintptr_t>(c->X[2]) : 0);
}
HOOK_DEFINE_INLINE(KbHook4) { static void Callback(exl::hook::InlineFloatCtx* c) { KbHook(c, 4, false); } };
