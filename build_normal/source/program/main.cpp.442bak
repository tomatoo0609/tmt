#include "lib.hpp"
namespace rtld { unsigned long lookup_global_auto(const char* name); }
namespace nvnhook { bool SplashOn(); bool UpdWanted(); void SplashManual(); } /* 後ろで作る */ /* 名前から関数の場所を探す (見つからなければ 0) */
#include "paint_image.hpp"
#include "sdimage.hpp"
#include "menu_text.hpp"
#include "font_glyphs.hpp"
#include "font_hd.hpp"

#include <cstring>

/*
 * inkdraw: ボタンを押すと、次に塗ったところを中心に好きな絵をインクで描く exlaunch モジュール。
 *
 * 対象: スプラトゥーン3 (0100C2500FC20000)、解析に使った main1130 のバージョンのみ。
 * ゲームが更新されたら、下のオフセットは探し直しが必要。
 *
 * 使い方: L スティック押し込み + R スティック押し込み (同時) で「予約」。
 *         そのあと床を塗ると (撃つ / ローラーを転がす)、その場所を中心に絵が描かれていく。
 *
 * 仕組み:
 *   Paint_Request (0x371D1C0) は「塗り要求」1件を通信に送り、自分の画面でも塗る関数。
 *   予約中に床塗りの要求が来たら、その要求のコピーを元に、位置だけずらしたコピーを
 *   画像の黒いピクセルの数だけ Paint_Request に渡す。通信にも送られるので友達にも見える。
 *   一度に全部送ると通信があふれるおそれがあるので、以後この関数が呼ばれるたびに
 *   kDotsPerCall 個ずつ送る。
 *   ボタンは nn::hid::GetNpadStates をフックして読む (ゲームが使っている関数)。
 */

#ifndef INKDRAW_HIDDRAW
#define INKDRAW_HIDDRAW 0
#endif
#ifndef INKDRAW_LIVEPOS
#define INKDRAW_LIVEPOS 0
#endif
#ifndef INKDRAW_SCAN
#define INKDRAW_SCAN 0
#endif
#ifndef INKDRAW_CAMPOS
#define INKDRAW_CAMPOS 0
#endif
#ifndef INKDRAW_DUMP
#define INKDRAW_DUMP 0
#endif
#ifndef INKDRAW_DIAG_GLYPH
#define INKDRAW_DIAG_GLYPH 0
#endif
#ifndef INKDRAW_BASELINE
#define INKDRAW_BASELINE 0
#endif
/* INKDRAW_BASELINE=1: 動いていた版 (22:30) と同じ動き (SD画像・自動描画・座標探索・バージョン判定なし) */

extern u64 g_CntFrame;

namespace {

    /* ---- オフセット (main1130 用。main モジュール先頭からの値) ---------------- */
    /* ゲームのバージョンごとの位置。起動時に Paint_Request の中身 (命令の並び) を調べて、合うほうを選ぶ。
       どれにも合わなければ、何もしない (落とさない)。 */
    struct GameOffsets {
        const char*  name;
        uintptr_t    paintRequest;   /* Paint_Request (通信 + 自分の画面) */
        uintptr_t    paintExecLocal; /* Paint_ExecLocal (自分の画面だけ)  */
        uintptr_t    paintMgrPtr;    /* g_PaintMgr (ポインタ)             */
    };
    constexpr GameOffsets kVersions[] = {
        { "1.3.0 (main1130)", 0x371D1C0, 0x371D320, 0x60FB568 },
        { "1.2.0 (main1120)", 0x371C880, 0x371C9E0, 0x60FA558 },
    };
    constexpr u32 kPaintRequestSig = 0x5A6A1F07; /* Paint_Request の先頭40命令の特徴 (どちらの版も同じ) */
    uintptr_t g_OffPaintRequest = 0, g_OffPaintExecLocal = 0, g_OffPaintMgrPtr = 0;

    /* 位置に依存する部分 (分岐先・アドレス) を消して、命令の並びだけを見る。 */
    u32 MaskInsn(u32 w) {
        if ((w & 0x9F000000) == 0x90000000) return w & 0x9F00001F;
        if ((w & 0x7C000000) == 0x14000000) return w & 0xFC000000;
        if ((w & 0xFF000010) == 0x54000000) return w & 0xFF00001F;
        if ((w & 0x7E000000) == 0x34000000) return w & 0xFF00001F;
        if ((w & 0x7E000000) == 0x36000000) return w & 0xFFF8001F;
        if ((w & 0x3B000000) == 0x18000000) return w & 0xFF00001F;
        if ((w & 0xFF800000) == 0x91000000) return w & 0xFFC003FF;
        return w;
    }
    u32 SignatureAt(uintptr_t off) {
        const u32* p = reinterpret_cast<const u32*>(exl::util::modules::GetTargetOffset(off));
        u32 x = 0x811C9DC5u;
        for (int i = 0; i < 40; i++)
            x = (x ^ MaskInsn(p[i])) * 0x01000193u;
        return x;
    }
    bool SelectVersion() {
        if (INKDRAW_BASELINE) {
            g_OffPaintRequest = 0x371D1C0; g_OffPaintExecLocal = 0x371D320; g_OffPaintMgrPtr = 0x60FB568;
            return true;
        }
        for (const auto& v : kVersions) {
            if (SignatureAt(v.paintRequest) == kPaintRequestSig) {
                g_OffPaintRequest = v.paintRequest;
                g_OffPaintExecLocal = v.paintExecLocal;
                g_OffPaintMgrPtr = v.paintMgrPtr;
                return true;
            }
        }
        return false;
    }

    /* SDK モジュール (ビルドID 574284B4) 内の nn::hid::GetNpadStates の位置。
       SDK の関数名表から確認した値で、モジュール先頭からのオフセット。 */
    constexpr uintptr_t kSdkHid[] = {
        0x5161D0, /* GetNpadStates(NpadFullKeyState*)  */
        0x5162B0, /* GetNpadStates(NpadHandheldState*) */
        0x516970, /* GetNpadStates(NpadJoyDualState*)  */
        0x516A50, /* GetNpadStates(NpadJoyLeftState*)  */
        0x516B30, /* GetNpadStates(NpadJoyRightState*) */
    };
    /* 各関数の最初の命令 (SDK が想定と同じか確かめる用)。違ったらフックを入れない。 */
    constexpr u32 kSdkHidFirst[] = { 0xD10083FF, 0xD10083FF, 0xD10083FF, 0xD10083FF, 0xD10083FF };
    constexpr int kHidCount = sizeof(kSdkHid) / sizeof(kSdkHid[0]);

    /* ---- 塗り要求の構造 (実機のダンプで確認) ---------------------------------- */
    constexpr size_t kReqSize   = 0x60;
    constexpr size_t kOffPos    = 0x08; /* float[3]: +0x08,+0x0c = 床の上の横方向2軸、+0x10 = 高さ */
    constexpr size_t kOffSize   = 0x14; /* float[2] 塗る大きさ                                    */
    constexpr size_t kOffKind   = 0x38; /* s32 種類                                               */
    constexpr size_t kOffObjFlag = 0x49;/* byte: 0 なら位置を直接指定した塗り                     */
    constexpr s32    kKindPoint = 1;

    /* ---- 調整用パラメータ --------------------------------------------------- */
    /* 予約するボタン (押し込みを同時): bit4 = L スティック押し込み, bit5 = R スティック押し込み */
    constexpr u64 kComboMask = (1ull << 0); /* A ボタン */
    constexpr u64 kComboMaskSticks = (1ull << 4) | (1ull << 5); /* L+R スティック押し込みでも予約できる */
    /* 撃っている間のボタン: R (bit7) / ZR (bit9)。撃っている間の塗りだけを、自分の座標探しに使う。 */
    constexpr u64 kFireMask = (1ull << 7) | (1ull << 9);
    /* true: 通信にも送る (友達にも見える)。false: 自分の画面だけ。 */
    constexpr bool kBroadcast = true;
    /* true: ボタンを押さなくても、ステージに入って最初に塗ったときに自動で描く。
       (ボタンを押せば、もう一度描ける) */
    /* true: 塗らなくても、ボタンを押した瞬間に描く (撃ったことが1回以上あるとき) */
    constexpr bool kDriveFromHid = INKDRAW_HIDDRAW;
    constexpr bool kAutoDraw = !INKDRAW_BASELINE;
    /* ドットとドットの間隔 (ゲーム内の距離)。 */
    constexpr float kStep = INKDRAW_BASELINE ? 0.7f : 1.0f;
    /* 1ドットの塗り大きさ。0 以下なら元の弾の大きさのまま。
       友達の画面では、受け取った塗りが丸いしぶきとして塗られるので、
       ドットの間隔より十分大きくして、つなげて塗りつぶす。 */
    constexpr float kDotSize = INKDRAW_BASELINE ? 1.5f : 1.9f; /* 点を少し大きくして、となりの点とつなげる */
    /* Paint_Request が1回呼ばれるたびに送るドット数。通信があふれるなら減らす。 */
    constexpr int kDotsPerCall = INKDRAW_BASELINE ? 32 : 12;
    /* 絵を何周送るか。通信で取りこぼしがあっても、2周目で埋まる。 */
    constexpr int kPasses = INKDRAW_BASELINE ? 1 : 2;

    /* ---- 画像ファイル (SD カード) -------------------------------------------- */
    /* SD カードの  sd:/inkdraw/image.png  (または image.bmp) を読む。
       白黒を反転したいときは image_inv.png / image_inv.bmp。 */
    constexpr const char* kMountName = "inkd";
    constexpr const char* kImagePaths[] = {
        "inkd:/inkdraw/image.png",     "inkd:/inkdraw/image.bmp",
        "inkd:/inkdraw/image_inv.png", "inkd:/inkdraw/image_inv.bmp",
    };
    constexpr bool kImageInvert[] = { false, false, true, true };
    constexpr int kMaxDim = sdimage::kMaxDim;
    constexpr size_t kMaxImageBytes = 1024; /* 文字の絵は 64 より大きいので余裕をもたせる */

    /* SDK (ビルドID 574284B4) の nn::fs の位置。SDK の関数名表から確認した値。 */
    constexpr uintptr_t kSdkMountSdCard = 0xEFB60; /* nn::fs::MountSdCard(const char*)                           */
    constexpr uintptr_t kSdkMountSdCardDbg = 0xEFFA0; /* nn::fs::MountSdCardForDebug(const char*) */
    constexpr uintptr_t kSdkOpenFile    = 0xAB0A0; /* nn::fs::OpenFile(FileHandle*, const char*, int)            */
    constexpr uintptr_t kSdkGetFileSize = 0xA9850; /* nn::fs::GetFileSize(long*, FileHandle)                     */
    constexpr uintptr_t kSdkReadFile    = 0xA94A0; /* nn::fs::ReadFile(unsigned long*, FileHandle, long, void*, unsigned long) */
    constexpr uintptr_t kSdkCloseFile   = 0xA9190; /* nn::fs::CloseFile(FileHandle)                              */

    struct FileHandle { void* handle; };

    struct PaintRequest {
        alignas(8) u8 raw[kReqSize];
    };

    /* ---- 状態 ---------------------------------------------------------------- */
    u32 g_SeqRef = 0; u64 g_SeqTick = 0; bool g_HaveSeq = false; u64 g_SeqFrame = 0; /* g_SeqFrame: g_SeqRef を見たときのゲームのフレーム数 */ u32 g_SeqTpf = 320000; /* 1フレームあたりの時計の数 (実測) */  /* ゲームが最後に出した塗り要求の +4 (60Hzのフレーム番号) と、その時刻 */
    bool g_PsOn = false; uintptr_t g_PsAddr = 0;
    volatile bool g_OpenEdge = false, g_SlideBusy = false; u64 g_CloseT = 0; volatile bool g_InBattle = false; volatile bool g_MarkOn = false; volatile bool g_Flk = false; volatile bool g_Wall = false; volatile bool g_Ruler = false; float g_RulerA[3] = {}; volatile bool g_RulerHave = false; volatile u32 g_WallN = 0; float g_FlkX = 0.0f, g_FlkZ = 0.0f; u32 g_PadDp[64] = {}; /* 視点移動 */ volatile u32 g_MarkCalls = 0, g_MarkSelfN = 0; bool g_MarkIsSelf = false, g_MarkPend = false;
    u32 g_DgNetTrue = 0, g_DgNetFalse = 0, g_DgSent = 0, g_DgQFull = 0, g_DgSkip = 0, g_DgQUsed = 0, g_DgQCap = 0, g_DgBegins = 0, g_DgFiles = 0, g_DgSeqFirst = 0, g_DgSeqLast = 0, g_DgHookPaint = 0;
    u64 g_DgBeginT = 0; u8 g_DgFirst[0x60], g_DgLast[0x60]; volatile int g_DgReq = 0; float g_DgStep = 0.0f, g_DgDot = 0.0f; int g_DgTotal = 0; bool g_DgHaveFirst = false;
    u8 g_DgBuf[0x400]; u8 g_ShotRaw[0x60]; u32 g_ShotN = 0, g_ShotNear = 0, g_ShotOwn = 0; u8 g_NearRaw[0x60]; u32 g_NearN = 0, g_NearCap = 0;
    /* 床ごとの番号 (+0x3e): 場所によって違うので、ゲームが出した塗りの位置と番号を覚えておき、点ごとに一番近いものの番号を使う */
    float g_FlS[256][3]; u16 g_FlId[256]; u64 g_FlT[256]; int g_FlN = 0, g_FlPos = 0;
    inline u64 NowTickF() { u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t)); return t; }
    inline u32 SeqLeadCap(u64 el) { const u64 l = el / 50u; return l > 300u ? 300u : static_cast<u32>(l); } /* 先に進める量の上限 (進めすぎると古い/未来の塗りとして捨てられる) */
    bool FloorIdAt(const float* p, u16* id) {
        int best = -1, old = -1; float bd = 1e9f, bo = 1e9f;
        const u64 nowT = NowTickF();
        for (int k = 0; k < g_FlN; k++) {
            const u64 age = nowT - g_FlT[k];
            const float dx = g_FlS[k][0] - p[0], dy = g_FlS[k][1] - p[1], dz = g_FlS[k][2] - p[2];
            if (dz > 4.0f || dz < -4.0f) continue;
            const float d = dx * dx + dy * dy + dz * dz * 4.0f;
            if (age <= 76800000ull) { if (d < 144.0f && d < bd) { bd = d; best = k; } } /* 4 秒以内: ふつうに使う */
            else if (dz < 2.5f && dz > -2.5f && d < 144.0f && d < bo) { bo = d; old = k; } /* 古い番号: 近くに新しいのが無いときだけ (床の番号は動かない床以外は変わらない) */
        }
        if (best < 0) best = old;
        if (best < 0) { /* 古くて遠い番号でも、何も無いよりまし (時間がたつと床の番号が消えて絵が出なくなるのを防ぐ) */ float bf = 1e9f; for (int k = 0; k < g_FlN; k++) { const float dx = g_FlS[k][0] - p[0], dy = g_FlS[k][1] - p[1], dz = g_FlS[k][2] - p[2]; if (dz > 4.0f || dz < -4.0f) continue; const float d = dx * dx + dy * dy + dz * dz * 4.0f; if (d < 900.0f && d < bf) { bf = d; best = k; } } }
        if (best < 0) return false;
        *id = g_FlId[best]; return true;
    }
    bool FloorIdAlt(const float* p, u16 used, u16* id) { /* すぐ近くに、別の番号の床があるか (小さい段差や、つながっていない塗りエリアのとなり) */
        const u64 nowT = NowTickF(); int best = -1; float bd = 1e9f;
        for (int k = 0; k < g_FlN; k++) {
            if (g_FlId[k] == used || nowT - g_FlT[k] > 76800000ull) continue;
            const float dx = g_FlS[k][0] - p[0], dy = g_FlS[k][1] - p[1], dz = g_FlS[k][2] - p[2];
            if (dz > 4.0f || dz < -4.0f) continue;
            const float d = dx * dx + dy * dy + dz * dz * 4.0f;
            if (d < 36.0f && d < bd) { bd = d; best = k; }
        }
        if (best < 0) return false; *id = g_FlId[best]; return true;
    }
    u64 g_BaseTick = 0, g_TmplTick = 0; /* 塗り要求の +4 は60Hzのフレーム番号。古い見本のままだと無視されるので、現在のフレームに直す */
    ALWAYS_INLINE u64 NowTick() { u64 t; asm volatile("mrs %0, cntpct_el0" : "=r"(t)); return t; }
    PaintRequest g_Base;                 /* 元にした塗り要求のコピー          */
    float        g_Origin[3];            /* 絵の中心                           */
    u64          g_BaseA2 = 0;           /* 元の塗りが Paint_Request に渡していた第2引数 (ビット0 = 通信に送る経路) */
    int          g_Cursor = -1;          /* 次に見るピクセル番号。-1 = 待機中 */
    volatile bool g_Armed = false;       /* ボタンで予約されたか              */
    uintptr_t    g_LastMgr = 0;          /* PaintMgr が作り直されたら状態を捨てる */
    bool         g_Emitting = false;     /* 自分で出した要求を再び横取りしないため */
    bool         g_HidDone[kHidCount] = {};
    bool         g_Fire[64] = {};
    volatile bool g_FireHeld = false;
    bool         g_RiseUp[64] = {};      /* 十字キー上を押している (コントローラーごと) */
    bool         g_RiseDn[64] = {};      /* 十字キー下を押している */
    volatile int g_RiseDir = 0;          /* +1 = 上がる / -1 = 下がる / 0 = 何もしない */
    u64          g_RiseTicks = 0, g_RiseLiveW = 0, g_RisePoW = 0; /* 診断: 上昇処理が走った回数 / 書き込んだ回数 */
    u64          g_BtnSeen = 0;          /* 診断: これまでに見えたボタンのビットの合計 (OR) */
    /* カメラの追従先の座標 (float x3 + 同じ高さ)。塊の +0x20 から 9 個の float が決まった値 (視野角 55.0 など) で並ぶので、それを目印に探す。 */
    uintptr_t    g_CamPos = 0;           /* 追従先の座標の位置 (x, 高さ, z) */
    int          g_CamHits = 0;
    float        g_CamOff = 0.0f;        /* 上げている量 */
    float        g_CamDelta = 0.0f;      /* 追従先の高さ - 足元の座標の高さ (上げ始めに測る) */
    bool         g_CamActive = false;
    u64          g_CamNextSearch = 0;
    constexpr bool kEnableTrk = true;    /* 追跡スキャン/二分探索 (十字キー左右) を使うか */
    constexpr bool kEnableCam = false;   /* カメラを上げる機能 (十字キー上下)。二分探索と操作が重なるので、探索中は切る */
    uintptr_t    g_CamRejA[4] = {}; int g_CamRejI = 0; /* 自分を追いかけていなかったので捨てたカメラ (最近の 4 個は候補から外す) */
    inline void CamReject(uintptr_t a) { if (a) { g_CamRejA[g_CamRejI & 3] = a; g_CamRejI++; } }
    uintptr_t    g_CamHitAddr[8] = {};   /* 見つかったカメラの塊 (候補から外すため) */
    int          g_CamHitN = 0;
    bool         g_PrevDL[64] = {};      /* 十字キー左/右の押した瞬間を見るため */
    bool         g_PrevDR[64] = {};
    bool         g_PrevUpE[64] = {};     /* 十字キー上/下の押した瞬間 (二分探索の答え) */
    bool         g_PrevDnE[64] = {};
    volatile bool g_ReqYes = false;      /* 十字キー上: 「動いた」 */
    volatile bool g_ReqNo = false;       /* 十字キー下: 「動かなかった」 */
    volatile bool g_ReqScan = false;     /* 十字キー左: 追跡スキャンを1歩進める */
    volatile bool g_ReqRefs = false;
    volatile bool g_ModeOn = false;         /* 飛ぶ (未完成)。最初は OFF: 十字キーや右スティックで、調査用の印 (ニコニコや四角) が出ないように */
    volatile int g_PendingGlyph = 0;
    /* 画面のメニュー */
    volatile bool g_MenuOpen = false; volatile int g_MenuSel = 0;
    volatile bool g_PchPanel = false; volatile int g_PchScroll = 0; volatile int g_PchSel = 0;
    bool Readable(uintptr_t a, size_t n); volatile uintptr_t g_SpdObj = 0; float g_SpdOrigAll[112] = {}; volatile int g_SpdGrp = 12; bool g_SpdHave = false; volatile float g_SpdMul = 1.0f; volatile bool g_LogClrReq = false; volatile int g_LogClrState = 0; volatile bool g_Trail = false; volatile int g_TrailWhy = 0, g_TrailN = 0; volatile u64 g_BtnNow = 0; volatile bool g_LookAHold = false; u64 g_BtnById[64] = {}; volatile int g_HSpd = 0; volatile u32 g_HState = 0, g_HCalls = 0; volatile bool g_HSpdReq = false; int g_HSpdLast = 4; volatile u32 g_HSpdFail = 0; volatile int g_Genki = 0; volatile bool g_GenkiReq = false; int g_GenkiLast = 6; /* 元気数値: 0 = OFF、1〜100 */
    u64 g_HoldStart[64][4] = {}, g_HoldNext[64][4] = {};
    /* インクリーナーの試し: トリカラの第3チーム (番号 2) の色で塗れば消えるかもしれない。チームが入っていそうな場所を順に試す */
    struct CleanOpt { u8 off, size, val; };
    constexpr CleanOpt kCleanOpts[] = {
        {0x01,1,2},{0x01,1,3},{0x02,1,2},{0x30,4,2},{0x30,4,3},{0x3C,2,2},{0x3C,2,3},{0x40,4,2},
        {0x40,4,3},{0x44,4,2},{0x44,4,3},{0x49,1,2},{0x4A,1,2},{0x4B,1,2},{0x54,4,2},{0x58,4,2},
    };
    constexpr int kCleanN = sizeof(kCleanOpts) / sizeof(kCleanOpts[0]);
    bool g_TeamOvr = false;
    uintptr_t g_CleanTeamPtr = 0; s32 g_CleanTeamOrig = 0; u64 g_CleanRestoreAt = 0; bool g_CleanTeamSet = false;
    /* メモリサーチ: 028595E0 (mov x19, x6) で x6 を拾う。開いたときの x6 の +0x4〜+0x1000 を表示して、いじれる */
    volatile uintptr_t g_X6Latest = 0; volatile u64 g_X6Calls = 0; volatile uintptr_t g_X6Ring[8] = {}; volatile int g_X6RingPos = 0;
    volatile int g_Fx[24] = {}; /* 便利機能の値 (0 = OFF) */ volatile int g_HudN = 0; char g_HudLine[10][64] = {}; volatile u64 g_HudBtn = 0; volatile float g_HudSt[4] = {};
    volatile bool g_Force60 = false; /* 広場も 60fps (メニューで切り替え) */ volatile int g_IntervalSeen = -1, g_IntervalGame = 0; void* g_WinForInterval = nullptr;
    volatile bool g_EraseReq = false, g_FillErase = false; volatile int g_EraseSel = 0; volatile u64 g_FillDiagUntil = 0; volatile int g_FillSkip = 0; int g_FillTy[6] = {}, g_FillTyN[6] = {};
