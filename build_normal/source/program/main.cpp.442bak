                });
            }
            cur = end;
        }
        if (gen != g_LoadGen || tok != g_ClTok || g_ClState != 1) return; /* 中止・時間切れのあとに終わった: 使わない */
        g_ClCpN = nc; g_ClState = 2;
    }
    void ClamPress() { g_ClReq = true; }
    void ClamTick() { /* 表の流れ: 押されたら探しを頼み、見つかったら 2 秒のあいだ、足元のまわりの輪の位置に書き続ける */
        const u64 now = NowTick();
        if (g_ClState == 1 && (g_ClGen != g_LoadGen || now - g_ClT > 40ull * 19200000ull)) { g_ClMsg = g_ClGen != g_LoadGen ? 5 : 6; g_ClState = 0; g_ClTok = g_ClTok + 1; } /* ロードした / 40 秒たっても終わらない: やめる (ずっと探し中のままだった) */
        if ((g_ClState == 2 || g_ClState == 3) && g_ClGen != g_LoadGen) { g_ClState = 0; g_ClMsg = 5; return; }
        if (g_ClReq) { g_ClReq = false; if (g_ClState == 1) return; float me[3]; if (!SelfPos(me)) { g_ClMsg = 3; return; } std::memcpy(g_ClMe, me, 12); g_ClGen = g_LoadGen; g_ClTok = g_ClTok + 1; g_ClT = now; g_ClState = 1; g_ClMsg = 1; if (!BgRequest(512u, nullptr)) { g_ClState = 0; g_ClMsg = 3; } return; }
        if (g_ClState == 2) {
            float me[3]; if (SelfPos(me)) std::memcpy(g_ClMe, me, 12);
            const float fy = g_ClMe[1] - kLiveHeight; int m = 0;
            for (int k = 0; k < g_ClN && k < kClMax; k++) { g_ClUse[k] = false; if (!Readable(g_ClObj[k], kClPos2 + 12) || *reinterpret_cast<const uintptr_t*>(g_ClObj[k]) != MainBase() + kClVt || *reinterpret_cast<const u32*>(g_ClObj[k] + 0x28) != kClTag) continue;
                const float* f = reinterpret_cast<const float*>(g_ClObj[k] + kClPos); if (ClamNearSelf(f)) continue;
                const int ring = m / 8, slot = m % 8; const float r = 0.8f + 0.4f * static_cast<float>(ring), a = (static_cast<float>(slot) + 0.5f * static_cast<float>(ring & 1)) * 0.7853982f; /* 8 個ずつ、輪を外へ広げる */
                g_ClTgt[k][0] = g_ClMe[0] + r * __builtin_cosf(a); g_ClTgt[k][1] = fy; g_ClTgt[k][2] = g_ClMe[2] + r * __builtin_sinf(a); g_ClUse[k] = true; m++; }
            g_ClGot = m; g_ClState = m > 0 ? 3 : 0; g_ClMsg = m > 0 ? 1 : 4; g_ClUntil = now + 2ull * 19200000ull; return;
        }
        if (g_ClState == 3) {
            if (now > g_ClUntil) { g_ClState = 0; g_ClMsg = 2; return; }
            for (int k = 0; k < g_ClN && k < kClMax; k++) { if (!g_ClUse[k]) continue; const uintptr_t ob = g_ClObj[k];
                if (!Readable(ob, kClPos2 + 12) || *reinterpret_cast<const uintptr_t*>(ob) != MainBase() + kClVt || *reinterpret_cast<const u32*>(ob + 0x28) != kClTag || !Writable(ob + kClPos, 12)) { g_ClUse[k] = false; continue; } /* 拾われた / 消えた */
