        }
        /* デザイン 14「アイス」: 青みの暗いパネル + 氷色のアクセント + 丸いピル */
                /* ドック: 白黒 + 光るふち (1分間に100色) */
        const Col panel { 0.043f, 0.047f, 0.055f }, border { 0.30f, 0.31f, 0.33f }, whiteG { 0.96f, 0.97f, 0.98f }, accent { 1.0f, 1.0f, 1.0f }, good { 0.85f, 0.88f, 0.90f };
        const Col dimG { 0.50f, 0.52f, 0.56f }, selBg { 0.93f, 0.94f, 0.95f }, ink { 0.05f, 0.055f, 0.065f };
        const Col white = whiteG, dim = dimG;
        const int glowStep = static_cast<int>((NowTick() / 11520000ull) % 100ull); /* 0.6 秒ごとに 1 色 */
        static const float kMcH[6] = { 0.0f, 0.52f, 0.78f, 0.36f, 0.92f, 0.08f }; /* メニューの色: 虹 / 水色 / 紫 / 緑 / ピンク / オレンジ */
        const Col glowC = g_MenuCol % 6 == 0 ? HueCol(glowStep / 100.0f, 0.80f, 1.0f) : HueCol(kMcH[g_MenuCol % 6], 0.80f, 1.0f);
        const int M = 4, MW = PchMenuW(), MWt = [] { const int a = 48 + U8W("プレイヤー") + 14, b = 18 + static_cast<int>(static_cast<float>(menu_text::kTITLE.w) * 1.25f) + 10 + U8W(kInkKind[0] == 'd' ? "beta dev" : kInkVerName) + 10; return a > b ? a : b; }(), /* 中身ぴったりの幅 */ MWc0 = MW, rowH = 38, head = 52, foot = 5, RW = 0, RG = 0, /* MWt: メインメニューの幅 (右の余白をけずった縦長)。MW: 2 個目のメニュー。foot: 下の余白 */ ty = (rowH - font_glyphs::kLineH) / 2;
        const int cnt = PageCount();
        static int prevCat = -1; static int catLast = -1; static u64 catBackT = 0;
        {
            const u64 nc = NowTick();
            if (prevCat >= 0 && g_Cat < 0) { catBackT = nc; catLast = prevCat; }
            if (g_Cat >= 0) catBackT = 0;
            prevCat = g_Cat;
        }
        const bool retract = g_Cat < 0 && catBackT != 0 && NowTick() - catBackT < 3840000ull;
        const int dCat = g_Cat >= 0 ? g_Cat : (retract ? catLast : -1);
        int cntB = 0; if (dCat >= 0) { cntB = CatCount(dCat); if (dCat == kPchCat && cntB > kPchVis) cntB = kPchVis; } /* pchtxt は 12 行ずつ (多いときは、選ぶ行について動く) */
        const int cntM = cnt > cntB ? cnt : cntB;
        const int MHt = head + rowH * kCatCount + foot, MHc = head + rowH * (cntB > 0 ? cntB : 1) + foot; /* 枠の高さは、中の行の数ぴったり (下に余白を作らない) */
        const int MH = dCat < 0 ? MHt : (MHt > MHc ? MHt : MHc), RH = MH; (void)cntM; (void)RH;
        const int PW = 360, gap = 10;
        const bool side = g_PchPanel || g_MemPanel || g_SelPanel != 0;
        static bool hadSide = false; static u64 sideCloseT = 0; static int snapH = 0; static u32 snapPx[360 * 700];
        { const u64 nq = NowTick(); if (hadSide && !side) sideCloseT = nq; if (side) sideCloseT = 0; hadSide = side; }
        const bool sideClosing = !side && sideCloseT && NowTick() - sideCloseT < 3840000ull && snapH > 0;
        const bool sideV = side || sideClosing;
        int sideH = 0; /* 3 つ目のメニューの高さ: 中身ぴったり (むだな余白を作らない) */
        if (side) { const int pr2 = g_MemPanel ? 26 : 34, nrow = g_MemPanel ? kMemRows : SelCount(); const int hh = head + pr2 * (nrow > 0 ? nrow : 1) + foot + (g_MemPanel ? 4 : 0), cap = PanelH(MH); sideH = hh > cap ? cap : hh; }
        const int sideHV = side ? sideH : snapH;
        const bool fvis = FuncVis(); const bool wide = side || fvis;
        g_BaseW = M * 2 + RW + RG + MWt + (dCat >= 0 ? MW + gap : 0) + (sideV ? gap + PW : (fvis ? gap + 300 : 0));
        g_BaseH = M * 2 + (sideV ? (sideHV > RH ? sideHV : RH) : (fvis ? (RH > 40 + 26 * 16 + 10 ? RH : 40 + 26 * 16 + 10) : RH));
        (void)wide;
