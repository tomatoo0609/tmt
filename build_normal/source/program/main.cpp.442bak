                        float* w = reinterpret_cast<float*>(ob + kBalOff); w[0] = tgt[j][0]; w[1] = tgt[j][1]; w[2] = tgt[j][2];
                        float* c = reinterpret_cast<float*>(ob + 0x40); c[0] = tgt[j][0]; c[1] = tgt[j][1] + 0.75526f; c[2] = tgt[j][2]; }
