                for (int q = 0; q < 3 && !ownSock; q++) { sockPool = u.alignedAlloc(0x1000, kPool[q]); if (!sockPool) continue; if (u.sockInit(sockPool, kPool[q], 0x20000, 4) == 0) ownSock = true; else { u.freeF(sockPool); sockPool = nullptr; } }
                if (!ownSock) { reinterpret_cast<DelFn>(sdk + 0xA9E80)(kBusy); g_UpdErr = 50; if (manual) UpdFinish(5, 4); else g_UpdState = 0; continue; }
            }
            g_UpdOwnSsl = false;
            if (!u.nifmAvail()) { netEnd(); reinterpret_cast<DelFn>(sdk + 0xA9E80)(kBusy); if (manual) UpdFinish(5, 3); else g_UpdState = 0; continue; }
            char vrel[96]; { /* 毎回ちがう名前で聞く。GitHub の配信サーバーは「?」のあとを無視して 5 分間、古い version.txt を返すので、
                  文字の一部を %76 のような書き方に変えて、サーバーが別のファイルと思うようにする (中身は同じ version.txt。毎回ちがう組みあわせにするので、いつも最新が来る) */
                static const char kV[] = "version"; u32 rnd = static_cast<u32>(NowTick()) * 2654435761u + 0x9E3779B9u; rnd ^= rnd >> 15; rnd *= 2246822519u; rnd ^= rnd >> 13;
                int o = 0; for (int q = 0; kV[q]; q++) { if ((rnd >> q) & 1u) { static const char hx[] = "0123456789abcdef"; vrel[o++] = '%'; vrel[o++] = hx[(kV[q] >> 4) & 15]; vrel[o++] = hx[kV[q] & 15]; } else vrel[o++] = kV[q]; }
                std::snprintf(vrel + o, sizeof(vrel) - static_cast<size_t>(o), ".txt?t=%lu", static_cast<unsigned long>(NowTick() / 19200000ull)); }
            int rc = UpdFetch(vrel, 4096, false);
            u32 nv = 0, nsz = 0, ncrc = 0; bool found = false;
            if (rc == 0) {
                const char* p = reinterpret_cast<const char*>(g_UpdBuf); int kl = 0; while (kInkKind[kl]) kl++;
                while (*p) {
                    while (*p == ' ' || *p == '\r' || *p == '\n' || *p == '\t') p++;
                    bool m = true; for (int i = 0; i < kl; i++) if (p[i] != kInkKind[i]) { m = false; break; }
                    if (m && (p[kl] == ' ' || p[kl] == '\t')) {
                        const char* q = p + kl; auto num = [&](int base) { u32 v = 0; while (*q == ' ' || *q == '\t') q++; for (;; q++) { int d = *q >= '0' && *q <= '9' ? *q - '0' : (base == 16 && *q >= 'a' && *q <= 'f' ? *q - 'a' + 10 : (base == 16 && *q >= 'A' && *q <= 'F' ? *q - 'A' + 10 : -1)); if (d < 0) break; v = v * static_cast<u32>(base) + static_cast<u32>(d); } return v; };
                        nv = num(10); nsz = num(10); ncrc = num(16); found = nv > 0 && nsz > 1024; break;
                    }
                    while (*p && *p != '\n') p++;
                }
            }
            if (rc == 0 && !found && kInkKind[0] == 'd') { netEnd(); reinterpret_cast<DelFn>(sdk + 0xA9E80)(kBusy); g_UpdNew = 0; if (manual) UpdFinish(6, 9); else g_UpdState = 0; continue; } /* 開発版: 配信は通常版だけなので、更新はない */
            if (rc != 0 || !found) { netEnd(); reinterpret_cast<DelFn>(sdk + 0xA9E80)(kBusy); g_UpdErr = rc ? rc : 40; if (manual) UpdFinish(5, 4); else g_UpdState = 0; continue; }
            if (nv <= static_cast<u32>(kInkVer)) { netEnd(); reinterpret_cast<DelFn>(sdk + 0xA9E80)(kBusy); g_UpdNew = nv; if (manual) UpdFinish(6, 0); else g_UpdState = 0; continue; }
            g_UpdNew = nv; g_UpdSel = 0; g_UpdState = 2; /* 「アップデートしますか?」 */
            while (g_UpdState == 2) u.sleepNs(50000000ll);
            if (g_UpdState != 3) { netEnd(); reinterpret_cast<DelFn>(sdk + 0xA9E80)(kBusy); g_UpdState = 0; continue; } /* いいえ */
            g_UpdGot = 0; g_UpdTot = nsz;
            char rel[64]; std::snprintf(rel, sizeof(rel), "%s/%u/subsdk9?v=%u", kInkKind, static_cast<unsigned>(nv), static_cast<unsigned>(nsz)); /* 版ごとに別の場所 (配信サーバーの古い写しを読まないように) */
            rc = UpdFetch(rel, nsz + 16, true);
            g_UpdGotLen = g_UpdLen; g_UpdWantLen = nsz;
            if (rc == 0 && g_UpdLen != nsz) rc = 41;
            if (rc == 0 && UpdCrc(g_UpdBuf, g_UpdLen) != ncrc) rc = 42;
            if (rc == 0 && std::memcmp(g_UpdBuf, "NSO0", 4) != 0) rc = 43;
            if (rc == 0) {
                static const char* const kDst = "inkd:/atmosphere/contents/0100C2500FC20000/exefs/subsdk9";
                static const char* const kNew = "inkd:/atmosphere/contents/0100C2500FC20000/exefs/subsdk9.new";
                if (u.renameF) { /* いったん別の名前で書いてから入れ替える (途中で止まっても、元のファイルが残る) */
                    if (!UpdWrite(sdk, kNew, g_UpdBuf, g_UpdLen)) rc = 44;
                    else { reinterpret_cast<DelFn>(sdk + 0xA9E80)(kDst); if (u.renameF(kNew, kDst) != 0) rc = UpdWrite(sdk, kDst, g_UpdBuf, g_UpdLen) ? 0 : 45; }
                } else if (!UpdWrite(sdk, kDst, g_UpdBuf, g_UpdLen)) rc = 45;
            }
            netEnd();
            reinterpret_cast<DelFn>(sdk + 0xA9E80)(kBusy);
            if (g_UpdBuf) { u.freeF(g_UpdBuf); g_UpdBuf = nullptr; g_UpdCap = 0; }
            g_UpdErr = rc; if (rc == 0) g_UpdSel = 0; UpdFinish(rc == 0 ? 7 : 5, rc == 0 ? 0 : 5); /* 終わったら「今すぐ再起動しますか?」 */
        }
    }
    /* 裏の流れ: 自分の座標・カメラ・足元を、ゲームを止めずに探す (読むだけなので、ゲームと同時に動いても安全)。優先度は低くして、ゲームのじゃまをしない */
    static volatile u32 g_BgReq = 0; static float g_BgRef[3] = {}; static volatile int g_BgState = 0; /* 0 まだ 1 動いている -1 使えない */
    void ClamScanSync(); void AsrScanSync(); void AdScanSync(); void DfScanSync(); void FootFindScanSync(); void ObjScanFull(); void TrkCollect(const float* L); extern volatile bool g_TrkBgDone; extern float g_TrkRef[3]; static volatile int g_ObjScanState = 0; /* 0 なし 1 頼んだ 2 終わった */ static volatile u32 g_ObjScanGen = 0; /* 頼んだときのロード番号 */
    constexpr int kBsMax = 160; /* バルーン召喚: バルーンの座標の写しを、メモリの中から探す */
    uintptr_t g_BsCopy[kBsMax]; float g_BsDy[kBsMax]; u8 g_BsOwner[kBsMax]; volatile int g_BsNc = 0, g_BsState = 0; float g_BsRefPos[8][3]; uintptr_t g_BsRefObj[8]; int g_BsRefN = 0;
    void BsScanSync() {
        const int nref = g_BsRefN; float P[8][3]; uintptr_t O[8]; std::memcpy(P, g_BsRefPos, sizeof(P)); std::memcpy(O, g_BsRefObj, sizeof(O));
        int nc = 0; MemoryInfo sm; u32 sp; uintptr_t selfLo = 0, selfHi = 0;
        if (R_SUCCEEDED(svcQueryMemory(&sm, &sp, reinterpret_cast<uintptr_t>(&g_BsNc)))) { selfLo = sm.addr; selfHi = sm.addr + sm.size; } /* このモッドの中は書き換えない */
        uintptr_t cur = 0;
        for (int guard = 0; guard < 8192 && nc < kBsMax; guard++) {
            MemoryInfo mi; u32 page; if (R_FAILED(svcQueryMemory(&mi, &page, cur))) break;
            const uintptr_t end = mi.addr + mi.size; if (end <= cur || end == 0) break;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC) && !(mi.addr < selfHi && end > selfLo);
            if (ok && mi.size >= 0x80) {
                const uintptr_t base = mi.addr;
                ScanSafe(base, mi.size / 4, 3, [&](const u32* w, size_t a, size_t b) {
                    for (size_t i = a; i < b && nc < kBsMax; i++) {
                        float x; std::memcpy(&x, w + i, 4);
                        for (int j = 0; j < nref; j++) {
                            const float dx = x - P[j][0]; if (!(dx <= 1e-4f && dx >= -1e-4f)) continue;
                            float y, z; std::memcpy(&y, w + i + 1, 4); std::memcpy(&z, w + i + 2, 4);
                            const float dz = z - P[j][2], dy = y - P[j][1]; if (!(dz <= 1e-4f && dz >= -1e-4f && dy <= 1.5f && dy >= -1.5f)) continue;
                            const uintptr_t a0 = base + i * 4; if (a0 >= O[j] && a0 < O[j] + 0x400) continue; /* バルーンの物の中は直接書く */
                            g_BsCopy[nc] = a0; g_BsDy[nc] = dy; g_BsOwner[nc] = static_cast<u8>(j); nc++; break;
                        }
                    }
                });
            }
            cur = end;
        }
        g_BsNc = nc;
    }
    static volatile u32 g_BgReq2 = 0; static volatile int g_Bg2Ok = 0; u64 g_TmObjS = 0, g_TmObjE = 0; /* 物 (敵・バルーン) 探し専用の流れ。g_Tm*: 時間の記録 (どこで時間がかかっているか調べる用) */
    static void BgWorker2(void*) {
        for (;;) {
            const u32 r = __atomic_exchange_n(&g_BgReq2, 0u, __ATOMIC_ACQ_REL);
            if (!r) { g_Ua.sleepNs(16000000ll); continue; }
            if (g_LoadT && NowTick() - g_LoadT < 28800000ull) { __atomic_or_fetch(&g_BgReq2, r, __ATOMIC_ACQ_REL); g_Ua.sleepNs(100000000ll); continue; }
            if (r & 16u) { g_TmObjS = NowTick(); ObjScanFull(); g_TmObjE = NowTick(); g_ObjScanState = 2; }
        }
    }
    static const char* volatile g_WrName = nullptr; static const void* volatile g_WrPtr = nullptr; static volatile u32 g_WrLen = 0; static volatile int g_WrBusy = 0; static bool WrBusyNow() { return g_WrBusy != 0; } /* 裏の流れで SD に書く物 */
    static void BgWorker(void*) {
        for (;;) {
            const u32 r = __atomic_exchange_n(&g_BgReq, 0u, __ATOMIC_ACQ_REL);
            if (!r) { g_Ua.sleepNs(16000000ll); continue; }
            if (r & 128u) { const uintptr_t sdk = UpdSdk(); if (g_WrName && sdk && UpdMount(sdk)) UpdWrite(sdk, g_WrName, g_WrPtr, g_WrLen); g_WrBusy = 0; if (!(r & ~128u)) continue; } /* SD への書き込みは、ロードの直後でも待たずに */
            if (g_LoadT && NowTick() - g_LoadT < 48000000ull) { __atomic_or_fetch(&g_BgReq, r & ~128u, __ATOMIC_ACQ_REL); g_Ua.sleepNs(100000000ll); continue; } /* ロードの直後はメモリが入れかわるので、3 秒待ってから探す (読んでいる所を手放されて落ちた) */
            const u32 gen = g_LoadGen; /* 探している間にロードしたら、その結果はロード前の物なので捨てる */
            if (r & 8u) { float ref[3]; std::memcpy(ref, g_BgRef, 12); FindLivePosSync(ref); if (gen != g_LoadGen) __atomic_or_fetch(&g_BgClear, 4u, __ATOMIC_ACQ_REL); }
            if ((r & 4u) && !LiveValid()) { FindLivePosSync(nullptr); if (gen != g_LoadGen) __atomic_or_fetch(&g_BgClear, 4u, __ATOMIC_ACQ_REL); }
            if ((r & 1u) && !CamValid()) { CamFindScanSync(); if (gen != g_LoadGen) __atomic_or_fetch(&g_BgClear, 1u, __ATOMIC_ACQ_REL); }
            if ((r & 2u) && !FootValid()) { FootFindScanSync(); if (gen != g_LoadGen) __atomic_or_fetch(&g_BgClear, 2u, __ATOMIC_ACQ_REL); }
            if (r & 32u) { float ref[3]; std::memcpy(ref, g_TrkRef, 12); TrkCollect(ref); if (gen != g_LoadGen) g_NTrk = 0; g_TrkBgDone = true; } /* バグフライの写し集め (重いので裏で) */
            if (r & 64u) { BsScanSync(); g_BsState = 2; }
            if (r & 512u) ClamScanSync(); /* アサリ集めの、アサリ探し */
            if (r & 1024u) AdScanSync(); /* アサリ詳細サーチ */
            if (r & 2048u) DfScanSync(); /* アサリ差分サーチ */
            if (r & 256u) AsrScanSync(); /* アサリサーチ */ /* バルーン召喚の写し探し */
            if (r & 16u) { ObjScanFull(); g_ObjScanState = 2; } /* 敵・バルーン・レティクルの物を、全体から一気に探す (裏なので止まらない) */
        }
    }
    bool BgRequest(u32 bits, const float* ref);
    /* ---- ノックバック記録: ゲームの 4 か所 (KnockBackHelper の入口 2 つと、その結果 2 つ) に見張りを付け (フックの置き場は全体で 20 個までなので 4 か所だけ)、呼ばれたときの値を輪の入れ物に覚える。
       オンの間 3 秒ごとに (増えていれば) 文字にして inkdraw/bin/kbrec.txt に書く。オフのときは見張りは何もしない。 */
    struct KbRec { u64 t; u32 id, lr; u64 x[4]; float s[3]; float v[3]; };
    static constexpr int kKbCap = 1024;
    static KbRec g_KbRing[kKbCap]; volatile u32 g_KbPos = 0; static u64 g_KbT0 = 0;
    static char g_KbTxt[200 * 1024]; static u32 g_KbSaved = 0; static volatile u32 g_KbWr = 0; static u64 g_KbSaveT = 0;
    static void KbPut(u32 id, u32 lr, const u64* x, const float* s, uintptr_t vp) {
        if (!g_KbOn) return;
        const u32 i = __atomic_fetch_add(&g_KbPos, 1u, __ATOMIC_RELAXED); KbRec& r = g_KbRing[i % kKbCap];
        r.t = NowTick() - g_KbT0; r.id = id; r.lr = lr; for (int k = 0; k < 4; k++) r.x[k] = x[k]; for (int k = 0; k < 3; k++) r.s[k] = s[k];
        if (vp && Readable(vp, 12)) std::memcpy(r.v, reinterpret_cast<const void*>(vp), 12); else { r.v[0] = r.v[1] = r.v[2] = 0.0f; }
    }
    static void KbSave() {
        const u32 n = g_KbPos; if (n == g_KbSaved || g_WrBusy) return; g_KbSaved = n;
        const u32 cnt = n > static_cast<u32>(kKbCap) ? static_cast<u32>(kKbCap) : n; const u32 from = n - cnt; int len = 0;
        len += std::snprintf(g_KbTxt, sizeof(g_KbTxt), "inkdraw ノックバック記録 (版 %d) 合計 %u 件\n番号 秒 | 場所 | 呼び元(main+) | x0 x1 x2 x3 | s0 s1 s2 | x2 の指す 3 つの数\n場所: 4=入口B(21c4b3c) の呼び出し 5=入口C(21c4c68) の呼び出し 6=入口Bの結果(s0-s2=速度) 7=入口Cの結果(s0-s2=速度)。呼び元(main+) が武器ごとの違い\n", kInkVer, n);
        for (u32 q = 0; q < cnt && len < static_cast<int>(sizeof(g_KbTxt)) - 400; q++) {
            const KbRec& r = g_KbRing[(from + q) % kKbCap];
            len += std::snprintf(g_KbTxt + len, sizeof(g_KbTxt) - len, "%u %.3f | %u | %x | %llx %llx %llx %llx | %.3f %.3f %.3f | %.3f %.3f %.3f\n", from + q, static_cast<double>(r.t) / 19200000.0, r.id, r.lr,
                static_cast<unsigned long long>(r.x[0]), static_cast<unsigned long long>(r.x[1]), static_cast<unsigned long long>(r.x[2]), static_cast<unsigned long long>(r.x[3]),
                static_cast<double>(r.s[0]), static_cast<double>(r.s[1]), static_cast<double>(r.s[2]), static_cast<double>(r.v[0]), static_cast<double>(r.v[1]), static_cast<double>(r.v[2]));
        }
        SdWriteAsync("inkd:/inkdraw/bin/kbrec.txt", g_KbTxt, static_cast<u32>(len)); g_KbWr = g_KbWr + 1;
    }
    static volatile bool g_KbFinal = false; static void KbReset(bool on) { if (on) { g_KbPos = 0; g_KbSaved = 0xFFFFFFFFu; g_KbT0 = NowTick(); g_KbSaveT = NowTick(); g_KbFinal = false; } else g_KbFinal = true; /* オフ: 最後の分は KbTick が書く */ }
    static void KbTick() { if (!g_KbOn) { if (g_KbFinal) { KbSave(); if (g_KbSaved == g_KbPos) g_KbFinal = false; } return; } const u64 now = NowTick(); if (now - g_KbSaveT < 3ull * 19200000ull) return; g_KbSaveT = now; KbSave(); }
    static void SdWriteAsync(const char* name, const void* p, u32 len) { /* 書く物 (p) は、書き終わるまで変えないこと (どれも static の入れ物) */
        if (!g_WrBusy) { g_WrName = name; g_WrPtr = p; g_WrLen = len; g_WrBusy = 1; if (BgRequest(128u, nullptr)) return; g_WrBusy = 0; }
        const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) UpdWrite(sdk, name, p, len); /* 裏の流れが使えない / 前の物を書いている途中: ここで書く */
    }
    bool BgRequest(u32 bits, const float* ref) {
        if (g_BgState == 0) { /* 最初に頼まれたときに、裏の流れを作る */
            g_BgState = -1;
            if (UpdResolve()) { alignas(16) static u8 th[0x400]; alignas(0x1000) static u8 stk[0x20000];
                if (g_Ua.thCreate(th, BgWorker, nullptr, stk, sizeof(stk), 28) == 0) { g_Ua.thStart(th); g_BgState = 1;
                    alignas(16) static u8 th2[0x400]; alignas(0x1000) static u8 stk2[0x20000];
                    if (g_Ua.thCreate(th2, BgWorker2, nullptr, stk2, sizeof(stk2), 28) == 0) { g_Ua.thStart(th2); g_Bg2Ok = 1; } } }
        }
        if (g_BgState != 1) return false;
        if (ref) std::memcpy(g_BgRef, ref, 12);
        if ((bits & 16u) && g_Bg2Ok) { __atomic_or_fetch(&g_BgReq2, 16u, __ATOMIC_ACQ_REL); bits &= ~16u; }
        if (bits) __atomic_or_fetch(&g_BgReq, bits, __ATOMIC_ACQ_REL);
        return true;
    }
    /* 毎フレーム (ボタン読み取りの側): 起動して 15 秒たったら 1 回だけ、自動で確かめる */
    void UpdTick() {
        static u64 t0 = 0; static bool started = false, autoDone = false;
        const u64 now = NowTick(); if (!t0) t0 = now;
        if ((g_UpdState == 4 || g_UpdState == 5 || g_UpdState == 6 || g_UpdState == 8) && now - g_UpdT > 8ull * 19200000ull) g_UpdState = 0; /* 結果は 8 秒で消す */
        if (g_UpdRestartReq) { /* 再起動: ソフトを自分で起動し直す (SDK の関数を名前で探して呼ぶ。見つからなければ、手で再起動してもらう) */
            g_UpdRestartReq = false;
            using Fn0 = void (*)(); using Fn2 = void (*)(const void*, unsigned long);
            const uintptr_t f1 = SdkSym("_ZN2nn2oe20RestartProgramNoArgsEv");
            const uintptr_t f2 = f1 ? 0 : SdkSym("_ZN2nn2oe28RequestToRelaunchApplicationEv");
            const uintptr_t f3 = (f1 || f2) ? 0 : SdkSym("_ZN2nn2oe14RestartProgramEPKvm");
            if (f1) reinterpret_cast<Fn0>(f1)();
            else if (f2) reinterpret_cast<Fn0>(f2)();
            else if (f3) { static const char kArg[1] = { 0 }; reinterpret_cast<Fn2>(f3)(kArg, 0); }
            g_UpdState = 8; g_UpdT = now; /* ここまで来た = 再起動しなかった */
        }
        const bool want = g_UpdManual || (!autoDone && now - t0 > 4ull * 19200000ull); /* 起動の表示を出している間に確かめる */
        if (!want) return;
        if (!started) {
            if (!UpdResolve()) { autoDone = true; if (g_UpdManual) { g_UpdManual = false; UpdFinish(5, 6); } return; }
            alignas(16) static u8 th[0x400]; alignas(0x1000) static u8 stk[0x10000];
            if (g_Ua.thCreate(th, UpdWorker, nullptr, stk, sizeof(stk), 24) != 0) { autoDone = true; g_UpdManual = false; UpdFinish(5, 6); return; }
            g_Ua.thStart(th); started = true;
        }
        if (g_UpdState == 0 || g_UpdState >= 4) {
            if (g_UpdManual) { g_UpdManual = false; g_UpdState = 1; g_UpdReq = 2; }
            else if (!autoDone) { autoDone = true; g_UpdAutoPhase = 1; g_UpdReq = 1; }
        } else g_UpdManual = false;
        autoDone = true;
    }
    /* ===== アドレスサーチ (ツール): 自分の座標が入っている場所を、メモリ全体から探す =====
       1) 止まっている間に、カメラの追従先 (自分の近く) とほぼ同じ値の float 3 つを全部集める
       2) 歩き回っている 10 秒の間、0.5 秒ごとに「追従先と同じだけ動いた」ものだけを残す
       3) 残ったものを SD の inkdraw/bin/addrsearch.txt に書く (場所、今の値、前にある main の vtable らしい値) */
    constexpr int kAsMax = 16384;
    static uintptr_t g_AsAddr[kAsMax]; static float g_AsPrev[kAsMax][3];
    volatile int g_AsStep = 0, g_AsN = 0, g_AsSample = 0; volatile bool g_AsOver = false; static u64 g_AsT = 0; static float g_AsRef[3];
    static bool AsRef(float* r) {
        if (CamValid()) { std::memcpy(r, reinterpret_cast<const void*>(g_CamPos), 12); return true; }
        if (LiveValid()) { std::memcpy(r, reinterpret_cast<const void*>(__atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE)), 12); return true; }
        return false;
    }
    static void AsCollect() {
        g_AsN = 0; g_AsOver = false;
        MemoryInfo selfmi; u32 selfpg; uintptr_t selfLo = 0, selfHi = 0;
        if (R_SUCCEEDED(svcQueryMemory(&selfmi, &selfpg, reinterpret_cast<uintptr_t>(&g_AsAddr[0])))) { selfLo = selfmi.addr; selfHi = selfmi.addr + selfmi.size; }
        const float rx = g_AsRef[0], ry = g_AsRef[1], rz = g_AsRef[2];
        uintptr_t addr = 0;
        for (int guard = 0; guard < 8192 && !g_AsOver; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC) && !(selfHi && mi.addr >= selfLo && end <= selfHi);
            if (ok && mi.size >= 0x100) {
                ScanSafe(mi.addr, mi.size / 4, 3, [&](const u32* w, size_t from, size_t to) {
                    const float* f = reinterpret_cast<const float*>(w);
                    for (size_t i = from; i < to; i++) {
                        const float x = f[i]; if (!(x > rx - 2.5f && x < rx + 2.5f)) continue;
                        const float z = f[i + 2]; if (!(z > rz - 2.5f && z < rz + 2.5f)) continue;
                        const float y = f[i + 1]; if (!(y > ry - 4.0f && y < ry + 4.0f)) continue;
                        if (g_AsN >= kAsMax) { g_AsOver = true; return; }
                        g_AsAddr[g_AsN] = mi.addr + i * 4; g_AsPrev[g_AsN][0] = x; g_AsPrev[g_AsN][1] = y; g_AsPrev[g_AsN][2] = z; g_AsN = g_AsN + 1;
                    }
                });
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
    }
    static void AsFilter(const float* d) {
        const bool moved = d[0] * d[0] + d[2] * d[2] > 0.09f;
        int n = 0; uintptr_t okPage = 0;
        for (int k = 0; k < g_AsN; k++) {
            const uintptr_t a = g_AsAddr[k];
            if ((a & ~0xFFFull) != okPage) { if (!Readable(a & ~3ull, 12)) continue; okPage = a & ~0xFFFull; }
            const float* f = reinterpret_cast<const float*>(a);
            const float vx = f[0] - g_AsPrev[k][0], vy = f[1] - g_AsPrev[k][1], vz = f[2] - g_AsPrev[k][2];
            bool keep;
            if (moved) keep = __builtin_fabsf(vx - d[0]) + __builtin_fabsf(vz - d[2]) < 0.8f && __builtin_fabsf(vy - d[1]) < 1.5f; /* 追従先と同じだけ動いた */
            else keep = vx * vx + vz * vz < 0.25f; /* 止まっていたのに大きく動いたものは捨てる */
            if (!keep) continue;
            g_AsAddr[n] = a; g_AsPrev[n][0] = f[0]; g_AsPrev[n][1] = f[1]; g_AsPrev[n][2] = f[2]; n++;
        }
        g_AsN = n;
    }
    static void AsWrite() {
        static char t[24 * 1024]; int L = 0;
        auto put = [&](const char* fm, auto... a) { if (L < static_cast<int>(sizeof(t)) - 200) L += std::snprintf(t + L, sizeof(t) - L, fm, a...); };
        const uintptr_t mb = exl::util::GetModuleInfo(exl::util::ModuleIndex::Main).m_Total.m_Start, me = mb + exl::util::GetModuleInfo(exl::util::ModuleIndex::Main).m_Total.m_Size;
        put("inkdraw アドレスサーチ (版 %d)  残り %d 件%s\n基準 (カメラの追従先) %.2f %.2f %.2f\n今の足元の座標の場所 (g_LivePos) 0x%lx / 追従先の場所 0x%lx\n\n", kInkVer, static_cast<int>(g_AsN), g_AsOver ? " (集めすぎて途中まで)" : "", g_AsRef[0], g_AsRef[1], g_AsRef[2], static_cast<unsigned long>(__atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE)), static_cast<unsigned long>(g_CamPos));
        { /* まとめ: いちばん近い「main の値」と距離の組ごとに数える (ロードやステージを変えても同じ組が出てくれば、それで探せる) */
            static uintptr_t kv[256]; static u32 kd[256]; static int kc[256]; int kn = 0;
            for (int k = 0; k < g_AsN; k++) {
                const uintptr_t a = g_AsAddr[k]; if (!Readable(a & ~3ull, 12)) continue;
                for (uintptr_t q = (a & ~7ull); q + 0x800 > a && q >= 0x10000; q -= 8) {
                    if (!Readable(q, 8)) break; const uintptr_t v = *reinterpret_cast<const uintptr_t*>(q);
                    if (v >= mb && v < me) { const uintptr_t vo = v - mb; const u32 dd = static_cast<u32>(a - q); int j = 0; for (; j < kn; j++) if (kv[j] == vo && kd[j] == dd) break; if (j == kn && kn < 256) { kv[kn] = vo; kd[kn] = dd; kc[kn] = 0; kn++; } if (j < 256) kc[j]++; break; }
                }
            }
            for (int x = 0; x < kn; x++) for (int y = x + 1; y < kn; y++) if (kc[y] > kc[x]) { const uintptr_t t1 = kv[x]; kv[x] = kv[y]; kv[y] = t1; const u32 t2 = kd[x]; kd[x] = kd[y]; kd[y] = t2; const int t3 = kc[x]; kc[x] = kc[y]; kc[y] = t3; }
            put("[まとめ] main+オフセット @距離 : 件数\n");
            for (int x = 0; x < kn && x < 40; x++) put("main+0x%lx @-0x%x : %d\n", static_cast<unsigned long>(kv[x]), static_cast<unsigned>(kd[x]), kc[x]);
            put("\n");
        }
        put("場所 | 今の値 x y z | 前にある main の値 (vtable らしい物: main+オフセット @ この場所からの距離)\n");
        for (int k = 0; k < g_AsN && k < 300; k++) {
            const uintptr_t a = g_AsAddr[k];
            if (!Readable(a & ~3ull, 12)) continue;
            const float* f = reinterpret_cast<const float*>(a);
            put("0x%lx | %.3f %.3f %.3f |", static_cast<unsigned long>(a), f[0], f[1], f[2]);
            int shown = 0;
            for (uintptr_t q = (a & ~7ull); q + 0x800 > a && q >= 0x10000 && shown < 2; q -= 8) {
                if (!Readable(q, 8)) break;
                const uintptr_t v = *reinterpret_cast<const uintptr_t*>(q);
                if (v >= mb && v < me) { put(" main+0x%lx @-0x%lx", static_cast<unsigned long>(v - mb), static_cast<unsigned long>(a - q)); shown++; }
            }
            if (a == __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE)) put("  <- 今の足元の座標");
            put("\n");
        }
        static int nth = 0; nth++; char nm[64]; std::snprintf(nm, sizeof(nm), "inkd:/inkdraw/bin/addrsearch_%d.txt", nth); /* 何回目かの番号付きでも残す (くらべるため) */
        const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) { UpdWrite(sdk, "inkd:/inkdraw/bin/addrsearch.txt", t, static_cast<u32>(L)); UpdWrite(sdk, nm, t, static_cast<u32>(L)); }
    }
    void AsTick() {
        if (g_AsStep == 0 || g_AsStep >= 9) return;
        const u64 now = NowTick();
        if (g_AsStep == 1) { /* 0.5 秒止まってから集める。カメラも座標もわからなければ、ここで探す (1 秒ごと、8 回まで) */
            static int tries = 0; static u64 nextTry = 0;
            if (now - g_AsT < 9600000ull) return;
            if (!AsRef(g_AsRef)) {
                if (now < nextTry) return; nextTry = now + 19200000ull;
                if (++tries > 8) { tries = 0; g_AsStep = 10; return; }
                if (!LiveValid()) { g_LivePos = 0; FindLivePos(nullptr); TryLiveAlt(); }
                if (!CamValid()) CamFind();
                return;
            }
            tries = 0; AsCollect(); g_AsSample = 0; g_AsT = now; g_AsStep = 2; return;
        }
        if (g_AsStep == 2) {
            if (now - g_AsT < 9600000ull) return; g_AsT = now;
            float r[3]; if (!AsRef(r)) return;
            const float d[3] = { r[0] - g_AsRef[0], r[1] - g_AsRef[1], r[2] - g_AsRef[2] }; std::memcpy(g_AsRef, r, 12);
            AsFilter(d); g_AsSample = g_AsSample + 1;
            if (g_AsSample >= 20 || g_AsN <= 1) { AsWrite(); g_AsStep = 9; }
        }
    }
    /* 足元の座標 (床の高さ): アドレスサーチの結果、vtable が main+0x5BF8770 の物の +0x18 に、床の高さぴったりの自分の座標が入っていた
       (3 回とも同じ場所で、ロードやステージを変えても変わらなかった)。カメラの追従先の真下 (1〜4 低い) にある物を選ぶ */
    constexpr uintptr_t kFootVt = 0x5BF8770; constexpr uintptr_t kFootOff = 0x18;
    uintptr_t g_FootPos = 0;
    bool FootValid() {
        const uintptr_t fp = g_FootPos; if (!fp || !Readable(fp - kFootOff, 0x30)) return false;
        if (*reinterpret_cast<const uintptr_t*>(fp - kFootOff) != MainBase() + kFootVt) return false;
        const float* f = reinterpret_cast<const float*>(fp); if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2] && f[0] > -5000.0f && f[0] < 5000.0f && f[1] > -5000.0f && f[1] < 5000.0f && f[2] > -5000.0f && f[2] < 5000.0f)) return false;
        { /* カメラの追従先から横に 3 以上はなれたままが 1.5 秒続いたら、違う物 (ロードのあとに別のプレイヤーの物になった など) なので忘れて探し直す */
            static u64 badT = 0; const uintptr_t cp = g_CamPos;
            if (cp && Readable(cp, 12)) { const float* C = reinterpret_cast<const float*>(cp); const float dx = C[0] - f[0], dz = C[2] - f[2];
                if (dx * dx + dz * dz > 9.0f && ReadTls() == g_TlsFrame) { const u64 nw = NowTick(); if (!badT) badT = nw; else if (nw - badT > 28800000ull) { badT = 0; if (g_FootPos == fp) g_FootPos = 0; return false; } } else badT = 0; } /* 消すのは表の流れだけ */
        }
        return true;
    }
    bool SelfValid() { return FootValid() || LiveValid(); }
    bool SelfPos(float* o) {
        if (FootValid()) { std::memcpy(o, reinterpret_cast<const void*>(g_FootPos), 12); o[1] += kLiveHeight; return true; } /* 今までの座標と同じ高さ (床 + kLiveHeight) にそろえる */
        const uintptr_t lp = __atomic_load_n(&g_LivePos, __ATOMIC_ACQUIRE); if (!LiveValid()) return false;
        std::memcpy(o, reinterpret_cast<const void*>(lp), 12); return true;
    }
    void FootFind() {
        if (!CamValid()) return;
        static u64 nextT = 0; static int fails = 0; const u64 now = NowTick(); if (now < nextT) return; /* メモリ全体を調べるので重い: 見つからないことが続いたら、30 秒に 1 回にする (一定間隔で固まらないように) */
        FootFindScan(); if (FootValid()) fails = 0; else fails++;
        nextT = now + ((fails > 2 && now - g_LoadT > 40ull * 19200000ull) ? 30ull : 2ull) * 19200000ull;
    }
    static uintptr_t g_FootRegLo = 0, g_FootRegHi = 0;
    void FootFindScanSync() {
        const uintptr_t cpF = g_CamPos; if (!CamValid() || !cpF || !Readable(cpF, 12)) return;
        const float* C = reinterpret_cast<const float*>(cpF); const float cx = C[0], cy = C[1], cz = C[2];
        const uintptr_t vt = MainBase() + kFootVt;
        uintptr_t best = 0; float bestD = 1.0f; uintptr_t bLo = 0, bHi = 0; /* 追従先の真下 1 以内 (ほかのプレイヤーの同じ物を選ばないように) */
        for (int pass = 0; pass < 2 && !best; pass++) { /* 0: 前に見つかった領域だけ、1: 全体 */
        if (pass == 0 && !g_FootRegHi) continue;
        uintptr_t addr = pass == 0 ? g_FootRegLo : 0;
        for (int guard = 0; guard < 8192; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            if (pass == 0 && mi.addr >= g_FootRegHi) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC);
            if (ok && mi.size >= 0x40) {
                ScanSafe(mi.addr, mi.size / 4, 12, [&](const u32* w, size_t from, size_t to) {
                    for (size_t i = from & ~static_cast<size_t>(1); i < to; i += 2) {
                        if (*reinterpret_cast<const uintptr_t*>(w + i) != vt) continue;
                        const float* f = reinterpret_cast<const float*>(w + i + kFootOff / 4);
                        const float dx = f[0] - cx, dz = f[2] - cz, dy = cy - f[1];
                        if (!(dy > 1.0f && dy < 4.0f)) continue; /* 追従先より 1〜4 低い (足元) */
                        const float d = dx * dx + dz * dz; if (d < bestD) { bestD = d; best = mi.addr + i * 4 + kFootOff; bLo = mi.addr; bHi = end; }
                    }
                });
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
        }
        if (best) { g_FootPos = best; g_FootRegLo = bLo; g_FootRegHi = bHi; }
    }
    void FootFindScan() { if (!BgRequest(2u, nullptr)) FootFindScanSync(); } /* 裏の流れで探す */
    /* バグフライ用: 体の座標の「元」を探す。アドレスサーチで足元の高さの座標が入っていた物 (vtable と、座標までの距離) を候補にして、
       浮くときに 1 組ずつ試しに書き、本当に足元の座標 (読むだけの写し) が上がった組を覚える。結果は SD の inkdraw/bin/flytest.txt に書く */
    struct FlyGrpDef { uintptr_t vt; u32 off; };
    static const FlyGrpDef kFlyGrp[9] = { { 0x5BF8770, 0x18 }, { 0x5D30060, 0x10 }, { 0x5F07DB0, 0x154 }, { 0x60016A0, 0x10 }, { 0x5F16988, 0x48 }, { 0x5D3F020, 0x40 }, { 0x5E01DD8, 0x64 }, { 0x170C1FC, 0xA4 }, { 0x5F15CB8, 0xA4 } };
    constexpr int kFlyGrpN = 9, kFlyGrpMax = 8;
    static uintptr_t g_FgAddr[kFlyGrpN][kFlyGrpMax]; static int g_FgN[kFlyGrpN];
    volatile int g_FlyGroup = -1; static u32 g_FgMask = 0; /* 効いた組 (ビット) */ static int g_FgTest = -1, g_FgFrames = 0; static float g_FgY0 = 0.0f; static bool g_FgFound = false; static char g_FgLog[4096]; static int g_FgLogL = 0;
    static bool FgRef(float* o) { if (SelfPos(o)) { o[1] -= kLiveHeight; return true; } return false; } /* 足元 (床の高さ) */
    /* 上がったかどうかを見る値: カメラの追従先 (本当の体についてくる。足元の写しは、試しに書いた組そのものかもしれないので使わない) */
    static bool FgMeasure(float* y) { if (CamValid()) { *y = reinterpret_cast<const float*>(g_CamPos)[1]; return true; } return false; }
    static void FgFind() {
        float R[3]; if (!FgRef(R)) return;
        std::memset(g_FgN, 0, sizeof(g_FgN));
        const uintptr_t mb = MainBase(); uintptr_t addr = 0;
        for (int guard = 0; guard < 8192; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC);
            if (ok && mi.size >= 0x200) {
                ScanSafe(mi.addr, mi.size / 4, 0x60, [&](const u32* w, size_t from, size_t to) {
                    for (size_t i = from & ~static_cast<size_t>(1); i < to; i += 2) {
                        const uintptr_t v = *reinterpret_cast<const uintptr_t*>(w + i); if (v < mb || v > mb + 0x7000000) continue;
                        for (int g = 0; g < kFlyGrpN; g++) {
                            if (v != mb + kFlyGrp[g].vt || g_FgN[g] >= kFlyGrpMax) continue;
                            const float* f = reinterpret_cast<const float*>(w + i + kFlyGrp[g].off / 4);
                            const float dx = f[0] - R[0], dy = f[1] - R[1], dz = f[2] - R[2];
                            if (dx * dx + dz * dz < 1.0f && dy > -0.6f && dy < 0.6f) g_FgAddr[g][g_FgN[g]++] = mi.addr + i * 4 + kFlyGrp[g].off;
                        }
                    }
                });
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
        g_FgFound = true;
        g_FgLogL = std::snprintf(g_FgLog, sizeof(g_FgLog), "inkdraw バグフライの座標テスト (版 %d)\n足元 %.2f %.2f %.2f\n", kInkVer, R[0], R[1], R[2]);
        for (int g = 0; g < kFlyGrpN; g++) if (g_FgLogL < 3800) g_FgLogL += std::snprintf(g_FgLog + g_FgLogL, sizeof(g_FgLog) - g_FgLogL, "組%d main+0x%lx +0x%x : %d 個\n", g, static_cast<unsigned long>(kFlyGrp[g].vt), static_cast<unsigned>(kFlyGrp[g].off), g_FgN[g]);
    }
    static void FgSave() { const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) UpdWrite(sdk, "inkd:/inkdraw/bin/flytest.txt", g_FgLog, static_cast<u32>(g_FgLogL)); }
    /* 組 g の全部に、動き (dx, dy, dz) を足す */
    static void FgMove(int g, float dx, float dy, float dz) {
        const uintptr_t vt = MainBase() + kFlyGrp[g].vt;
        for (int k = 0; k < g_FgN[g]; k++) { const uintptr_t a = g_FgAddr[g][k]; if (!Writable(a - kFlyGrp[g].off, kFlyGrp[g].off + 12) || *reinterpret_cast<const uintptr_t*>(a - kFlyGrp[g].off) != vt) continue; /* 同じ種類の物のままのときだけ書く */ float* f = reinterpret_cast<float*>(a); f[0] += dx; f[1] += dy; f[2] += dz; }
    }
    /* 浮くたびに呼ぶ (1 フレーム 1 回、フレーム更新の前)。覚えた組があれば true (その組で動かす) */
    static bool FgTick(int rd) {
        if (g_FlyGroup >= 0) return true;
        static bool wasUp = false;
        if (rd <= 0) { wasUp = false; return false; } /* 上がるときだけ試す (手を離しても、どこまで試したかは覚えておく) */
        if (!g_FgFound) { FgFind(); g_FgTest = -1; if (g_FgFound) FgSave(); }
        float Y; if (!FgMeasure(&Y)) return false;
        if (!wasUp) { wasUp = true; g_FgFrames = 0; g_FgY0 = Y; } /* 押し直したら、今の組を初めから測り直す */
        if (g_FgTest < 0 || g_FgFrames >= 20) {
            if (g_FgTest >= 0) { /* 結果 */
                const float up = Y - g_FgY0;
                if (g_FgLogL < 3800) g_FgLogL += std::snprintf(g_FgLog + g_FgLogL, sizeof(g_FgLog) - g_FgLogL, "組%d を試した: カメラの追従先が %.2f 上がった%s\n", g_FgTest, up, up > 0.5f ? " ← 効いた" : "");
                FgSave();
                if (up > 0.5f) g_FgMask |= 1u << g_FgTest; /* カメラは遅れてついてくるので、少しでも上がれば効いている (前の結果: 組0 で 1.28)。全部の組を試して、効いた組を全部使う */
            }
            int nx = g_FgTest + 1; while (nx < kFlyGrpN && g_FgN[nx] == 0) nx++;
            if (nx >= kFlyGrpN) {
                if (g_FgMask) { int f = 0; while (!(g_FgMask & (1u << f))) f++; g_FlyGroup = f; g_FgTest = -1; if (g_FgLogL < 3800) g_FgLogL += std::snprintf(g_FgLog + g_FgLogL, sizeof(g_FgLog) - g_FgLogL, "効いた組 (ビット) 0x%x を使う\n", static_cast<unsigned>(g_FgMask)); FgSave(); return true; }
                if (g_FgLogL < 3800) g_FgLogL += std::snprintf(g_FgLog + g_FgLogL, sizeof(g_FgLog) - g_FgLogL, "どの組も効かなかった\n"); FgSave(); g_FgTest = -1; g_FgFound = false; g_FlyGroup = -2; return false; }
            g_FgTest = nx; g_FgFrames = 0; g_FgY0 = Y;
        }
        FgMove(g_FgTest, 0.0f, 0.4f, 0.0f); g_FgFrames++;
        return false;
    }
    /* バグフライから呼ぶ: 覚えた組があれば、その組を (dx, rd 方向, dz) 動かして true */
    bool FlyGrpTesting() { return g_FgFound && g_FgTest >= 0; }
    void FlyGrpReset() { g_FlyGroup = -1; g_FgFound = false; g_FgTest = -1; g_FgMask = 0; } /* ロードしたら、見つけた場所は使えない */
    static bool g_FgHov = false; static float g_FgHY = 0.0f, g_FgBase = 0.0f; static int g_FgBad = 0;
    bool FlyGrpHovering() { return g_FgHov && g_FlyGroup >= 0; }
    void FlyGrpHoverOff() { g_FgHov = false; }
    /* 見つけた組で飛ぶ: B / ZL で上下、離すとその高さに止まる (フリーフライを OFF にするまで)。横は L スティック */
    bool FlyGrpStep(int rd, float dx, float dz) {
        if (g_FlyGroup < 0) { g_FgHov = false; if (!FgTick(rd)) return false; }
        const int g = g_FlyGroup; if (g < 0 || g_FgN[g] <= 0) return false;
        const uintptr_t a0 = g_FgAddr[g][0];
        if (!Readable(a0 - kFlyGrp[g].off, kFlyGrp[g].off + 12) || *reinterpret_cast<const uintptr_t*>(a0 - kFlyGrp[g].off) != MainBase() + kFlyGrp[g].vt) { FlyGrpReset(); g_FgHov = false; return false; } /* 物が消えた: 探し直す */
        const float y0 = reinterpret_cast<const float*>(a0)[1];
        if (!g_FgHov) { if (rd == 0) return false; g_FgHov = true; g_FgHY = y0; g_FgBase = y0; g_FgBad = 0; }
        g_FgHY += 0.4f * static_cast<float>(rd);
        if (g_FgHY > g_FgBase + 300.0f) g_FgHY = g_FgBase + 300.0f;
        if (g_FgHY < g_FgBase - 0.3f) g_FgHY = g_FgBase - 0.3f; /* 飛び始めた床より下には行かない */
        if (y0 - g_FgHY > 10.0f || y0 - g_FgHY < -10.0f) { if (++g_FgBad > 30) { g_FgHov = false; return false; } } else g_FgBad = 0; /* 大きく離れたまま = リスポーンなど: やめる */
        for (int q = 0; q < kFlyGrpN; q++) if (g_FgMask & (1u << q)) { /* 効いた組を全部、同じ高さ・同じ横の動きにそろえる */
            if (g_FgN[q] <= 0) continue; const float yq = reinterpret_cast<const float*>(g_FgAddr[q][0])[1];
            FgMove(q, dx, g_FgHY - yq, dz);
        }
        { /* 記録: 浮いている間の 180 フレーム (書く前の高さ / 目標 / 足元の座標 / カメラの追従先) */
            static char lg[12 * 1024]; static int ll = 0, rows = 0; static bool saved = false;
            if (rows == 0) { ll = std::snprintf(lg, sizeof(lg), "inkdraw バグフライ記録 (版 %d) 効いた組 0x%x\n番号 | 書く前の高さ | 目標 | 足元の座標 y | 追従先 y\n", kInkVer, static_cast<unsigned>(g_FgMask)); saved = false; }
            if (rows < 180 && ll < static_cast<int>(sizeof(lg)) - 100) { float sp[3] = {}; SelfPos(sp); const float cy = CamValid() ? reinterpret_cast<const float*>(g_CamPos)[1] : 0.0f; ll += std::snprintf(lg + ll, sizeof(lg) - ll, "%d | %.3f | %.3f | %.3f | %.3f\n", rows, y0, g_FgHY, sp[1] - kLiveHeight, cy); rows++; }
            if (rows >= 180 && !saved) { saved = true; const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) UpdWrite(sdk, "inkd:/inkdraw/bin/flylog.txt", lg, static_cast<u32>(ll)); }
        }
        return true;
    }
    /* ===== 飛び方テスト (ツール): 体の座標の「元」を探す =====
       アドレスサーチで見つかった物のうち、座標が何か所も入っている物 (位置・前の位置・途中の位置など) を候補にして、
       1 種類ずつ、その物の中の座標を全部まとめて 30 フレーム持ち上げ、カメラの追従先 (本当の体についてくる) がどれだけ上がったかを測る。
       結果は SD の inkdraw/bin/flytest2.txt。バグフライの飛び方は変えない */
    struct Ft2Def { uintptr_t vt; int n; u16 off[8]; };
    static const Ft2Def kFt2[8] = {
        { 0x5D30060, 7, { 0x10, 0x40, 0x4C, 0x58, 0x64, 0x70, 0x7C } },
        { 0x5D31578, 4, { 0x118, 0x124, 0x148, 0x154 } },
        { 0x5F07DB0, 1, { 0x154 } },
        { 0x60016A0, 1, { 0x10 } },
        { 0x5D3C428, 2, { 0x40, 0x70 } },
        { 0x5D3F020, 1, { 0x40 } },
        { 0x5BF8770, 1, { 0x18 } },
        { 0x5E01DD8, 1, { 0x64 } },
    };
    constexpr int kFt2N = 8, kFt2Obj = 4;
    static uintptr_t g_Ft2Obj[kFt2N][kFt2Obj]; static int g_Ft2ObjN[kFt2N];
    volatile int g_Ft2Step = 0, g_Ft2Grp = 0; volatile bool g_Ft2Wait = false; static int g_Ft2F = 0; static float g_Ft2Y0 = 0.0f, g_Ft2Max = 0.0f; static char g_Ft2Log[4096]; static int g_Ft2L = 0;
    static void Ft2Put(const char* s) { while (*s && g_Ft2L < static_cast<int>(sizeof(g_Ft2Log)) - 1) g_Ft2Log[g_Ft2L++] = *s++; g_Ft2Log[g_Ft2L] = 0; }
    static void Ft2Save() { const uintptr_t sdk = UpdSdk(); if (sdk && UpdMount(sdk)) UpdWrite(sdk, "inkd:/inkdraw/bin/flytest2.txt", g_Ft2Log, static_cast<u32>(g_Ft2L)); }
    static void Ft2Find() {
        std::memset(g_Ft2ObjN, 0, sizeof(g_Ft2ObjN));
        const float* C = reinterpret_cast<const float*>(g_CamPos); const float cx = C[0], cy = C[1], cz = C[2];
        const uintptr_t mb = MainBase(); uintptr_t addr = 0;
        for (int guard = 0; guard < 8192; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC);
            if (ok && mi.size >= 0x200) {
                ScanSafe(mi.addr, mi.size / 4, 0x60, [&](const u32* w, size_t from, size_t to) {
                    for (size_t i = from & ~static_cast<size_t>(1); i < to; i += 2) {
                        const uintptr_t v = *reinterpret_cast<const uintptr_t*>(w + i); if (v < mb || v > mb + 0x7000000) continue;
                        for (int g = 0; g < kFt2N; g++) {
                            if (v != mb + kFt2[g].vt || g_Ft2ObjN[g] >= kFt2Obj) continue;
                            const float* f = reinterpret_cast<const float*>(w + i + kFt2[g].off[0] / 4);
                            const float dx = f[0] - cx, dz = f[2] - cz, dy = cy - f[1];
                            if (dx * dx + dz * dz < 4.0f && dy > 0.5f && dy < 4.5f) g_Ft2Obj[g][g_Ft2ObjN[g]++] = mi.addr + i * 4;
                        }
                    }
                });
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
    }
    static void Ft2Lift(int g, float dy) {
        const uintptr_t vt = MainBase() + kFt2[g].vt;
        for (int k = 0; k < g_Ft2ObjN[g]; k++) {
            const uintptr_t o = g_Ft2Obj[g][k]; if (!Writable(o, 0x160) || *reinterpret_cast<const uintptr_t*>(o) != vt) continue; /* 同じ種類の物のままのときだけ */
            for (int j = 0; j < kFt2[g].n; j++) reinterpret_cast<float*>(o + kFt2[g].off[j])[1] += dy;
        }
    }
    /* 1 フレームに 1 回 (フレーム更新の前) */
    void Ft2Tick() {
        if (g_Ft2Step == 0 || g_Ft2Step >= 9) return;
        { static u64 lt = 0; const u64 n0 = NowTick(); if (n0 - lt < 250000ull) return; lt = n0; } /* 1 フレームに 1 回まで (フレーム更新とボタン読み取りの両方から呼ぶ) */
        if (!CamValid()) { /* カメラがわからない: 探す (1 秒に 1 回、自分の座標から先に) */
            static u64 nextT = 0; const u64 now = NowTick(); g_Ft2Wait = true;
            if (now >= nextT) { nextT = now + 19200000ull; if (!LiveValid()) { g_LivePos = 0; FindLivePos(nullptr); TryLiveAlt(); } CamFind(); }
            return;
        }
        g_Ft2Wait = false;
        const float cy = reinterpret_cast<const float*>(g_CamPos)[1];
        if (g_Ft2Step == 1) { /* 探す */
            Ft2Find(); g_Ft2L = 0; char b[160];
            std::snprintf(b, sizeof(b), "inkdraw 飛び方テスト (版 %d)\n組ごとに、物の中の座標を全部 30 フレーム持ち上げ (1 フレーム 0.3)、カメラの追従先がいちばん何上がったか\n", kInkVer); Ft2Put(b);
            for (int g = 0; g < kFt2N; g++) { std::snprintf(b, sizeof(b), "組%d main+0x%lx 座標 %d か所 : 物 %d 個\n", g, static_cast<unsigned long>(kFt2[g].vt), kFt2[g].n, g_Ft2ObjN[g]); Ft2Put(b); }
            Ft2Save(); g_Ft2Grp = 0; g_Ft2F = 0; g_Ft2Step = 2; return;
        }
        if (g_Ft2Step == 2) { /* 組ごとに: 30 フレーム持ち上げ、30 フレーム休む */
            while (g_Ft2Grp < kFt2N && g_Ft2ObjN[g_Ft2Grp] == 0) g_Ft2Grp = g_Ft2Grp + 1;
            if (g_Ft2Grp >= kFt2N) { Ft2Put("おわり\n"); Ft2Save(); g_Ft2Step = 9; return; }
            if (g_Ft2F == 0) { g_Ft2Y0 = cy; g_Ft2Max = 0.0f; }
            if (g_Ft2F < 30) Ft2Lift(g_Ft2Grp, 0.3f);
            if (cy - g_Ft2Y0 > g_Ft2Max) g_Ft2Max = cy - g_Ft2Y0;
            if (++g_Ft2F >= 60) { char b[96]; std::snprintf(b, sizeof(b), "組%d: %.2f 上がった%s\n", g_Ft2Grp, g_Ft2Max, g_Ft2Max > 1.0f ? " ← 効いた" : ""); Ft2Put(b); Ft2Save(); g_Ft2Grp = g_Ft2Grp + 1; g_Ft2F = 0; }
        }
    }
    /* バルーンの box: バルーン座標ツールの結果、イカバルーンのところにだけ vtable main+0x5C1C998 の物があり、その +0x4C に床の高さの座標が入っていた。
       この種類の物を全部探して覚える (10 秒ごとに探し直す。消えた物は使わない) */
    constexpr uintptr_t kBalVt = 0x5C1C998; constexpr u32 kBalOff = 0x4C; constexpr int kBalMax = 32;
    uintptr_t g_BalObj[kBalMax]; volatile int g_BalN = 0; u8 g_BalPool[kBalMax] = {};
    static void BalFind() {
        const uintptr_t vt = MainBase() + kBalVt; int n = 0; uintptr_t addr = 0;
        for (int guard = 0; guard < 8192 && n < kBalMax; guard++) {
            MemoryInfo mi; u32 page;
            if (R_FAILED(svcQueryMemory(&mi, &page, addr))) break;
            const uintptr_t end = mi.addr + mi.size;
            const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC);
            if (ok && mi.size >= 0x80) {
                ScanSafe(mi.addr, mi.size / 4, 0x18, [&](const u32* w, size_t from, size_t to) {
                    for (size_t i = from & ~static_cast<size_t>(1); i < to && n < kBalMax; i += 2) {
                        if (*reinterpret_cast<const uintptr_t*>(w + i) != vt) continue;
                        const float* f = reinterpret_cast<const float*>(w + i + kBalOff / 4);
                        if (!(f[0] == f[0] && f[1] == f[1] && f[2] == f[2]) || f[0] < -5000.0f || f[0] > 5000.0f || f[1] < -5000.0f || f[1] > 5000.0f || f[2] < -5000.0f || f[2] > 5000.0f) continue;
                        g_BalObj[n++] = mi.addr + i * 4;
                    }
                });
            }
            if (end <= addr || end == 0) break;
            addr = end;
        }
        g_BalN = n;
    }
    volatile bool g_HasPl = false; /* ほかのプレイヤーがいる = 試合中 (試合にバルーンは無いので、残っているバルーンの物は数えない・狙わない) */
    bool BalPos(int k, float* o) { /* k 番目のバルーンの床の座標 (まだ同じ種類の物のときだけ) */
        if (k < 0 || k >= g_BalN || g_BalPool[k] || g_HasPl || !BattleGate()) return false; const uintptr_t ob = g_BalObj[k];
        if (!Readable(ob, 0x254) || *reinterpret_cast<const uintptr_t*>(ob) != MainBase() + kBalVt) return false;
        { const u8 bs = *reinterpret_cast<const u8*>(ob + 0x250); if (bs == 1 || bs == 0) return false; } /* 1 = 割れている、0 = 使われていない物 (試合中に出ていた変なバルーン)。3 以外でも、当たった瞬間などは数える (前は 3 だけにして、たまに消えていた) */ /* +0x250 が 1 = 割れている (3 = ある)。割れている間は無いことにする */
        std::memcpy(o, reinterpret_cast<const void*>(ob + kBalOff), 12); return o[0] == o[0] && o[1] == o[1] && o[2] == o[2];
    }
    /* 敵: ターゲット座標の結果、敵の足元 (床の高さ) の座標が、vtable main+0x5D30060 の物の +0x10 に入っていた (自分の体の組と同じ種類)。
       この種類の物を全部探して覚える (自分は除く)。バルーンと同じく、1 フレームに 8MB ずつ少しずつ調べ、1 周したら 10 秒休む */
    constexpr uintptr_t kEnVt = 0x5D30060; constexpr u32 kEnOff = 0x10; constexpr int kEnMax = 48; /* プレイヤーの体の組は、使っていない物も含めてたくさんあるので多めに (16 だと本物の敵が入らないことがあった) */
    uintptr_t g_EnObj[kEnMax]; volatile int g_EnN = 0; static float g_EnFirst[kEnMax][3]; static u8 g_EnMoved[kEnMax], g_EnFirstOk[kEnMax], g_EnPool[kEnMax]; static float g_EnRef[kEnMax][3]; static u64 g_EnMoveT[kEnMax]; /* 見つけてから一度でも動いたか (動いたことのない物は、使っていない物のことがある) */ uintptr_t g_EnSelf = 0, g_EnCloseObj = 0, g_EnBase = 0; int g_EnCloseN = 0; /* g_EnSelf: 自分の体 (同じ種類の物) */
    constexpr uintptr_t kRtVt = 0x5D34000;
    bool RetPoint(float* A) { /* レティクルの点 (撃つ先) の x y z。銃口 (+0x8C) が自分のすぐ近くにあるときだけ */
        const uintptr_t ob = g_RtObj; if (!ob || !Readable(ob, 0xC4) || *reinterpret_cast<const uintptr_t*>(ob) != MainBase() + kRtVt) return false;
        const float* M = reinterpret_cast<const float*>(ob + 0x8C); float me[3]; if (!SelfPos(me)) return false;
        const float dx = M[0] - me[0], dy = M[1] - me[1], dz = M[2] - me[2]; if (!(dx * dx + dy * dy + dz * dz < 16.0f)) return false;
        std::memcpy(A, reinterpret_cast<const void*>(ob + 0xB8), 12); return A[0] == A[0] && A[1] == A[1] && A[2] == A[2] && A[0] > -5000.0f && A[0] < 5000.0f && A[1] > -5000.0f && A[1] < 5000.0f && A[2] > -5000.0f && A[2] < 5000.0f;
    }
    bool RayHit(float* H) { /* カメラのまん中の線が当たった所 (レティクルの物の +0x98) */
        const uintptr_t ob = g_RtObj; if (!ob || !Readable(ob, 0xC4) || *reinterpret_cast<const uintptr_t*>(ob) != MainBase() + kRtVt) return false;
        float A[3]; if (!RetPoint(A)) return false; std::memcpy(H, reinterpret_cast<const void*>(ob + 0x98), 12); return H[0] == H[0] && H[1] == H[1] && H[2] == H[2];
    }
    static u64 g_EnOccT[kEnMaxFwd], g_EnSeenT[kEnMaxFwd];
    void EnOccTick() { /* 画面のまん中 (2.5 度以内) にいる敵だけ、まん中の線が先に壁に当たっていないかを見る。当たっていたら「壁の裏」 */
        float E[3], c[3], H[3]; if (!CamEye(E) || !CamDir3(c) || !RayHit(H)) return; const u64 nw = NowTick();
        const float hx = H[0] - E[0], hy = H[1] - E[1], hz = H[2] - E[2]; const float hd = __builtin_sqrtf(hx * hx + hy * hy + hz * hz);
        for (int k = 0; k < g_EnN && k < kEnMaxFwd; k++) { float p[3]; if (!EnPos(k, p)) continue; p[1] += EnSquid(k) ? 0.3f : 0.9f;
            const float vx = p[0] - E[0], vy = p[1] - E[1], vz = p[2] - E[2], t = vx * c[0] + vy * c[1] + vz * c[2]; if (t < 1.0f) continue;
            const float p2 = vx * vx + vy * vy + vz * vz - t * t; if (p2 > t * t * 0.0019f) continue; /* 2.5 度より外 */
            if (hd < t - 1.5f) g_EnOccT[k] = nw; else g_EnSeenT[k] = nw; }
    }
    bool EnOccluded(int k) { return false; /* 壁の裏の判定はやめた (見えているのに狙わないことがあった) */ if (k < 0 || k >= kEnMaxFwd) return false; const u64 nw = NowTick(); return g_EnOccT[k] && nw - g_EnOccT[k] < 57600000ull && g_EnOccT[k] > g_EnSeenT[k]; } /* 3 秒前までに壁の裏と分かった */
    bool EnSquid(int k) { /* 潜伏中か: 潜伏記録の結果、体の組の +0x7FC と +0x804 が、人のとき 0、潜伏のとき 1.0 になっていた */
        if (k < 0 || k >= g_EnN) return false; const uintptr_t ob = g_EnObj[k]; if (!Readable(ob + 0x7FC, 12)) return false;
        const float a = *reinterpret_cast<const float*>(ob + 0x7FC), c = *reinterpret_cast<const float*>(ob + 0x804); return a > 0.5f && a < 1.5f && c > 0.5f && c < 1.5f;
    }
    bool EnMovedOnce(int k) { return k >= 0 && k < g_EnN && k < kEnMax && g_EnMoved[k]; }
    static uintptr_t EnSelfBody() { /* 自分の体: 分かっていればそれ、なければカメラの追従先の真下にある体 (0.5 秒ごとに探し直す) */
        static uintptr_t cache = 0; static u64 t = 0; const u64 now = NowTick();
        if (t && now - t < 9600000ull && (!cache || Readable(cache, 0x10B0))) return cache;
        t = now; cache = 0;
        if (g_EnSelf && Readable(g_EnSelf, 0x10B0)) { cache = g_EnSelf; return cache; }
        const uintptr_t cp = g_CamPos; if (!cp || !CamValid() || !Readable(cp, 12)) return 0; const float* C = reinterpret_cast<const float*>(cp);
        float bd = 1.44f;
        for (int k = 0; k < g_EnN && k < kEnMax; k++) { const uintptr_t ob = g_EnObj[k]; if (!Readable(ob, 0x10B0) || *reinterpret_cast<const uintptr_t*>(ob) != MainBase() + kEnVt) continue;
            const float* o = reinterpret_cast<const float*>(ob + kEnOff); const float dx = o[0] - C[0], dz = o[2] - C[2], up = C[1] - o[1], d2 = dx * dx + dz * dz;
            if (up > 0.3f && up < 4.5f && d2 < bd) { bd = d2; cache = ob; } }
        return cache;
    }
    static bool EnIsAlly(uintptr_t ob) { /* 自分の体が分からないとき・値がチームの番号らしくないときは、味方とみなさない (今までどおり狙う) */
        const uintptr_t sb = EnSelfBody(); if (!sb || sb == ob || !Readable(ob, 0x10B0)) return false;
        const u32 s1 = *reinterpret_cast<const u32*>(sb + 0x10A8), s2 = *reinterpret_cast<const u32*>(sb + 0xCA0);
        const u32 b1 = *reinterpret_cast<const u32*>(ob + 0x10A8), b2 = *reinterpret_cast<const u32*>(ob + 0xCA0);
        if (s1 > 3 || s2 > 3) return false;
        return b1 == s1 && b2 == s2;
    }
    bool EnPos(int k, float* o) { /* k 番目の敵の床の座標 (まだ同じ種類の物で、自分ではないときだけ) */
        if (k < 0 || k >= g_EnN || !BattleGate()) return false; const uintptr_t ob = g_EnObj[k];
        if (g_EnBase != g_CamPos) { g_EnBase = g_CamPos; g_EnSelf = 0; g_EnCloseObj = 0; g_EnCloseN = 0; } /* ロードした: 覚え直す */
        if (!Readable(ob, kEnOff + 12) || *reinterpret_cast<const uintptr_t*>(ob) != MainBase() + kEnVt) return false;
        std::memcpy(o, reinterpret_cast<const void*>(ob + kEnOff), 12);
        if (!(o[0] == o[0] && o[1] == o[1] && o[2] == o[2]) || o[0] < -5000.0f || o[0] > 5000.0f || o[1] < -5000.0f || o[1] > 5000.0f || o[2] < -5000.0f || o[2] > 5000.0f) return false;
        if (o[0] == 0.0f && o[1] == 0.0f && o[2] == 0.0f) return false; /* まだ使われていない物 */
        float camC[3]; bool haveC = false; { const uintptr_t cp = g_CamPos; if (cp && CamValid() && Readable(cp, 12)) { std::memcpy(camC, reinterpret_cast<const void*>(cp), 12); haveC = true; } }
        if (ob == g_EnSelf) { bool farC = false; if (haveC) { const float dx = o[0] - camC[0], dz = o[2] - camC[2]; farC = dx * dx + dz * dz > 9.0f; } if (!farC) return false; g_EnSelf = 0; } /* 自分だと分かった物 (追従先から 3 以上はなれていたら、自分ではなかった: 覚え直す) */
        if (haveC) { const float dx = o[0] - camC[0], dz = o[2] - camC[2], up = camC[1] - o[1]; if (dx * dx + dz * dz < 1.0f && up > 0.3f && up < 4.5f) return false; } /* 追従先の真下 = 自分の体 */
        if (!Readable(ob + 0xB80, 16) || (*reinterpret_cast<const u64*>(ob + 0xB80) == 0 && *reinterpret_cast<const u64*>(ob + 0xB88) == 0)) return false; /* 体の記録の比べた結果: 本物のプレイヤーは +0xB80 / +0xB88 に値が入っている。ステージの地面や地中に出ていた偽物 (使われていない体) は 0 */
        if (Readable(ob + 0xEF0, 0x20)) { /* 敵の死亡記録 (2) の結果: 倒れた瞬間に +0xEF4 (リスポーンまでの数え。約 390 から 0 へ減る) と +0xF04 (1) が入った。生きている間は両方 0 */
            const s32 rt = *reinterpret_cast<const s32*>(ob + 0xEF4); const u32 dfl = *reinterpret_cast<const u32*>(ob + 0xF04);
            if (rt > 0 && rt < 3000 && dfl >= 1u) return false; } /* +0xF04 は倒された回数の数え (1 回目 = 1, 2 回目 = 2 ...)。1 だけを見ていたので、2 回目以降は消えなかった */
        float me[3]; if (SelfPos(me)) { const float dx = o[0] - me[0], dz = o[2] - me[2], dy = o[1] - (me[1] - kLiveHeight), d2 = dx * dx + dz * dz;
            if (!g_EnMoved[k]) { /* 動いたことがあるか: 最初の位置から 0.5 以上動いたら「使われている物」 */
                if (!g_EnFirstOk[k]) { std::memcpy(g_EnFirst[k], o, 12); g_EnFirstOk[k] = 1; }
                else { const float mx = o[0] - g_EnFirst[k][0], my = o[1] - g_EnFirst[k][1], mz = o[2] - g_EnFirst[k][2]; if (mx * mx + my * my + mz * mz > 0.25f) g_EnMoved[k] = 1; } }
            if (!g_EnMoved[k] && g_EnPool[k]) return false; /* 低い所にいるだけでは消さない (偽物は上の値で見分ける) */
            { const u64 nw = NowTick(); const float rx = o[0] - g_EnRef[k][0], ry = o[1] - g_EnRef[k][1], rz = o[2] - g_EnRef[k][2];
              if (!g_EnMoveT[k] || rx * rx + ry * ry + rz * rz > 0.09f) { std::memcpy(g_EnRef[k], o, 12); g_EnMoveT[k] = nw; } /* 最後に動いた時刻 */ } /* 動かない敵も消さない (倒された敵は +0xEF4 / +0xF04 で見分ける) */
            if (dy < -150.0f) return false; /* (前は 8 で、高い所に上ると下の敵を見なくなっていた) */ /* 自分より 8 以上下 (ステージの下に置いてある、使われていない物) */
            if (d2 < 1.44f && dy > -2.5f && dy < 2.5f) { /* 自分のすぐ近く (1.2 以内): 敵としては使わない。長く (約 1 秒) 近いままなら「自分」として覚える */
                if (g_EnCloseObj == ob) { if (++g_EnCloseN >= 60) { bool nc = true; if (haveC) { const float cx2 = o[0] - camC[0], cz2 = o[2] - camC[2]; nc = cx2 * cx2 + cz2 * cz2 < 9.0f; } if (nc) g_EnSelf = ob; } } else { g_EnCloseObj = ob; g_EnCloseN = 1; }
                return false; }
            if (g_EnCloseObj == ob) g_EnCloseN = 0; }
        if (EnIsAlly(ob)) return false; /* 味方 */
        if (!g_TmEnOk) g_TmEnOk = NowTick();
        return true;
    }
    /* バルーンと敵の探し物を 1 回の見回りでまとめて行う (同じメモリを 2 回見ないように)。1 フレームに 4MB ずつ少しずつ調べ、1 周したら結果を入れかえる。
       見えている物があるときは 30 秒休む (ほとんど探さない = 固まらない)。見る物がいないときだけ 3 秒で探し直す */
    static uintptr_t g_ObjTb[kBalMax], g_ObjTe[kEnMax], g_ObjTr[16]; static int g_ObjNb = 0, g_ObjNe = 0, g_ObjNr = 0; static bool g_ObjScB = false, g_ObjScE = false, g_ObjScR = false;
    void ObjScanFull() { /* 裏の流れで: メモリから、バルーン・敵・レティクルの物を探す。前に見つけた物のまわり (前後 24MB) を先に調べ、足りなければ全体を調べる */
        const uintptr_t vb = MainBase() + kBalVt, ve = MainBase() + kEnVt, vr = MainBase() + kRtVt; int nb = 0, ne = 0, nr = 0;
        static uintptr_t hLo[8], hHi[8]; static int hN = 0; static u32 scanN = 0; scanN++;
        auto pass = [&](bool quick) {
            nb = 0; ne = 0; nr = 0; uintptr_t cur = 0; uintptr_t nLo[8], nHi[8]; int nN = 0;
            for (int guard = 0; guard < 8192; guard++) {
                MemoryInfo mi; u32 page;
                if (R_FAILED(svcQueryMemory(&mi, &page, cur))) break;
                const uintptr_t end = mi.addr + mi.size; if (end <= cur || end == 0) break;
                const bool ok = (mi.type == 2 || mi.type == 4 || mi.type == 5 || mi.type == 9) && (mi.perm & Perm_R) && (mi.perm & Perm_W) && !(mi.attr & 0xC);
                if (ok && mi.size >= 0x80) {
                    uintptr_t lo[8], hi[8]; int nw = 0;
                    if (quick) { for (int h = 0; h < hN; h++) { const uintptr_t a = (hLo[h] > mi.addr ? hLo[h] : mi.addr) & ~static_cast<uintptr_t>(7), b = hHi[h] < end ? hHi[h] : end; if (b > a + 0x80) { lo[nw] = a; hi[nw] = b; nw++; } } }
                    else { lo[0] = mi.addr; hi[0] = end; nw = 1; }
                    for (int wI = 0; wI < nw; wI++) {
                        const uintptr_t from = lo[wI]; const int nb0 = nb, ne0 = ne, nr0 = nr;
                        ScanSafe(from, (hi[wI] - from) / 4, 0x18, [&](const u32* w, size_t a, size_t b) {
                            for (size_t i = a & ~static_cast<size_t>(1); i < b; i += 2) {
                                const uintptr_t v = *reinterpret_cast<const uintptr_t*>(w + i);
                                if (g_ObjScR && v == vr) { if (nr < 16) g_ObjTr[nr++] = from + i * 4; continue; }
                                u32 off; if (g_ObjScB && v == vb && nb < kBalMax) off = kBalOff; else if (g_ObjScE && v == ve && ne < kEnMax) off = kEnOff; else continue;
                                const float* f = reinterpret_cast<const float*>(w + i + off / 4);
