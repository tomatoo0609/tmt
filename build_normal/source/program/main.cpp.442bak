                            for (u32 i = 3; i < n; i++) if (g_UpdBuf[i - 3] == '\r' && g_UpdBuf[i - 2] == '\n' && g_UpdBuf[i - 1] == '\r' && g_UpdBuf[i] == '\n') { hdrEnd = static_cast<int>(i + 1); break; }
                            if (hdrEnd >= 0) {
