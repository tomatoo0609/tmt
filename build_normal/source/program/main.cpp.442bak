                                if (h[0] == 'H' && h[8] == ' ') status = (h[9] - '0') * 100 + (h[10] - '0') * 10 + (h[11] - '0');
                                for (const char* q = h; *q; q++) {
                                    if (q != h && q[-1] != '\n') continue;
                                    auto ieq = [&](const char* key) { int i = 0; for (; key[i]; i++) { char c = q[i]; if (c >= 'A' && c <= 'Z') c += 32; if (c != key[i]) return 0; } return i; };
                                    int kl;
                                    if ((kl = ieq("content-length:"))) { const char* v = q + kl; while (*v == ' ') v++; clen = 0; while (*v >= '0' && *v <= '9') clen = clen * 10 + (*v++ - '0'); }
                                    else if ((kl = ieq("transfer-encoding:"))) { for (const char* v = q + kl; *v && *v != '\r'; v++) if (v[0] == 'c' && v[1] == 'h') chunked = true; }
                                }
                                if (status != 200) { rc = 30 + (status / 100); break; }
                                if (clen > static_cast<long>(maxLen)) { rc = 22; break; }
                                if (progress) g_UpdTot = clen > 0 ? static_cast<u32>(clen) : 0;
                            }
                        }
                        if (hdrEnd >= 0) { if (progress) g_UpdGot = n - static_cast<u32>(hdrEnd); if (clen >= 0 && n - static_cast<u32>(hdrEnd) >= static_cast<u32>(clen)) break; }
                    }
                    if (rc == 0) {
                        if (hdrEnd < 0) rc = 23;
                        else {
                            u8* body = g_UpdBuf + hdrEnd; u32 bl = n - static_cast<u32>(hdrEnd);
                            if (chunked) { /* つながった塊をほどく */
                                u32 r = 0, w = 0;
                                while (r < bl) {
                                    u32 sz = 0; bool any = false;
                                    while (r < bl) { const u8 c = body[r]; int d = c >= '0' && c <= '9' ? c - '0' : (c >= 'a' && c <= 'f' ? c - 'a' + 10 : (c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1)); if (d < 0) break; sz = sz * 16 + static_cast<u32>(d); r++; any = true; }
                                    while (r < bl && body[r] != '\n') r++; r++;
                                    if (!any || sz == 0) break;
                                    if (r + sz > bl) { sz = bl - r; }
                                    std::memmove(body + w, body + r, sz); w += sz; r += sz + 2;
                                }
                                bl = w;
                            } else if (clen >= 0) { if (bl < static_cast<u32>(clen)) rc = 24; else bl = static_cast<u32>(clen); }
                            if (rc == 0) { std::memmove(g_UpdBuf, body, bl); g_UpdLen = bl; g_UpdBuf[bl] = 0; }
                        }
