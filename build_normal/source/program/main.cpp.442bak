        static uintptr_t at[kT][kNear]; static float dd[kT][kNear]; static float ps[kT][kPosMax][3]; int nn[kT] = {}, all[kT] = {};
        MemoryInfo sm; u32 sp; uintptr_t selfLo = 0, selfHi = 0; if (R_SUCCEEDED(svcQueryMemory(&sm, &sp, reinterpret_cast<uintptr_t>(g_EbBuf)))) { selfLo = sm.addr; selfHi = sm.addr + sm.size; }
        const float mx = g_AdMe[0], my = g_AdMe[1] - kLiveHeight, mz = g_AdMe[2]; uintptr_t cur = 0;
        for (int guard = 0; guard < 8192; guard++) {
            if (gen != g_LoadGen) { g_AdMsg = 4; return; }
